    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Beards! Get your wonderful beards!",
      "translation" : "胡须！快来看看这漂亮的胡须！"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Would you like a beard?",
      "translation" : "你想要一把胡须吗？"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Yes, I'd like some facial hair!",
      "translation" : "是啊，我想留点胡子！"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "No thanks, thats gross!",
      "translation" : "不用了，太恶心！"
