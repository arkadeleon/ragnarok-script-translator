    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[胡须男]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Fine, be that way!",
      "translation" : "好吧，随你便！"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[胡须男]"
    },
