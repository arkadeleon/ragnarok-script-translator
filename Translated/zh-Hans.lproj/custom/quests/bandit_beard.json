      "npc" : "Man",
      "state" : "translated",
      "text" : "[Thread Merchant]",
      "translation" : "[线商人]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Man",
      "state" : "translated",
      "text" : "Oh thank the Gods!",
      "translation" : "谢天谢地！"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Man",
      "state" : "translated",
      "text" : "If you can only just kill the bugs I would be able to make my delivery.",
