    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[胡须男]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "HoHo~ So you want some whiskers.",
      "translation" : "呵呵~所以你想要点胡须。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Well I would give you my beards but there not cheap.",
      "translation" : "我倒是愿意把自己的胡须给你，但它可不便宜。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Matter of fact I have only one left...",
      "translation" : "事实上，我只剩下一把了..."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "but I'm not selling it.",
      "translation" : "不过我不卖。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "But don't get mad! I can make you one.",
      "translation" : "别生气！我可以给你做一把。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[胡须男]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "I would need some ^8080FFThread^000000 for the Beard.",
      "translation" : "做胡须需要一些^8080FF线^000000。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Talk to my friend in Izlude for some ^8080FFThread^000000.",
      "translation" : "去依斯鲁得找我的朋友拿些^8080FF线^000000。"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[胡须男]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Also I would need you to get me some things for the beard.",
      "translation" : "另外，你还得帮我收集一些胡须材料。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "They are:",
      "translation" : "需要这些："
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFElastic Band^000000",
      "translation" : "^8080FF橡皮筋^000000"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FF5 Animal Skins^000000",
      "translation" : "^8080FF动物皮5张^000000"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFBlack Dye Stuff^000000",
      "translation" : "^8080FF黑色染料^000000"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFGranpa Beard^000000",
      "translation" : "^8080FF爷爷胡须^000000"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FF100 sticky Mucus^000000",
      "translation" : "^8080FF粘稠液体100个^000000"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFCounteragent^000000",
      "translation" : "^8080FF中和剂^000000"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : " and one ^8080FF2 Carat Diamond^000000",
      "translation" : "还有一颗^8080FF二克拉钻石^000000"
