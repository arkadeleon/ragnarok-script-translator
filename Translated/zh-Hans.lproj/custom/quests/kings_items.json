{
  "file" : "npc/custom/quests/kings_items.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "[King of Prontera]\nHello, can you help me?",
      "translation" : "[普隆德拉国王]\n你好，能帮个忙吗？"
    },
    {
      "kind" : "option",
      "line" : 20,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "Sure, what can I do?",
      "translation" : "当然，需要做什么？"
    },
    {
      "kind" : "option",
      "line" : 20,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "Sorry, I'm busy.",
      "translation" : "抱歉，我很忙"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "[King of Prontera]\nOk, that's fine, I'm sure someone else will help.",
      "translation" : "[普隆德拉国王]\n好的，没关系，我相信会有其他人帮忙的。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "[King of Prontera]\nThank you. Well, my daughter next to me is a little rowdy...\nIf you get her these items I'm sure she'll calm down.\nI'll give you my crown or my sword as a reward.",
      "translation" : "[普隆德拉国王]\n谢谢。嗯，我旁边的女儿有点调皮...\n如果你能给她这些物品，我相信她会安静下来的。\n我会把我的王冠或剑作为奖励给你。"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "What do you need?",
      "translation" : "你需要什么？"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "I have the items!",
      "translation" : "我有这些物品！"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "Forget it.",
      "translation" : "算了"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "King of Prontera",
      "state" : "translated",
      "text" : "[King of Prontera]\nIf you could get me:\nI'll give my crown.",
      "translation" : "[普隆德拉国王]\n如果你能帮我收集：\n我就把我的王冠送给你。"
    },
