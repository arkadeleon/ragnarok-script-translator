      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "What Do I Need?",
      "translation" : "我需要准备什么？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "Where Can I find this Crap?",
      "translation" : "这些破烂要去哪里找？"
