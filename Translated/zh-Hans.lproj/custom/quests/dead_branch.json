      "text" : "[Mister Mobry]",
      "translation" : "[莫布里先生]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "In fact I know a secret about these spirits that can in some way... perhaps aid you...",
      "translation" : "其实我知道这些灵魂的一个秘密，也许能以某种方式...帮到你..."
