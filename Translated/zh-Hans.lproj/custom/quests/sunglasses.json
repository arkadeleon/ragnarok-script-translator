{
  "file" : "npc/custom/quests/sunglasses.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "There is nothing more I can tell you.",
      "translation" : "我没什么能再告诉你的了。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Go see Maseph. She is somewhere north of Morocc.",
      "translation" : "去找玛瑟普。她在梦罗克北边某处。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Hello. What can I do for you?",
      "translation" : "你好，有什么事吗？"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "I heard that you can make ^0000FFSlotted Sunglasses^000000.",
      "translation" : "听说你会制作^0000FF开洞太阳镜^000000。"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Nothing, sorry to bother you.",
      "translation" : "没事，抱歉打扰了。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Come back to me than you are ready.",
      "translation" : "等你准备好了再来找我。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "I do not make them, but I can tell you where to find the person who does. For a small fee...",
      "translation" : "我不制作太阳镜，不过可以告诉你去哪里找制作的人。只收一点费用..."
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "How much?",
      "translation" : "要多少钱？"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "No way, I will find her myself!",
      "translation" : "算了，我自己去找她！"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Suit yourself, the Maker will not make you ^0000FFSlotted Sunglasses^000000 unless she knows that you are coming.",
      "translation" : "随你便。除非她知道你会去，否则制作者不会给你制作^0000FF开洞太阳镜^000000。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Only I can tell her you are coming.",
      "translation" : "只有我能通知她你要过去。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Come back to me when you have given up. Hahaha...",
      "translation" : "等你放弃了再回来找我。哈哈哈..."
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "In order for me to tell you information on ^0000FFSlotted Sunglasses^000000 you need to get me:",
      "translation" : "想让我告诉你^0000FF开洞太阳镜^000000的消息，你得先给我："
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : " - ^0000881 Carat Diamond^000000",
      "translation" : " - ^0000881颗钻石^000000"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : " - ^00008850 Feathers^000000",
      "translation" : " - ^00008850根羽毛^000000"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : " - ^000088100000z^000000",
      "translation" : " - ^000088100000金币^000000"
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Alright, here.",
      "translation" : "好，给你。"
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "That's too much!",
      "translation" : "太贵了！"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Suit yourself.",
      "translation" : "随你便。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "You're missing something. Come back when you've gathered all the materials.",
      "translation" : "你还缺东西。收集齐所有材料后再来。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Great. Now, listen carefully.",
      "translation" : "很好。现在仔细听。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太阳镜商人]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Look for someone named Maseph somewhere north of Morocc.",
      "translation" : "去梦罗克北边找一个叫玛瑟普的人。"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "I will send her a message to let her know that you are coming.",
      "translation" : "我会给她捎个口信，让她知道你要过去。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[玛瑟普]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Lovely day, isn't it ?",
      "translation" : "今天天气真好，不是吗？"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Hello there.",
      "translation" : "你好。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "You came for the ^000088Slotted Sunglasses^000000, right?",
      "translation" : "你是来找^000088开洞太阳镜^000000的，对吧？"
    },
    {
      "kind" : "option",
      "line" : 80,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 80,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "No, sorry to bother you.",
      "translation" : "不是，抱歉打扰了。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[玛瑟普]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Off you go, then.",
      "translation" : "那你去吧。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[玛瑟普]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "To make one, I will need one pair of ^000088Sunglasses^000000 and 400000z.",
      "translation" : "制作一副需要一副^000088太阳镜^000000和400000金币。"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Here you go.",
      "translation" : "给你。"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "No, thanks.",
      "translation" : "不用了，谢谢。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[玛瑟普]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "As you wish.",
      "translation" : "如你所愿。"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[玛瑟普]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "I need one pair of ^000088Sunglasses^000000. Come back to me when you have one.",
      "translation" : "我需要一副^000088太阳镜^000000。准备好后再来找我。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "You do not have enough Zeny. Come back to me when you do.",
      "translation" : "你的金币不够。攒够了再来找我。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Thank you. I will get on it right away...",
      "translation" : "谢谢。我马上就开始制作..."
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[玛瑟普]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Here you go, my friend.",
      "translation" : "给你，我的朋友。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Enjoy your ^000088Slotted Sunglasses^000000.",
      "translation" : "好好享用你的^000088开洞太阳镜^000000。"
    }
  ]
}