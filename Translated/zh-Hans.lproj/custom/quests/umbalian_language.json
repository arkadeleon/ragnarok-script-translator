      "text" : "[Mason]",
      "translation" : "[梅森]"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Mason",
      "state" : "translated",
      "text" : "Hey there, I came here to Prontera in search of an old lady who can remove cards from slots. Do you know where I can find her?",
      "translation" : "你好，我来普隆德拉找一位能拆除卡片的老太太。你知道她在哪里吗？"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Mason",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "知道"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Mason",
      "state" : "translated",
      "text" : "No",
      "translation" : "不知道"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Mason",
      "state" : "translated",
      "text" : "Oooo, could you please tell me where she's at? I'd be really appreciative.",
      "translation" : "哦哦，能告诉我她在哪儿吗？我会非常感激的。"
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Mason",
      "state" : "translated",
      "text" : "Swordsman Association",
      "translation" : "剑士协会"
    },
    {
