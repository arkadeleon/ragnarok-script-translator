      "npc" : "Mason",
      "state" : "translated",
      "text" : "Prontera Chivalry",
      "translation" : "普隆德拉骑士团"
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Mason",
      "state" : "translated",
