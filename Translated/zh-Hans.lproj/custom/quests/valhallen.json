    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^3355FFMjolnir^000000 is the mighty Hammer of Thor.",
      "translation" : "^3355FF雷神之锤^000000是雷神托尔的强大武器。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^3355FFSleipnir^000000 are boots made after Odin's War Horse.",
      "translation" : "^3355FF斯雷普尼尔^000000是以奥丁的战马为原型打造的靴子。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^3355FFBrisingammen^000000 is the magical Necklace of Freyja, goddess of Beauty.",
      "translation" : "^3355FF布里希嘉曼^000000是美与爱之女神芙蕾雅的魔法项链。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFGleipnir^000000 is a light yet strong rope required to make ^3355FFMegingjard^000000",
      "translation" : "^3355FF格莱普尼尔^000000是一条轻巧而坚韧的绳索，是制作^3355FF梅吉恩杰德^000000所需的材料。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFMegingjard^000000 is the powerful Belt of Thor.",
      "translation" : "^3355FF梅吉恩杰德^000000是雷神托尔的强力腰带。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFAsprika^000000 is the light of gods.",
      "translation" : "^3355FF阿斯普里卡^000000是诸神之光。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFBrynhild^000000 is the warrior's armor.",
      "translation" : "^3355FF布伦希尔德^000000是战士的铠甲。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFHervor^000000 is named after the valkyrie who ensures victory for her warriors.",
      "translation" : "^3355FF赫尔沃^000000以女武神命名，她负责确保战士们取得胜利。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFJormungand^000000 is famous for its ability to poison the enemy.",
      "translation" : "^3355FF耶梦加得^000000以能使敌人中毒而闻名。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFMuspellium^000000 is required to make ^3355FFJormungand^000000 and ^3355FFHervor^000000.",
      "translation" : "制作^3355FF耶梦加得^000000和^3355FF赫尔沃^000000需要^3355FF穆斯贝尔海姆之石^000000。"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜丝]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFEssence Of Rune^000000 is required to make ^3355FFJormungand^000000 and ^3355FFHervor^000000.",
      "translation" : "制作^3355FF耶梦加得^000000和^3355FF赫尔沃^000000需要^3355FF卢恩精华^000000。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^FF0000The items I need are as follows:^000000",
      "translation" : "^FF0000我需要以下物品：^000000"
