        "((countitem(.@id)<.@amount)?(\"^dd3355\"):(\"^33dd55\"))",
        "getitemname(.@id)",
        "((getitemslots(.@id)>0)?\" [\"+getitemslots(.@id)+\"]\":\"\")"
