      "kind" : "message",
      "line" : 24,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "I can transmute for you many of the Valhallen items,",
      "translation" : "我可以为你合成许多英灵殿的物品，"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "although they require many rare elements to make.",
      "translation" : "不过制作它们需要许多稀有材料。"
