      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I can ^0055FFsign your name^000000 on almost any rare item you hold.",
      "translation" : "我可以在你持有的几乎所有稀有物品上^0055FF签上你的名字^000000。"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Tell me more...",
      "translation" : "详细说说..."
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Sign my items, please!",
      "translation" : "请帮我给物品签名！"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I can put your name on any slotless equipment or weapon.",
      "translation" : "我可以在任何没有插槽的装备或武器上签名。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "For my work I accept:",
      "translation" : "我的服务收费如下："
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Perchik",
      "placeholders" : [
        ".@Item[.@i+1]",
        "getitemname(.@Item[.@i])"
      ],
      "state" : "translated",
      "text" : " ~ {0}x {1}",
      "translation" : " ~ {0}个{1}"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Perchik",
      "placeholders" : [
        "callfunc(\"F_InsertComma\",.@Cost[0])"
      ],
      "state" : "translated",
      "text" : " ~ {0} Zeny",
      "translation" : " ~ {0} Zeny"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Perchik",
      "placeholders" : [
        "callfunc(\"F_InsertComma\",.@Cost[1])"
      ],
      "state" : "translated",
      "text" : " ~ {0} Zeny per refine",
      "translation" : " ~ 每次精炼{0} Zeny"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I work for free, but...",
      "translation" : "我可以免费帮忙，不过..."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Alas, I have 12 hungry children",
      "translation" : "唉，我有12个饿肚子的孩子，"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "and a very angry wife.",
      "translation" : "还有一个非常生气的妻子。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Or it was 12 angry children",
      "translation" : "又或者是12个生气的孩子，"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "and a very hungry wife...",
      "translation" : "还有一个饿坏了的妻子..."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Show me your items to sign...",
      "translation" : "把要签名的物品给我看看..."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Nothing is equipped there!",
      "translation" : "那个位置没有装备物品！"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Alas, this item's already signed.",
      "translation" : "唉，这件物品已经签过名了。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I would never touch a master's work.",
      "translation" : "我绝不会碰大师的作品。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "A card? Here?!",
      "translation" : "卡片？这里面有卡片？！"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "As I said before, I don't sign items with cards.",
      "translation" : "我之前说过，我不为带卡片的物品签名。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Sorry, I don't sign slotted items.",
      "translation" : "抱歉，我不为有插槽的物品签名。"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Sorry, I don't sign rental items!",
      "translation" : "抱歉，我不为租赁物品签名！"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I will need:",
      "translation" : "我需要："
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Perchik",
      "placeholders" : [
        ".@Item[.@i+1]",
        "getitemname(.@Item[.@i])"
      ],
      "state" : "translated",
      "text" : " ~ {0}x {1}",
      "translation" : " ~ {0}个{1}"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Perchik",
      "placeholders" : [
        ".@price"
      ],
      "state" : "translated",
      "text" : " ~ {0} Zeny",
      "translation" : " ~ {0} Zeny"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Perchik",
      "placeholders" : [
        "getitemname(.@id)"
      ],
      "state" : "translated",
      "text" : "Shall I sign your ^0055FF{0}^000000?",
      "translation" : "要我为你的^0055FF{0}^000000签名吗？"
    },
    {
      "kind" : "option",
      "line" : 106,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Ok!",
      "translation" : "好！"
    },
    {
      "kind" : "option",
      "line" : 106,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Leave",
      "translation" : "离开"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "See you...",
      "translation" : "再见..."
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩尔奇克]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I don't work for 'thanks'.",
      "translation" : "光说谢谢可不够。"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Perchik",
      "placeholders" : [
        "getitemname(@id)"
      ],
      "state" : "translated",
      "text" : "Where is {0}...?",
      "translation" : "{0}在哪里...？"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Perchik",
      "state" : "translated",
