{
  "file" : "npc/custom/etc/airplane.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "F_Porter",
      "text" : "^FF0000[Porter]^000000\nThe plane is currently ported.  Would you like to board?",
      "translation" : "^FF0000[搬运工]^000000\n飞机目前已靠岸。您要登机吗？"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "text" : "Yes.",
      "translation" : "要。"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "text" : "No.",
      "translation" : "不"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "text" : "View Hourly Itinerary.",
      "translation" : "查看每小时时刻表"
    },
    {
      "kind" : "message",
      "line" : 251,
      "npc" : "F_Porter",
      "text" : "^FF0000[Porter]^000000\nHave a good day.  Thank you for traveling with Airship.",
      "translation" : "^FF0000[搬运工]^000000\n祝您生活愉快。感谢您乘坐飞空艇。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "F_Porter",
      "text" : "^FF0000[Porter]^000000\nSorry, ma'am, but the plane currently isn't ported.  However, you can view the airplane's hourly itinerary.",
      "translation" : "^FF0000[搬运工]^000000\n抱歉，女士，飞机目前尚未靠岸。不过，您可以查看飞机的每小时时刻表。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "F_Porter",
      "text" : "^FF0000[Porter]^000000\nSorry, sir, but the plane currently isn't ported.  However, you can view the airplane's hourly itinerary.",
      "translation" : "^FF0000[搬运工]^000000\n抱歉，先生，飞机目前尚未靠岸。不过，您可以查看飞机的每小时时刻表。"
    },
    {
      "kind" : "option",
      "line" : 260,
      "npc" : "F_Porter",
      "text" : "Yes, please.",
      "translation" : "是的，请。"
    },
    {
      "kind" : "option",
      "line" : 260,
      "npc" : "F_Porter",
      "text" : "No thanks.",
      "translation" : "不用了，谢谢。"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "F_Porter",
      "text" : "^FF0000[Porter]^000000",
      "translation" : "^FF0000[搬运工]^000000"
    },
    {
      "kind" : "message",
      "line" : 342,
      "npc" : "Itinerary Schedule",
      "text" : "^FF0000[Itinerary]^000000",
      "translation" : "^FF0000[时刻表]^000000"
    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "Docker",
      "text" : "^FF0000[Airplane Attendant]^000000",
      "translation" : "^FF0000[空乘人员]^000000"
    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "Docker",
      "placeholders" : [
        "$locationsname$[$destination]"
      ],
      "text" : "^FF0000[Airplane Attendant]^000000\nWe are currently docked at {0}.  Would you like to exit?",
      "translation" : "^FF0000[空乘人员]^000000\n我们目前停靠在 {0}。您要下机吗？"
    },
    {
      "kind" : "option",
      "line" : 353,
      "npc" : "Docker",
      "text" : "Yes.",
      "translation" : "要。"
    },
    {
      "kind" : "option",
      "line" : 353,
      "npc" : "Docker",
      "text" : "No.",
      "translation" : "不"
    },
    {
      "kind" : "message",
      "line" : 362,
      "npc" : "Docker",
      "text" : "^FF0000[Airplane Attendant]^000000\nHave a good day.  Thank you for traveling with us.",
      "translation" : "^FF0000[空乘人员]^000000\n祝您生活愉快。感谢您乘坐我们的航班。"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Docker",
      "text" : "^FF0000[Airplane Attendant]^000000\nSorry, ma'am, but the plane currently isn't docked.  Please wait.",
      "translation" : "^FF0000[空乘人员]^000000\n抱歉，女士，飞机目前尚未停靠。请稍候。"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Docker",
      "text" : "^FF0000[Airplane Attendant]^000000\nSorry, sir, but the plane currently isn't docked.  Please wait.",
      "translation" : "^FF0000[空乘人员]^000000\n抱歉，先生，飞机目前尚未停靠。请稍候。"
    },
    {
      "kind" : "message",
      "line" : 373,
      "npc" : "Docker",
      "text" : "^FF0000[Airplane Attendant]^000000\nWe're currently in air. Please wait until the pilot has announced that we have safely landed.",
      "translation" : "^FF0000[空乘人员]^000000\n我们目前正在飞行中。请在飞行员宣布安全着陆后再行离开。"
    },
