{
  "file" : "npc/custom/etc/airplane.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nThe plane is currently ported.  Would you like to board?",
      "translation" : "^FF0000[搬运工]^000000\n飞空艇目前停靠中。\n您想登船吗？"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "Yes.",
      "translation" : "是的"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "View Hourly Itinerary.",
      "translation" : "查看时刻表"
    },
    {
      "kind" : "message",
      "line" : 251,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nHave a good day.  Thank you for traveling with Airship.",
      "translation" : "^FF0000[搬运工]^000000\n祝您愉快。\n感谢您乘坐飞空艇。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nSorry, ma'am, but the plane currently isn't ported.  However, you can view the airplane's hourly itinerary.",
      "translation" : "^FF0000[搬运工]^000000\n女士，很抱歉，飞空艇目前未停靠。\n不过您可以查看飞空艇的时刻表。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nSorry, sir, but the plane currently isn't ported.  However, you can view the airplane's hourly itinerary.",
      "translation" : "^FF0000[搬运工]^000000\n先生，很抱歉，飞空艇目前未停靠。\n不过您可以查看飞空艇的时刻表。"
    },
    {
      "kind" : "option",
      "line" : 260,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "Yes, please.",
      "translation" : "好，请让我看看"
    },
    {
      "kind" : "option",
      "line" : 260,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不用了，谢谢"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000",
      "translation" : "^FF0000[搬运工]^000000"
    },
    {
      "kind" : "message",
      "line" : 342,
      "npc" : "Itinerary Schedule",
      "state" : "translated",
      "text" : "^FF0000[Itinerary]^000000",
      "translation" : "^FF0000[时刻表]^000000"
    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000",
      "translation" : "^FF0000[空乘人员]^000000"
    },
    {
      "kind" : "message",
