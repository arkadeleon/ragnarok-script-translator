      "npc" : "Docker",
      "placeholders" : [
        "$locationsname$[$destination]"
      ],
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nWe are currently docked at {0}.  Would you like to exit?",
      "translation" : "^FF0000[空乘人员]^000000\n我们目前停靠在{0}。\n您想下船吗？"
    },
    {
      "kind" : "option",
      "line" : 353,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "Yes.",
      "translation" : "是的"
    },
    {
      "kind" : "option",
      "line" : 353,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不"
    },
    {
      "kind" : "message",
      "line" : 362,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nHave a good day.  Thank you for traveling with us.",
      "translation" : "^FF0000[空乘人员]^000000\n祝您愉快。\n感谢您乘坐我们的飞空艇。"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nSorry, ma'am, but the plane currently isn't docked.  Please wait.",
      "translation" : "^FF0000[空乘人员]^000000\n女士，很抱歉，飞空艇目前未停靠。\n请稍候。"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nSorry, sir, but the plane currently isn't docked.  Please wait.",
      "translation" : "^FF0000[空乘人员]^000000\n先生，很抱歉，飞空艇目前未停靠。\n请稍候。"
    },
    {
      "kind" : "message",
      "line" : 373,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nWe're currently in air. Please wait until the pilot has announced that we have safely landed.",
      "translation" : "^FF0000[空乘人员]^000000\n我们目前正在空中飞行。请等飞行员宣布安全着陆。"
    },
