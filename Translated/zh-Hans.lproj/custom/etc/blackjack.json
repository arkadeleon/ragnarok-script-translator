      "line" : 124,
      "npc" : "Black Jack Dealer",
      "state" : "translated",
      "text" : "[Dealer]",
      "translation" : "[荷官]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Black Jack Dealer",
      "state" : "translated",
      "text" : "Feel free to come back anytime",
      "translation" : "欢迎随时回来。"
    },
