      "line" : 103,
      "npc" : "Black Jack Dealer",
      "state" : "translated",
      "text" : "[Dealer]",
      "translation" : "[荷官]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Black Jack Dealer",
      "state" : "translated",
      "text" : "The 'Ace' card is a unique card in the game of Black Jack because",
      "translation" : "A是21点游戏中的特殊牌，"
