      "line" : 96,
      "npc" : "Black Jack Dealer",
      "state" : "translated",
      "text" : "[Dealer]",
      "translation" : "[荷官]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Black Jack Dealer",
      "state" : "translated",
      "text" : "An example of when doubling down is useful, is when",
      "translation" : "比如，最初两张牌点数合计为11时，"
