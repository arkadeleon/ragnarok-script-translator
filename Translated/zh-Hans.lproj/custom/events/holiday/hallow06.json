      "npc" : "Hallows' Eve Event",
      "state" : "translated",
      "text" : "I hope you enjoy your trick and Happy Halloween!",
      "translation" : "希望你喜欢这次恶作剧，万圣节快乐！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Hallows' Eve Event",
      "state" : "translated",
      "text" : "[Hallows' Eve Event]",
      "translation" : "[万圣节前夜活动]"
