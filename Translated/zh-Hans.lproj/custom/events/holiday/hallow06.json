      "npc" : "Hallows' Eve Event",
      "state" : "translated",
      "text" : "[Hallows' Eve Event]",
      "translation" : "[万圣节前夜活动]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Hallows' Eve Event",
      "state" : "translated",
      "text" : "Trick or treat, which do you prefer?",
      "translation" : "不给糖就捣蛋，你选哪个？"
