    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Hallows' Eve Event",
      "state" : "translated",
      "text" : "Here is your treat. Your Base EXP has been slightly increased.",
      "translation" : "这是给你的糖果。你的基础经验值略微提高了。"
