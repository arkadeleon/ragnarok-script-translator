      "translation" : "[万圣节前夜活动]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Hallows' Eve Event",
      "state" : "translated",
      "text" : "Halloween is upon us and it is almost time to adventure out into places few dare go.",
      "translation" : "万圣节就要到了，马上又到了去那些少有人敢去的地方冒险的时候。"
