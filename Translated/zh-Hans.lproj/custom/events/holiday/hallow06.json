      "text" : "[Hallows' Eve Event]",
      "translation" : "[万圣节前夜活动]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Hallows' Eve Event",
      "state" : "translated",
      "text" : "Bring back all the necessary items, and I will create you a treat.",
      "translation" : "把所需物品都带回来，我就为你制作一份糖果。"
    },
