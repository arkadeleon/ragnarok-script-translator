{
  "file" : "npc/custom/events/holiday/valentinesdayexp.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "The legend says that on 14th February... on the Day of Saint Valentine...",
      "translation" : "传说每到2月14日...也就是圣瓦伦丁节..."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "Only in Run-Midgard kingdom...",
      "translation" : "在卢恩·米德加兹王国..."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "Some married chocolate lovers almost double their experience at trainings!",
      "translation" : "有些喜欢巧克力的已婚人士，在训练时能获得将近双倍的经验值！"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "But everything isn't so simply...",
      "translation" : "不过，事情可没那么简单..."
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "Wow! Tell me more!",
      "translation" : "哇！快告诉我更多！"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "Marri... what?",
      "translation" : "结...什么？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "Are you a single?",
      "translation" : "你是单身吗？"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "Today is a great date to ask your beloved half for marriage!",
      "translation" : "今天正适合向你的另一半求婚！"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "The Marriage fee is ridiculous low these days!",
      "translation" : "现在的结婚费用低得离谱！"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "The magic effect possesses only handmade chocolate from grand-grand-grand-whoever recipes!",
      "translation" : "只有用不知传了多少代的祖传秘方制作的手工巧克力，才有这种魔法效果！"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "It being known that Black Handmade Chocolate works on married guys... And the White one on the married girls!",
      "translation" : "据说黑色手工巧克力对已婚男性有效...白色手工巧克力则对已婚女性有效！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "If you lose your wedding ring... then alas, it won't work on you.",
      "translation" : "要是弄丢了结婚戒指...唉，那就对你没用了。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "On having a Chocolate, you should put off your ring then... put it back... And if your partner is online, then magic would last till the next hour!",
      "translation" : "拿到巧克力后，先摘下戒指...再戴回去...如果你的伴侣在线，魔法效果就会持续到下一个整点！"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "Rumors bark that guys and gals have +50% EXP bonuses on FIVE different races of the monsters... Excluding bloody bosses, of course.",
      "translation" : "据说男女双方对五种不同种族的魔物都能获得+50%的经验值加成...当然，那些该死的Boss不算。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "[Tine]",
      "translation" : "[蒂内]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Tine",
      "state" : "translated",
      "text" : "There's a famous confectioner in the Castle of Prontera! He's the one you need.",
      "translation" : "普隆德拉城堡里有位著名的糖果师！你要找的就是他。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Guess what I've got?",
      "translation" : "猜猜我有什么？"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "A tasty treat not easily found in Midgard....",
      "translation" : "在米德加兹可不容易找到这样的美味..."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Chocolate!",
      "translation" : "巧克力！"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "That's right, don't you love chocolate.... I do.",
      "translation" : "没错，你喜欢巧克力吧...反正我喜欢。"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "And you are in luck, because I'm selling them for only 5,000 zeny a piece!",
      "translation" : "你可走运了，我这里每块只卖5,000 Zeny！"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I want some chocolate!",
      "translation" : "我想要巧克力！"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不用了，谢谢。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You don't want any chocolate?",
      "translation" : "你不想要巧克力吗？"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm telling you! You'll regret it!",
      "translation" : "我告诉你！你会后悔的！"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You better get some now... you won't come across Chocolate like this ever again!",
      "translation" : "你最好现在买一些...再也遇不到这样的巧克力了！"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Think it over and visit me again sometime.",
      "translation" : "好好考虑一下，改天再来找我。"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Hah!",
      "translation" : "哈！"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I knew it!",
      "translation" : "我就知道！"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "But I can't sell you more than 5 at once....but, if you really need more....",
      "translation" : "不过我一次最多只能卖5块...要是你真的还想多买..."
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "you can come back again.",
      "translation" : "可以再来找我。"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "So how many do you want?",
      "translation" : "那么你要几块？"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "There you go!",
      "translation" : "给你！"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You can give that to someone as a gift, or enjoy it yourself!",
      "translation" : "你可以把它送给别人，也可以自己享用！"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Mmm....sweet chocolate...",
      "translation" : "嗯...甜甜的巧克力..."
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Visit me anytime...!",
      "translation" : "随时欢迎再来...！"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm sorry but I can't give you that many.",
      "translation" : "抱歉，我不能给你那么多。"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm sorry but it seems you can't afford to buy these of me.",
      "translation" : "抱歉，看来你买不起我的巧克力。"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "You know what? The chocolate that my boyfriend sells are from me!",
      "translation" : "你知道吗？我男朋友卖的巧克力都是我做的！"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I made them by myself. Now I need some Milk for my special White Chocolate.",
      "translation" : "都是我亲手做的。现在我需要一些牛奶来制作特制白巧克力。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "You know ... In certain countries, there's a tradition of presenting chocolates to a person that you love...",
      "translation" : "你知道吗...在某些国家，人们有向心爱的人赠送巧克力的传统..."
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "They call it ^3355FFValentine's Day^000000.",
      "translation" : "他们称之为^3355FF情人节^000000。"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "So I gave him my delicious chocolate...",
      "translation" : "于是我把自己做的美味巧克力送给了他..."
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "And then he made me cook a lot more...",
      "translation" : "结果他让我又做了好多..."
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "And now he is selling them to everyone.",
      "translation" : "现在他还把巧克力卖给大家。"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I guess he really enjoyed it.",
      "translation" : "看来他真的很喜欢。"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "But, I do feel good when people buy something I have made.",
      "translation" : "不过，看到有人愿意买我做的东西，我还是很开心的。"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "It would be great if you bought some too...",
      "translation" : "如果你也买一些就好了..."
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I will be making white chocolates for a while so...",
      "translation" : "我最近会一直做白巧克力，所以..."
    },
    {
      "kind" : "option",
      "line" : 152,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I want some white chocolate!",
      "translation" : "我想要白巧克力！"
    },
    {
      "kind" : "option",
      "line" : 152,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不用了，谢谢。"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "You don't like white chocolate?",
      "translation" : "你不喜欢白巧克力吗？"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "Then buy some Stephen's black one!",
      "translation" : "那就买些斯蒂芬的黑巧克力吧！"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I can't sell you more than 5 at once....but, if you really need more....",
      "translation" : "不过我一次最多只能卖5份...要是你真的还想多买..."
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "you can come back again.",
      "translation" : "可以再来找我。"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Jainie",
      "state" : "translated",
