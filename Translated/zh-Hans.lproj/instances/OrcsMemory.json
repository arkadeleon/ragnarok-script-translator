    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Dimensional Gorge Piece",
      "state" : "translated",
      "text" : "Memorial Dungeon Orc's Memory does not exist.",
      "translation" : "兽人记忆纪念副本不存在。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Dimensional Gorge Piece",
      "state" : "translated",
      "text" : "Memorial Dungeon has been destroyed by the Party Leader, or because of the time limit. Please try again after 2 hours.",
      "translation" : "纪念副本已被队长关闭，或因时间限制而消失。请在2小时后重试。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Dimensional Gorge Piece",
      "state" : "translated",
      "text" : "Only a member of the party can enter the Memorial Dungeon.",
      "translation" : "只有队伍成员才能进入纪念副本。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "The Mad Scientist doesn't seem to notice you and keeps mumbling to himself...",
      "translation" : "疯狂科学家似乎没有注意到你，仍在不停地自言自语..."
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Haha, no Orcs are coming near me!",
      "translation" : "哈哈，兽人根本不敢靠近我！"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "The power of the Dimensional Gorge is undefeatable!!",
      "translation" : "次元裂隙的力量不可战胜！！"
    },
    {
      "kind" : "option",
      "line" : 118,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Orcs don't attack you?",
      "translation" : "兽人不攻击你？"
    },
    {
      "kind" : "option",
      "line" : 118,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "You wish!",
      "translation" : "你想得美！"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Yeah, yeah.. I know it's hard to belive. I don't blame ya.",
      "translation" : "好吧好吧...我知道这很难相信。我不怪你。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "I used to study the Dimensional Gorge discovered near Morocc.",
      "translation" : "我以前一直在研究梦罗克附近发现的次元裂隙。"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "According to my research, the minerals found there have enormous power inside them!",
      "translation" : "根据我的研究，那里发现的矿物蕴藏着巨大的能量！"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "You are a pretty distrustful person, huh?",
      "translation" : "你这人还真多疑，是吧？"
    },
    {
      "kind" : "option",
      "line" : 132,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Oh? Like what, travel to alternate space?",
      "translation" : "哦？比如什么，穿越到异空间？"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Very smart! I have actually just done that! See that statue over there? It's not your normal Monolith!",
      "translation" : "真聪明！我刚刚真的办到了！看到那边的雕像了吗？那可不是普通的石碑！"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "I have created it with a combination of our technology and the unlimited energy I discovered from the Gorge! Want to try it?",
      "translation" : "我结合我们的技术和从裂隙中发现的无限能量制造了它！想试试吗？"
    },
    {
      "kind" : "option",
      "line" : 139,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "...Um, that doesn't sound legal?",
      "translation" : "...嗯，这听起来不太合法吧？"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Hey, since when did something so interesting have to be legal!? How about it! You can talk to the Orcs! C'mon!",
      "translation" : "喂，这么有趣的事什么时候还需要合法了！？怎么样！你可以和兽人说话！快来！"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Chances are they'll just give you lots of instructions once they see you, so just wing it! They're always saying the same thing, to the point where I memorized them!",
      "translation" : "他们一看到你，很可能就会给你一堆指示，你随机应变就行！他们总说同样的话，我都背下来了！"
    },
    {
      "kind" : "option",
      "line" : 146,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Alright... What do I do?",
      "translation" : "好吧...我要做什么？"
    },
    {
      "kind" : "option",
      "line" : 146,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Umm, maybe not.",
      "translation" : "嗯...还是算了。"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Very good! Just sit in the hands of this statue! And try to act natural when you're in there!",
      "translation" : "很好！坐到这尊雕像的手掌上！进去之后尽量表现自然！"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Oh fine, be that way!",
      "translation" : "好吧，随你！"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "[Mad Scientist]",
      "translation" : "[疯狂科学家]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Mad Scientist",
      "state" : "translated",
      "text" : "Hmm? Put your hand on that Monemus Statue if you want to experience traveling through dimensions!",
      "translation" : "嗯？想体验次元旅行的话，就把手放在那尊莫涅莫斯雕像上！"
    },
    {
      "kind" : "message",
      "line" : 870,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "[Kruger]",
      "translation" : "[克鲁格]"
    },
    {
      "kind" : "message",
      "line" : 871,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "*Coughing*",
      "translation" : "*咳嗽*"
    },
    {
      "kind" : "message",
      "line" : 872,
      "npc" : "Kruger",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "{0}, it's you...",
      "translation" : "{0}，是你啊..."
    },
    {
      "kind" : "message",
      "line" : 874,
      "npc" : "Kruger",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}] ",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 875,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "Don't move! You are wounded!",
      "translation" : "别动！你受伤了！"
    },
    {
      "kind" : "message",
      "line" : 877,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "[Kruger]",
      "translation" : "[克鲁格]"
    },
    {
      "kind" : "message",
      "line" : 878,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "It's... all right.. I'm dying...",
      "translation" : "我...没事...我快死了..."
    },
    {
      "kind" : "message",
      "line" : 879,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "....",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 880,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "The Shaman? What about the Shaman?",
      "translation" : "萨满？萨满怎么了？"
    },
    {
      "kind" : "message",
      "line" : 882,
      "npc" : "Kruger",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}] ",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 883,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "The Shaman's dead now. Who was that Shaman really?",
      "translation" : "萨满已经死了。那萨满到底是什么人？"
    },
    {
      "kind" : "message",
      "line" : 885,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "Kruger seemed to be relieved as he hears of the death of the Shaman, but you notice the bitter expression on his face.",
      "translation" : "克鲁格听到萨满死讯后似乎松了口气，但你注意到他的脸上仍带着苦涩。"
    },
    {
      "kind" : "message",
      "line" : 887,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "[Kruger]",
      "translation" : "[克鲁格]"
    },
    {
      "kind" : "message",
      "line" : 888,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "I.. I just couldn't kill my own daughter...",
      "translation" : "我...我就是下不了手杀自己的女儿..."
    },
    {
      "kind" : "message",
      "line" : 889,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "Thank you, I'm sure she's finally free from the nightmare that used to choke her soul.",
      "translation" : "谢谢你，我相信她终于摆脱了曾经扼住她灵魂的噩梦。"
    },
    {
      "kind" : "message",
      "line" : 891,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "Kruger was about to say something more, but he breathed his last breath before he could...",
      "translation" : "克鲁格似乎还想说些什么，但话未出口便咽下了最后一口气..."
    },
    {
      "kind" : "message",
      "line" : 896,
      "npc" : "Kruger",
      "state" : "translated",
      "text" : "You can see the dead body of Kruger, peacefully lying on the ground.",
      "translation" : "你看见克鲁格的遗体安详地躺在地上。"
    }
  ]
}