    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Dimensional Gorge Piece",
      "state" : "translated",
      "text" : "^0000ffAll records and after-effects related to the Orc's Memory Dungeon are deleted. You can now regenerate or re-enter the dungeon.^000000",
