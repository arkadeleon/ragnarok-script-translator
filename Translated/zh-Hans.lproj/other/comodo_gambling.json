      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "[Cain]",
      "translation" : "[凯恩]"
    },
    {
      "kind" : "message",
      "line" : 408,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "I've been charging other people for this information, but since, shall we say, we work in the same professional field, I don't have the heart to take your zeny.",
