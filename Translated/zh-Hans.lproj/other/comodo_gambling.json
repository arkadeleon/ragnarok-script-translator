      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "Heeeey...",
      "translation" : "喂..."
    },
    {
      "kind" : "message",
      "line" : 405,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "It seems we share the same line of work, you and me. Heh heh, lemme give you a hot tip.",
      "translation" : "看来咱们是同行啊。嘿嘿，我告诉你一个内部消息。"
