      "line" : 90,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Isalei]",
      "translation" : "[伊莎蕾]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Hello, adventurer.",
      "translation" : "你好，冒险者。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "My companion Keiki and I have discovered a way to increase our warp portal abilities.",
      "translation" : "我的同伴凯琪和我发现了一种提升瞬间移动能力的方法。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Isalei]",
      "translation" : "[伊莎蕾]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Though I have not mastered up to the level that she has, I have been able to attain Level 5.",
      "translation" : "虽然我还没有像她那样掌握更高等级的技能，但已经练到了5级。"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Isalei]",
      "translation" : "[伊莎蕾]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Maybe one day I can level up my skills enough so that I can use Warp portal to more saved locations.",
      "translation" : "也许有一天，我能把技能练得更高，就可以用瞬间移动前往更多已记录的地点。"
