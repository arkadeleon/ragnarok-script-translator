  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凯琪]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Hello there, adventurer.",
      "translation" : "你好，冒险者。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I've been studying magic from all over Rune-Midgarts to upgrade what I believe to be one of the greatest skills available to the acolyte class.",
      "translation" : "我一直在研究卢恩米德加尔特各地的魔法，希望提升我认为是服事者职业最强技能之一的能力。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凯琪]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I am the one and only Acolyte that has attained the Level 10 Warp Portal skill!",
      "translation" : "我是唯一一个将瞬间移动技能练到10级的服事者！"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凯琪]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "That's right! And...",
      "translation" : "没错！而且..."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I promise you that I don't forget locations that I have already memorized.",
      "translation" : "我保证不会忘记已经记下来的地点。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "One day I will level up my skills to warp to wherever I please~",
      "translation" : "总有一天，我会提升技能等级，想传送到哪里就传送到哪里~"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凯琪]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I am willing to warp you to the many locations that I have memorized for a small fee.",
      "translation" : "只要付少量费用，我愿意把你送到许多我记下来的地点。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Would you like to use this service?",
      "translation" : "要使用这项服务吗？"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凯琪]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Where would you like to go to?",
      "translation" : "你想去哪里？"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I wish you goodluck on your journey.",
      "translation" : "祝你旅途顺利。"
    },
    {
      "kind" : "option",
      "line" : 56,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凯琪]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I'm sorry, but you don't have",
      "translation" : "抱歉，你的"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "enough zeny for the Teleport",
      "translation" : "Zeny 不够，无法支付传送"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Service. The fee to teleport",
      "translation" : "服务。传送费用为"
