    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "- Wait a minute !! -\n- Currently you're carrying -\n- too many items with you. -\n- Please try again -\n- after you lose some weight. -",
      "translation" : "- 等等！！ -\n- 您现在携带的物品 -\n- 太多了。 -\n- 请在减轻负重后 -\n- 再试一次。 -"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nChildren are not allowed in here.",
      "translation" : "[松武道]\n这里不欢迎小孩子。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nHey hey~ This is not something\nyou can see everyday.\nOh~ you look strong!\nWanna try?",
      "translation" : "[松武道]\n嘿~ 这可不多见呢。\n哦~ 你看起来很强壮！\n要不要试试？"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "Why not?",
      "translation" : "为什么不呢？"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "?????",
      "translation" : "?????"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "No thanks.",
      "translation" : "不用了，谢谢。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nHaha~ I knew you would try.\nIf you could lift this up,\nI'll tell you something interesting.\nReady?",
      "translation" : "[松武道]\n哈哈~ 我就知道你会试的。\n如果你能把它举起来，\n我就告诉你一些有趣的事情。\n准备好了吗？"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "^0000FFSongmoodoo points to a rock\nand asks you to lift it.",
      "translation" : "^0000FF松武道指着一块岩石，\n让你把它抬起来。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nThat's not a big deal.\nIf you believe you're strong,\nthis might be a good chance to experience\nsomething new. Wanna try??",
      "translation" : "[松武道]\n这不算什么。\n如果你相信自己很强，\n这可能是一个体验新事物的好机会。\n要不要试试？"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nI guess not...",
      "translation" : "[松武道]\n看来不行啊..."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nGood to see you again!\nWanna go??",
      "translation" : "[松武道]\n很高兴再次见到你！\n要开始吗？"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "Sure",
      "translation" : "当然"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "Maybe next time",
      "translation" : "下次再说吧"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nGood! Haha.\nI like your confidence.\nGood luck to you~",
      "translation" : "[松武道]\n好！哈哈。\n我喜欢你的自信。\n祝你好运~"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nWell... alright.\nI'll see you next time then.",
      "translation" : "[松武道]\n嗯...好吧。\n那我们下次再见。"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nYou ran away from there?\nGuess you're not strong enough!\nI'll give you another chance.\nSee you again.",
      "translation" : "[松武道]\n你从那里逃跑了？\n看来你不够强壮！\n我再给你一次机会。\n下次见。"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "You lifted the Stone lightly.^000000",
      "translation" : "你轻松地举起了石头。^000000"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Iron man",
      "state" : "needs_review",
      "text" : "[Songmoodoo]\nWow~ Excellent~\nI'll take you to someplace nice\nnext time I see you.\nSee ya~",
      "translation" : "[松武道]\n哇~ 太棒了~\n下次见到你时，\n我会带你去个好地方。\n再见~"
    },
