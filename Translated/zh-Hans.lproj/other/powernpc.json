    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "- Wait a minute !! -\n- Currently you're carrying -\n- too many items with you. -\n- Please try again -\n- after you lose some weight. -",
      "translation" : "- 请等一下！ -\n- 你携带的物品太多了。 -\n- 请减轻负重后再试。 -"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nChildren are not allowed in here.",
      "translation" : "[松武道]\n小孩子不能进来。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nHey hey~ This is not something\nyou can see everyday.\nOh~ you look strong!\nWanna try?",
      "translation" : "[松武道]\n嘿，嘿~ 这可不是天天都能见到的。\n哦~ 你看起来很强壮！\n要不要试试？"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "Why not?",
      "translation" : "试试看"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "?????",
      "translation" : "?????"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不用了，谢谢"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nHaha~ I knew you would try.\nIf you could lift this up,\nI'll tell you something interesting.\nReady?",
      "translation" : "[松武道]\nHaha~ 我就知道你会试。\n能把它举起来，我就告诉你一件有趣的事。\n准备好了吗？"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "^0000FFSongmoodoo points to a rock\nand asks you to lift it.",
      "translation" : "^0000FF松武道指着一块岩石，让你把它举起来。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nThat's not a big deal.\nIf you believe you're strong,\nthis might be a good chance to experience\nsomething new. Wanna try??",
      "translation" : "[松武道]\n没什么大不了的。\n要是觉得自己够强，这倒是个体验新鲜事物的好机会。\n要不要试试？"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nI guess not...",
      "translation" : "[松武道]\n看来不行啊..."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nGood to see you again!\nWanna go??",
      "translation" : "[松武道]\n很高兴再次见到你！\n要开始吗？"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "Sure",
      "translation" : "当然"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "Maybe next time",
      "translation" : "下次再说吧"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nGood! Haha.\nI like your confidence.\nGood luck to you~",
      "translation" : "[松武道]\n好！Haha.\n我喜欢你的自信。\n祝你好运~"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nWell... alright.\nI'll see you next time then.",
      "translation" : "[松武道]\n嗯...好吧。\n那我们下次再见。"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nYou ran away from there?\nGuess you're not strong enough!\nI'll give you another chance.\nSee you again.",
      "translation" : "[松武道]\n你从那里逃跑了？\n看来你不够强壮！\n我再给你一次机会。\n下次见。"
