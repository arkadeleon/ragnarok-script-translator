{
  "file" : "npc/re/warps/dungeons/iz_dun.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守门人]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Halt!",
      "translation" : "站住！"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "What brings you here, Adventurer?",
      "translation" : "冒险者，来这里做什么？"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "We've discovered a new floor of this underwater city.",
      "translation" : "我们在这座水下城市发现了新的一层。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守门人]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Do you think you're up to the challenge?",
      "translation" : "你觉得自己能应付这里的挑战吗？"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "The monsters here are between levels 110 and 124.",
      "translation" : "这里的魔物等级在110到124级之间。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "And you must beware of the Kraken!",
      "translation" : "还得当心克拉肯！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Release the Kraken!",
      "translation" : "放出克拉肯！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "I'll stay here.",
      "translation" : "我留在这里。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守门人]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Be cautious and good luck.",
      "translation" : "小心行事，祝你好运。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "If you see the Kraken be sure you have your friends to help or do what we do and run.",
      "translation" : "要是遇到克拉肯，记得找朋友帮忙；或者像我们一样，赶紧逃跑。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守门人]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "It's always best to be prepared before exploring a new area.",
      "translation" : "探索新区域前，最好先做好准备。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Come back when you're ready to go.",
      "translation" : "准备好出发时再回来。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守门人]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "So I guess you want to go back to the fifth floor?",
      "translation" : "看来你想回到第五层？"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "Yes!",
      "translation" : "是！"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "No, I'll stay.",
      "translation" : "不，我留在这里。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守门人]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "Be safe, adventurer.",
      "translation" : "冒险者，保重。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守门人]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "You're not going?",
      "translation" : "你不打算走吗？"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "You're braver than I thought.",
      "translation" : "你比我想象的还勇敢。"
    }
  ]
}