{
  "file" : "npc/re/other/dimensional_gap.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 10,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Are you going to enter the ^0000FFDimensional Gap^000000?  Please use this Transport Device you see here.",
      "translation" : "要进入^0000FF次元裂隙^000000吗？请使用这里的传送装置。"
    },
    {
      "kind" : "option",
      "line" : 13,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "What is the Dimensional Gap?",
      "translation" : "什么是次元裂隙？"
    },
    {
      "kind" : "option",
      "line" : 13,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "End Conversation.",
      "translation" : "结束对话。"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "As you know we've already entered through the Dimensional Rift to get to Ash Vacuum right?  The Dimensional Gap is an expansion of that initial discovery.",
      "translation" : "你知道，我们已经通过次元裂缝进入了灰烬虚空，对吧？次元裂隙就是在那项发现的基础上进一步扩展而成的。"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "A member of the Expedition team found these backdoor passages to get through the Dimensional Rifts.",
      "translation" : "远征队的一名成员发现了这些秘密通道，可以穿越次元裂缝。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "This is like a Midgard Alliance version of the Bifrost bridge so it can connect us to different parts of the New World.",
      "translation" : "这就像是米德加尔特联盟版本的毕弗罗斯特桥，能够连接新世界的不同区域。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Time and space is distorted in the Dimensional Gap.  Not all passageways have been discovered so please be sure to use caution when entering an unverified area.",
      "translation" : "次元裂隙中的时空十分扭曲。我们还没有发现所有通道，所以进入未经确认的区域时务必小心。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Anyone who has become lost here has yet to return.",
      "translation" : "在这里迷路的人，至今都没有回来。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Take care.",
      "translation" : "保重。"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[远征队向导]"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Please use a ^0000FFTransport Device^000000 if you wish to travel through the dimensional rift.  The insides have not been fully explored yet so please be careful in there.",
      "translation" : "想要穿越次元裂缝，请使用^0000FF传送装置^000000。里面还没有完全探索过，请务必小心。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "[Allied Forces Soldier]",
      "translation" : "[同盟军士兵]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "This dimensional rift is connected to the Allied Forces ^0000FFExpedition Camp^000000 in Jotunheim.",
      "translation" : "这道次元裂缝连接着约顿海姆的同盟军^0000FF远征营地^000000。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "[Allied Forces Soldier]",
      "translation" : "[同盟军士兵]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "Do not worry, it has been set up after testing hundreds of experiments for safe teleportation.",
      "translation" : "放心吧，我们经过数百次实验测试，才设置好这条安全传送通道。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "[Morocc Soldier]",
      "translation" : "[梦罗克士兵]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "This dimensional rift is connected to ^0000FFMorocc^000000 back in Midgard.",
      "translation" : "这道次元裂缝连接着米德加尔特的^0000FF梦罗克^000000。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "[Morocc Soldier]",
      "translation" : "[梦罗克士兵]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "This is the fastest gateway back to our world.  The area is still destroyed but restoration efforts will soon be on the way.",
      "translation" : "这是返回我们世界最快的通道。虽然那片地区仍是一片废墟，但很快就会开始重建。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "[Spledide Soldier]",
      "translation" : "[斯普兰迪德士兵]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "This dimensional rift is connected to the south of ^0000FFBifrost^000000.  It enables quick travel to the Splendide frontline.",
      "translation" : "这道次元裂缝连接着^0000FF毕弗罗斯特^000000南部，可以快速前往斯普兰迪德前线。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "[Spledide Soldier]",
      "translation" : "[斯普兰迪德士兵]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "If we use it properly, it enables us to advance more easily to the capital of the Sapha.",
      "translation" : "善加利用的话，我们就能更轻松地推进到萨帕的首都。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "[Spledide Soldier]",
      "translation" : "[斯普兰迪德士兵]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "The Mayor has asked us to cooperate as best we can instead of fighting, so I'm under orders not to do anything.  Since we have a common enemy we won't fight the Sapha... for now...",
      "translation" : "市长要求我们尽可能合作而不是开战，所以我奉命不得轻举妄动。既然我们有共同的敌人，暂时不会和萨帕开战..."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "[Dispatched Sapha]",
      "translation" : "[派遣的萨帕]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "This dimensional rift is connected to the southern area of the ^0000FFKamidal Mountains^000000 in El Dicastes.  I just dropped by for my research, but it is incredible.",
      "translation" : "这道次元裂缝连接着艾尔迪卡斯特斯的^0000FF卡米达尔山脉^000000南部。我只是顺道来做研究，但这里真令人惊叹。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "[Dispatched Sapha]",
      "translation" : "[派遣的萨帕]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "Moreover it is next to the Laphine capital..... Hmm... Do not worry, I do not want to fight in such a place.",
      "translation" : "而且这里就在拉斐内首都旁边...嗯...放心，我不想在这种地方开战。"
    },
    {
