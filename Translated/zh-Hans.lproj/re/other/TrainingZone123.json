    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "[Neighborhood Grandmother]",
      "translation" : "[邻居奶奶]"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "Hohoho- Seeing the young people sweating and working hard makes me feel a bit energized.",
      "translation" : "呵呵呵，看着年轻人挥汗努力，我也觉得精神了不少。"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "[Neighborhood Grandmother]",
      "translation" : "[邻居奶奶]"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "Oh, by the way. Did you know that?",
      "translation" : "对了，你知道吗？"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "[Neighborhood Grandmother]",
      "translation" : "[邻居奶奶]"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "Dummies in the training grounds that are strong against physical attacks have a sword icon above their heads, and dummies that are strong against magic attacks have a staff icon above their heads.",
      "translation" : "训练场里，擅长抵御物理攻击的训练假人头上有剑的图标，擅长抵御魔法攻击的假人头上则有手杖图标。"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "[Neighborhood Grandmother]",
      "translation" : "[邻居奶奶]"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Neighborhood Grandmother",
      "state" : "translated",
      "text" : "If you know this, you'll be able to hit them harder, right?",
      "translation" : "知道这一点之后，就能更有效地攻击它们了，对吧？"
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "Fress",
      "state" : "translated",
      "text" : "[Fress]",
      "translation" : "[芙蕾丝]"
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Fress",
      "state" : "translated",
      "text" : "If you want to go to Prontera, you can exit through the guards located throughout the area or through the warp portals at 3 and 9 o'clock. Seriously.",
      "translation" : "想去普隆德拉的话，可以从区域内各处的守卫那里离开，也可以走位于3点钟和9点钟方向的传送门。真的。"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Nine Oranges",
      "state" : "translated",
      "text" : "[Nine Oranges]",
      "translation" : "[九橙]"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Nine Oranges",
      "state" : "translated",
      "text" : "Remember! Once you've chosen a name, it's hard to change, so choose wisely.",
      "translation" : "记住！名字一旦选定就很难更改，所以要慎重选择。"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Nine Oranges",
      "state" : "translated",
      "text" : "[Nine Oranges]",
      "translation" : "[九橙]"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Nine Oranges",
      "state" : "translated",
      "text" : "By the way, where's the Undead Dummy?",
      "translation" : "对了，不死系训练假人在哪里？"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Nine Oranges",
      "state" : "translated",
      "text" : "[Nine Oranges]",
      "translation" : "[九橙]"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Nine Oranges",
      "state" : "translated",
      "text" : "My friend said it has a bone icon above its head...? You have to see it first.",
      "translation" : "朋友说它头上有骨头图标...你得先找到它。"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Village",
      "state" : "translated",
      "text" : "[Village ]",
      "translation" : "[村民]"
    },
    {
      "kind" : "message",
      "line" : 212,
      "npc" : "Village",
      "state" : "translated",
      "text" : "Hi! The weather is really nice, isn't it? I came to check out the new training grounds.",
      "translation" : "你好！天气真不错，对吧？我来看看新建的训练场。"
    },
    {
      "kind" : "message",
      "line" : 214,
      "npc" : "Village",
      "state" : "translated",
      "text" : "[Village ]",
      "translation" : "[村民]"
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "Village",
      "state" : "translated",
      "text" : "The old training grounds weren't bad, but they were actually renting space that beginners had been using for a long time, so there were some inconveniences.",
      "translation" : "旧训练场也不错，但其实长期占用了新手一直在用的场地，所以有些不方便。"
    },
    {
      "kind" : "message",
      "line" : 217,
      "npc" : "Village",
      "state" : "translated",
      "text" : "[Village ]",
      "translation" : "[村民]"
    },
    {
      "kind" : "message",
      "line" : 218,
      "npc" : "Village",
      "state" : "translated",
      "text" : "But they're building such a spacious and nice new training ground. It seems like they're quite financially sound these days!",
      "translation" : "不过他们正在建这么宽敞又漂亮的新训练场。看来最近资金挺充裕的！"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Jar Cat",
      "state" : "translated",
      "text" : "[Jar Cat]",
      "translation" : "[罐猫]"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Jar Cat",
      "state" : "translated",
      "text" : "Is this your first time at the training grounds? I'll explain myself, as a veteran.",
      "translation" : "你第一次来训练场吗？我作为老手来给你讲讲。"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Jar Cat",
      "state" : "translated",
      "text" : "[Jar Cat]",
      "translation" : "[罐猫]"
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Jar Cat",
      "state" : "translated",
      "text" : "There are three training grounds: the basic training ground, the 1/10 training ground, and the 1/100 training ground. I'll leave the differences between each training ground for you to discover for yourself.",
      "translation" : "训练场有三种：基础训练场、1/10训练场和1/100训练场。它们之间有什么区别，就留给你自己探索吧。"
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Jar Cat",
      "state" : "translated",
      "text" : "[Jar Cat]",
      "translation" : "[罐猫]"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Jar Cat",
      "state" : "translated",
      "text" : "Oh, right! To move to another training ground, you can use the warp portals at 3 o'clock and 9 o'clock. Remember!",
      "translation" : "哦，对了！要前往其他训练场，可以使用3点钟和9点钟方向的传送门。记住！"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Little One",
      "state" : "translated",
      "text" : "[Little One]",
      "translation" : "[小家伙]"
    },
    {
      "kind" : "message",
      "line" : 236,
      "npc" : "Little One",
      "state" : "translated",
      "text" : "Dad told me! The Dummys with staff icons above their heads are strong against magic!",
      "translation" : "爸爸告诉我了！头上有手杖图标的训练假人擅长抵御魔法攻击！"
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Little One",
      "state" : "translated",
      "text" : "[Little One]",
      "translation" : "[小家伙]"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Little One",
      "state" : "translated",
      "text" : "So... if you can defeat those Dummys with magic, you're truly strong, right?!",
      "translation" : "所以...如果你能用魔法打败那些假人，就说明你真的很强，对吧？！"
    },
    {
      "kind" : "message",
      "line" : 244,
      "npc" : "Kekekekereurur",
      "state" : "translated",
      "text" : "[Kekekekereurur]",
      "translation" : "[咯咯咯鲁鲁]"
    },
    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Kekekekereurur",
      "state" : "translated",
      "text" : "They say training with the Dummys with cat icons above them will help you fight Doram in PvP.",
      "translation" : "听说和头上有猫咪图标的训练假人练习，就能在PvP中对付杜兰族。"
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Kekekekereurur",
      "state" : "translated",
      "text" : "[Kekekekereurur]",
      "translation" : "[咯咯咯鲁鲁]"
    },
    {
      "kind" : "message",
      "line" : 248,
      "npc" : "Kekekekereurur",
      "state" : "translated",
      "text" : "I'm definitely not practicing here after getting beat up by a passing Doram. Remember!",
      "translation" : "我绝对不是被路过的杜兰族打败后才来这里练习的。记住！"
    },
    {
      "kind" : "message",
      "line" : 253,
      "npc" : "Lumberjack",
      "state" : "translated",
      "text" : "[Lumberjack]",
      "translation" : "[伐木工]"
    },
    {
      "kind" : "message",
      "line" : 254,
      "npc" : "Lumberjack",
      "state" : "translated",
      "text" : "Whoosh- Cha-Whoosh- Cha-",
      "translation" : "呼——嚓——呼——嚓——"
    },
    {
      "kind" : "message",
      "line" : 259,
      "npc" : "Dong",
      "state" : "translated",
      "text" : "[Dong]",
      "translation" : "[咚]"
    },
    {
      "kind" : "message",
      "line" : 260,
      "npc" : "Dong",
      "state" : "translated",
      "text" : "Aaaah- Stop! Stop! I'm not a monster. Don't attack me.",
      "translation" : "啊——住手！住手！我不是魔物，别攻击我。"
    },
    {
      "kind" : "message",
      "line" : 262,
      "npc" : "Dong",
      "state" : "translated",
      "text" : "[Dong]",
      "translation" : "[咚]"
    },
    {
      "kind" : "message",
      "line" : 263,
      "npc" : "Dong",
      "state" : "translated",
      "text" : "Whew- Thank you. Some people often mistake me for the monster Mukka, but I'm a cactus from a place called RockRidge.",
      "translation" : "呼——谢谢你。有些人常把我误认成魔物魔卡，可我是来自一个叫洛克里奇的地方的仙人掌。"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "Dong",
      "state" : "translated",
      "text" : "[Dong]",
      "translation" : "[咚]"
    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Dong",
      "state" : "translated",
      "text" : "If you visit RockRidge, you can meet our living, breathing Cacti, the Cactus. Come visit. Hahaha.",
      "translation" : "如果你去洛克里奇，就能遇见我们这些活生生的仙人掌。欢迎来玩。哈哈哈。"
    },
