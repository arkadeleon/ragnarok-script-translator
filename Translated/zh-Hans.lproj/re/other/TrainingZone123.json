      "text" : "[Training Ground Warehouse Soldier]",
      "translation" : "[训练场仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "The guild storage is only available for guild members.",
      "translation" : "只有公会成员才能使用公会仓库。"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "[Training Ground Warehouse Soldier]",
      "translation" : "[训练场仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "It seems that it is not yet possible for your guild to use the guild warehouse or you do not have access permissions for the warehouse.",
      "translation" : "你的公会似乎还不能使用公会仓库，或者你没有仓库使用权限。"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "Please come back after checking the guild skill and the permission to access the warehouse.",
      "translation" : "请确认公会技能和仓库使用权限后再来。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "[Training Ground Warehouse Soldier]",
      "translation" : "[训练场仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "I am afraid you do not have enough money to settle the fee.",
      "translation" : "恐怕你的钱不够支付费用。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "The fee is 1000 Zeny.",
      "translation" : "费用是1000金币。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "[Training Ground Warehouse Soldier]",
      "translation" : "[训练场仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "I will open the guild storage for you then. Have a memorable time!",
      "translation" : "那么我为你打开公会仓库。祝你留下难忘的回忆！"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "[Training Ground Warehouse Soldier]",
      "translation" : "[训练场仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "I am afraid someone else is using the warehouse right now.",
      "translation" : "恐怕现在有其他人在使用仓库。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Training Ground Warehouse Soldier",
      "state" : "translated",
      "text" : "Please try again after a while.",
      "translation" : "请过一会儿再试。"
