    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Welcome, Adventurer. This is the plaza of Eclage, a great and sacred tree. How can I help you?",
      "translation" : "欢迎你，冒险者。这里是埃克拉珠这棵伟大神树的广场。有什么需要帮忙吗？"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Palace",
      "translation" : "宫殿"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Orb",
      "translation" : "光球"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Store",
      "translation" : "商店"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Prison",
      "translation" : "监狱"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Clinic",
      "translation" : "诊所"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Residential Area",
      "translation" : "居住区"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Finish the conversation",
      "translation" : "结束对话"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠卫兵]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Our great king, courageous generals, and scholars are all staying at the palace.",
      "translation" : "我们伟大的国王、英勇的将军和学者都住在宫殿里。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "The palace is located at the top of Eclage. We usually fly there, but I see you don't have wings. Follow the path on your right then. It will lead you to the palace.",
      "translation" : "宫殿位于埃克拉珠顶端。我们通常飞过去，不过看起来你没有翅膀，那就沿右边的小路走吧，它会通往宫殿。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠卫兵]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "The Orb behind me is like a symbol of us Laphines.",
      "translation" : "我身后的光球是我们拉菲尼族的象征。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "It's filled with great and mysterious power. We always keep an eye on it and guard it carefully.",
      "translation" : "它蕴含着强大而神秘的力量。我们一直密切关注并小心守护着它。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠卫兵]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "This is the plaza of Eclage. You'll find everything you need around here.",
      "translation" : "这里是埃克拉珠广场，附近能找到你需要的一切。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠卫兵]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Prison is a place for criminals. Why would an adventurer like you go there?",
      "translation" : "监狱是关押罪犯的地方。你这样的冒险者为什么要去那里？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Well, it's a little suspicious...but I'll tell you the location. Follow the path on your left. They don't let anyone in though.",
      "translation" : "嗯，是有点可疑...不过我还是告诉你位置吧。沿左边的小路走就能到，但他们不会让任何人进去。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠卫兵]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "All your pain and weariness melt away in the arms of nature. Restore your mind and body at Eclage Clinic.",
      "translation" : "在大自然的怀抱中，所有伤痛与疲惫都会消散。到埃克拉珠诊所恢复身心吧。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Follow the path on your left.",
      "translation" : "沿左边的小路走。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠卫兵]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Haven't you seen our decorations for Yai? Take a trip outside. You'll see our residential area.",
      "translation" : "你没看过我们为雅伊准备的装饰吗？到外面走走，就能看到居住区。"
    }
  ]
