{
  "file" : "npc/re/guides/guides_dicastes.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Oh!! You are a stranger!",
      "translation" : "哦！！你是外来者！"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "I'm Ichack, the first adventurer that arrived here in El Dicastes!",
      "translation" : "我叫伊查克，是第一个来到艾尔迪卡斯特的冒险者！"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "There was someone in the expedition team claiming that he was the first, but it WAS me. That's right.",
      "translation" : "探险队里有人说自己是第一个到这里的，但那个人就是我。没错。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "That's why I will provide a service to guide adventurers from Midgard.",
      "translation" : "所以我会为米德加尔特来的冒险者提供向导服务。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "What would you like to know?",
      "translation" : "你想了解什么？"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Dicastes Diel",
      "translation" : "迪尔"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Residential Area",
      "translation" : "住宅区"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Training Room",
      "translation" : "训练场"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Factory",
      "translation" : "工厂"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Pub",
      "translation" : "酒馆"
    },
    {
      "kind" : "option",
      "line" : 31,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Cat Paw Caravan",
      "translation" : "猫爪商队"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Ah~ That's a beautiful building.",
      "translation" : "啊~那栋建筑真漂亮。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "It's said they discuss important things...",
      "translation" : "听说他们会在里面商议重要事务..."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"Diel\",\"dicastes01,198,351\")"
      ],
      "state" : "translated",
      "text" : "Please make sure you signed in at the {0}, otherwise you'll get in trouble.",
      "translation" : "记得先去{0}登记，否则会惹上麻烦。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Go directly north from here and you can't miss it.",
      "translation" : "从这里一直往北走，很容易就能找到。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "The Sapha tribe is so weird. How can they sleep in there?",
      "translation" : "萨帕族真奇怪。他们怎么能睡在那种地方？"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "You don't understand?",
      "translation" : "你不明白吗？"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "You won't believe me until you see it! Go see it for yourself!",
      "translation" : "不亲眼看看你是不会相信的！自己去看看吧！"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "The residential area is divided into 2 areas.",
      "translation" : "住宅区分为两个区域。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"lower residential area\",\"dicastes01,136,106\")"
      ],
      "state" : "translated",
      "text" : "The {0} is around 7 o'clock, and the ",
      "translation" : "{0}在大约7点钟方向，"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"upper area\",\"dicastes01,280,283\")"
      ],
      "state" : "translated",
      "text" : "{0} is around 1 o'clock.",
      "translation" : "{0}在大约1点钟方向。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Because of the dangers here, we need better security...",
      "translation" : "这里很危险，所以需要更严密的治安..."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Have you ever been to the ",
      "translation" : "你去过"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"training room\",\"dicastes01,255,172\")"
      ],
      "state" : "translated",
      "text" : "{0}? The training guards seem to never sleep!",
      "translation" : "{0}吗？训练场的守卫好像从来不睡觉！"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "This is one of the most important reasons why they live here.",
      "translation" : "他们住在这里，最重要的原因之一就在这儿。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"factory\",\"dicastes01,97,256\")"
      ],
      "state" : "translated",
      "text" : "If you go to the {0}, you can see the recently refined Bradium.",
      "translation" : "去{0}就能看到最近精炼出来的布拉迪姆。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Although I arrived here as the first adventurer, the owner of the pub was the first person here.",
      "translation" : "虽然我是第一个来到这里的冒险者，但酒馆老板才是最早到这里的人。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"Bumen Florine's pub\",\"dicastes01,136,106\")"
      ],
      "state" : "translated",
      "text" : "{0} is located underground in the lower residential area.",
      "translation" : "{0}位于下层住宅区的地下。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "He might have some valuable information for you.",
      "translation" : "他或许能告诉你一些有价值的情报。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"cats\",\"dicastes01,199,39\")"
      ],
      "state" : "translated",
      "text" : "The {0} don't seem to have a good relationship with the Sapha like we do.",
      "translation" : "{0}似乎不像我们这样和萨帕族关系良好。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Perhaps it's because trading is involved.",
      "translation" : "也许是因为牵涉到交易吧。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "Poor cats. They must be shivering from the cold out there.",
      "translation" : "可怜的猫咪，它们在外面一定冻得发抖。"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "[Traveler Ichack]",
      "translation" : "[旅行者伊查克]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Traveler Ichack",
      "state" : "translated",
      "text" : "You can find their caravan just outside the gates.",
      "translation" : "他们的商队就在大门外。"
    }
  ]
}