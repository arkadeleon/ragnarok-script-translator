      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]\nHo ho ho ~!\nGuiding is very interesting.",
      "translation" : "[毁葛向导婆婆]\n呵呵呵~！\n当向导真有意思。"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Guide Rich King",
      "state" : "translated",
      "text" : "[Rich King]\nWhat business do you have\nin this countryside village?",
      "translation" : "[富有的国王]\n你到这乡下村子来，有何贵干？"
