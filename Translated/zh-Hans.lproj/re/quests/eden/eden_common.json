      "text" : "[Lime Evenor]",
      "translation" : "[莱姆·艾弗诺]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "There you go. Come back again~",
      "translation" : "给您。欢迎再来~"
