      "state" : "translated",
      "text" : "[Lime Evenor]",
      "translation" : "[莱姆·艾弗诺]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "What possible reason would you have... to not exchange?",
