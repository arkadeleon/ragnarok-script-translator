    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "[Lime Evenor]",
      "translation" : "[莱姆·艾弗诺]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "People who follow their dreams and romances listen to me. We are representatives of the paradise called 'The garden of Eden' called the Eden group . There is no place like this anywhere.",
      "translation" : "追寻梦想与浪漫的人们，请听我说！我们是乐园团的代表，这里就像名为“伊甸园”的乐园，世上独一无二。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Hello. Can I help you?",
      "translation" : "您好，有什么能帮您的吗？"
    },
    {
      "kind" : "option",
      "line" : 62,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "What is Eden group?",
      "translation" : "什么是乐园团？"
    },
    {
      "kind" : "option",
      "line" : 62,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Join the Eden Group.",
      "translation" : "加入乐园团"
