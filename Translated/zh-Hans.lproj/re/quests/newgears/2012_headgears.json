    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Reno",
      "state" : "translated",
      "text" : "[Reno]",
      "translation" : "[雷诺]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Reno",
      "state" : "translated",
      "text" : "If it works well, it seems to be good for both ECRA and adventurers.",
