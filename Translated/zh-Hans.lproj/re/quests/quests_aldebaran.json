    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[贝尔杰明·巴顿]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Really? You don't have the money and asked me to take you there?",
      "translation" : "真的吗？你没钱，还要我带你去那里？"
    },
    {
      "kind" : "message",
