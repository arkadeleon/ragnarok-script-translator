    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "The monsters here are able to control time.",
      "translation" : "这里的魔物能够操控时间。"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Come back when you've reached ^0000FFLevel 150^000000.",
      "translation" : "达到^0000FF150级^000000后再回来。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Time, memories, environments... all can become warped here.",
      "translation" : "时间、记忆、环境...在这里一切都可能扭曲。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[贝尔杰明·巴顿]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "I'm begging you not to ask more about it. It might put your life in danger.",
      "translation" : "求你别再问下去了。这可能会让你丢掉性命。"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Don't ask",
      "translation" : "不再询问"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Go to 2nd floor of warped tower",
      "translation" : "前往扭曲之塔2楼"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Go to 3rd floor of warped tower",
      "translation" : "前往扭曲之塔3楼"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[贝尔杰明·巴顿]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Be careful with your choice.",
      "translation" : "慎重选择。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[贝尔杰明·巴顿]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "I need ^0000FF10,000z^000000 to let you in. It's a pretty dangerous place to be.",
      "translation" : "我需要^0000FF10,000 Zeny^000000才能让你进去。那里相当危险。"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Quit",
      "translation" : "退出"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Pay 10,000z",
      "translation" : "支付10,000 Zeny"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Why do you need money?",
      "translation" : "你为什么需要钱？"
