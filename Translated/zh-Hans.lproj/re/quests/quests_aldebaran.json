      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[贝尔杰明·巴顿]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Me too. You might also be a missing one. Unaware, with no purpose nor idea.",
      "translation" : "我也一样。你可能也是个失踪者，浑然不觉，没有目的，也不知道该做什么。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[贝尔杰明·巴顿]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "It's time to go back. Please cherish your time some more.",
      "translation" : "该回去了。请再好好珍惜这段时光。"
