      "translation" : "[接待员]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Welcome to Eclage Clinic.",
      "translation" : "欢迎来到艾克拉珠诊所。"
    },
    {
      "kind" : "option",
      "line" : 32,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Save Location",
      "translation" : "设置保存地点"
    },
    {
      "kind" : "option",
      "line" : 32,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Rest",
      "translation" : "休息"
    },
    {
      "kind" : "option",
      "line" : 32,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Finish the conversation",
      "translation" : "结束对话"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "[Receptionist]",
      "translation" : "[接待员]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Clinic has been set as your save point. Be careful though~",
      "translation" : "诊所已设为你的保存地点。不过要小心哦~"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "[Receptionist]",
      "translation" : "[接待员]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Restore your mind and body at our clinic. It's filled with Eclage's clean energy.",
      "translation" : "在我们的诊所恢复身心吧。这里充满了艾克拉珠纯净的能量。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "We charge 1 Splendide Coin normally, but we offer a special discount for travelers. Your total is 5,000 zeny. ",
      "translation" : "平时收费1枚斯普兰迪硬币，不过我们为旅行者提供特别优惠。总共只需5,000 Zeny。"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Pay with Splendide Coin",
      "translation" : "用斯普兰迪硬币支付"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Pay with Zeny",
      "translation" : "用 Zeny 支付"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Forget it",
      "translation" : "算了"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "[Receptionist]",
      "translation" : "[接待员]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "It seems like you don't have enough coins. Would you check your account again, please?",
      "translation" : "你的硬币似乎不够。请再确认一下账户，好吗？"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "[Receptionist]",
      "translation" : "[接待员]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Make yourself at home~",
      "translation" : "请随意休息~"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "[Receptionist]",
      "translation" : "[接待员]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Looks like you don't have enough resources to proceed. Do you mind checking your account again?",
      "translation" : "你的资源似乎不足，无法继续。能请你再确认一下账户吗？"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "[Receptionist]",
      "translation" : "[接待员]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Make yourself at home~",
      "translation" : "请随意休息~"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "[Injured Laphine]",
      "translation" : "[受伤的拉菲内]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "Ooww...",
      "translation" : "呜啊..."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "Where...am...I?",
      "translation" : "我...在...哪里？"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "[Doctor]",
      "translation" : "[医生]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "You're at a clinic. Don't worry.",
      "translation" : "你在诊所里。别担心。"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "We stopped the bleeding and cast emergency spells.",
      "translation" : "我们已经止住出血，并施了紧急治疗魔法。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "You were bleeding a lot. That was close, you know.",
      "translation" : "你流了很多血。真是险些丧命。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "[Injured Laphine]",
      "translation" : "[受伤的拉菲内]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "......",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "What, no, I...I don't feel anything...what's going on?",
      "translation" : "什么，不，我...我什么都感觉不到...这是怎么回事？"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "[Doctor]",
      "translation" : "[医生]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "Umm...the arrow damaged your wing pretty badly...",
      "translation" : "嗯...箭矢把你的翅膀伤得很严重..."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "[Injured Laphine]",
      "translation" : "[受伤的拉菲内]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "...what do you mean?",
      "translation" : "...你这是什么意思？"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "[Doctor]",
      "translation" : "[医生]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "Well...I was going to tell you after you recover, but you should know. You can't decorate the Yai anymore. ",
      "translation" : "嗯...我本想等你康复后再告诉你，但你应该知道。你再也不能装饰自己的羽翼了。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "In other words, you injured your wing. The arrow went through the most critical part in the wing.",
      "translation" : "也就是说，你的翅膀受伤了。箭穿过了翅膀上最关键的部位。"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "[Injured Laphine]",
      "translation" : "[受伤的拉菲内]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Injured Laphine",
      "state" : "translated",
      "text" : "What? No way...please...doctor!! No!!",
      "translation" : "什么？不可能...拜托...医生！！不要！！"
    }
  ]
}