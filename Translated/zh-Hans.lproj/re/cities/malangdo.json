    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "^9E1837Admiral Tomas^000000 said to kidnap humans... No... Bring them politely?",
      "translation" : "^9E1837托马斯提督^000000说要把人类绑架过去...不对...是礼貌地请过去？"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Anyway, I got you. Whenever you want to go, just tell me.",
      "translation" : "行吧，我知道了。想去的时候随时告诉我。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Ok! I like your attitude. Full of passion.",
      "translation" : "好！我喜欢你的态度，充满热情。"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Now, before you go ^A2314BMalangdo^000000, let me give you some warnings.",
      "translation" : "在你去^A2314B绵绵岛^000000之前，我先提醒你几件事。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "First!! It is natural that when you arrive on ^A2314BMalangdo^000000, you should notify ^9E1837Admiral Tomas^000000 that you are here.",
      "translation" : "第一！！抵达^A2314B绵绵岛^000000后，当然要通知^9E1837托马斯提督^000000你已经到了。"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "If you don't do that, you might be attacked by scary and wild cats when you walk through dark streets.",
      "translation" : "如果你不这么做，走在昏暗的街道上时，可能会遭到凶猛野猫袭击。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Secondly!! This ^A2314BMalangdo^000000 is absolutely our island of cats, even though we open to humans.",
      "translation" : "第二！！^A2314B绵绵岛^000000绝对是我们猫咪的岛屿，虽然也对人类开放。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "We have a personality... no... no... respect us like one catality because we are cats.",
      "translation" : "我们有个性...不...不...因为我们是猫，要像尊重一个猫类那样尊重我们。"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "And the next one is...",
      "translation" : "接下来还有一条..."
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Dolangmal proceeds and gives hundreds of warnings.",
      "translation" : "多朗马尔接着滔滔不绝地叮嘱了一大堆。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Ok! Those are all the warnings!! They're easy and simple... right? Can you remember them?",
      "translation" : "好！叮嘱的事情就这些！！很简单，对吧？你都记住了吗？"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Remember his warnings",
      "translation" : "记住他的叮嘱"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Can't remember",
      "translation" : "记不住"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Ok! Do not bite two mice with one mouth. ^9E1837Admiral Tomas^000000 is located at the ^A2314Bcenter of the ship in Malangdo^000000.",
      "translation" : "好！一张嘴可别同时咬两只老鼠。^9E1837托马斯提督^000000就在^A2314B绵绵岛船只的中央^000000。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Don't forget to give him notice of your arrival.",
      "translation" : "别忘了通知他你已经到了。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Alright. Let's go to the heaven of the cats, ^A2314BMalangdo^000000~",
      "translation" : "好啦，出发去猫的天堂——^A2314B绵绵岛^000000吧~"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "What!? Can't you keep these easy rules? Chet!",
      "translation" : "什么！？这么简单的规矩你都记不住？切！"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "You're such an annoying guy. If you can't keep these, why didn't you tell me during our conversation? I told you everything... but..",
      "translation" : "你这家伙真麻烦。记不住的话，刚才聊天时为什么不说？我明明都告诉你了...不过..."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "^9E1837Admiral Tomas^000000 said to kidnap humans... No... Bring them politely?",
      "translation" : "^9E1837托马斯提督^000000说要把人类绑架过去...不对...是礼貌地请过去？"
    },
    {
      "kind" : "message",
