      "kind" : "message",
      "line" : 49,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "You're such an annoying guy. If you don't go, why did you talk to me... but...",
      "translation" : "你这家伙真麻烦。不想去还来搭什么话...不过..."
