      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗马尔]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "What!? You don't want to go ^A2314BMalangdo^000000? Chet!",
      "translation" : "什么！？你不想去^A2314B绵绵岛^000000？切！"
