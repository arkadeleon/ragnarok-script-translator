      "state" : "translated",
      "text" : "[Traveler]",
      "translation" : "[旅行者]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Traveler",
      "state" : "translated",
      "text" : "I want to go explore inside...",
      "translation" : "我想进去探索一番..."
