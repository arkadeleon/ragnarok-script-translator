    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "You've been reborn, haven't you?",
      "translation" : "你已经转生了，对吧？"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "I see you're retreading the path of the Swordman! Once you've gotten used to brandishing a sword, you can never go back!!",
      "translation" : "看来你又走上了剑士之路！习惯挥剑之后，就再也回不去了！！"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hmm? Ah, you must first master the Basic Skills before you are ready to become a Swordman.",
      "translation" : "嗯？啊，你得先精通基本技能，才能准备好成为剑士。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Come back to me when you have finished learning the Basic Novice Skills.",
      "translation" : "学完初学者的基本技能后再来找我。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Excellent! Let me promote you to a Swordman right away!",
      "translation" : "很好！我马上帮你转职为剑士！"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hmm... You look like a well-experienced Swordman. Still, I'm sure that you must train to improve your skills and gain strength!",
      "translation" : "嗯...你看起来是个经验丰富的剑士。不过，我相信你还得继续训练，提升技巧、增强实力！"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hm...?",
      "translation" : "嗯...？"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "You're a reborn",
      "translation" : "你是转生后的"
    },
    {
