    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Hey, you didn't quit",
      "translation" : "喂，你没有放弃"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "your business, did you?",
      "translation" : "自己的生意吧？"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "What happened?",
      "translation" : "怎么了？"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[会长曼苏]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Whoa...",
      "translation" : "哇..."
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "You've actually been to Valhalla?! Wow, you've come a long way...",
      "translation" : "你真的去过英灵殿？！哇，真是成长了不少..."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[会长曼苏]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Hmmm...",
      "translation" : "嗯..."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "It seems that you're not ready to become a Merchant again. Go finish learning the Basic Novice Skills first.",
      "translation" : "看来你还没准备好再次成为商人。先去学完初学者的基本技能吧。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[会长曼苏]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Don't worry, we'll always have a Merchant position open for you. Just come back when you're ready, okay?",
      "translation" : "别担心，我们随时都为你留着商人的位置。准备好后再回来，好吗？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[会长曼苏]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I guess it's destiny that we meet like this once more. Alright. Once again, let me change you into a Merchant!",
      "translation" : "我想我们再次相遇一定是命运安排。好吧，我再帮你转职为商人！"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[会长曼苏]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Ah~ How nostalgic. Just like old times! Alright, do your best!",
      "translation" : "啊~真令人怀念。就像以前一样！好好努力吧！"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[会长曼苏]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "^333333*Sigh*^000000",
      "translation" : "^333333*叹气*^000000"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I'm so bored...",
      "translation" : "真无聊..."
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "When will I hear from my lovely Blossom?",
      "translation" : "我什么时候才能收到可爱的花花的消息呢？"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Hey, why are you here?",
      "translation" : "喂，你来这里做什么？"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I want to be a merchant.",
      "translation" : "我想成为商人。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I want to know more about merchants.",
      "translation" : "我想了解更多关于商人的事。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Ask him the requirements to be a merchant.",
      "translation" : "问他成为商人的条件。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Nothing.",
      "translation" : "没事。"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : ".....? Sorry? What are you saying?",
      "translation" : "...？抱歉？你在说什么？"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "You are already a merchant. Oh my..",
      "translation" : "你已经是商人了。哎呀..."
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Huh?! ...Do I need to laugh right now?!",
      "translation" : "什么？！...现在是要我笑吗？！"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Ahh? Are you trying to have both ways?",
      "translation" : "啊？你想两边都占着吗？"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "How about just giving yourself over to your original job?",
      "translation" : "不如回去做你原本的职业吧？"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "We have business ethics you know.",
      "translation" : "我们可是讲商业道德的。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Want to be a merchant? Hmm...",
      "translation" : "想成为商人？嗯..."
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "But if you want to be a merchant, your basic skill level must reach Level 9 or you must spend all of your skill points.",
      "translation" : "不过想成为商人，基本技能等级必须达到9级，或者用完所有技能点。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Don't you think we need to learn some basic skills although we just deal with money?",
      "translation" : "你不觉得即使我们只跟钱打交道，也得学一些基本技能吗？"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Good, I think you're fully ready for it seeing that your basic skill level is fulfilled.",
      "translation" : "很好，你的基本技能等级已经达标，我想你完全准备好了。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Now I allow you to be a merchant.",
      "translation" : "现在我批准你成为商人。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Congratulations on becoming a merchant!",
      "translation" : "恭喜你成为商人！"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Congratulations again for being a member of the merchant guild and one of our colleagues. I expect your active participation from now on!",
      "translation" : "再次恭喜你加入商人公会，成为我们的同伴。从现在起，我期待你积极参与！"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Absolutely, we need young people who have passion to achieve our great goal for securing 20% of the worldwide currency volume. You get it? Huh?",
      "translation" : "当然，我们需要有干劲的年轻人，帮助实现掌握全球20%货币流通量的宏伟目标。明白吗？嗯？"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Well, I'm just saying... it means let's make lots of money in the end. You guys know that~",
      "translation" : "哎，我只是说说...总之就是要赚大钱。你们懂的~"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Merchant? To put it simply, the person who sells good and makes money is a merchant.",
      "translation" : "简单来说，商人就是出售商品赚钱的人。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Not good at fighting and doesn't have special attack/recovery skills... but a merchant can buy things at a low price and then sell them and make money.",
      "translation" : "商人不擅长战斗，也没有特别的攻击或恢复技能...但可以低价买进，再高价卖出赚钱。"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Well, a merchant has an ultimate skill called Mammonite which strikes an enemy with his/her money... We can equip everything except Bows, Rods, and Two-Handed Swords. But we can always sell and buy those.",
      "translation" : "商人有一种终极技能叫金钱攻击，可以用钱砸击敌人...除了弓、手杖和双手剑，其他武器我们都能装备。不过这些也可以低买高卖。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Yes... we merchants always have money on our minds, got it?",
      "translation" : "没错...我们商人脑子里想的总是钱，明白了吗？"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "To become a merchant, although just selling and receiving money is our job, you must reach at least basic skill level 9.",
      "translation" : "要成为商人，虽然我们的工作只是买卖收钱，基本技能等级也必须至少达到9级。"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Well, we used to receive a start-up fee before. Wasn't it hard to make that money?",
      "translation" : "以前我们会收取创业费。要凑齐那笔钱很难吧？"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "There were too many people who couldn't gather that money and kept crying.",
      "translation" : "有太多人凑不齐钱，只能一直哭诉。"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公会职员曼苏]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "So recently, we decided to allow any Novice who wants to be a merchant become one.",
      "translation" : "所以最近我们决定，任何想成为商人的初学者都可以转职。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Because to be alive or not later is all up to one's ability.",
      "translation" : "因为以后能不能活下去，全看个人本事。"
    }
  ]
}