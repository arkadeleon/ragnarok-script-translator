    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Karacas",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "So, you are [{0}]... right?",
      "translation" : "那么，你是[{0}]...对吧？"
    },
    {
      "kind" : "option",
      "line" : 181,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Yes, I am.",
      "translation" : "是的，我是"
    },
    {
      "kind" : "option",
      "line" : 181,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "No, I'm not!",
      "translation" : "不，我不是！"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Karacas",
