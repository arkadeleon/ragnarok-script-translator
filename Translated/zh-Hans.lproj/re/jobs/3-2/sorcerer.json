      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Hm hm!!!~",
      "translation" : "咳咳！！~"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Aaaak!! ",
      "translation" : "啊啊啊！"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Oh, my... ",
      "translation" : "哦，天哪..."
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Wh... where are you from?",
      "translation" : "你...你是从哪里来的？"
