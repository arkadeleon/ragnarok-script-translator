      "line" : 161,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Ah... excuse me~",
      "translation" : "啊...打扰了~"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Karacas",
