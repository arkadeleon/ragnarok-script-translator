{
  "file" : "npc/re/merchants/blessed_refiner.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[铁匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "state" : "translated",
      "text" : "In this highly competitive society, we must be different in order to survive!",
      "translation" : "在竞争如此激烈的社会里，我们必须与众不同才能生存！"
    },
    {
      "kind" : "message",
      "line" : 21,
      "state" : "translated",
      "text" : "I only refine equipment at the +6 ~ 12 levels.",
      "translation" : "我只精炼+6到+12等级的装备。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[铁匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "state" : "translated",
      "text" : "I will need ^ff9999Blessed Oridecon^000000 for weapons, and ^ff9999Blessed Elunium^000000 for armors.",
      "translation" : "武器需要^ff9999祝福神之金属^000000，防具需要^ff9999祝福铝^000000。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "state" : "translated",
      "text" : "Failed refines ^FF0000will not break or reduce the refine level^000000.",
      "translation" : "精炼失败^FF0000不会损坏装备，也不会降低精炼等级^000000。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[铁匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "state" : "translated",
      "text" : "How about it? Do you want to refine?",
      "translation" : "怎么样？要精炼吗？"
    },
    {
      "kind" : "message",
      "line" : 35,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[铁匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "state" : "translated",
      "text" : "I'm a blacksmith, not a hairstylist.",
      "translation" : "我是铁匠，不是发型师。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "state" : "translated",
      "text" : "With my hammer, I will make you a star of the sky.",
      "translation" : "用我的铁锤，我会让你成为天上的明星。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "state" : "translated",
      "text" : "Making artificial hands is not my specialty.",
      "translation" : "制作义肢可不是我的专长。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "Bring out the item so I can refine it!",
      "translation" : "把装备拿出来，我才能帮你精炼！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "state" : "translated",
      "text" : "Where is this weird smell coming from?",
