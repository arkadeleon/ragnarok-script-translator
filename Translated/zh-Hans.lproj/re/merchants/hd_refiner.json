      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 99,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[铁匠 巨力铁锤]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "state" : "translated",
      "text" : "I will wait until you are ready.",
      "translation" : "我会等你准备好。"
