  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[铁匠 巨力铁锤]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "state" : "translated",
      "text" : "Unlike others, I am a blacksmith who refines a very limited number of items.",
      "translation" : "我跟其他铁匠不同，只精炼少数几种装备。"
    },
    {
      "kind" : "message",
      "line" : 22,
      "state" : "translated",
      "text" : "I refine only items that are ^CC0000+7 to +9^000000.",
      "translation" : "我只精炼^CC0000+7到+9^000000的装备。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[铁匠 巨力铁锤]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "state" : "translated",
      "text" : "My specialty is that even if my refining fails, the refine level decreases by 1 without losing the gear. Isn't it great?",
      "translation" : "我的特色是精炼失败时装备不会损毁，只降低1级精炼值。很不错吧？"
    },
    {
      "kind" : "message",
      "line" : 27,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[铁匠 巨力铁锤]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "state" : "translated",
      "text" : "So lets kick this into overdrive, what d' ya say? What item do you want to refine?",
      "translation" : "那就火力全开吧，怎么样？你想精炼什么装备？"
    },
    {
      "kind" : "message",
      "line" : 35,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[铁匠 巨力铁锤]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "state" : "translated",
      "text" : "I'm a blacksmith, not a hairstylist.",
      "translation" : "我是铁匠，不是理发师。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "state" : "translated",
      "text" : "With my hammer, I will make you a star of the sky.",
      "translation" : "我会用这把锤子把你打上天，变成一颗星星。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "state" : "translated",
      "text" : "Making artificial hands is not my specialty.",
      "translation" : "制作假手不是我的专长。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "Bring out the item so I can refine it!",
      "translation" : "把装备拿出来，我才能帮你精炼！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "state" : "translated",
      "text" : "Where is this foot odor coming from?",
      "translation" : "这股脚臭味是从哪里来的？"
