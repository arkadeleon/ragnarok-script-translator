      "kind" : "message",
      "line" : 76,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "It's rather inexpensive!",
      "translation" : "价格相当实惠！"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "If you're interested, talk to me any time!",
      "translation" : "感兴趣的话，随时来找我！"
