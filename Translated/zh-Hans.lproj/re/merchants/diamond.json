{
  "file" : "npc/re/merchants/diamond.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Ladies and Gentlemen! ! !",
      "translation" : "各位先生、女士！！！"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "You've heard rumors but you've never once seen with your own eyes",
      "translation" : "你们可能听说过这个传闻，却从未亲眼见过"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "the world's rarest diamond!",
      "translation" : "世界上最稀有的钻石！"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "The ^FF82FF'17 Carat Diamond'^000000 is currently on sale for a cheap price!!",
      "translation" : "^FF82FF“17克拉钻石”^000000现在正以超低价出售！！"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "If valuable diamonds interest you then listen up!",
      "translation" : "如果你对珍贵钻石感兴趣，就听好了！"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "You can give the diamond as a gift to your lover.",
      "translation" : "你可以把它送给心爱的人。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "The receiver of the ^FF82FF'17 Carat Diamond'^000000 will cherish it",
      "translation" : "收到^FF82FF“17克拉钻石”^000000的人会珍藏它，"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "and treasure you in their heart.",
      "translation" : "并将你铭记在心。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "What? You don't have a lover?",
      "translation" : "什么？你没有恋人？"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "You can still just hang on to it for yourself.",
      "translation" : "那就自己留着也行。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "The enchanting aura of the ^FF82FF'17 Carat Diamond'^000000 is likely",
      "translation" : "^FF82FF“17克拉钻石”^000000散发的迷人气息"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "to bring love into your life.",
      "translation" : "或许会为你带来爱情。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Known as the captivating diamond of diamonds...",
      "translation" : "它被誉为钻石中的绝世珍品..."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "It is the ^FF82FF'17 Carat Diamond'^000000!",
      "translation" : "它就是^FF82FF“17克拉钻石”^000000！"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Yes!",
      "translation" : "是！"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Hehe, the ^FF82FF'17 Carat Diamond'^000000 you see right now",
      "translation" : "呵呵，你现在看到的^FF82FF“17克拉钻石”^000000"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "is one of the highest quality 17 carat diamonds.",
      "translation" : "是品质最高的17克拉钻石之一。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Comparing it to any pea-sized, colorless rock you may have",
      "translation" : "把它和你可能从梦罗克挖到的"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "dug up from Morocc is unspeakable!",
      "translation" : "豌豆大小的无色石头相提并论，简直是侮辱！"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Some claim that this is the very same diamond",
      "translation" : "有人说，这就是卡夏在海洞见过的"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "that was seen by Kachua in Comodo!",
      "translation" : "那颗钻石！"
    },
    {
      "kind" : "option",
      "line" : 74,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "End Conversation",
      "translation" : "结束对话"
    },
    {
      "kind" : "option",
      "line" : 74,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "How much is it?",
      "translation" : "多少钱？"
