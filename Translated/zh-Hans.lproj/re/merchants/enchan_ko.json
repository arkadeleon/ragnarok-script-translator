    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Artisan Tene",
      "state" : "translated",
      "text" : "Since I use a stable and unique way of adding options, there are no risks of ^ff0000'Reset Refine'^000000 or ^ff0000'Losing Cards'^000000 equipped.",
