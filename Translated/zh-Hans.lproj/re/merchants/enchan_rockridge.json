      "text" : "[Affable Lady]",
      "translation" : "[和蔼的女士]"
    },
    {
      "kind" : "message",
      "line" : 250,
      "npc" : "Affable Lady",
      "state" : "translated",
      "text" : "You're an adventurer. I like people like you who have passion.",
