      "kind" : "message",
      "line" : 93,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[违禁品加工师]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Oh, do you really want to reset it? As I told you before, contraband Vigilante Badges are prone to destruction.",
