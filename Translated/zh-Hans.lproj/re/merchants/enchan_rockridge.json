      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[违禁品加工师]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Why are you wasting my time? Go wear your equipment first.",
      "translation" : "你在浪费我的时间。先把装备穿上再来。"
