  "scripts" : [
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I'm carrying too many types of items. I should lighten my bag first.",
      "translation" : "我带的物品种类太多了。得先整理一下背包。"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I'm overweight. I'd better lighten my bag first.",
      "translation" : "我超重了。得先整理一下背包。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[违禁品加工师]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Have you tried to buy some contraband items with Rock Ridge Coins? I can make your contraband items better.",
      "translation" : "你用洛克里奇金币买过违禁品吗？我可以帮你强化违禁品。"
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Make them better? How?",
      "translation" : "怎么强化？"
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Enchant contraband items.",
      "translation" : "附魔违禁品。"
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Reset contraband item Enchantment level.",
      "translation" : "重置违禁品的附魔等级。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[违禁品加工师]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Ah, have we met before? I meet so many people every day that I can't remember all of their faces. Let me catch you up to speed.",
      "translation" : "啊，我们以前见过吗？我每天见的人太多，记不清所有人的脸。让我再跟你说明一下。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[违禁品加工师]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I can enchant the equipment that you can buy with Rock Ridge Coins, for up to 3 sockets for Armor and Garments and up to 2 sockets for Accessories.",
      "translation" : "我可以为用洛克里奇金币购买的装备附魔：铠甲和披肩最多可附加3个插槽，饰品最多可附加2个插槽。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[违禁品加工师]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I charge 2 Rock Ridge Coins per socket for both enchanting and resetting.",
      "translation" : "无论附魔还是重置，每个插槽都要收取2枚洛克里奇金币。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[违禁品加工师]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Oh, and note that these contraband items are prone to destruction, especially when they are reset.",
      "translation" : "还有，这些违禁品很容易损坏，尤其是在重置时。"
    },
    {
      "kind" : "option",
