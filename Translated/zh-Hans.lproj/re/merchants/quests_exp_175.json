    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃尔门]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "I'm sorry. Adventurer.",
      "translation" : "抱歉，冒险者。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Dynite Refinement can only be refined up to 100 at a time? The machine is small, so there is no help. Please understand.",
      "translation" : "达因石一次最多只能精炼100个。机器太小，实在没办法。请谅解。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃尔门]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Cancel?",
      "translation" : "要取消吗？"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "If you need refinement of the Dynite, please find it anytime. There is no one who can do it without me.",
      "translation" : "如果还需要精炼达因石，随时来找我。除了我，没人能做这件事。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃尔门]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Hey! This makes it difficult for each other, don't you run out of materials needed for refining? The materials!",
      "translation" : "喂！这可让人很为难啊。精炼需要的材料可不能短缺！材料啊！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃尔门]"
    },
    {
