{
  "file" : "npc/re/merchants/guild_warehouse.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 12,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "How are you? We are specialized in guild warehouses. This is our ^0000cdstory^000000:",
      "translation" : "最近如何？我们专营公会仓库。这是我们的^0000cd故事^000000："
    },
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Why can't guild members share a storage? We started off with that simple question.",
      "translation" : "为什么公会成员不能共用仓库？我们最初就是从这个简单的问题开始的。"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "You can open the warehouse for 1000 Zeny or look up the usage history of the guild.",
      "translation" : "支付1000 Zeny即可开启公会仓库，也可以查询公会仓库的使用记录。"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "How can I help you?",
      "translation" : "需要我帮你做什么？"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Open guild warehouse",
      "translation" : "开启公会仓库"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "View warehouse usage history",
      "translation" : "查看仓库使用记录"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "The guild storage is only available for guild members.",
      "translation" : "只有公会成员才能使用公会仓库。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "It seems that it is not yet possible for your guild to use the guild warehouse or you do not have access permissions for the warehouse.",
      "translation" : "贵公会似乎尚未解锁公会仓库，或者你没有仓库使用权限。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Please come back after checking the guild skill and the permission to access the warehouse.",
      "translation" : "请检查公会技能和仓库使用权限后再来。"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I am afraid you do not have enough money to settle the fee.",
      "translation" : "恐怕你的钱不够支付费用。"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "The fee is 1000 Zeny.",
      "translation" : "费用是1000 Zeny。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I will open the guild storage for you then. Have a memorable time!",
      "translation" : "那我为你开启公会仓库。祝你度过难忘的时光！"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I am afraid someone else is using the warehouse right now.",
      "translation" : "恐怕现在有人正在使用仓库。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Please try again after a while.",
      "translation" : "请过一会儿再试。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "The guild storage is only available for guild members.",
      "translation" : "只有公会成员才能使用公会仓库。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "It seems that it is not yet possible for your guild to use the guild warehouse or you do not have access permissions for the warehouse.",
      "translation" : "贵公会似乎尚未解锁公会仓库，或者你没有仓库使用权限。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Please come back after checking the guild skill and the permission to access the warehouse.",
      "translation" : "请检查公会技能和仓库使用权限后再来。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[仓库管理员]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I will show you the usage history of the warehouse. Usage history will be retained for up to 3 months.",
      "translation" : "我来为你显示仓库使用记录。记录最多保留3个月。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Have a memorable time!",
      "translation" : "祝你度过难忘的时光！"
    }
  ]
