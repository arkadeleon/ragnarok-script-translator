      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[装备改良宣传员]"
    },
    {
      "kind" : "message",
      "line" : 9,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Hello, adventurer!",
      "translation" : "你好，冒险者！"
    },
    {
      "kind" : "message",
      "line" : 10,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Are you unhappy with your equipment now?",
      "translation" : "你对现在的装备不满意吗？"
    },
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Don't you want to try a new modification than just any other normal method?",
      "translation" : "想不想试试与众不同的改造方式？"
    },
    {
      "kind" : "message",
      "line" : 12,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Join the Regenschirm Institute!",
      "translation" : "加入雷根施尔姆研究所吧！"
    },
    {
      "kind" : "option",
      "line" : 14,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Let's go.",
      "translation" : "出发吧。"
    },
    {
      "kind" : "option",
      "line" : 14,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Listen to the explanation.",
      "translation" : "听听说明。"
    },
    {
      "kind" : "option",
      "line" : 14,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Quit.",
      "translation" : "离开。"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[装备改良宣传员]"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Good! Other facilities in the institute are confidential and are not accessible, so we will guide you on a special path where you outsiders can enter!",
      "translation" : "很好！研究所里的其他设施属于机密，外人无法进入，所以我们会带你走一条特别通道，让你们这些外来者也能进去！"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[装备改良宣传员]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "All around the world research is being conducted at the Regenschirm Institute to modify weapons, armor, accessories and other equipment items...",
      "translation" : "雷根施尔姆研究所正在世界各地研究武器、防具、饰品等装备的改造..."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "We're still collecting data and researching modifications, so we need a lot of adventurer's equipment to increase our modification research.",
      "translation" : "我们仍在收集资料、研究改造方式，因此需要大量冒险者的装备来推进研究。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[装备改良宣传员]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Research is ongoing, so please look forward to the addition of multiple new equipment as soon as it is completed!",
      "translation" : "研究仍在进行中，完成后敬请期待陆续推出更多新装备改造！"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[装备改良宣传员]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "If you're interested later, come back!",
      "translation" : "以后有兴趣的话，欢迎再来！"
    },
