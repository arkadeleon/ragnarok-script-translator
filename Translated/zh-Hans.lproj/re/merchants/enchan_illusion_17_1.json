    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Elyumina",
      "state" : "translated",
      "text" : "[Elyumina]",
      "translation" : "[艾琳米娜]"
    },
    {
      "kind" : "message",
      "line" : 267,
      "npc" : "Elyumina",
      "state" : "translated",
      "text" : "Argh! Why do you keep asking for me when I need to focus on my research? I'm busy, alright? If you're bored, go bring me more damaged weapons!",
