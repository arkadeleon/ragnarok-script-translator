    },
    {
      "kind" : "message",
      "line" : 275,
      "npc" : "Elyumina",
      "state" : "translated",
      "text" : "[Elyumina]",
      "translation" : "[艾琳米娜]"
    },
    {
      "kind" : "message",
      "line" : 276,
      "npc" : "Elyumina",
      "state" : "translated",
      "text" : "Didn't you come for weapons or armor? Your bag is full. I don't have time to wait for you while you rummage through your bag. Come back later.",
