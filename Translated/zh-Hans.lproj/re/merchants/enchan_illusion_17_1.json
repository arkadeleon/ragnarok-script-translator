      "kind" : "message",
      "line" : 155,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "[Rebellion]",
      "translation" : "[反叛军]"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "Okay, enjoy your conversation.",
      "translation" : "好，聊得愉快。"
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "It took a long time to coax him, but he eventually agreed to modify our weapons and armor. He's pretty good at it, too. He's been working all day, every day.",
      "translation" : "我们花了很长时间才说服他，他最后总算答应帮我们改造武器和防具。他手艺还不错，而且每天都在埋头工作。"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "[Rebellion]",
      "translation" : "[反叛军]"
