    },
    {
      "kind" : "message",
      "line" : 278,
      "npc" : "Elyumina",
      "state" : "translated",
      "text" : " - Your bag is full. Please make some room, and then talk to me again. -",
      "translation" : " - 你的背包满了。请先腾出一些空间，再来找我。 -"
    },
    {
      "kind" : "message",
      "line" : 282,
      "npc" : "Elyumina",
      "state" : "translated",
      "text" : "[Elyumina]",
      "translation" : "[艾琳米娜]"
    },
    {
      "kind" : "message",
      "line" : 283,
      "npc" : "Elyumina",
      "state" : "translated",
      "text" : "What is it so important that you had to interrupt my research? This had better be important.",
      "translation" : "什么事这么重要，非得打断我的研究？最好真有要紧事。"
    },
    {
      "kind" : "option",
      "line" : 286,
