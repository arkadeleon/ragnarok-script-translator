    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "We haven't been this busy for a long time.",
      "translation" : "我们已经很久没有这么忙过了。"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "I don't like that we're working with the President and the company, but it still feels good to be busy with something.",
      "translation" : "我不喜欢和总统以及公司合作，不过能忙起来感觉还不错。"
