    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "[Rebellion]",
      "translation" : "[反叛军]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "Did you bring Damaged Weapons? Would you like to see that science criminal? He's in there. Want me to call him for you?",
      "translation" : "你带来损坏的武器了吗？想见见那个科学罪犯吗？他就在里面。要我帮你叫他吗？"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "Or do you have business with me? I can exchange Weapon Modification Devices and Armor Modification Modules.",
      "translation" : "还是说你有事找我？我可以兑换武器改造装置和防具改造模块。"
    },
    {
      "kind" : "option",
      "line" : 153,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "See Elyumina.",
      "translation" : "找艾琳米娜"
    },
    {
      "kind" : "option",
      "line" : 153,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "Request Weapon Modification Device.",
      "translation" : "兑换武器改造装置"
    },
    {
      "kind" : "option",
      "line" : 153,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "Request Armor Modification Module.",
      "translation" : "兑换防具改造模块"
