    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Welcome to Zonda, where innovation begins. What can I do for you?",
      "translation" : "欢迎来到佐达，创新从这里开始。有什么可以帮你的吗？"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Why are you here?",
      "translation" : "你为什么来这里？"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Enter ^6B9900<Wave Mode - Forest>^000000.",
      "translation" : "进入^6B9900〈波浪模式 - 森林〉^000000。"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Enter ^6B9900<Wave Mode - Sky>^000000.",
      "translation" : "进入^6B9900〈波浪模式 - 天空〉^000000。"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "We now offer a new service. Have you heard about the dimensional rifts?",
      "translation" : "我们现在推出了一项新服务。你听说过次元裂隙吗？"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "In case you haven't, many organizations and scientists study the rifts formed between dimensions.",
      "translation" : "如果你还不知道，许多组织和科学家都在研究维度之间形成的裂隙。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "One of them is my company, Zonda, and after long, painstaking research...",
      "translation" : "其中一家就是我的公司佐达。经过漫长而艰苦的研究..."
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "We've developed two different dimensional rifts that we call Wave Modes - Forest and Sky!",
      "translation" : "我们开发出了两种不同的次元裂隙，称为波浪模式：森林和天空！"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Do you have any questions about Zonda's ambitious new project, Wave Mode?",
      "translation" : "你对佐达这个雄心勃勃的新计划“波浪模式”有什么疑问吗？"
    },
    {
      "kind" : "option",
      "line" : 97,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "About ^6B9900<Wave Mode - Forest>^000000",
      "translation" : "关于^6B9900〈波浪模式 - 森林〉^000000"
    },
    {
      "kind" : "option",
      "line" : 97,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "About ^6B9900<Wave Mode - Sky>^000000",
      "translation" : "关于^6B9900〈波浪模式 - 天空〉^000000"
    },
    {
      "kind" : "option",
      "line" : 97,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "No.",
      "translation" : "没有。"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "The ^6B9900<Wave Mode - Forest>^000000",
      "translation" : "^6B9900〈波浪模式 - 森林〉^000000"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Introducing the first Wave Mode service, Zonda's objective is to work with your party members to keep monster waves from reaching the other side of the bridge.",
      "translation" : "这是佐达推出的首种波浪模式服务。你的队伍需要阻止一波波魔物到达桥的另一端。"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Monsters will advance without fighting, but the party will fail if 20 monsters are let go..",
      "translation" : "魔物会不战而进，但如果放过20只魔物，队伍就会失败..."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "The ^6B9900<Wave Mode - Sky>^000000",
      "translation" : "^6B9900〈波浪模式 - 天空〉^000000"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Available once a day. Like the other Wave Mode, keep the monsters away from reaching the other side of the map.",
      "translation" : "每天可以参加一次。和另一种波浪模式一样，要阻止魔物到达地图另一端。"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Feel free to come back with your party.",
      "translation" : "欢迎和队伍成员一起来参加。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "Thank you for visiting Zonda, where innovation begins.",
      "translation" : "感谢你造访佐达，创新从这里开始。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Zonda Rep",
      "state" : "translated",
      "text" : "[Belka]",
      "translation" : "[贝尔卡]"
