      "state" : "translated",
      "text" : "[Bijou]",
      "translation" : "[碧珠]"
    },
    {
      "kind" : "message",
      "line" : 563,
      "npc" : "Fenrir",
      "state" : "translated",
      "text" : "Yes, I was in the middle of taking care of the annoying bugs.",
      "translation" : "我正在处理这些碍事的小虫子。"
