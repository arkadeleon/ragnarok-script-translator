    {
      "kind" : "message",
      "line" : 799,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "So you're looking for a partner, eh?",
      "translation" : "哦，你是在找同伴啊？"
    },
    {
      "kind" : "message",
      "line" : 800,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Good idea, but...I think it's too late.",
      "translation" : "主意不错，不过...我想已经太迟了。"
    },
    {
      "kind" : "message",
      "line" : 803,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Bijou]",
      "translation" : "[碧珠]"
    },
    {
      "kind" : "message",
      "line" : 804,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Because...",
      "translation" : "因为..."
    },
    {
      "kind" : "message",
      "line" : 805,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "This will be the final, fatal blow to you. Wahahaha!",
      "translation" : "这将是给你们的最后一击，也是致命一击。哇哈哈哈！"
    },
    {
      "kind" : "message",
      "line" : 811,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Bijou]",
      "translation" : "[碧珠]"
    },
    {
      "kind" : "message",
      "line" : 812,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "....~Sighs~",
      "translation" : "...~叹气~"
    },
    {
      "kind" : "message",
      "line" : 813,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Huh?...In my stomach...",
      "translation" : "咦...？我的肚子..."
    },
    {
      "kind" : "message",
      "line" : 814,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "This knife...",
      "translation" : "这把刀..."
    },
    {
      "kind" : "message",
      "line" : 815,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Sa...Sarah...? How?",
      "translation" : "莎...莎拉...？怎么会..."
    },
    {
      "kind" : "message",
      "line" : 819,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 820,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Is that all you want to say?",
      "translation" : "你就只想说这些吗？"
    },
    {
      "kind" : "message",
      "line" : 821,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Don't worry. I'll let Himelmez know of your brave contribution. Don't blame me, Bijou.",
      "translation" : "放心吧，我会把你的英勇表现转告希梅尔兹的。别怪我，碧珠。"
    },
    {
      "kind" : "message",
      "line" : 823,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Bijou]",
      "translation" : "[碧珠]"
    },
    {
      "kind" : "message",
      "line" : 824,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Why...? Tell me why!",
      "translation" : "为什么...？告诉我为什么！"
    },
    {
      "kind" : "message",
      "line" : 825,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "...That...that little chick...Was that it? Because she's your sister? Was that it? Tell me, Sarah!",
      "translation" : "...那个...那个小丫头...是因为她吗？因为她是你的妹妹？是这样吗？告诉我，莎拉！"
    },
    {
      "kind" : "message",
      "line" : 827,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Bijou]",
      "translation" : "[碧珠]"
    },
    {
      "kind" : "message",
      "line" : 828,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "~Groans~",
      "translation" : "~呻吟~"
    },
    {
      "kind" : "message",
      "line" : 832,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 833,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "......",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 834,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Your soul has been set free, Bijou.",
      "translation" : "碧珠，你的灵魂已经得到解脱。"
    },
    {
      "kind" : "message",
      "line" : 837,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Iris]",
      "translation" : "[艾丽丝]"
    },
    {
      "kind" : "message",
      "line" : 838,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "(Did she save me...?)",
      "translation" : "(她救了我...？)"
    },
    {
      "kind" : "message",
      "line" : 840,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Iris]",
      "translation" : "[艾丽丝]"
    },
    {
      "kind" : "message",
      "line" : 841,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Sarah...",
      "translation" : "莎拉..."
    },
    {
      "kind" : "message",
      "line" : 842,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "It's Sarah, right?",
      "translation" : "你叫莎拉，对吧？"
    },
    {
      "kind" : "message",
      "line" : 843,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "People say we parted when we were little...",
      "translation" : "听说我们小时候就分开了..."
    },
    {
      "kind" : "message",
      "line" : 845,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Iris]",
      "translation" : "[艾丽丝]"
    },
    {
      "kind" : "message",
      "line" : 846,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "...So what's your plan, huh? Why...why did you save me?!",
      "translation" : "...那你到底有什么打算？为什么...为什么要救我？！"
    },
    {
      "kind" : "message",
      "line" : 847,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Don't you ever think this will ever change my belief! I will never, ever forgive you!",
      "translation" : "别以为这样就能改变我的信念！我绝不会原谅你！"
    },
    {
      "kind" : "message",
      "line" : 849,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Iris]",
      "translation" : "[艾丽丝]"
    },
    {
      "kind" : "message",
      "line" : 850,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Mom...Dad...Every people in our town. I'm going to revenge!",
      "translation" : "妈妈...爸爸...还有镇上的所有人，我要替他们报仇！"
    },
    {
      "kind" : "message",
      "line" : 853,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 854,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Shut that mouth!",
      "translation" : "闭嘴！"
    },
    {
      "kind" : "message",
      "line" : 855,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Don't be a drama queen as if you're the only victim here.",
      "translation" : "别装得好像只有你是受害者一样。"
    },
    {
      "kind" : "message",
      "line" : 856,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "They just paid the price for what they sinned. The sin that they committed by killing my mother 12 years ago.",
      "translation" : "他们只是为自己的罪付出了代价。他们十二年前杀害我母亲，这就是他们犯下的罪。"
    },
    {
      "kind" : "message",
      "line" : 858,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 859,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Do you want me to tell you the truth? Those 'loved ones' you're incessantly talking about...Our great elder and the people in our town were actually...",
      "translation" : "想听真相吗？你一直挂在嘴边的那些“亲人”...我们的大长老和镇上的人其实..."
    },
    {
      "kind" : "message",
      "line" : 861,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 862,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "......",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 863,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Stop it...",
      "translation" : "别说了..."
    },
    {
      "kind" : "message",
      "line" : 864,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Ymir's Heart comes first, no matter what.",
      "translation" : "无论如何，尤弥尔之心最重要。"
    },
    {
      "kind" : "message",
      "line" : 866,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 867,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Mark my word.",
      "translation" : "记住我的话。"
    },
    {
      "kind" : "message",
      "line" : 868,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "I didn't let you live.",
      "translation" : "我可没打算放过你。"
    },
    {
      "kind" : "message",
      "line" : 869,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "I will let you die soon.",
      "translation" : "我很快就会让你死。"
    },
    {
      "kind" : "message",
      "line" : 870,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "I make sure you no longer see the light of day the next time when we meet.",
      "translation" : "下次见面时，我会让你再也见不到天日。"
    },
    {
      "kind" : "message",
      "line" : 872,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 873,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "Don't you ever let anyone kill you until then, Iris.",
      "translation" : "在那之前，艾丽丝，别让任何人杀了你。"
    },
    {
      "kind" : "message",
      "line" : 874,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "I'd better bid farewell for today, then.",
      "translation" : "那么今天就先告辞了。"
    },
    {
      "kind" : "message",
      "line" : 879,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Fenrir]",
      "translation" : "[芬里尔]"
    },
    {
      "kind" : "message",
      "line" : 880,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "~Grunts~ That Valkyrie destroyed the ceiling when taking Ymir's Heart!",
      "translation" : "~闷哼~那女武神夺走尤弥尔之心时把天花板毁掉了！"
    },
    {
      "kind" : "message",
      "line" : 882,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "[Fenrir]",
      "translation" : "[芬里尔]"
    },
    {
      "kind" : "message",
      "line" : 883,
      "npc" : "Iris",
      "state" : "translated",
      "text" : "We'd better get out of here, too! This place is too dangerous!",
      "translation" : "我们也赶紧离开这里！这里太危险了！"
    }
  ]
}