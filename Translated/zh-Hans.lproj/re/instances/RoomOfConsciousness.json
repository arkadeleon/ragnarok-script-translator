      "state" : "translated",
      "text" : "[Sarah]",
      "translation" : "[莎拉]"
    },
    {
      "kind" : "message",
      "line" : 567,
      "npc" : "Fenrir",
      "state" : "translated",
      "text" : "What kind of answer is that, Bijou?",
