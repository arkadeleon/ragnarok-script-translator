    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : " Guests, welcome to the water garden,",
      "translation" : "客人，欢迎来到水之庭园，"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "Are you going to see Papilla? Papilla's been very sensitive about the intruders lately...",
      "translation" : "你要去见帕皮拉吗？最近帕皮拉对入侵者变得很敏感..."
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "[Hetilla]",
      "translation" : "[赫蒂拉]"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "Papillas are playing around here and there.",
      "translation" : "帕皮拉们正在各处玩耍。"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "They use psychedelic materials from their wings to make short distance movements or use a dangerous magic over them.",
      "translation" : "它们会利用翅膀上的致幻物质进行短距离移动，或对它们施展危险的魔法。"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "[Hetilla]",
      "translation" : "[赫蒂拉]"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "I warned you on advanced, but be careful.",
      "translation" : "我提前提醒过你了，请务必小心。"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "Pruning all overgrown plants and animals opens the door to the next area at 3 o'clock.",
      "translation" : "修剪所有过度生长的植物和动物，就能在三点钟方向打开通往下一区域的门。"
