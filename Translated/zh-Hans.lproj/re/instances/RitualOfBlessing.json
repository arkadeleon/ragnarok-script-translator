    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "[Nyhill]",
      "translation" : "[尼希尔]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "By the way.........",
      "translation" : "对了..."
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "After I left the Banquet Hall",
      "translation" : "我离开宴会厅之后"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "....No, never mind.",
      "translation" : "...不，没什么。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "[Nyhill]",
      "translation" : "[尼希尔]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "Nothing good can be heard if we keep them waiting for any longer. Let's get going.",
      "translation" : "不能再让他们继续等下去了，耽误太久也没好处。我们走吧。"
    },
