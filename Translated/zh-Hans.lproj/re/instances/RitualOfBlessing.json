      "kind" : "message",
      "line" : 28,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "[Skia]",
      "translation" : "[斯基亚]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "^4d4dffThere is a seat left next to Lord Richard. It must be the seat reserved for an observer.^000000",
      "translation" : "^4d4dff理查德公爵旁边还空着一个座位，应该是留给观察员的。^000000"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "[Skia]",
      "translation" : "[斯基亚]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "Well, let's go.",
      "translation" : "那么，我们走吧。"
    },
    {
      "kind" : "message",
      "line" : 498,
      "npc" : "Isenhonor Walther",
      "state" : "translated",
      "text" : "[Isenhonor]",
      "translation" : "[伊森霍诺]"
    },
    {
      "kind" : "message",
      "line" : 499,
      "npc" : "Isenhonor Walther",
      "state" : "translated",
      "text" : "What is going on...",
      "translation" : "这是怎么回事..."
    },
    {
      "kind" : "message",
      "line" : 500,
      "npc" : "Isenhonor Walther",
      "state" : "translated",
      "text" : "We shall leave this place first.",
      "translation" : "我们先离开这里。"
    },
    {
      "kind" : "message",
      "line" : 502,
      "npc" : "Isenhonor Walther",
      "state" : "translated",
      "text" : "[Isenhonor]",
      "translation" : "[伊森霍诺]"
    },
    {
      "kind" : "message",
      "line" : 503,
      "npc" : "Isenhonor Walther",
      "state" : "translated",
      "text" : "Is everyone all right...",
      "translation" : "大家都没事吧..."
    },
    {
      "kind" : "message",
      "line" : 515,
      "npc" : "Helmut Roegenburg",
      "state" : "translated",
      "text" : "[Helmut]",
      "translation" : "[赫尔穆特]"
    },
    {
      "kind" : "message",
      "line" : 516,
      "npc" : "Helmut Roegenburg",
      "state" : "translated",
      "text" : "All seem well.",
      "translation" : "看起来都还好。"
    },
    {
      "kind" : "message",
      "line" : 517,
      "npc" : "Helmut Roegenburg",
      "state" : "translated",
      "text" : "...I shall get going. The brothers don't look so good.",
      "translation" : "...我先走了。兄弟们看起来不太好。"
    },
    {
      "kind" : "message",
      "line" : 531,
      "npc" : "Skia Nerius",
      "state" : "translated",
      "text" : "[Skia]",
      "translation" : "[斯基亚]"
    },
    {
      "kind" : "message",
      "line" : 532,
      "npc" : "Skia Nerius",
      "state" : "translated",
      "text" : "Phew, let's get out of here.",
      "translation" : "呼，快离开这里吧。"
    },
    {
      "kind" : "message",
      "line" : 533,
      "npc" : "Skia Nerius",
      "state" : "translated",
      "text" : "Sis, let's get out!",
      "translation" : "姐姐，我们走吧！"
    },
    {
      "kind" : "message",
      "line" : 534,
      "npc" : "Skia Nerius",
      "state" : "translated",
      "text" : "Nyhill, you should come with us!",
      "translation" : "尼希尔，你也跟我们走！"
    },
    {
      "kind" : "message",
      "line" : 536,
      "npc" : "Skia Nerius",
      "state" : "translated",
      "text" : "[Skia]",
      "translation" : "[斯基亚]"
    },
    {
      "kind" : "message",
      "line" : 537,
      "npc" : "Skia Nerius",
      "state" : "translated",
      "text" : "Other people will get out on their own!",
      "translation" : "其他人会自己离开的！"
    },
    {
      "kind" : "message",
      "line" : 560,
      "npc" : "Friedrich S. Heine",
      "state" : "translated",
      "text" : "[Friedrich]",
      "translation" : "[弗里德里希]"
    },
    {
      "kind" : "message",
      "line" : 561,
      "npc" : "Friedrich S. Heine",
      "state" : "translated",
      "text" : "...There seems to be no one dead.",
      "translation" : "...似乎没人丧命。"
    },
    {
      "kind" : "message",
      "line" : 585,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 586,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Peter is in a critical condition.",
      "translation" : "彼得伤势很重。"
    },
    {
      "kind" : "message",
      "line" : 587,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "...Would you mind fighting against the intruder for us?",
      "translation" : "...能请你替我们对付入侵者吗？"
    },
    {
      "kind" : "message",
      "line" : 591,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 592,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "....",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 593,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : ".... ^4d4dffTerra Gloria^000000 is missing...",
      "translation" : "...^4d4dff泰拉荣耀^000000不见了..."
    },
    {
      "kind" : "option",
      "line" : 595,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Terra Gloria?",
      "translation" : "泰拉荣耀？"
    },
    {
      "kind" : "message",
      "line" : 596,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 597,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "It is the crown passed down in the palace of Rune-Midgarts.",
      "translation" : "这是卢恩米德加尔特王宫世代相传的王冠。"
    },
    {
      "kind" : "message",
      "line" : 598,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "It means more than an ordinary crown.",
      "translation" : "它的意义远不止一顶普通的王冠。"
    },
    {
      "kind" : "message",
      "line" : 600,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 601,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Has it been taken by them?",
      "translation" : "被他们拿走了吗？"
    },
    {
      "kind" : "message",
      "line" : 602,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "What on earth...!",
      "translation" : "这到底是怎么回事...！"
    },
    {
      "kind" : "message",
      "line" : 604,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 605,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "What is hidden here is not known to anyone... Except the seven royal families...!",
      "translation" : "这里藏着什么，除了七大家族之外，没有任何人知道...！"
    },
    {
      "kind" : "message",
      "line" : 607,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 608,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Does it mean...",
      "translation" : "难道说..."
    },
    {
      "kind" : "message",
      "line" : 609,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "...Well, first things first, There are things to find out.",
      "translation" : "...总之，当务之急是先查清一些事情。"
    },
    {
      "kind" : "message",
      "line" : 611,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 612,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Let's get out of here now.",
      "translation" : "我们现在先离开这里。"
    },
    {
      "kind" : "message",
      "line" : 613,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "There is much left for use to find out.",
      "translation" : "还有很多事情等着我们调查。"
    },
    {
      "kind" : "message",
      "line" : 618,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 619,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Whoever left here, clear out with the wounded near you!",
      "translation" : "不管是谁留在这里，都带上身边的伤者撤离！"
    },
    {
      "kind" : "message",
      "line" : 620,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "The Room of Consciousness will be closed for a while!",
      "translation" : "意识之间将暂时关闭！"
    },
    {
      "kind" : "message",
      "line" : 625,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 626,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Peter has been wounded.",
      "translation" : "彼得受伤了。"
    },
    {
      "kind" : "message",
      "line" : 627,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "We need to move him fast.",
      "translation" : "我们得尽快转移他。"
    },
    {
      "kind" : "message",
      "line" : 629,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克罗内克]"
    },
    {
      "kind" : "message",
      "line" : 630,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "I'll see you out there.",
      "translation" : "外面见。"
    },
    {
      "kind" : "message",
      "line" : 631,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "You can leave through the door you have entered.",
      "translation" : "你可以从进来的那扇门离开。"
    },
    {
      "kind" : "message",
      "line" : 632,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Let's meet at the Past Memories of the Royal Family.",
      "translation" : "我们在王室往昔回忆处碰面。"
    },
    {
      "kind" : "message",
      "line" : 641,
      "npc" : "Nyhill M. Heine",
      "state" : "translated",
      "text" : "[Nyhill]",
      "translation" : "[尼希尔]"
    },
    {
      "kind" : "message",
      "line" : 642,
      "npc" : "Nyhill M. Heine",
      "state" : "translated",
      "text" : "...This... Is all... My fault...",
      "translation" : "...这...都是...我的错..."
    },
    {
      "kind" : "message",
