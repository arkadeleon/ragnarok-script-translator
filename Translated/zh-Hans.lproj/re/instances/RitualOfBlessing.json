      "line" : 13,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "I've been wondering when you would arrive.",
      "translation" : "我一直在等你来。"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "[Nyhill]",
      "translation" : "[尼希尔]"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "You are here!",
      "translation" : "你来了！"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Skia",
      "state" : "translated",
      "text" : "The people from other families all have taken their seats.",
      "translation" : "其他家族的人都已经入座了。"
