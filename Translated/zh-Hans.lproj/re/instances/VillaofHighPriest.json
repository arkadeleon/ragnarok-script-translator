{
  "file" : "npc/re/instances/VillaofHighPriest.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亚姆]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "Are you all gathered?",
      "translation" : "人都到齐了吗？"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亚姆]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I think I should check to see if there are other employees and go up to the second floor.",
      "translation" : "我想确认一下还有没有其他员工，然后上二楼看看。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亚姆]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I feel a sharp presence beyond the central stairs.",
      "translation" : "我感觉中央楼梯那边有一股强烈的气息。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "Probably the Heart Hunter who fought in the temple.",
      "translation" : "应该是那个在神殿交过手的心脏猎人。"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亚姆]"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I'm worried about the missing piece of Ymir's heart.",
      "translation" : "我很担心依米尔之心缺失的碎片。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "If it's about inciting trouble, what happened at the temple is enough.",
      "translation" : "如果是想挑起事端，神殿发生的事已经够了。"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亚姆]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "What if my father has other plans...",
      "translation" : "要是父亲还有别的打算..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "If you try to go down the wrong path again, I have to stop him.",
      "translation" : "如果他又想走错路，我就必须阻止他。"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亚姆]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "First, shall we get some information from the villa employees?",
      "translation" : "我们先从别墅员工那里打听些消息，好吗？"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I see a male employee over there.",
      "translation" : "我看到那边有位男员工。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亚姆]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I'll go to that employee.",
      "translation" : "我去找那位员工。"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "Adventurer, please find another employee and ask him about the mansion.",
      "translation" : "冒险者，请再找一名员工，向他打听这座宅邸的情况。"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[别墅员工]"
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "This is my first time meeting you. Who are you?",
      "translation" : "这是我第一次见到你。你是谁？"
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Are you the elder's guest?",
      "translation" : "你是长老的客人吗？"
    },
    {
      "kind" : "option",
      "line" : 223,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Where is Amal?",
      "translation" : "阿玛尔在哪里？"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[别墅员工]"
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Wouldn't he be at the chapel?",
      "translation" : "他不在礼拜堂吗？"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Whenever you come here, please look for the chapel first...",
      "translation" : "你每次来这里，都请先去礼拜堂看看..."
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[别墅员工]"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Yes. He seemed to be a man of faith, so he built a chapel inside the mansion.",
      "translation" : "是的。他似乎很虔诚，所以在宅邸里建了一座礼拜堂。"
    },
    {
      "kind" : "option",
      "line" : 232,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "What about other people?",
      "translation" : "其他人呢？"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[别墅员工]"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Most were suddenly fired.",
      "translation" : "大多数人都突然被解雇了。"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "I also heard someone tell me to leave a little while ago. Is this a sign of mass layoff!?",
      "translation" : "刚才我也听人叫我离开。难道要大规模裁员！？"
    },
    {
      "kind" : "message",
      "line" : 237,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[别墅员工]"
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "The atmosphere was so heavy that I couldn't even ask.",
      "translation" : "气氛太压抑了，我连问都不敢问。"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "The chapel can be reached by going up the central stairs and past the banquet hall.",
      "translation" : "上中央楼梯，穿过宴会厅就能到达礼拜堂。"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Then, go do your business.",
      "translation" : "那么，你去办自己的事吧。"
    },
    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[别墅员工]"
    },
    {
      "kind" : "message",
      "line" : 246,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Sir Amal went to chapel.",
      "translation" : "阿玛尔先生去了礼拜堂。"
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Go up the central stairs, pass the banquet hall, and you will reach the chapel.",
      "translation" : "上中央楼梯，穿过宴会厅，就能到达礼拜堂。"
    },
    {
      "kind" : "message",
      "line" : 253,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "This is the person Miriam decided to investigate. Let's find another one.",
      "translation" : "这是米莉亚姆决定调查的人。我们再找一个吧。"
    },
    {
      "kind" : "message",
      "line" : 456,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "Firmly Locked Door.",
      "translation" : "牢牢锁住的门。"
    },
    {
      "kind" : "message",
      "line" : 457,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "There is a Silver Key hole.",
      "translation" : "上面有一个银钥匙孔。"
    },
    {
      "kind" : "message",
      "line" : 593,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "Firmly Locked Door.",
      "translation" : "牢牢锁住的门。"
    },
    {
      "kind" : "message",
      "line" : 594,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "There is a small key hole.",
      "translation" : "上面有一个小钥匙孔。"
    },
    {
      "kind" : "message",
      "line" : 598,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "I used a spare key.",
      "translation" : "我用了备用钥匙。"
    },
    {
      "kind" : "message",
      "line" : 639,
      "npc" : "Ornate Door",
      "state" : "translated",
      "text" : "The door won't budge.",
      "translation" : "门纹丝不动。"
    },
    {
      "kind" : "message",
      "line" : 640,
      "npc" : "Ornate Door",
      "state" : "translated",
      "text" : "It feels like a strong magical force is blocking the door.",
      "translation" : "感觉有一股强大的魔力挡住了门。"
    },
    {
      "kind" : "message",
      "line" : 732,
      "npc" : "Elegant Door",
      "state" : "translated",
      "text" : "There is a door with an elegant ^4d4dffLily^000000 engraved on it.",
      "translation" : "有一扇门，上面刻着优雅的^4d4dff百合花^000000。"
    },
    {
      "kind" : "message",
      "line" : 733,
      "npc" : "Elegant Door",
      "state" : "translated",
      "text" : "I feel an unknown magical power.",
      "translation" : "我感觉到一股未知的魔力。"
    }
  ]
}