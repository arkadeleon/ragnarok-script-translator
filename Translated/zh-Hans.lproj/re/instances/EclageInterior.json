    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "Oh, what's going on here?",
      "translation" : "哦，这里发生什么事了？"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "They destroyed additional troops that Mayor sent?",
      "translation" : "市长派来的增援也被他们消灭了吗？"
    },
    {
      "kind" : "option",
      "line" : 103,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "What...?",
      "translation" : "什么...？"
    },
    {
      "kind" : "option",
      "line" : 103,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "I fought monsters off!",
      "translation" : "是我击退了魔物！"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "[Shenime]",
      "translation" : "[谢尼梅]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "It doesn't matter.",
      "translation" : "那不重要。"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "Your job ends here.",
      "translation" : "你的工作到此为止。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "Now you became a betrayer.",
      "translation" : "现在你成了叛徒。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "Farewell, then!",
      "translation" : "那么，再见了！"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Shenime",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Shenime",
      "state" : "translated",
      "text" : "No...way!!!",
      "translation" : "不...可能！！！"
    },
    {
      "kind" : "message",
      "line" : 177,
      "state" : "translated",
      "text" : "Upon eliminating the intruders near the Orb, another strange-looking creatures appeared.",
      "translation" : "消灭奥布附近的入侵者后，又出现了一些外形奇怪的生物。"
    },
    {
      "kind" : "message",
      "line" : 179,
      "state" : "translated",
      "text" : "We couldn't communicate with them either, and one of them seemed furious after looking around and finding out that its fellows are defeated.",
      "translation" : "我们也无法和它们沟通。其中一只发现同伴被击败后，似乎愤怒不已。"
    },
    {
      "kind" : "message",
      "line" : 181,
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "state" : "translated",
      "text" : "They look as if they are incarnation of Morocc.",
      "translation" : "它们看起来像是魔王摩洛克的化身。"
    },
    {
      "kind" : "message",
      "line" : 183,
      "state" : "translated",
      "text" : "Is the King of Domons after the Orb?",
      "translation" : "魔王会为了奥布而来吗？"
    },
    {
      "kind" : "message",
      "line" : 184,
      "state" : "translated",
      "text" : "Or is it just a coincidence?",
      "translation" : "还是说这只是巧合？"
    },
    {
      "kind" : "message",
      "line" : 186,
      "state" : "translated",
      "text" : "[Subordinate of the King of Demons]",
      "translation" : "[魔王的部下]"
    },
    {
      "kind" : "message",
      "line" : 187,
      "state" : "translated",
      "text" : "Kyaarr...Keraahhh!!!",
      "translation" : "咿呀...咯啊啊！！！"
    },
    {
      "kind" : "message",
      "line" : 188,
      "state" : "translated",
      "text" : "Kkwaaa!",
      "translation" : "咔啊啊！"
    },
    {
      "kind" : "message",
      "line" : 190,
      "state" : "translated",
      "text" : "A battle cannot be avoided!",
      "translation" : "看来免不了一战！"
    },
    {
      "kind" : "message",
      "line" : 191,
      "state" : "translated",
      "text" : "They will kill me!",
      "translation" : "它们会杀了我的！"
    },
    {
      "kind" : "message",
      "line" : 221,
      "state" : "translated",
      "text" : "An empty room with nothing inside.",
      "translation" : "空荡荡的房间里什么也没有。"
    },
    {
      "kind" : "message",
      "line" : 222,
      "state" : "translated",
      "text" : "a light is coming out of a circular equipment in the middle of the room.",
      "translation" : "房间中央的圆形装置正散发着光芒。"
    },
    {
      "kind" : "message",
      "line" : 224,
      "state" : "translated",
      "text" : "[Suspicious Creature]",
      "translation" : "[可疑生物]"
    },
    {
      "kind" : "message",
      "line" : 225,
      "state" : "translated",
      "text" : "Keheehehehe......",
      "translation" : "咯咯咯咯..."
    },
    {
      "kind" : "message",
      "line" : 227,
      "state" : "translated",
      "text" : "A group of unidentifiable creatures is approaching threateningly.",
      "translation" : "一群无法辨认的生物正气势汹汹地逼近。"
    },
    {
      "kind" : "message",
      "line" : 228,
      "state" : "translated",
      "text" : "They seemed surprised, and although Bifrost's will still holds, it's hard to communicate.",
      "translation" : "它们似乎很惊讶。虽然毕弗罗斯特的意志仍在，但很难和它们沟通。"
    },
    {
      "kind" : "message",
      "line" : 230,
      "state" : "translated",
      "text" : "[Suspicious Creature]",
      "translation" : "[可疑生物]"
    },
    {
      "kind" : "message",
      "line" : 231,
      "state" : "translated",
      "text" : "Kyaarr...Ke...Keryarya!!",
      "translation" : "咿呀...咯...咯呀呀！！"
    },
    {
      "kind" : "message",
      "line" : 233,
      "state" : "translated",
      "text" : "It seems like they are going to start attacking any minute.",
      "translation" : "它们看起来随时都会发动攻击。"
    },
    {
      "kind" : "message",
      "line" : 234,
      "state" : "translated",
      "text" : "We cannot help fighting them!",
      "translation" : "看来只能和它们战斗了！"
    },
    {
      "kind" : "message",
      "line" : 260,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "[Avant]",
      "translation" : "[阿凡特]"
    },
    {
      "kind" : "message",
      "line" : 261,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Hey, look who's here!",
      "translation" : "哎呀，看看这是谁！"
    },
    {
      "kind" : "message",
      "line" : 262,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "You're a friend of my son, right?",
      "translation" : "你是我儿子的朋友吧？"
    },
    {
      "kind" : "message",
      "line" : 263,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "What a strange chance it is that has brought us together here!",
      "translation" : "真没想到我们会在这里相遇！"
    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "[Avant]",
      "translation" : "[阿凡特]"
    },
    {
      "kind" : "message",
      "line" : 267,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Did something happen to you?",
      "translation" : "你怎么了？"
    },
    {
      "kind" : "message",
      "line" : 268,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "There was a subtle and magical echo to it.",
      "translation" : "刚才那声音带着微妙的魔力回响。"
    },
    {
      "kind" : "message",
      "line" : 269,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Immediately after that, you were thrown here.",
      "translation" : "紧接着，你就被扔到这里来了。"
    },
    {
      "kind" : "option",
      "line" : 271,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "It's all because of you!",
      "translation" : "都怪你！"
    },
    {
      "kind" : "option",
      "line" : 271,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Shenime said...",
      "translation" : "谢尼梅说..."
    },
    {
      "kind" : "message",
      "line" : 272,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "[Avant]",
      "translation" : "[阿凡特]"
    },
    {
      "kind" : "message",
      "line" : 273,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "I don't understand a word you're saying.",
      "translation" : "我一句也听不懂。"
    },
    {
      "kind" : "message",
      "line" : 274,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Can't you organize your story? Don't you know 'five W's and one H' rule?",
      "translation" : "你就不能把事情讲清楚吗？不知道“五个W和一个H”的规则吗？"
    },
    {
      "kind" : "message",
      "line" : 277,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "[Avant]",
      "translation" : "[阿凡特]"
    },
    {
      "kind" : "message",
      "line" : 278,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Ooh...so that's what happened.",
      "translation" : "哦...原来如此。"
    },
    {
      "kind" : "message",
      "line" : 279,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "So you're saying that Shenime was after the Orb?",
      "translation" : "所以你是说，谢尼梅在打奥布的主意？"
    },
    {
      "kind" : "message",
      "line" : 281,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "[Avant]",
      "translation" : "[阿凡特]"
    },
    {
      "kind" : "message",
      "line" : 282,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "hehehe...hahahhaha ahahahahha",
      "translation" : "呵呵呵...哈哈哈哈，啊哈哈哈哈"
    },
    {
      "kind" : "message",
      "line" : 283,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Well, well...did he get me, too?",
      "translation" : "哎呀哎呀...他也对我动手了吗？"
    },
    {
      "kind" : "message",
      "line" : 284,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Me, Avant, of all the people?! Hahahaha!",
      "translation" : "居然是我，阿凡特？！哈哈哈哈！"
    },
    {
      "kind" : "option",
      "line" : 287,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "What do you mean?",
      "translation" : "你这是什么意思？"
    },
    {
      "kind" : "message",
      "line" : 288,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "[Avant]",
      "translation" : "[阿凡特]"
    },
    {
      "kind" : "message",
      "line" : 289,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "I was doing a research on the power of the Orb on my own.",
      "translation" : "我一直在独自研究奥布的力量。"
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "But Shenime just urged me persistently.",
      "translation" : "可是谢尼梅总是不断催促我。"
    },
    {
      "kind" : "message",
      "line" : 293,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "[Avant]",
      "translation" : "[阿凡特]"
    },
    {
      "kind" : "message",
      "line" : 294,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "I started from thinking about the beauty of the Orb and went on to wondering what kind of power is accumulated inside the Orb...",
      "translation" : "我先是思考奥布为何如此美丽，接着开始好奇奥布内部积蓄着怎样的力量..."
    },
    {
      "kind" : "message",
      "line" : 295,
      "npc" : "Avant",
      "state" : "translated",
