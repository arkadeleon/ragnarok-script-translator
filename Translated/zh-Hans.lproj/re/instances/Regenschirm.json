    {
      "kind" : "message",
      "line" : 420,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "There's nothing else to see here.",
      "translation" : "这里没有其他值得查看的东西了。"
    },
    {
      "kind" : "message",
