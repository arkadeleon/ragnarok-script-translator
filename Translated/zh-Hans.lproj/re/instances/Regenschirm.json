    {
      "kind" : "message",
      "line" : 405,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 406,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "It's a mercenary contract...",
      "translation" : "这是一份佣兵合同..."
    },
    {
      "kind" : "message",
      "line" : 407,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "There's a rough plan for the day of the raid.",
      "translation" : "这里有一份突袭当天的简要计划。"
    },
    {
      "kind" : "message",
      "line" : 408,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "I can't believe it came to this...",
      "translation" : "真不敢相信事情竟然变成这样..."
    },
    {
      "kind" : "message",
      "line" : 410,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 411,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "This is meant to provoke me.",
      "translation" : "这是故意激怒我的。"
    },
    {
      "kind" : "message",
      "line" : 412,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "It won't work this time. I'll track this to the end.",
      "translation" : "这次不会得逞的。我会追查到底。"
