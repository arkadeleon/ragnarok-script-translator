    {
      "kind" : "message",
      "line" : 414,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 415,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "I'd better take it back to Tess and analyze it.",
      "translation" : "我最好把它带回去交给泰丝分析。"
