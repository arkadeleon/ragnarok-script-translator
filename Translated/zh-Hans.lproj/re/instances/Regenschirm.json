      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 484,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "As confirmed by the security system, nothing is being detected on the inside...",
