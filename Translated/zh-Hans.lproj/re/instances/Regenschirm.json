      "line" : 488,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 489,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "First I'll need to disable the auto-locking mechanism, and then I'll follow right away.",
      "translation" : "我得先解除自动上锁装置，之后马上跟上。"
    },
    {
      "kind" : "message",
