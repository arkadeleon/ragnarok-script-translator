      "line" : 479,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 480,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Please speak to me when you're ready.",
      "translation" : "准备好后跟我说。"
    },
    {
      "kind" : "message",
      "line" : 481,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "I don't know why, but it's tightly closed;. It takes some time to maintain access.",
      "translation" : "不知道为什么，门锁得很紧；需要一些时间才能恢复通行。"
