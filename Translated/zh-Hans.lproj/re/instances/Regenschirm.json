      "npc" : "Goni",
      "state" : "translated",
      "text" : "... ... ...",
      "translation" : "... ... ..."
    },
    {
      "kind" : "message",
      "line" : 509,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 510,
      "npc" : "Est",
      "state" : "translated",
      "text" : "I don't believe there are any enemies left inside, I'm going to pull out.",
      "translation" : "我不认为里面还剩下敌人，我准备撤出。"
    },
    {
      "kind" : "message",
      "line" : 511,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Just check the Central Room and then get out.",
      "translation" : "检查一下中央室，然后就撤出来。"
    },
    {
