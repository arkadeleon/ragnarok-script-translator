{
  "file" : "npc/re/instances/Regenschirm.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Oscar",
      "state" : "translated",
      "text" : "[Oscar]",
      "translation" : "[奥斯卡]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Oscar",
      "state" : "translated",
      "text" : "The captain sneaked in the control panel room.",
      "translation" : "队长偷偷潜入了控制面板室。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Oscar",
      "state" : "translated",
      "text" : "Move quietly.",
      "translation" : "轻声行动。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "The door is normally locked with the security system, so I have to stay there and work with the controller.",
      "translation" : "这扇门平时由安保系统锁住，所以我得留在这里操作控制器。"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "As you can see most of the entrances have been blocked already.",
      "translation" : "如你所见，大部分入口已经封锁了。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Hi",
      "translation" : "喂。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "It will take some time to go through them one by one.",
      "translation" : "逐个检查需要一些时间。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "I'll keep helping you through the intercom.",
      "translation" : "我会通过对讲机继续协助你。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "You'll have to go through the restaurant to reach the hallway.",
      "translation" : "你得穿过餐厅才能到走廊。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Est will be performing the operation alone.",
      "translation" : "艾丝特会独自执行行动。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "If there's a disturbance, Est may have caused it. So please check out with her before continuing.",
      "translation" : "如果发生骚动，可能是艾丝特那边出了状况。继续行动前先去确认她的情况。"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "You should go now adventurer. I'll keep working on securing the security controller.",
      "translation" : "冒险者，你现在出发吧。我会继续设法控制安保系统。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "There may be researchers detained inside.",
      "translation" : "里面可能还有被拘留的研究员。"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Please consider their safety first.",
      "translation" : "请优先确保他们的安全。"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Now go ahead.",
      "translation" : "现在出发吧。"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Researcher",
      "state" : "translated",
      "text" : "The biometric scan is still operational, I'll be staying here to keep the door open.",
      "translation" : "生物识别扫描仍在运作，我会留在这里保持门开着。"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Researcher",
      "state" : "translated",
      "text" : "If you're in a hurry, please go...",
      "translation" : "赶时间的话，请先走..."
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Are you the one who removed the poison gas outside?",
      "translation" : "外面的毒气是你处理的吗？"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Est",
      "state" : "translated",
      "text" : "You arrived at a good time.",
      "translation" : "你来得正是时候。"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Because of the gas, the door was forcibly locked down!",
      "translation" : "因为毒气，门被强制锁上了！"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Est",
      "state" : "translated",
      "text" : "It takes time for Aas to come hack the controller and release the gas.",
      "translation" : "等阿斯过来破解控制器、解除毒气需要时间。"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Est",
      "state" : "translated",
      "text" : "I was going to do it myself.",
      "translation" : "我本来打算自己动手。"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Est",
      "state" : "translated",
      "text" : "The guards here were wearing the same clothes as those Heart Hunters we saw before.",
      "translation" : "这里的守卫穿着和我们之前遇到的心脏猎人一样的制服。"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Est",
      "state" : "translated",
      "text" : "I don't think I can save all the researchers alone.",
      "translation" : "我一个人恐怕救不了所有研究员。"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Est",
      "state" : "translated",
      "text" : "It seems we've gathered most of them here already.",
      "translation" : "看来大部分研究员都已经聚集到这里了。"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Let's organize our next strategy.",
      "translation" : "我们来商量下一步的行动。"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Est",
      "state" : "translated",
      "text" : "There are laboratories on the other side and it's likely to be a mess.",
      "translation" : "另一边还有实验室，里面恐怕一片混乱。"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Est",
      "state" : "translated",
      "text" : "I wonder if there will be a big fight.",
      "translation" : "不知道会不会爆发激战。"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Est",
      "state" : "translated",
      "text" : "From now on the Rebellion Special Forces will prioritize on rescuing the Detained Researchers.",
      "translation" : "接下来，反叛军特种部队会优先营救被拘留的研究员。"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Est",
      "state" : "translated",
      "text" : "If you get it, move quickly!",
      "translation" : "明白的话就快行动！"
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Okay, adventurer, find a communication device and get in contact with Aas.",
      "translation" : "好，冒险者，找到通信设备并联系阿斯。"
    },
    {
      "kind" : "message",
      "line" : 188,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Est",
      "state" : "translated",
      "text" : "You have to open the entrance of the private labs.",
      "translation" : "你得打开私人实验室的入口。"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Huh. We'll focus on rescuing the hostages first.",
      "translation" : "嗯，我们先集中精力营救人质。"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Look for the Security Guard's room that Aas talked about.",
      "translation" : "去找阿斯提到的保安室。"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "Code is inactive.",
      "translation" : "代码已失效。"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "The communication has been terminated.",
      "translation" : "通信已中断。"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "Voice Transmission Connected.",
      "translation" : "语音传输已连接。"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "Code is inactive.",
      "translation" : "代码已失效。"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "The communication has been terminated.",
      "translation" : "通信已中断。"
    },
    {
      "kind" : "message",
      "line" : 248,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 249,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Hey, Did you check all the labs yet?",
      "translation" : "喂，实验室都检查过了吗？"
    },
    {
      "kind" : "message",
      "line" : 250,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Please check if there are still Detained Researchers.",
      "translation" : "请确认是否还有被拘留的研究员。"
    },
    {
      "kind" : "message",
      "line" : 254,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 255,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "The spare Master Key still remains.",
      "translation" : "备用万能钥匙还在。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Without it, I wouldn't have been able to control over the security systems. Are you okay?",
      "translation" : "没有它，我就没法控制安保系统了。你没事吧？"
    },
    {
      "kind" : "message",
      "line" : 258,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 259,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Now you only need to check the Central Room.",
      "translation" : "现在只要检查中央室了。"
    },
    {
      "kind" : "message",
      "line" : 260,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Did you say Heart Hunters?",
      "translation" : "你说心脏猎人？"
    },
    {
      "kind" : "message",
      "line" : 261,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "The traitors from Schlein have already escaped.",
      "translation" : "来自施莱因的叛徒已经逃走了。"
    },
    {
      "kind" : "message",
      "line" : 263,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 264,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "We've got our focus on that room.",
      "translation" : "我们已经把注意力集中到那个房间了。"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "That's the main idea.",
      "translation" : "大致就是这样。"
    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Where is Est?",
      "translation" : "艾丝特在哪里？"
    },
    {
      "kind" : "message",
      "line" : 269,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Goni]",
      "translation" : "[戈尼]"
    },
    {
      "kind" : "message",
      "line" : 270,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "... ... ...",
      "translation" : "... ... ..."
    },
    {
      "kind" : "message",
      "line" : 273,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 274,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "You have to keep looking for all the Researchers?",
      "translation" : "还得继续寻找所有研究员吗？"
    },
    {
      "kind" : "message",
      "line" : 275,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "That's necessary, I understand.",
      "translation" : "这是必要的，我明白了。"
    },
    {
      "kind" : "message",
      "line" : 277,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 278,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Adventurer, we head to the Central Room.",
      "translation" : "冒险者，我们去中央室。"
    },
    {
      "kind" : "message",
      "line" : 279,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Meet me over there.",
      "translation" : "到那边和我会合。"
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 291,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Adventurer, we head to the Central Room.",
      "translation" : "冒险者，我们去中央室。"
    },
    {
      "kind" : "message",
      "line" : 292,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Meet me over there.",
      "translation" : "到那边和我会合。"
    },
    {
      "kind" : "message",
      "line" : 298,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 299,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "My... my search... materials...",
      "translation" : "我的...我的研究...材料..."
    },
    {
      "kind" : "message",
      "line" : 300,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "They took it all!",
      "translation" : "他们全都拿走了！"
    },
    {
      "kind" : "message",
      "line" : 301,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "They took everything!",
      "translation" : "什么都被拿走了！"
    },
    {
      "kind" : "message",
      "line" : 304,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Goni]",
      "translation" : "[戈尼]"
    },
    {
      "kind" : "message",
      "line" : 305,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "... ... ...",
      "translation" : "... ... ..."
    },
    {
      "kind" : "message",
      "line" : 309,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Oh, you're here to protect me?",
      "translation" : "哦，你是来保护我的吗？"
    },
    {
      "kind" : "message",
      "line" : 310,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I'll go with you, thank you!",
      "translation" : "我跟你走，谢谢！"
    },
    {
      "kind" : "message",
      "line" : 312,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 313,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Oh, you're there to protect me?",
      "translation" : "哦，你是来保护我的？"
    },
    {
      "kind" : "message",
      "line" : 314,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I'll go with you, thank you!",
      "translation" : "我跟你走，谢谢！"
    },
    {
      "kind" : "message",
      "line" : 324,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 325,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I thought they kicked out all the crazy guy...",
      "translation" : "我还以为他们把那些疯子全赶走了..."
    },
    {
      "kind" : "message",
      "line" : 326,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I hit the back of my head like this.",
      "translation" : "我就这样撞到了后脑勺。"
    },
    {
      "kind" : "message",
      "line" : 327,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Tsk.",
      "translation" : "啧。"
    },
    {
      "kind" : "message",
      "line" : 329,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 330,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Are you here to save us?",
      "translation" : "你是来救我们的吗？"
    },
    {
      "kind" : "message",
      "line" : 331,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Get me out of here!",
      "translation" : "快带我离开这里！"
    },
    {
      "kind" : "message",
      "line" : 332,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "We couldn't flee because they put poisonous gas outside the doors!",
      "translation" : "门外有毒气，所以我们逃不出去！"
    },
    {
      "kind" : "message",
      "line" : 334,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 335,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Yeah, I know a little bit about the Heart Hunters, I will tell you everything!",
      "translation" : "嗯，我知道一些心脏猎人的事，我会把一切都告诉你！"
    },
    {
      "kind" : "message",
      "line" : 338,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 339,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Ah? Do you have more information to share?",
      "translation" : "啊？你还有其他情报要告诉我吗？"
    },
    {
      "kind" : "message",
      "line" : 340,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Do you want to go outside and talk about it calmly with me?",
      "translation" : "要不要和我一起出去，再慢慢聊？"
    },
    {
      "kind" : "message",
      "line" : 343,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾丝特]"
    },
    {
      "kind" : "message",
      "line" : 344,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I'll take this guy out of here and you look at the other rooms.",
      "translation" : "我带这个人离开这里，你去检查其他房间。"
    },
    {
      "kind" : "message",
      "line" : 355,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 356,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Please help me!",
      "translation" : "请帮帮我！"
    },
    {
      "kind" : "message",
      "line" : 357,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I worked a lot and I'm not getting paid!",
      "translation" : "我干了这么多活，却一分钱都没拿到！"
    },
    {
      "kind" : "message",
      "line" : 359,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 360,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Schlein, where is Schlein?",
      "translation" : "施莱因，施莱因在哪里？"
    },
    {
      "kind" : "message",
      "line" : 361,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "He's a traitor!",
      "translation" : "他是叛徒！"
    },
    {
      "kind" : "message",
      "line" : 362,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I've seen it with my own eyes, he just killed the guards...",
      "translation" : "我亲眼看见他杀了守卫..."
    },
    {
      "kind" : "option",
      "line" : 364,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Calm down.",
      "translation" : "冷静点"
    },
    {
      "kind" : "message",
      "line" : 365,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 366,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Is it safe now?",
      "translation" : "现在安全了吗？"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I'm glad when I was hired at Rekenber, but what the hell is going with such a big company...",
      "translation" : "我当初很高兴能进雷根贝勒工作，可这么大的公司到底怎么了..."
    },
    {
      "kind" : "message",
      "line" : 369,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 370,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Say what? The Rebellions are coming to save us?",
      "translation" : "什么？反叛军要来救我们？"
    },
    {
      "kind" : "message",
      "line" : 371,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Can't I just run away with you instead?",
      "translation" : "我能不能干脆跟你一起逃走？"
    },
    {
      "kind" : "message",
      "line" : 373,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 374,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Oh... you're part of the recon team?",
      "translation" : "哦...你是侦察队的一员？"
    },
    {
      "kind" : "message",
      "line" : 375,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Alright. I'll wait for the rescue team.",
      "translation" : "好吧，我会等救援队来。"
    },
    {
      "kind" : "message",
      "line" : 376,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Many people escaped by breaking the windows and ran away..",
      "translation" : "很多人打破窗户逃走了.."
    },
    {
      "kind" : "message",
      "line" : 378,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 379,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Oh you already know.",
      "translation" : "哦，你已经知道了。"
    },
    {
      "kind" : "message",
      "line" : 380,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Okay. I'll be quiet now and wait.",
      "translation" : "好吧，我会安静地等着。"
    },
    {
      "kind" : "message",
      "line" : 381,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Your uniform is really cool though.",
      "translation" : "不过你的制服真帅。"
    },
    {
      "kind" : "message",
      "line" : 385,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 386,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I know. I know.",
      "translation" : "我知道，我知道。"
    },
    {
      "kind" : "message",
      "line" : 387,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "If I wait here, will the Rebellions come and save me?",
      "translation" : "我待在这里的话，反叛军会来救我吗？"
    },
    {
      "kind" : "message",
      "line" : 388,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I'll be fine then.",
      "translation" : "那我就放心了。"
    },
    {
      "kind" : "message",
      "line" : 390,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究员]"
    },
    {
      "kind" : "message",
      "line" : 391,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "But again, your uniform is really cool.",
      "translation" : "话说回来，你的制服真的很帅。"
    },
    {
      "kind" : "message",
      "line" : 397,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "This is the list of the Enterprise security teams.",
      "translation" : "这是企业的安保队伍名单。"
    },
    {
      "kind" : "message",
      "line" : 398,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "Some have circles around them... others are crossed out.",
      "translation" : "有些名字被圈了起来...其他的则被划掉了。"
    },
    {
      "kind" : "message",
      "line" : 401,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 402,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "The ones circled are probably those who accepted to be recruited...",
      "translation" : "被圈起来的应该是接受招募的人..."
    },
    {
      "kind" : "message",
      "line" : 403,
      "npc" : "Scattered Documents",
      "state" : "translated",
      "text" : "My team is the one with a X marked next to it.",
      "translation" : "我所在的队伍旁边标了个叉。"
