{
  "file" : "npc/re/instances/HorrorToyFactory.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 14,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Aaa.. Are you going to go into there?",
      "translation" : "啊...你要进去吗？"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "You'd better release your transformation if you'd like to enter. It could be dangerous in some ways.",
      "translation" : "想进去的话，最好先解除变身。变身状态可能会带来危险。"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Catherine Jet Johnson",
      "placeholders" : [
        "( Sex ? \"man\" : \"woman\" )"
      ],
      "state" : "translated",
      "text" : "Ah, wait! Please wait. This is not a good place for a promising young {0} like you!",
      "translation" : "啊，等等！请等一下。这种地方不适合你这样前途无量的{0}！"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "If you must, come back later after you become far stronger. Hmmm.. I would say.. Lv.140?",
      "translation" : "如果你执意要去，等变得更强之后再来吧。嗯...我觉得至少要140级？"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^ff0000Be cautious taming or other ways than hunting monsters are not considered as normal killing counts.^000000",
      "translation" : "^ff0000请注意，驯服怪物或其他非狩猎方式不计入正常击杀数。^000000"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Do.. Don't be afraid of me. Now I look ugly, but I wasn't like this before.",
      "translation" : "别...别怕我。我现在看起来很丑，但以前不是这样的。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffThe skull-faced girl in front of you is speaking in a tearful voice. Void holes where there should be eyes are staring at you.^000000",
      "translation" : "^0000ff眼前这位骷髅脸少女含泪说着话。她眼睛的位置空洞洞的，正凝视着你。^000000"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "What's wrong with your face?",
      "translation" : "你的脸怎么了？"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "This is a long story.. Would you mind if I talk to you? If you waste your time on someone like me?",
      "translation" : "说来话长...你愿意听我说吗？会不会觉得把时间花在我这种人身上很浪费？"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Quit.",
      "translation" : "离开。"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Please keep talking.",
      "translation" : "请继续说。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Okay, take care of yourself. And don't ever come near that odd entrance.",
      "translation" : "好吧，保重。千万别靠近那个奇怪的入口。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Mmm.. Where should I start.. The story of this town first?...",
      "translation" : "嗯...该从哪里说起呢...先讲讲这个镇子的故事吧？"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffWith a sigh, the girl begins to speak in a subdued tone like a bard who tells an old story.^000000",
      "translation" : "^0000ff少女叹了口气，压低声音，像吟游诗人讲述古老传说一样开始说起往事。^000000"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "There was a toy factory in this town. All of the people in this town work there and I was one of the employees.",
      "translation" : "这个镇上曾有一座玩具工厂。镇上的人都在那里工作，我也是其中一员。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "We all were happy in the beginning. We used to gather around together and have a friendly chat having gingerbread and hot tea after work.",
      "translation" : "一开始大家都很快乐。下班后，我们常聚在一起，边吃姜饼、喝热茶，边愉快地聊天。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I couldn't even imagine, seeing this mood...",
      "translation" : "看到现在这副景象，我简直不敢想象..."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Yes, because we couldn't earn a living by packaging toys forever. The situations got tough after the villagers left in ones and twos.",
      "translation" : "是啊，我们不可能永远靠包装玩具谋生。村民陆陆续续离开后，日子就越来越难了。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I was the one who worked as an assistant beside the doll craftsman who made dolls to the end.",
      "translation" : "我是一直陪在玩偶工匠身边、协助他制作玩偶的人。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffI could feel her slender jawbone is trembling due to the subtle change of her emotion.^000000",
      "translation" : "^0000ff她的情绪微微变化，我能感觉到她纤细的下颌骨在颤抖。^000000"
    },
    {
      "kind" : "option",
      "line" : 68,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Ask her to continue.",
      "translation" : "请她继续说。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "On the day when the factory is decided to be closed, the doll maker dressed the last doll he made and shed tears.",
      "translation" : "工厂决定关闭那天，玩偶工匠为自己制作的最后一个玩偶穿好衣服，流下了眼泪。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Perhaps he thought he wouldn't make dolls anymore.",
      "translation" : "也许他觉得自己再也不会制作玩偶了。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "He named the last doll ^0000ffCeline Kimi^000000 and stopped all the lines in the factory.",
      "translation" : "他给最后一个玩偶取名为^0000ff塞琳·琪米^000000，随后关停了工厂的所有生产线。"
    },
    {
      "kind" : "option",
      "line" : 78,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Did he give a doll a name?",
      "translation" : "他给玩偶取了名字？"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Sometimes so much work goes into a doll as if it were their child to doll makers. Kimi was the one for him.",
      "translation" : "对玩偶工匠来说，制作玩偶时常倾注许多心血，就像在制作自己的孩子。琪米就是他的孩子。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I guess his earnestness breathed life to Kimi.",
      "translation" : "我想，是他的真心赋予了琪米生命。"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Do you mean the doll is alive?",
      "translation" : "你是说那个玩偶活过来了？"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Yes, ^0000ffShe^000000 became a living creature. I don't know how, but she is striding in the toy factory with heavy sorrow and rage.",
      "translation" : "是的，^0000ff她^000000变成了活生生的生命。我不知道这是怎么发生的，但她如今带着深深的悲伤与愤怒，在玩具工厂里徘徊。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "When I first saw her, she was standing beside the doll maker who died and collapsed. She stood there with a bare expression.",
      "translation" : "我第一次看到她时，她站在已经倒下身亡的玩偶工匠身边，脸上毫无表情。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "That's the end. I was outside when I woke up again after I had blacked out. My face has become like this.",
      "translation" : "故事就是这样。我昏过去后醒来时，发现自己已经在外面，脸也变成了这副模样。"
    },
    {
      "kind" : "option",
      "line" : 95,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Did Kimi do that?",
      "translation" : "是琪米做的吗？"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I don't know.. She would do it, or it could be a different problem. I have no memory of it.",
      "translation" : "我不知道...可能是她做的，也可能另有原因。我完全不记得发生了什么。"
    },
    {
      "kind" : "option",
      "line" : 99,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Do you blame her?",
      "translation" : "你怪她吗？"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Ah, no. I don't blame her! I just want to know what happened to the doll craftsman on that day.",
      "translation" : "啊，不，我不怪她！我只是想知道那天玩偶工匠身上发生了什么。"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I don't think the scene I saw was everything. However, getting into the factory again is.. Re-entering there is...",
      "translation" : "我觉得自己看到的并非全部真相。不过，再次进入工厂...要重新进去的话..."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Yes, I am scared and reluctant to do it. If there's someone who can help me..",
      "translation" : "是的，我既害怕又不情愿。如果有人能帮我..."
    },
    {
      "kind" : "option",
      "line" : 109,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I am not very helpful to you.",
      "translation" : "我帮不了你什么。"
    },
    {
      "kind" : "option",
      "line" : 109,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Maybe I can help you with it.",
      "translation" : "也许我能帮你。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Thank you for.. for listening to me. Hope you will enjoy your trip..",
      "translation" : "谢...谢谢你愿意听我说。祝你旅途愉快..."
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Heh? You would do me a favor?",
      "translation" : "咦？你愿意帮我？"
    },
    {
      "kind" : "option",
      "line" : 117,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Let's get into the factory.",
      "translation" : "我们进工厂吧。"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "We.. Well, I cannot help you at all except for providing you with directions. Besides, this can be very dangerous to you.",
      "translation" : "我...嗯，除了告诉你路线，我帮不上别的忙。而且那里对你来说很危险。"
    },
    {
      "kind" : "option",
      "line" : 121,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "You can reunite with Kimi, can't you?",
      "translation" : "你可以再见到琪米，对吧？"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Kimi, you mean Kimi..",
      "translation" : "琪米...你是说琪米吗..."
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffShe is thinking about something intently with gaping eyes.^000000",
      "translation" : "^0000ff她睁大双眼，专注地思索着什么。^000000"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凯瑟琳·杰特·约翰逊]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I.. I've decided. It won't be a great help to you, but I can simply let you know the directions.",
      "translation" : "我...我决定了。虽然帮不上你太多忙，但我可以告诉你路线。"
    },
    {
      "kind" : "message",
      "line" : 130,
