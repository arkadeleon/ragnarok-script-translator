    {
      "kind" : "message",
      "line" : 523,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 524,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "AWW... I almost brought him out.",
      "translation" : "啊...差一点就把它引出来了。"
