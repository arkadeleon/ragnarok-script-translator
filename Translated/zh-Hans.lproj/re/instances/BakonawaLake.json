      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Civilians cannot enter.",
      "translation" : "平民不能进入。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "The rope used for getting to the Lake is already broken. We are now cleaning up the surroundings so come back after some time.",
      "translation" : "通往湖边的绳子已经断了。我们正在清理周围，请过一段时间再来。"
