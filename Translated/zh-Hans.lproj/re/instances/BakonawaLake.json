    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "The rope hasn't been weaved yet. Wait a little.",
      "translation" : "绳子还没编好。请稍等。"
