    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "It's all cleaned up around here. Now you can go down again after getting a rope.",
      "translation" : "周围已经清理干净了。拿到绳子后就可以再次下去了。"
    },
    {
      "kind" : "message",
