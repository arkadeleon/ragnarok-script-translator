    {
      "kind" : "message",
      "line" : 527,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 528,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Then I will use Albopal once again to the lake.",
      "translation" : "那么我再往湖里滴一次阿尔波帕尔。"
    },
    {
      "kind" : "message",
      "line" : 530,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 531,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "We are about to see Bakonawa with intenser anger...",
      "translation" : "马上就能看到更加愤怒的巴科纳瓦了..."
    },
    {
      "kind" : "message",
      "line" : 538,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 539,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "I am dropping Albopal like I did a while ago. I hope it pisses him off...",
      "translation" : "我像刚才那样滴下阿尔波帕尔。希望这能把它惹火..."
