    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "[Hugin]",
      "translation" : "[休金]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "After the time gap opens, please tell me again.",
