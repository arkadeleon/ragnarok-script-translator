      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "...",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I'm afraid you're not up for this yet.",
      "translation" : "恐怕你还不够资格。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "You have to be at least Level 160.",
      "translation" : "你的等级必须至少达到160级。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "...Where am I?",
      "translation" : "...我在哪里？"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I don't know when it began...",
      "translation" : "我不知道这是从什么时候开始的..."
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "The same nightmare has been plaguing me for a long time.",
      "translation" : "同一个噩梦已经折磨我很久了。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "In my nightmare, Demon King Morocc awakens from his century-long slumber and fills the world with darkness and horror.",
      "translation" : "在我的噩梦里，魔王梦罗克从沉睡百年的长眠中醒来，让整个世界陷入黑暗与恐惧。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I couldn't shake off the vivid images I saw in that nightmare. I've wandered off and around like a madman and finally arrived here.",
      "translation" : "那个噩梦中的景象如此真实，我无法忘怀。我像疯子一样四处游荡，最后来到了这里。"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I saw this place in my dream. It's where Demon God Morocc awakens from his slumber. My dream was showing me a possible future.",
      "translation" : "我在梦里见过这里。魔神梦罗克将在此处从沉睡中苏醒。我的梦预示着一种可能的未来。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "If my dream really is a premonition, the forces of Demon God Morocc's are within that yellow seed.",
      "translation" : "如果我的梦真的是预兆，那么魔神梦罗克的力量就在那颗黄色种子里。"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I tried to enter the seed, but to no avail: I'm just too old and weak. But perhaps you can.",
      "translation" : "我试过进入那颗种子，但没能成功：我实在太老也太虚弱了。不过你或许可以做到。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "Please investigate that yellow seed.",
      "translation" : "请调查那颗黄色种子。"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "It's too dangerous for you to go alone. You should take at least one comrade with you.",
      "translation" : "你独自前往太危险了，至少带一位同伴一起去。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "Please investigate that yellow seed.",
      "translation" : "请调查那颗黄色种子。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "It's too dangerous for you to go alone. You should take at least one comrade with you.",
      "translation" : "你独自前往太危险了，至少带一位同伴一起去。"
    },
    {
      "kind" : "message",
      "line" : 351,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "[Vrid]",
      "translation" : "[弗里德]"
    },
    {
      "kind" : "message",
      "line" : 352,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "I came by",
      "translation" : "我偶然间"
    },
    {
      "kind" : "message",
      "line" : 353,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "this Hero Token by accident.",
      "translation" : "得到了这枚英雄徽章。"
    },
    {
      "kind" : "message",
      "line" : 354,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "I want to give it to you. You deserve it.",
      "translation" : "我想把它送给你。这是你应得的。"
    },
    {
      "kind" : "message",
      "line" : 356,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "[Vrid]",
      "translation" : "[弗里德]"
    },
    {
      "kind" : "message",
      "line" : 357,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "Let's get out of this creepy place!",
      "translation" : "我们快离开这个阴森的地方吧！"
    }
  ]
