      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Unfortunate.",
      "translation" : "很遗憾。"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "You are an adventurer. Tell me what you decide to do.",
      "translation" : "你是冒险者。告诉我你的决定吧。"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "How can I assist you?",
      "translation" : "我能为你做什么？"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "What do you want to do this time?",
      "translation" : "这次你想做什么？"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Please talk to me after composing a party of 1 or more, or after joining a party.",
