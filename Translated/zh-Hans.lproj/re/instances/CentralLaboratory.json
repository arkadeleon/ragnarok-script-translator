    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Well... I don't know if you can come in handy, it seems that there is still a gap!",
      "translation" : "嗯...我不确定你能不能帮上忙，看来还差一点条件！"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "When you become stronger, come back to me. You should be almost level 135!",
      "translation" : "等你变强一些再来找我。你的等级应该快到135级了！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "^ff0000Taming monsters will impede progress in this dungeon. Please take note of this.^000000",
      "translation" : "^ff0000在这个地下城驯服怪物会妨碍探索进度，请注意。^000000"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "There are a lot of interesting things about the ancient civilizations in this area.",
      "translation" : "这个地区的古代文明有很多有趣之处。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Observing the soil strata it is estimated to be 500 to 600 years old!",
      "translation" : "根据土层观察结果，这里大约有500到600年历史！"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "But many of the excavated objects here already far surpass our current technology.",
      "translation" : "不过，这里挖掘出的许多物品都远远超出了我们现有的科技水平。"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "A lot of undefined terms are found in the recovered records as well.",
      "translation" : "在出土记录中还发现了许多含义不明的词语。"
    },
    {
      "kind" : "option",
      "line" : 71,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "What kind of unknown terms?",
      "translation" : "什么样的未知词语？"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "^0000ffMother Computer^000000 or, ^0000ff LSI Chip^000000 Or, and what else. ^0000ffChicken^000000?",
      "translation" : "^0000ff母型电脑^000000、^0000ffLSI芯片^000000，还有什么来着？^0000ff鸡^000000？"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Mm that's right. There definitely was the word Chicken. I don't know what kind of combination of technology that may be...",
      "translation" : "嗯，没错。记录里确实有“鸡”这个词。我不知道那会是怎样的科技组合..."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "It is referrenced in the records of people who seem to 'root' amongst the many traces of technology.",
      "translation" : "记录中提到了那些似乎在众多科技遗迹中“扎根”的人。"
    },
    {
      "kind" : "option",
      "line" : 81,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "It is not a topic I would be interested in.",
      "translation" : "这不是我感兴趣的话题。"
    },
    {
      "kind" : "option",
      "line" : 81,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Interesting. Have there been any results?",
      "translation" : "真有意思，有什么研究成果吗？"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Unfortunate.",
      "translation" : "很遗憾。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "My aim is to research the use of technology related to the relevant times. Even though what I have found out so far is insignificant.",
      "translation" : "我的目标是研究与那个时代相关的科技用途。虽然到目前为止，研究成果还微不足道。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "If I had it my way I would use the dimension mover to see for myself but there's too much work. Besides I am not an adventurer...",
      "translation" : "如果可以，我真想用次元移动装置亲自去看看，可是工作太多了。而且我又不是冒险者..."
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "By any chance, would you interested in traveling to the past?",
      "translation" : "你有没有兴趣去一趟过去？"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Even better if you show me around if you find an interesting object.",
      "translation" : "如果你发现有趣的物品，也带我去看看就更好了。"
    },
    {
      "kind" : "option",
      "line" : 98,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Not interested.",
      "translation" : "没兴趣。"
