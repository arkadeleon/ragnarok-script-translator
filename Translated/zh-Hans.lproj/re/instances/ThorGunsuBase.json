    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "You've arrived, adventurer!",
      "translation" : "冒险者，你终于到了！"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "Thank you for coming all the way here.",
      "translation" : "谢谢你远道而来。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "[Maram]",
      "translation" : "[玛拉姆]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "It seems like this is the real deal after all. The security here is different from what it has been so far....",
      "translation" : "看来这次确实是来真的了。这里的警戒和之前完全不同..."
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "Let's be careful not to be caught by the guards and explore the inside.",
      "translation" : "我们小心点，别被守卫发现，进去探索吧。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "[Maram]",
      "translation" : "[玛拉姆]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "Try to move away from the security guard's line of sight as much as possible.",
      "translation" : "尽量避开守卫的视线。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "If you get caught, you might be attacked, so if you can't break through, we'll meet again here.",
      "translation" : "要是被发现，他们可能会攻击你。如果无法突破，就回到这里和我会合。"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "[Maram]",
      "translation" : "[玛拉姆]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Maram",
      "state" : "translated",
      "text" : "Let's try to go in while avoiding the guard tower as much as possible.",
      "translation" : "尽量避开警戒塔再进去。"
    },
    {
