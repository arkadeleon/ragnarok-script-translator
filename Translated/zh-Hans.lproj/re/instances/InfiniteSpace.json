      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "[ Reckless Explorer ]",
      "translation" : "[鲁莽的探险家]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "Are you going in there again this time?",
      "translation" : "这次还要进去吗？"
