      "kind" : "message",
      "line" : 49,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "[ Reckless Explorer ]",
      "translation" : "[鲁莽的探险家]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "Some of the restoration workers and guards that were sent to the palace went missing. Rumors has it that monsters are crawling down there.",
      "translation" : "派去王宫的部分修复工人和守卫失踪了。传闻有魔物在下面爬行。"
