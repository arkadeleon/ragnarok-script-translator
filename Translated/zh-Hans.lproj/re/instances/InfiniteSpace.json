      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "[ Reckless Explorer ]",
      "translation" : "[鲁莽的探险家]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "Because its depth is seemingly endless, the people here became afraid of this place and started calling it Infinite Space.",
      "translation" : "这里深不见底，当地人因此害怕这个地方，开始称它为“无限空间”。"
