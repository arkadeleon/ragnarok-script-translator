      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "I'm not interested.",
      "translation" : "没兴趣。"
    },
    {
      "kind" : "option",
      "line" : 58,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "Yes.",
      "translation" : "有。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "[ Reckless Explorer ]",
      "translation" : "[鲁莽的探险家]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "That's unfortunate. Come back whenever you change your mind. I'll welcome you anytime.",
      "translation" : "真遗憾。改变主意的话随时回来，我随时欢迎你。"
    },
    {
      "kind" : "message",
