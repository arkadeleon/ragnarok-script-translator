      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "[ Reckless Explorer ]",
      "translation" : "[鲁莽的探险家]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Reckless Explorer",
      "state" : "translated",
      "text" : "I know some people who sneaked in and made a fortune. That's why I'm going to give it a try, are you interested?",
      "translation" : "我认识一些偷偷进去发了财的人。所以我也打算试试，你有兴趣吗？"
    },
