{
  "file" : "npc/merchants/enchan_arm.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "I've been studying ways to enhance an armor to maximize its capability.",
      "translation" : "我一直在研究如何强化防具，充分发挥它的性能。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Enchanting is an awesome skill that infuses a mysterious status powers into the armor's hidden socket.",
      "translation" : "附魔是一种强大的技巧，可以将神秘的状态能力注入防具隐藏的插槽。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "However, you have to keep in mind that if there are two armors of the same kind in your possession, the Enchantment will be applied in the order they are placed in your inventory.",
      "translation" : "不过请记住，如果你带着两件相同类型的防具，附魔会按照它们在背包中的排列顺序依次进行。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "In that case, the Enchantment may be applied to an item which you didn't mean to Enchant. So just bring ^5555ffONE Armor^000000 you want enchanted to be safe...",
      "translation" : "这样一来，可能会把你不想附魔的装备附魔。所以为了保险，请只带来^5555ff一件想要附魔的防具^000000..."
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "I'm not responsible for what would happen if you have more than one of the same kind in your inventory.",
      "translation" : "如果你的背包里有多件同类型防具，之后发生什么我概不负责。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Non Slotted Armor.",
      "translation" : "无插槽防具。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Slotted Armor.",
      "translation" : "有插槽防具。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "High Grade Armor.",
      "translation" : "高级防具。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Maybe next time.",
      "translation" : "下次再说。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Please come back when you have any interest in enchanting your armor.",
      "translation" : "等你想给防具附魔时再来吧。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "I am in charge of Enchanting Armors. Simply put, I've been studying ways to power-up armor.",
      "translation" : "我负责防具附魔。简单来说，我一直在研究如何强化防具。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "If by any chance, you would want to enchant your armor, bring me 400,000 zeny and the armor you want to enchant and you are all set to go.",
      "translation" : "如果你想给防具附魔，只要带来400,000 Zeny和要附魔的防具就可以了。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Socket enchant will cost you 400,000 zeny. And there will be a random option enchanted. Of course, there is a chance of breaking your armor.",
      "translation" : "插槽附魔需要400,000 Zeny，并会随机附加一种属性。当然，防具有可能会损坏。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "First and most importantly.",
      "translation" : "首先，最重要的是："
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "^ff5555Existing Refine Level of the Armor",
      "translation" : "^ff5555防具现有的精炼等级"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "and Cards will be GONE.^000000",
      "translation" : "以及卡片都会消失。^000000"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Do you still want to try an Enchant?",
      "translation" : "你还想尝试附魔吗？"
    },
    {
      "kind" : "option",
      "line" : 82,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Hmm... Let me think it over.",
      "translation" : "嗯...让我考虑一下。"
    },
    {
      "kind" : "option",
      "line" : 82,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Go ahead.",
      "translation" : "开始吧。"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Well, I can't blame you. Safety first, eh?",
      "translation" : "我能理解。安全第一，对吧？"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Now you have a nice day.",
      "translation" : "祝你今天愉快。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Quite of an adventurer huh? Well, shall we?",
      "translation" : "真是位大胆的冒险者啊。那么，开始吧？"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Sorry, but you don't have enough zeny.",
      "translation" : "抱歉，你的 Zeny 不够。"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "[Apprentice Craftsman]",
      "translation" : "[学徒工匠]"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Well that's too bad.",
      "translation" : "真遗憾。"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "The requested equipment has failed to enchant.",
      "translation" : "所选装备附魔失败了。"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Hmm? There's nothing to be enchanted!",
      "translation" : "嗯？没有装备可以附魔！"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Apprentice Craftsman",
      "state" : "translated",
      "text" : "Please come back with just ONE equipment to be enchanted.",
      "translation" : "请只带一件要附魔的装备再来。"
    }
  ]
}