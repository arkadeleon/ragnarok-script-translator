      "text" : "...",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : ".....",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : ".......Huhuhuhuhu~",
      "translation" : "...呵呵呵呵~"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "........It was your choice and my ability, no regret.",
      "translation" : "...这是你的选择，也是我的本事，别后悔。"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Suhnbi",
      "placeholders" : [
        ".@equip_lv"
      ],
      "state" : "translated",
      "text" : "You want to refine a level {0} weapon?",
      "translation" : "你想精炼一件等级{0}的武器吗？"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Suhnbi",
      "placeholders" : [
        "getitemname(.@item_req)",
        ".@price"
      ],
      "state" : "translated",
      "text" : "To refine that, you'll need to have one ^ff9999{0}^000000 and {1} zeny.",
      "translation" : "精炼它需要一件^ff9999{0}^000000和{1}金币。"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Would you like to continue?",
      "translation" : "要继续吗？"
    },
    {
      "kind" : "option",
      "line" : 147,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 147,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Wow!!",
      "translation" : "哇！！"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "This weapon probably",
      "translation" : "这把武器看起来"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "looks like it's been refined...",
      "translation" : "已经精炼过..."
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "many times...",
      "translation" : "很多次了..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "It may break if",
      "translation" : "再精炼一次"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "you refine it again.",
      "translation" : "可能会损坏。"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "And if it breaks,",
      "translation" : "一旦损坏，"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "you can't use it anymore!",
      "translation" : "就再也不能使用了！"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "All the cards in it and the properties ^ff0000will be lost^000000!",
      "translation" : "里面的卡片和属性^ff0000都会消失^000000！"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "^ff0000Besides, the equipment will break!^000000",
      "translation" : "^ff0000而且，装备本身也会损坏！^000000"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Are you sure you still want to continue?",
      "translation" : "确定还要继续吗？"
    },
    {
      "kind" : "option",
      "line" : 164,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 164,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Good.",
      "translation" : "好吧。"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Because if the weapon breaks from unreasonable refining, then I get a bad mood, too.",
      "translation" : "如果武器因为胡乱精炼而损坏，我的心情也会变差。"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Giggle. Giggle. Oh, you have guts, daring to refine this.",
      "translation" : "嘻嘻。你还真有胆量，竟敢精炼这件装备。"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "You know it's pretty risky, don't you?",
      "translation" : "你知道这很危险吧？"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "If your defensive equipment is broken, you'll never be able to use it again.",
      "translation" : "防具一旦损坏，就再也不能使用了。"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Even your cards and your modifications will ^ff0000completely disappear^000000.",
      "translation" : "连卡片和改造效果也会^ff0000全部消失^000000。"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Do you really wish to continue?",
      "translation" : "你真的要继续吗？"
    },
    {
      "kind" : "option",
      "line" : 180,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 180,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "What nonsense. You waste my precious time.",
      "translation" : "胡说什么。别浪费我的宝贵时间。"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Get lost, punk.",
      "translation" : "滚开，小子。"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Wait a second...",
      "translation" : "等一下..."
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Do you think I'm stupid?!",
      "translation" : "你以为我傻吗？！"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "You switched the item while I wasn't looking! Get out of here!",
      "translation" : "趁我不注意时换了物品！快滚！"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Are these all you have?",
      "translation" : "这些就是你带来的全部材料吗？"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "I'm very sorry, but I can't do anything without all the materials. Besides, I deserve some payments for my work, don't I?",
      "translation" : "很抱歉，没有全部材料我就没法帮你。而且我的手工也该收点报酬吧？"
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "I can't help it even if you're not happy about it...",
      "translation" : "就算你不高兴，我也没办法..."
    }
  ]
}