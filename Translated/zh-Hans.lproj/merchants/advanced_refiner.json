    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "I am the Armsmith",
      "translation" : "我是武器匠，"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "I can refine all kinds of weapons,",
      "translation" : "各种武器、"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "armor and equipment, so let me",
      "translation" : "防具和装备我都能精炼。想精炼什么，"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "know what you want to refine.",
      "translation" : "告诉我吧。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "I don't think I can refine any items you have...",
      "translation" : "我想我没法精炼你带来的任何物品..."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Go find another Blacksmith. You can't refine this thing.",
      "translation" : "去找别的铁匠吧。这东西我精炼不了。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Hmm... someone perfected this already. I don't think I can work on it further.",
      "translation" : "嗯...这件装备已经精炼到极限了。我想我没法再处理了。"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Clang! Clang! Clang!",
      "translation" : "铿！铿！铿！"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "There you go! It's done.",
      "translation" : "好了！完成了。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Suhnbi",
      "placeholders" : [
        "((.@itemtype == IT_WEAPON)?\"weapon\":\"armor\")"
      ],
      "state" : "translated",
      "text" : "It's been a while since I've made such a fine {0}. You must be happy because it has become stronger!",
      "translation" : "我好久没做出这么好的{0}了。它变强了，你一定很高兴吧！"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Uuuuuuuuuummmmmph!!!",
      "translation" : "呜呜呜呜呜呜呜呜呜！！！"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[顺比]"
    },
    {
      "kind" : "message",
