    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "That's an admirable attitude for an adventurer such as yourself. Honor comes when you abandon all personal desires for the sake of mankind.",
