      "npc" : "Metheus Sylphe",
      "state" : "translated",
      "text" : "[Metheus Sylphe]",
      "translation" : "[梅修斯·希尔弗]"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Metheus Sylphe",
      "state" : "translated",
      "text" : "Welcome to the Library of the Schweicherbil Magic Academy.",
      "translation" : "欢迎来到施威彻勒比尔魔法学院图书馆。"
    },
    {
