    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "I wish that the release the goddess Urd has granted you proves to be a blessing. I hope that the memories Verdandi has recorded will always honor you.",
