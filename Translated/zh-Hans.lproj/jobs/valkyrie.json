      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "[Valkyrie]",
      "translation" : "[女武神]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "And I pray that the new life to which the goddess Skuld will guide you will be even more honorable than your last.",
