{
  "file" : "npc/pre-re/merchants/hair_dyer.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Welcome~!",
      "translation" : "欢迎光临~！"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "How may I help you?",
      "translation" : "有什么可以帮你的吗？"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Oh, no! Your hair is damaged. It seems as if you may need professional treatment. Come sit over here, please. Come.",
      "translation" : "哎呀！你的头发受损了。看来需要专业护理。请坐到这边来，来嘛。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Eh!? Oh my! Oh no no no no! Your hair is sooo damaged! It's not good if you leave your hair like this.",
      "translation" : "咦！？天哪！糟了糟了糟了！你的头发受损得太严重了！这样放任不管可不行。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Would you let me treat your hair? Please?",
      "translation" : "让我帮你护理头发，好吗？拜托啦！"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Wow! Your hair would be perfect once it's dyed~ How about dying your hair for a change?",
      "translation" : "哇！染过之后，你的头发一定会美极了~要不要换个颜色试试？"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Dye Hair",
      "translation" : "染发"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Tips and Information",
      "translation" : "护理建议与说明"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Yes yes, good choice~",
      "translation" : "是啊是啊，选得真好~"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Well then, this is your chance for a make-over, your chance to blossom in beauty! Choose the color you would like.",
      "translation" : "那么，这就是让你焕然一新的机会，让你绽放美丽的机会！选个喜欢的颜色吧。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "What do you think? Did you want a different color?",
      "translation" : "怎么样？想换个颜色吗？"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "想"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "No",
      "translation" : "不想"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Okay! Choose the color that you would like.",
      "translation" : "好！选个你喜欢的颜色吧。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Hmm, I'm sort of disappointed. I wanted to do a better job. But I promise I'll do it better next time. Please come again~",
      "translation" : "嗯，我有点失望。本来想做得更好一些。不过我保证下次会做得更好。记得再来哦~"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Red, please.",
      "translation" : "请染成红色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Yellow, please.",
      "translation" : "请染成黄色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Violet, please.",
      "translation" : "请染成紫色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Orange, please.",
      "translation" : "请染成橙色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Green, please.",
      "translation" : "请染成绿色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Blue, please.",
      "translation" : "请染成蓝色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "White, please.",
      "translation" : "请染成白色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Black, please.",
      "translation" : "请染成黑色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Actually, I like my hair as it is.",
      "translation" : "其实我觉得现在的发色就很好。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "You must like your hair color~",
      "translation" : "看来你很喜欢自己的发色~"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Eehh~? You're not going to dye your hair? I'm a little sad...",
      "translation" : "咦~？你不打算染发吗？我有点难过..."
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Eh? But that's the hair color you already have. Please choose a different color.",
      "translation" : "咦？这就是你现在的发色呀。请选个别的颜色。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "The fee is 1000 zeny. Do you not have enough...?",
      "translation" : "费用是1000金币。你钱不够吗...？"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "When you're feeling down , when you get dumped, when you want to impress someone, or even when you just want to stand out...",
      "translation" : "心情低落时、被甩时、想给某人留下好印象时，甚至只是想引人注目时..."
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "For that special place and time, wouldn't you want a hairstyle of your very own? As long as you have the appropriate dyestuffs, I will make your hair look wonderful.",
      "translation" : "在那个特别的地点和时刻，难道不想拥有专属于自己的发型吗？只要带来合适的染料，我就能让你的头发焕然一新。"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "And try not to worry too much about the fee. Acquiring beauty is the same as acquiring everything. Hehe~",
      "translation" : "费用的事也不用太担心。获得美丽和得到其他东西是一样的。嘿嘿~"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "* Fees and Information *",
      "translation" : "* 费用与说明 *"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "- 1 Dyestuffs item of the color of hair you want.",
      "translation" : "- 1份与你想染的发色相符的染料。"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "- 1000 zeny fee.",
      "translation" : "- 费用1000金币。"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Men or Women...",
      "translation" : "男人也好，女人也好..."
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Everyone has the right and obligation to be beautiful.",
      "translation" : "每个人都有追求美丽的权利，也有让自己变美的义务。"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理发师约沃维奇]"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Jovovich",
      "placeholders" : [
        "getitemname(getarg(0))",
        "getarg(1)"
      ],
      "state" : "translated",
      "text" : "Eh?! But you need the item '{0}' to dye your hair {1}...",
      "translation" : "咦？！不过，你需要物品“{0}”才能把头发染成{1}..."
    }
  ]
