    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Job change? Muhahaha! But you're already a Swordman! Be proud and be strong!",
      "translation" : "转职？哇哈哈哈！可你已经是剑士了！拿出剑士的骄傲，变得更强吧！"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Haha! Oh boy. I'm flattered, but you already have another job! Still, I can't blame you...",
      "translation" : "哈哈！哎呀，你这么向往剑士，真让我受宠若惊，可你已经有其他职业了！不过，也不能怪你..."
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "So you wish to become a proud Swordman? By all means, please sign up!",
      "translation" : "你想成为一名值得骄傲的剑士？那就来报名吧！"
    },
    {
      "kind" : "option",
      "line" : 112,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Sign up.",
      "translation" : "报名"
    },
    {
      "kind" : "option",
      "line" : 112,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Ah, yes. Your application will be reviewed as soon as possible.",
      "translation" : "好的，我们会尽快审核你的申请。"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "If you have already met the requirements, you can take an interview right now. Would you like to?",
      "translation" : "如果你已经满足条件，现在就能参加面试。要参加吗？"
    },
    {
      "kind" : "option",
      "line" : 122,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Yes.",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 122,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "No.",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Good, good.",
      "translation" : "很好，很好。"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Now, let's see...",
      "translation" : "那么，让我看看..."
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Alright then. Feel free to come back whenever you are ready. All you have to do now is meet our requirements. Good luck to you.",
      "translation" : "好，准备好了随时回来。现在你只要达到我们的要求就行。祝你好运。"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hm? Alright, come back whenever you change your mind. The world can always use another Swordman!",
      "translation" : "嗯？好吧，改变主意后随时回来。世界永远需要更多剑士！"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hm, you still haven't learned all of the Basic Skills. You need to do that before you can become a Swordman.",
      "translation" : "嗯，你还没学会所有基本技能。想成为剑士，得先把它们学完。"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Check the requirements for job change again, and come back when you are ready.",
      "translation" : "再次确认转职要求，准备好后再回来。"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hm, you've learned all of the Basic Skills but didn't take the test yet. You must first pass the exam before you can change your job to Swordman.",
      "translation" : "嗯，你已经学会所有基本技能，不过还没参加考试。通过考试后，才能转职为剑士。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Enter the room to my right so that you can take the test. You'll need to speak to my right so you can enter the examination area.",
      "translation" : "去我右边的房间参加考试。你需要先和右边的人交谈，才能进入考场。"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hahaha! Congratulations! Now you are fully qualified to be a real Swordman! I will transform you right away!",
      "translation" : "哈哈哈！恭喜你！现在你完全有资格成为真正的剑士了！我马上为你办理转职！"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Once again, congratulations. I expect that you will be a good representative of the Swordman Association.",
      "translation" : "再次恭喜你。希望你能成为剑士公会的优秀代表。"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "So you wish to know more about the mighty Swordman job? Well, then...",
      "translation" : "想进一步了解强大的剑士职业？好，那就..."
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Amongst the First Class jobs, the Swordman is the best melee fighter for three reasons.",
      "translation" : "在一转职业中，剑士是最出色的近战战士，原因有三个。"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "There are 3 reasons why Swordy is the best to approch a fight!",
      "translation" : "剑士最适合迎战，原因有三个！"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "First, Swordman has the benefit of additional HP. Second, Swordman generally have access to a wider selection fo weapons than the other First Class jobs.",
      "translation" : "第一，剑士拥有更高的HP。第二，比起其他一转职业，剑士能使用的武器种类更多。"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "And third, most of the Swordman skills are crushing physical attacks! In my opinion, being a Swordman is the best job ever!",
      "translation" : "第三，剑士的大部分技能都是威力强大的物理攻击！在我看来，剑士就是最棒的职业！"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hmmm...",
      "translation" : "嗯..."
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "But there's no need to tell you the requirements. You've met them and already became a Swordman! Well, anyway...",
      "translation" : "不过，没必要跟你说转职条件了。你早已满足条件，成为剑士了！总之..."
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "It's too late for you to become a Swordman. You already have another job. Still, there's no harm in telling you...",
      "translation" : "你已经有其他职业，不能再成为剑士了。不过，告诉你也无妨..."
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 190,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "First, you must learn all 9 of the Basic Skills. If you can't complete this requirement, you won't be able to change to any job.",
      "translation" : "首先，必须学会全部9个基本技能。达不到这一要求，就无法转职成任何职业。"
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Second, you must pass the Swordman Test. Inquire the Test Manager located in the waiting room of the Swordman Test.",
      "translation" : "其次，必须通过剑士考试。详情请咨询剑士考试等候室里的考试管理员。"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "If you can complete these 2 requirements, you can change to a Swordman anytime you want.",
      "translation" : "满足这两个条件后，你就可以随时转职为剑士。"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Ha ha ha!",
      "translation" : "哈哈！"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Swordman",
