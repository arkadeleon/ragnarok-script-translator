      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hmm? Ah, you must first master the Basic Skills before you are ready to become a Swordman.",
      "translation" : "嗯？啊，你得先掌握基本技能，才能成为剑士。"
