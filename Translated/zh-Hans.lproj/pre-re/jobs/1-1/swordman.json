      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Come back to me when you have finished learning the Basic Novice Skills.",
      "translation" : "学完初心者的基本技能后，再回来找我。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Excellent! Let me promote you to a Swordman right away!",
      "translation" : "很好！我马上就为你转职成剑士！"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "[Swordman]",
      "translation" : "[剑士]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Swordman",
      "state" : "translated",
      "text" : "Hmm... You look like a well-experienced Swordman. Still, I'm sure that you must train to improve your skills and gain strength!",
      "translation" : "嗯...你看起来已经是个经验丰富的剑士了。不过，仍然要训练自己，磨练技艺、增强实力！"
