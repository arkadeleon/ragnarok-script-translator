    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[马雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "May the grace of God light your path and guide you during your journey of penance.",
      "translation" : "愿上帝的恩典照亮你的道路，在苦行旅程中指引你。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[马雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "You lied?",
      "translation" : "你撒谎了？"
