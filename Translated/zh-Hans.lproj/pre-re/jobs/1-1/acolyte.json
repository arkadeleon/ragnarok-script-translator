      "translation" : "[马雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "I am proud to say that you are now ready to become an Acolyte!",
      "translation" : "我很高兴地告诉你，你现在已经准备好成为服事者了！"
    },
    {
