      "line" : 196,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[马雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Always remember to be thankful to God, who is taking care of us all the time.",
      "translation" : "永远记得感谢上帝，因为祂一直在照顾我们。"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[马雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Always use your gifts to serve Him by helping others. In chaos and times of difficulty, face your hardships with unwavering faith.",
      "translation" : "要善用上帝赐予你的才能帮助他人。在混乱和艰难时刻，也要以坚定的信念面对困境。"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[马雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 203,
