      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[马雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Good Lord! Haven't you accomplished the Basic Training yet?! It's important that you finish that!",
      "translation" : "天哪！你还没完成基本训练吗？！完成训练非常重要！"
