{
  "file" : "npc/pre-re/guides/guides_rachel.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Welcome to the capital of",
      "translation" : "欢迎来到阿鲁纳费尔兹的首都，"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Arunafeltz, Rachel where a warm",
      "translation" : "拉赫尔。女神芙蕾雅温暖的"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "breath of goddess Freya reaches.",
      "translation" : "气息也吹拂着这里。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "If this is the first time for you",
      "translation" : "如果这是你第一次"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "to use the guide services, why",
      "translation" : "使用导览服务，"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "don't you check the \"Notice\" menu first?",
      "translation" : "不妨先查看“公告”菜单？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Village Guide",
      "translation" : "村庄导览"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Remove Marks from Mini-Map",
      "translation" : "移除小地图标记"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Notice",
      "translation" : "公告"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "I can tell you any building location as long as it is in Rachel.",
      "translation" : "只要在拉赫尔城内，我都能告诉你各栋建筑的位置。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "So where do you want to go?",
      "translation" : "你想去哪里？"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Would you like me",
      "translation" : "要我帮你"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "to mark locations",
      "translation" : "在小地图上"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "on your Mini-Map?",
      "translation" : "标记位置吗？"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "要"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "No",
      "translation" : "不要"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Cheshrumnir",
      "translation" : "切斯鲁姆尼尔"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Inn",
      "translation" : "旅馆"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Weapon Shop",
      "translation" : "武器店"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Tool Shop",
      "translation" : "道具店"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Airport",
      "translation" : "机场"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Cheshrumnir is a holy ground where pope, the incarnation of goddess Freya stays.",
      "translation" : "切斯鲁姆尼尔是圣地，女祭司住在那里，她是女神芙蕾雅的化身。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Take the road to the norh to find the building.",
      "translation" : "沿着道路往北走就能找到那栋建筑。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "You can rest your fatigue off the journey in the Inn.",
      "translation" : "旅途劳累的话，可以到旅馆休息。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "The left building next to me is the Inn of Rachel.",
      "translation" : "我旁边左侧的建筑就是拉赫尔旅馆。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Do you want to check out the weapons that are sold in Rachel?",
      "translation" : "想看看拉赫尔出售的武器吗？"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "The weapon shop is located nearby the western gate.",
      "translation" : "武器店就在西门附近。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Rachel tool shop sells the best quality potions.",
      "translation" : "拉赫尔道具店出售品质最好的药水。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "It's located nearby the western gate.",
      "translation" : "它就在西门附近。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "The Airport is located outside the eastern gate.",
      "translation" : "机场位于东门外。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "If you like to get rid of all the location marks on your Mini-Map,",
      "translation" : "如果想移除小地图上的所有位置标记，"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "just ask me again, and choose \"Remove Marks from Mini-Map\" menu.",
      "translation" : "再来找我，并选择“移除小地图标记”菜单即可。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Okay, they are gone now. If you have more locations to ask, just let me know.",
      "translation" : "好了，标记已经移除了。还想查询其他地点的话，告诉我就行。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "When you are using the ''Village Guide'' menu,",
      "translation" : "使用“村庄导览”菜单时，"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "make sure that building locations will be marked on your mini-map at the upper right side of your screen.",
      "translation" : "请留意建筑位置会标记在屏幕右上角的小地图上。"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "If you cannot see your mini-map, use the short cut key ''ctrl+tab'' or press the ''Map'' button on your basic information windows, okay?",
      "translation" : "如果看不到小地图，可以按快捷键“Ctrl+Tab”，或点击基本信息窗口中的“地图”按钮。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "And you can also zoom out your mini-map by using the ''-'' button in case you cannot view the entire map of the village.",
      "translation" : "如果无法看到整个村庄地图，也可以按“-”按钮缩小小地图。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "[Rachel Guide]",
      "translation" : "[拉赫导览员]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "Hope you have a wonderfull journey",
      "translation" : "祝你在阿鲁纳费尔兹"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Rachel Guide",
      "state" : "translated",
      "text" : "in Arunafeltz.",
      "translation" : "旅途愉快！"
    }
  ]
}