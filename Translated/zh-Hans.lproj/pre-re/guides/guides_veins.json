{
  "file" : "npc/pre-re/guides/guides_veins.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Desert City Veins welcomes adventurers seeking shelter from harsh sandstorms.",
      "translation" : "沙漠城市维因斯欢迎各位冒险者前来，在狂暴的沙尘暴中寻求庇护。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If this is the first time for you to use the guide services, why don't you check the...",
      "translation" : "如果这是你第一次使用导览服务，不妨先查看..."
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Village Guide",
      "translation" : "村庄导览"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Remove Marks from Mini-Map",
      "translation" : "移除小地图标记"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Notice",
      "translation" : "公告"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "I can tell you any building location as long as it is in Veins.",
      "translation" : "只要在维因斯城内，我都能告诉你各栋建筑的位置。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "So where do you want to go?",
      "translation" : "你想去哪里？"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Would you like me",
      "translation" : "要我帮你"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "to mark locations",
      "translation" : "在小地图上"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "on your Mini-Map?",
      "translation" : "标记位置吗？"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "要"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "No",
      "translation" : "不要"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Temple",
      "translation" : "神殿"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Inn",
      "translation" : "旅馆"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Weapon Shop",
      "translation" : "武器店"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Tool Shop",
      "translation" : "道具店"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Airship",
      "translation" : "飞艇"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Tavern",
      "translation" : "酒吧"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Geological Research Institute",
      "translation" : "地质研究所"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Our temple is located north,",
      "translation" : "我们的神殿位于北边，"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "and always crowded with sincere followers of Goddess Freya.",
      "translation" : "那里总是挤满了芙蕾雅女神的虔诚信徒。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "You can rest your fatigue of the journey in the Inn.",
      "translation" : "旅途劳累的话，可以到旅馆休息。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "The left building next to me is the Inn of Veins.",
      "translation" : "我旁边左侧的建筑就是维因斯旅馆。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Yes, you should protect yourself from danger on your own.",
      "translation" : "是的，你应该靠自己保护自己，免受危险。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Purchase high quality weapons at affordable prices.",
      "translation" : "这里可以买到价格实惠的优质武器。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "The Veins Weapon Shop is located to the West.",
      "translation" : "维因斯武器店位于西边。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Have you packed enough necessities  for your adventure?",
      "translation" : "冒险所需的物品都准备齐了吗？"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If not, I suggest you check what the Veins in the Center can offer you.",
      "translation" : "如果没有，我建议你去看看维因斯中央区有什么可买的。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Please be aware that Veins only operates cargo airships.",
      "translation" : "请注意，维因斯只有货运飞艇。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If you'd like to make friends with",
      "translation" : "如果你想结识"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "the townspeople, I suggest you",
      "translation" : "镇上的居民，我建议你"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "go have a drink at the tavern to",
      "translation" : "去西边的酒吧"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "the west.",
      "translation" : "喝一杯。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Are you interested in studying geology?",
      "translation" : "你对地质学有兴趣吗？"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Then you'd better go check out the",
      "translation" : "那你最好去看看"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Geological Research Institute on",
      "translation" : "武器店二楼的"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "the 2nd floor of the weapon shop.",
      "translation" : "地质研究所。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If you like to get rid of all the location marks on your Mini-Map,",
      "translation" : "如果想移除小地图上的所有位置标记，"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "just ask me again, and choose 'Remove Marks from Mini-Map' menu.",
      "translation" : "再来找我，并选择“移除小地图标记”菜单即可。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Okay, they are gone now. If you have more locations to ask, just let me know.",
      "translation" : "好了，标记已经移除了。还想查询其他地点的话，告诉我就行。"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Enjoy your stay in Veins.",
      "translation" : "祝你在维因斯逗留愉快。"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "When you are using the ''Village Guide'' menu,",
      "translation" : "使用“村庄导览”菜单时，"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "make sure that building locations will be marked on your mini-map at the upper right side of your screen.",
      "translation" : "请留意建筑位置会标记在屏幕右上角的小地图上。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If you cannot see your mini-map, use the short cut key ''ctrl+tab'' or press the ''Map'' button on your basic information windows, okay?",
      "translation" : "如果看不到小地图，可以按快捷键“Ctrl+Tab”，或点击基本信息窗口中的“地图”按钮。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "And you can also zoom out your mini-map by using the ''-'' button in case you cannot view the entire map of the village.",
      "translation" : "如果无法看到整个村庄地图，也可以按“-”按钮缩小小地图。"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[维因斯导览员]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Enjoy your stay in Veins.",
      "translation" : "祝你在维因斯逗留愉快。"
    }
  ]
}