    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Welcome to Luoyang,",
      "translation" : "欢迎来到龙之城，"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "a city with a long",
      "translation" : "这是一座历史悠久"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "and colorful history.",
      "translation" : "且多姿多彩的城市。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Recently we've developed",
      "translation" : "最近，我们开辟了"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "an ocean lane to accomodate",
      "translation" : "一条海上航线，以促进"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "positive exchange with",
      "translation" : "友好往来"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "foreign nations.",
      "translation" : "与外国之间的交流。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Luoyang is well-known for various specialties in addition to its rich history. Here you can find many things unique to our land.",
      "translation" : "龙之城不仅历史悠久，也以各种特产闻名。在这里，您能找到许多本地独有的事物。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Please take your time",
      "translation" : "请慢慢游览，"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "and we invite you to enjoy",
      "translation" : "祝您在这里"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "your trip here in Luoyang.",
      "translation" : "度过愉快的时光。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Ask Building Locations.",
      "translation" : "询问建筑位置。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Remove all marks from mini-map.",
      "translation" : "清除小地图上的所有标记。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Where would you like to go?",
      "translation" : "您想去哪里？"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Dragon Castle",
      "translation" : "龙宫"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Doctor's Office",
      "translation" : "诊所"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "City Hall",
      "translation" : "市政厅"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Weapon Shop",
      "translation" : "武器店"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Tool Shop",
      "translation" : "道具店"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Tavern",
      "translation" : "酒馆"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Dragon Castle is located at ^FF3355+^000000. It is where all the nobles reside, including our lord.",
      "translation" : "龙宫位于^FF3355+^000000标记处。包括领主在内，所有贵族都住在那里。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Since you're an outsider, I guess it would be appropriate for you to visit our lord first.",
      "translation" : "您是外地来的客人，我想先去拜访领主比较合适。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "We have a very skillful doctor.",
      "translation" : "这里有一位医术高明的医生。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "You can find her office at ^CE6300+^000000.",
      "translation" : "她的诊所位于^CE6300+^000000标记处。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "It is said that there",
      "translation" : "据说没有"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "is no disease she cannot cure. Well, I can't guarantee if that's true or not.",
      "translation" : "她治不好的病。不过这话是真是假，我可不敢保证。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "We have a City Hall where the federal government operates.",
      "translation" : "这里设有市政厅，联邦政府就在此办公。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "It is located at ^A5BAAD+^000000.",
      "translation" : "市政厅位于^A5BAAD+^000000标记处。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "If you have any problems,",
      "translation" : "如果您遇到问题，"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "you should talk with the",
      "translation" : "可以向市政厅的"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "employees in City Hall.",
      "translation" : "工作人员咨询。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Weapon Shop is located at ^55FF33+^000000.",
      "translation" : "武器店位于^55FF33+^000000标记处。"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "You will see",
      "translation" : "在那里，您可以看到"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "marvelous weapons forged",
      "translation" : "由龙之城经验丰富的铁匠"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "by the well-experienced",
      "translation" : "精心打造的"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "blacksmiths of Luoyang.",
      "translation" : "精良武器。"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Tool Shop is located at ^3355FF+^000000.",
      "translation" : "道具店位于^3355FF+^000000标记处。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Knowing your enemy",
      "translation" : "了解敌人"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "is half the battle!",
      "translation" : "就成功了一半！"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "It's also safer to prepare yourself than to be sorry later. Why don't you go check their supplies?",
      "translation" : "事先做好准备，总比事后后悔要稳妥。不妨去看看店里的补给品？"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "When you get tired during your trip, I suggest that you visit the Tavern. It's located at ^00FF00+^000000.",
      "translation" : "旅途中累了，不妨去酒馆休息一下。酒馆位于^00FF00+^000000标记处。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Tavern is a good place",
      "translation" : "酒馆是结识其他游客的好地方，"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "to meet other tourists, as well as to hear of any news that may be helpful to know.",
      "translation" : "也能打听到一些有用的消息。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "If you wish to remove all marks",
      "translation" : "如果您想清除小地图上的所有标记，"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "on your mini-map, please choose 'Remove all marks from mini-map.' from the menu.",
      "translation" : "请在菜单中选择“清除小地图上的所有标记”。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "There, I've erased all the marks on your mini-map. Feel free to ask me about building locations whenever you need to.",
      "translation" : "好了，您小地图上的所有标记都已清除。需要询问建筑位置时，随时来找我。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "I guess it's fun",
      "translation" : "有时候，"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "sometimes to go exploring",
      "translation" : "自己四处探索"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "on your own. Take care.",
      "translation" : "也挺有趣。保重。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "[Representative]",
      "translation" : "[代表]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "Welcome to Luoyang,",
      "translation" : "欢迎来到龙之城，"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "an ancient land with",
      "translation" : "这片古老的土地，"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "a history full of tales",
      "translation" : "流传着许多"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "of bravery.",
      "translation" : "英勇的故事。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "[Representative]",
      "translation" : "[代表]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "We now provide an ocean lane to accomodate foreign travelers and intercultural exchange from which all can benefit.",
      "translation" : "我们已开辟海上航线，方便外国旅客往来，促进文化交流，让大家都能从中受益。"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "[Representative]",
      "translation" : "[代表]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "Luoyang is famous for",
      "translation" : "龙之城以悠久的历史"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "its elaborate history, as well as specialties that are unique to this nation. Please take your time and enjoy your stay.",
      "translation" : "和本国独有的特产闻名。请慢慢游览，祝您在此度过愉快的时光。"
    },
    {
      "kind" : "option",
      "line" : 144,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "Ask Building Locations.",
      "translation" : "询问建筑位置。"
    },
    {
