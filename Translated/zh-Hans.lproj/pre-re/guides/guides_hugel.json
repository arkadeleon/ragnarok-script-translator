{
  "file" : "npc/pre-re/guides/guides_hugel.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Oh, hello~ you are one energetic adventurer.",
      "translation" : "哦，你好呀~真是个精力充沛的冒险者。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Welcome to Hugel. I was honored to guide you to this beautiful village.",
      "translation" : "欢迎来到胡格尔。我很荣幸能带你游览这个美丽的村庄。"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "If this is the first time for you to use the guide services, why don't you check the ''Notice'' menu first?",
      "translation" : "如果你是第一次使用导游服务，不妨先看看“公告”菜单？"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Village Guide",
      "translation" : "村庄导览"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Remove Marks from Mini-Map",
      "translation" : "移除小地图标记"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Notice",
      "translation" : "公告"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "I can tell you any building location as long as it is in Hugel.",
      "translation" : "只要是在胡格尔，我都能告诉你建筑的位置。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "So where do you want to go?",
      "translation" : "那么，你想去哪里？"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Would you like me",
      "translation" : "要我帮你"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "to mark locations",
      "translation" : "标记地点"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "on your Mini-Map?",
      "translation" : "在小地图上吗？"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Yes.",
      "translation" : "好的。"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不用。"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Church",
      "translation" : "教堂"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Inn",
      "translation" : "旅馆"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Pub",
      "translation" : "酒吧"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Airport",
      "translation" : "机场"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Weapon Shop",
      "translation" : "武器店"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Tool Shop",
      "translation" : "道具店"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Party Supplies Shop",
      "translation" : "派对用品店"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "^3131FFHunter Job Change Place^000000",
      "translation" : "^3131FF猎人转职处^000000"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "^3131FFShrine Expedition's Place^000000",
      "translation" : "^3131FF神殿探险队驻地^000000"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Monster Race Arena",
      "translation" : "魔物赛跑场"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Bingo Game Room",
      "translation" : "宾果游戏室"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Well, to me, this Church is rather like a place for old folks like me, you know...",
      "translation" : "哎呀，在我看来，这座教堂倒像是给我这样的老人准备的地方呢..."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Pudding rather than praise.",
      "translation" : "与其受人称赞，不如吃布丁。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "You'd better unpack your stuffs first before you start looking around this village.",
      "translation" : "你最好先把行李放好，再开始逛村子。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "It is the building right next to me.",
      "translation" : "就在我旁边那栋建筑里。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Yes, when you travel, you want to drop by a pub and make new friends.",
      "translation" : "旅行时去酒吧坐坐，结交新朋友，感觉真好。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Go east from here, then you will arrive at the pub.",
      "translation" : "从这里往东走，就能到酒吧。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "A while ago, strangers came to village and built that strange airport kind of thing...",
      "translation" : "不久前，有些陌生人来到村里，建了个奇怪的机场一样的东西..."
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "What do they call it? Airship?",
      "translation" : "他们管那东西叫什么来着？飞艇？"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Well, we have a weapon shop in the center of village.",
      "translation" : "嗯，村子中心有一家武器店。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "But I don't know if there is any weapon that you find useful.",
      "translation" : "不过我不知道里面有没有你觉得好用的武器。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Yes, I love Hugel brand Red Potions. I haven't tasted Red Potions from any other brands yet...hohoho. ",
      "translation" : "是啊，我最喜欢胡格尔牌红色药水了。我还没尝过其他牌子的红色药水呢...呵呵呵。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "The tool shop is located in the center of village.",
      "translation" : "道具店在村子中心。"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "The party supplies shop is around the center of village.",
      "translation" : "派对用品店在村子中心附近。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Make sure that you will not use any firecracker stuffs near other people, because it is dangerous, you know?",
      "translation" : "记得别在别人旁边放鞭炮之类的东西，很危险的，知道吗？"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Oh, are you an aspiring Hunter?",
      "translation" : "哦，你想成为猎人吗？"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Then head northeast following the beach, then you will find the Hunter job change place.",
      "translation" : "那就沿着海滩往东北方向走，你会找到猎人转职处。"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "I heard that the shrine expedition is staying in a house at the west.",
      "translation" : "我听说神殿探险队住在西边的一栋房子里。"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "They have put some kind of sign in the middle of village, so I guess that they are hiring people for something...",
      "translation" : "他们在村子中央立了个牌子，所以我猜他们在招人做什么事..."
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "I wonder what they are doing in here...hmmm.",
      "translation" : "不知道他们来这里做什么...嗯..."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "I also like playing Monster Race games. It is pretty fun, you know?",
      "translation" : "我也喜欢玩魔物赛跑。挺有意思的，知道吗？"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Oh, you haven't tried it yet? No~ you'd better try. Trust me, you will like it.",
      "translation" : "哦，你还没玩过？那可不行~最好去试试。相信我，你会喜欢的。"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Do you like bingo games? If you do, go visit Euklan's Bingo Game Room.",
      "translation" : "你喜欢玩宾果吗？喜欢的话，就去尤克兰的宾果游戏室看看。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "If you like to get rid of all the location marks on your Mini-Map,",
      "translation" : "如果你想清除小地图上的所有地点标记，"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "just ask me again, and choose ''Remove Marks from Mini-Map'' menu.",
      "translation" : "再来找我，选择“移除小地图标记”菜单就行。"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "Okay, they are gone now. If you have more locations to ask, just let me know.",
      "translation" : "好了，标记都清除了。还想问其他地点的话，告诉我就行。"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "When you are using the ''Village Guide'' menu, ",
      "translation" : "使用“村庄导览”菜单时，"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "make sure that building locations will be marked on your mini-map at the upper right side of your screen.",
      "translation" : "建筑位置会显示在屏幕右上角的小地图上。"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "If you cannot see your mini-map, use the short cut key ''ctrl+tab'' or press the ''Map'' button on your basic information windows, okay?",
      "translation" : "如果看不到小地图，可以按快捷键“Ctrl+Tab”，或点击基本信息窗口中的“地图”按钮，好吗？"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "And you can also zoom out your mini-map by using the ''-'' button in case you cannot view the entire map of the village.",
      "translation" : "如果村庄地图显示不全，也可以点击“-”按钮缩小小地图。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "[Hugel Guide Granny]",
      "translation" : "[胡格尔导游奶奶]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "This guide job is pretty exciting. Hohoho~",
      "translation" : "做导游真是令人兴奋。呵呵呵~"
    }
  ]
}