    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Vending Machine",
      "state" : "translated",
      "text" : "So if you use an item that has been ^FF3355upgraded, or has a card compounded to it^000000, any cards or upgrades will be lost in creating the new item.",
