      "state" : "translated",
      "text" : "[Audi]",
      "translation" : "[奥迪]"
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Vending Machine",
      "state" : "translated",
      "text" : "So when you try to exchange and generate items, please put all the valuable items you won't be using into the Kafra Storage.",
      "translation" : "所以，兑换或制作物品之前，请把不打算使用的贵重物品存进卡普拉仓库。"
    },
