    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Vending Machine",
      "state" : "translated",
      "text" : "I need to tell you one important thing. This vending machine is not equipped to differentiate between special items and ordinary items.",
      "translation" : "有件重要的事要告诉你。这台自动贩卖机无法区分特殊物品和普通物品。"
    },
