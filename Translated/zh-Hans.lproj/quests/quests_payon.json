      "line" : 174,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Huhuhuhuhu...",
      "translation" : "呵呵呵呵..."
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "What if I can't get rid of all these Thief Bugs? I might even grow to love them... *Huk*",
      "translation" : "如果我没法除掉这些盗虫怎么办？说不定我会爱上它们...*哈*"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Wahhhhhh! I, I...",
      "translation" : "哇啊啊！我、我..."
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I can't take it any more!",
      "translation" : "我再也受不了了！"
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "You little stinky filthy bastards!",
      "translation" : "你们这些臭烘烘的小混蛋！"
    },
    {
      "kind" : "option",
      "line" : 186,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Continue",
