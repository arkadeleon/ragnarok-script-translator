{
  "file" : "npc/quests/quests_payon.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "^3355FFWait a second! Right now, you're carrying too many items with you. Please come back after putting some of your things into Kafra Storage.^000000",
      "translation" : "^3355FF请稍等！你身上带的东西太多了。把部分物品存入卡普拉仓库后再来吧。^000000"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "I wish I could make some clothing for my grandchildren for the festival season...",
      "translation" : "真希望能在节日期间给孙儿们做些衣服..."
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Oh! Would you give me your ^3355FFSkirt of Virgin^000000? I'd need four of them. Please, I'm begging you.",
      "translation" : "哦！能把你的^3355FF处女裙^000000给我吗？我需要4条。拜托你了。"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Alright.",
      "translation" : "好吧。"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "No way!",
      "translation" : "才不要！"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Oh! Thank you so much~ Now I can make some clothes for Kitty Cutty~",
      "translation" : "哦！太感谢你了~现在我可以给小猫咪做衣服了~"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Ah, Wait! I almost forgot. I was quite a popular actress back in my youth. My actor friends gave me a wedding present when I left the Troupe. I've kept it to remind me of those precious times.",
      "translation" : "啊，等等！我差点忘了。年轻时我可是很受欢迎的演员。离开剧团时，演员朋友们送了我一份结婚礼物。我一直留着它，纪念那段珍贵时光。"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "If it's okay...",
      "translation" : "如果你不介意..."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "I'd like to give you this.",
      "translation" : "我想把这个送给你。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Goodbye, adventurer~!",
      "translation" : "再见，冒险者~！"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Thank you for making an old woman so happy...",
      "translation" : "谢谢你让一个老婆婆这么开心..."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "*Sigh* How can I get ^3355FFSkirt of Virgin^000000 by myself? I'm just so weak and feeble, even rolling in my rocking chair exhausts me. *Sniff* All I want is to make my grandchildren happy...",
      "translation" : "*叹气*我这么虚弱，连在摇椅上晃一晃都会累，怎么可能自己找到^3355FF处女裙^000000呢？*抽泣*我只想让孙儿们开心..."
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "I gather Mushrooms on the Mountain of Payon everyday. Time passes and before I know it, it's already fesitval season. I wish I could make clothing for my family this time of the year.",
      "translation" : "我每天都在斐扬山采蘑菇。时光飞逝，转眼又到了节日季节。真希望今年能给家人做些衣服。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "...",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "But for that, I need ^3355FF4 Skirt of Virgin^000000...",
      "translation" : "不过，为了做衣服，我需要^3355FF4条处女裙^000000..."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Young traveler, please help me. When you find some ^3355FFSkirt of Virgin^000000, please bring them to me. I'd really appreciate it...",
      "translation" : "年轻的旅人，请帮帮我。找到^3355FF处女裙^000000后，请带来给我。我会非常感激..."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "My family has produced and sold the special Winter product ^3355FFEar Muffs^000000 for many years. We just moved here, but the weather is always warm so we can hardly make a living.",
      "translation" : "我们家多年来一直制作和出售冬季特色商品^3355FF耳罩^000000。我们刚搬到这里，可天气总是很暖和，生意都快做不下去了。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "If you plan to travel to colder regions, I suggest that you bring some ^3355FFEar Muffs^000000...",
      "translation" : "如果你打算去更寒冷的地方旅行，我建议你带上^3355FF耳罩^000000..."
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Ear Muffs are my family's specialty, and we provide it to customers who have ^FF33551 Cursed Ruby^000000, ^3311AA1 Headset,^000000 ^3355FF 200 Feathers^000000 and ^DDDD005000 Zeny^000000.",
      "translation" : "耳罩是我们家的特产。只要带来^FF33551颗诅咒红宝石^000000、^3311AA1个耳机^000000、^3355FF200根羽毛^000000和^DDDD005000泽尼^000000，就能换取一副。"
    },
    {
      "kind" : "option",
      "line" : 89,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Oh Yeah? That sounds good.",
      "translation" : "真的吗？听起来不错。"
    },
    {
      "kind" : "option",
      "line" : 89,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "No thank you, Ma'am.",
      "translation" : "不了，谢谢您。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Here, I will give you this pre-made one.",
      "translation" : "来，这副是我事先做好的，送给你。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Thank you for buying our product. You won't regret purchasing our Ear Muffs: Satisfaction guaranteed~",
      "translation" : "谢谢你购买我们的商品。买了耳罩绝不会后悔，保证满意~"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Oh dear...",
      "translation" : "哎呀..."
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "You don't have enough money or items. Unfortunately, we can't give any discounts. Please understand that we have to make a living...",
      "translation" : "你的钱或物品不够。很遗憾，我们不能打折。请理解，我们也要维持生计..."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "That's fine.",
      "translation" : "没关系。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "I believe we",
      "translation" : "我相信我们"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "will meet again.",
      "translation" : "还会再见。"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "...One of these days.",
      "translation" : "...总有一天。"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "ArrrGggghh!",
      "translation" : "啊啊啊！"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Ah, No I can't...",
      "translation" : "啊，不行..."
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "*Huk*",
      "translation" : "*哈*"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Now even my eyes have gone mad!! Why do these bugs suddenly seem so cute?! Nooooooo~!!!",
      "translation" : "现在连我的眼睛都出问题了吗！！这些虫子怎么突然变得这么可爱？！不——！！！"
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Show Ora Ora",
      "translation" : "展示奥拉奥拉"
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Give Ora Ora",
      "translation" : "交出奥拉奥拉"
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Oooooohhhh!!!",
      "translation" : "哦哦哦哦！！！"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Is, is this",
      "translation" : "这、这就是"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "the one?!",
      "translation" : "我要找的东西吗？！"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "This is...",
      "translation" : "这是..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Ora Ora!!",
      "translation" : "奥拉奥拉！！"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I'll make it short! Give it to me, and I will give you my treasure! So how's my idea? Wanna deal?",
      "translation" : "我就直说了！把它给我，我就把宝物给你！怎么样？成交吗？"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Muhahahahah!!!",
      "translation" : "哇哈哈哈哈！！！"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I finally have this!",
      "translation" : "我终于拿到它了！"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Ora Ora!",
      "translation" : "奥拉奥拉！"
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Stupid and Disgusting",
      "translation" : "又蠢又恶心的"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Thief Bugs!!",
      "translation" : "盗虫！！"
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "You will pay!!!",
      "translation" : "你们给我等着！！！"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Huk...Huk...",
      "translation" : "哈...哈..."
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Sorry, I was out of control with pleasure for a while. Now, I will give my treasure as promised.",
      "translation" : "抱歉，我刚才高兴得有些失控了。现在我会兑现承诺，把宝物给你。"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "When you wear this over your mouth and start to breathe, it filters junk out before getting to your lungs.",
      "translation" : "把这个戴在嘴上呼吸时，它会在杂质进入肺部前将其过滤掉。"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年轻男子]"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Kakakakakaka!",
      "translation" : "咔咔咔咔咔！"
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I can't wait",
      "translation" : "我等不及了"
    },
    {
