      "translation" : "[埃德加]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "state" : "translated",
      "text" : "Boy oh boy,",
      "translation" : "哎呀呀，"
    },
    {
      "kind" : "message",
      "line" : 90,
      "state" : "translated",
      "text" : "if you think",
      "translation" : "如果你觉得"
    },
    {
      "kind" : "message",
      "line" : 91,
      "state" : "translated",
      "text" : "that's a rip off...",
      "translation" : "这都算敲诈的话..."
    },
    {
      "kind" : "message",
      "line" : 94,
      "state" : "translated",
      "text" : "[Edgar]",
      "translation" : "[埃德加]"
    },
    {
      "kind" : "message",
      "line" : 95,
      "state" : "translated",
      "text" : "Yeah, alright.",
      "translation" : "好吧，行。"
    },
    {
      "kind" : "message",
      "line" : 96,
