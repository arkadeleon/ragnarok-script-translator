      "text" : "This isn't",
      "translation" : "钱"
    },
    {
      "kind" : "message",
      "line" : 79,
      "state" : "translated",
      "text" : "enough money.",
      "translation" : "不够。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "state" : "translated",
      "text" : "Go and get",
      "translation" : "去弄"
    },
    {
      "kind" : "message",
      "line" : 81,
      "state" : "translated",
      "text" : "some more.",
      "translation" : "多一点吧。"
    },
    {
      "kind" : "message",
      "line" : 88,
