{
  "file" : "npc/quests/okolnir.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "This castle has a hidden secret.",
      "translation" : "这座城堡隐藏着一个秘密。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "That is the ^4d4dff'Okolnir'^000000.",
      "translation" : "那就是^4d4dff“奥克尼尔”^000000。"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "About Okolnir.",
      "translation" : "关于奥克尼尔"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Go to Okolnir.",
      "translation" : "前往奥克尼尔"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Okolnir is a kind of virtual realm...",
      "translation" : "奥克尼尔是一种虚拟领域..."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "I don't know how Okolnir exists, but I guess only Valkyrie knows.",
      "translation" : "我不知道奥克尼尔是如何存在的，想必只有女武神才知道。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "As you know this is a place to test the adventurers made by Valkyrie...",
      "translation" : "如你所知，这里是女武神用来考验冒险者的地方..."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "...you know the qualifications to enter Okolnir.",
      "translation" : "...你知道进入奥克尼尔的资格要求。"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Qualifications?",
      "translation" : "资格要求？"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Yes, Valkyrie definitely prefers strong adventurers.",
      "translation" : "没错，女武神当然更青睐强大的冒险者。"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Only the qualified can enter Okolnir and Valhalla.",
      "translation" : "只有符合资格的人才能进入奥克尼尔和瓦尔哈拉。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "It only opens when everyone comes together to work it out.",
      "translation" : "只有大家齐心协力，入口才会开启。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "The key is in the castle.",
      "translation" : "关键就在城堡里。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "If a castle's ^4d4dffeconomy is over 65 and defense also over 30^000000, this will be acceptable to access Okolnir.",
      "translation" : "只要城堡的^4d4dff经济值超过65，防御值也超过30^000000，便符合进入奥克尼尔的条件。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "And, if you pass all of the tests given by Valkyrie in Okolnir!",
      "translation" : "此外，如果你通过女武神在奥克尼尔设下的所有考验！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "You will also receive a mysterious gift.",
      "translation" : "你还会得到一份神秘礼物。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Would you like to try to enter here?",
      "translation" : "你想从这里进入吗？"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Great! Economy and Defense are OK.",
      "translation" : "太好了！经济和防御都达标了。"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "You can enter Okolnir now....",
      "translation" : "现在可以进入奥克尼尔了..."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Do you want to go there?",
      "translation" : "你想去那里吗？"
    },
    {
      "kind" : "option",
      "line" : 71,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Sure let's go there.",
      "translation" : "好，我们这就去。"
    },
    {
      "kind" : "option",
      "line" : 71,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不了。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Ok......",
      "translation" : "好吧..."
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Please follow me...",
      "translation" : "请跟我来..."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "You can try this anytime in the future...",
      "translation" : "以后任何时候都可以再来尝试..."
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "If you are ready to protect this castle.",
      "translation" : "等你准备好守护这座城堡。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "You are not qualified yet.",
      "translation" : "你还不符合资格。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Please develop your castle more...",
      "translation" : "请继续提升城堡的发展度..."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "... OK...",
      "translation" : "...好吧..."
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Good luck.",
      "translation" : "祝你好运。"
    },
    {
      "kind" : "option",
      "line" : 102,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Enter now.",
      "translation" : "现在进入"
    },
    {
      "kind" : "option",
      "line" : 102,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不了。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Hope you get everything you want...",
      "translation" : "希望你能得到想要的一切..."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Really?",
      "translation" : "真的吗？"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Sorry to hear that.",
      "translation" : "真遗憾。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "Building Okolnir needs quite a long time.",
      "translation" : "建造奥克尼尔需要相当长的时间。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "....even though it's only virtual...",
      "translation" : "...尽管它只是虚拟的..."
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "It takes about 12 - 13 hours to create the virtual realm.",
      "translation" : "创建这个虚拟领域大约需要12到13个小时。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "You'll have to wait.",
      "translation" : "你得耐心等待。"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[向导]"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "... I've never seen you before.",
      "translation" : "...我以前没见过你。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Guide",
      "state" : "translated",
      "text" : "You are strangers here. You'd better get out of here right now.",
      "translation" : "你们是这里的陌生人。最好现在就离开。"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "I am... Wish maiden.",
      "translation" : "我...是祈愿少女。"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Mourning in this virtual realm, Okolnir.",
      "translation" : "在这个名为奥克尼尔的虚拟领域中哀悼。"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "On behalf of the humanbeings who defeated God here.",
      "translation" : "代表曾在此击败神明的人类。"
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Are you ready to endure the trials to get the Goddess' glory?",
      "translation" : "你准备好接受考验，赢得女神的荣光了吗？"
    },
    {
      "kind" : "option",
      "line" : 197,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Yes, I am",
      "translation" : "我准备好了"
    },
    {
      "kind" : "option",
      "line" : 197,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Sorry, I'll try later",
      "translation" : "抱歉，我晚点再来"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "I will test whether or not you deserve the Goddess shine...",
      "translation" : "我会考验你是否配得上女神的光辉..."
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Isn't it simple?",
      "translation" : "这很简单，不是吗？"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Okolnir is a virtual place.",
      "translation" : "奥克尼尔是一个虚拟的地方。"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "There is no room for error there.",
      "translation" : "在那里，绝不能出错。"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "^ff0000You only have one hour.^000000",
      "translation" : "^ff0000你只有一个小时。^000000"
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "If you have not finished in that time, Okolnir will be destroyed, and I will go to rest.",
      "translation" : "如果你没能在规定时间内完成，奥克尼尔就会被摧毁，而我也会去休息。"
    },
    {
      "kind" : "message",
      "line" : 212,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "You will have to wait again...",
      "translation" : "到时你就得再等一轮..."
    },
    {
      "kind" : "message",
      "line" : 214,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Are you ready to go through?",
      "translation" : "你准备好进去了吗？"
    },
    {
      "kind" : "message",
      "line" : 216,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "^4d4dffYou need to have 16 to 20 members present^000000.",
      "translation" : "^4d4dff需要有16到20名成员到场^000000。"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "I will open the gate of Okolnir if your members are ready.",
      "translation" : "如果你的成员都准备好了，我就会开启奥克尼尔之门。"
    },
    {
      "kind" : "option",
      "line" : 222,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "We are ready.",
      "translation" : "我们准备好了。"
    },
    {
      "kind" : "option",
      "line" : 222,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "We need more time.",
      "translation" : "我们还需要一些时间。"
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 228,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Now I will open the gate of Okolnir where I am.",
      "translation" : "现在，我要在这里为你们打开奥克尼尔之门。"
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "I will wait for you on the top of Okolnir...",
      "translation" : "我会在奥克尼尔顶端等你们..."
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 232,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "I hope that you can complete all of the trials before the virtual Okolnir is destroyed...",
      "translation" : "希望你们能在虚拟奥克尼尔被摧毁之前，通过所有考验..."
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Good luck.",
      "translation" : "祝你好运。"
    },
    {
      "kind" : "message",
      "line" : 246,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "[Wish Maiden]",
      "translation" : "[祈愿少女]"
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "You need to have 16 to 20 members present to open the gate of Okolnir.",
      "translation" : "必须有16到20名成员到场，才能开启奥克尼尔之门。"
    },
    {
      "kind" : "message",
      "line" : 248,
      "npc" : "Wish Maiden",
      "state" : "translated",
      "text" : "Come back when you are ready.",
