{
  "file" : "npc/cities/yuno.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "[Freidrich]",
      "translation" : "[弗雷德里希]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "^3355FFJuno^000000 is kept aloft in the air by an ancient and mysterious force.",
      "translation" : "^3355FF朱诺^000000依靠一种古老而神秘的力量漂浮在空中。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "[Freidrich]",
      "translation" : "[弗雷德里希]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "This power is said to come from a relic from an ancient civilization called ^3355FFJuperos^000000 which existed here long before Juno.",
      "translation" : "据说，这股力量来自名为^3355FF朱佩罗斯^000000的古代文明遗物。朱佩罗斯早在朱诺出现以前就存在于此。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "[Freidrich]",
      "translation" : "[弗雷德里希]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "Research revealed that Juno's power source based on ^3355FFPieces of Ymir's Heart^000000. I hear that this power source is found where Juperos used to exist.",
      "translation" : "研究发现，朱诺的能量来源是^3355FF尤弥尔之心碎片^000000。我听说这种能量源就在朱佩罗斯遗址。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "[Freidrich]",
      "translation" : "[弗雷德里希]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "Since many scholars have been coming to Juno to study and research this power source, our city is basically a well known mecca for scholars.",
      "translation" : "许多学者来到朱诺研究这种能量源，因此我们的城市如今已成为知名的学术圣地。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "[Freidrich]",
      "translation" : "[弗雷德里希]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "The city of Sages,",
      "translation" : "贤者之城"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "^3355FFJuno,^000000 is made of",
      "translation" : "^3355FF朱诺^000000由"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "three islands.",
      "translation" : "三座岛屿组成。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "[Freidrich]",
      "translation" : "[弗雷德里希]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "These are Solomon, the island of honor, Mineta, the island of prosperity, and Snotora, the island of knowledge.",
      "translation" : "分别是荣誉之岛所罗门、繁荣之岛米涅塔，以及知识之岛斯诺托拉。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "[Freidrich]",
      "translation" : "[弗雷德里希]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "The location of each island is",
      "translation" : "各岛的位置如下："
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "North-west : Solomon",
      "translation" : "西北：所罗门"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "North-east : Snotora",
      "translation" : "东北：斯诺托拉"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Freidrich",
      "state" : "translated",
      "text" : "South : Mineta.",
      "translation" : "南方：米涅塔。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "So, do you enjoy candy?",
      "translation" : "那么，你喜欢糖果吗？"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "^3355FFGranny hands you some candy^000000.",
      "translation" : "^3355FF老奶奶递给你一些糖果^000000。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "You've already chosen. It doesn't matter whether or not you get this candy. That doesn't matter at all. You have to understand why it's happened.",
      "translation" : "你已经做出选择了。拿不拿这些糖果都无所谓。真正重要的是，你必须明白事情为何会变成这样。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Here's ^3355FF1,000 zeny^000000.",
      "translation" : "给你^3355FF1,000 ZENY^000000。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Do you accept this?",
      "translation" : "你要收下吗？"
    },
    {
      "kind" : "option",
      "line" : 77,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Accept",
      "translation" : "收下"
    },
    {
      "kind" : "option",
      "line" : 77,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Do not accept",
      "translation" : "不收下"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "*Giggle*",
      "translation" : "*咯咯*"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "There you go~",
      "translation" : "给你~"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "*Giggle*",
      "translation" : "*咯咯*"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Well then...",
      "translation" : "那么..."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "See you ~",
      "translation" : "再见啦~"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Yes, that's right. Now you must ask yourself why you didn't accept the candy I offered.",
      "translation" : "没错。现在你该问问自己，为什么没有收下我给你的糖果。"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "*Giggle giggle*",
      "translation" : "*咯咯咯*"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "The time has come.",
      "translation" : "时候到了。"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Well then...",
      "translation" : "那么..."
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "I am an old Sage granny who foresees everything...",
      "translation" : "我是能预知一切的贤者老奶奶..."
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "Have you heard of a boss monster that has been around Juno for a long time? It's known only as the ^FF3355Lord of the Dead^000000.",
      "translation" : "你听说过长期徘徊在朱诺附近的首领魔物吗？人们只称它为^FF3355死亡之王^000000。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "It is rumored to be from the realm of the dead. It brings many undead monsters with it, intending to lead living creatures to its cold and icy realm.",
      "translation" : "据说它来自冥界，会带来许多不死魔物，企图把生灵引入冰冷的国度。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Juno Granny",
      "state" : "translated",
      "text" : "You have already chosen whether or not you will challenge the Lord of the Dead. All you need to do right now is understand why you made the decision.",
      "translation" : "你已经决定是否挑战死亡之王。现在只需要明白自己为何做出这个决定。"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "[Sergiof]",
      "translation" : "[塞尔吉奥夫]"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "My name is Sergiof,",
      "translation" : "我叫塞尔吉奥夫，"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "the fighter who",
      "translation" : "是侍奉老奶奶的"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "serves Granny.",
      "translation" : "战士。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "[Sergiof]",
      "translation" : "[塞尔吉奥夫]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "I will tell you about ^3355FFGrand Peco^000000 which is a high level Peco Peco. Grand Peco is faster than Peco Peco and is quite aggressive.",
      "translation" : "我来告诉你^3355FF大嘴鸟波利^000000的事。它是高等级的大嘴鸟，比普通大嘴鸟跑得更快，也更具攻击性。"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "[Sergiof]",
      "translation" : "[塞尔吉奥夫]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Juno Fighter",
      "state" : "translated",
      "text" : "It attacks using its strong bill and many Peco Pecos follow it. There's quite a difference in power between Peco Peco and the Grand Peco.",
      "translation" : "它会用强有力的鸟喙攻击，而且身边常有许多大嘴鸟跟随。普通大嘴鸟和大嘴鸟波利的实力相差很大。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "[Ninno]",
      "translation" : "[尼诺]"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "You are very lucky to have me tell you this story. This only happens by ^FF33551 out of a 1,000 chance^000000.",
      "translation" : "能听我讲这个故事，你真是走运。这种事发生的概率只有^FF3355千分之一^000000。"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "[Ninno]",
      "translation" : "[尼诺]"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "This world you are experiencing is actually fabricated! It's time for you to see reality for what it is!",
      "translation" : "你所经历的世界其实是虚构的！是时候看清现实了！"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "[Ninno]",
      "translation" : "[尼诺]"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "Open your eyes! Stop being manipulated by virtual reality!",
      "translation" : "睁开眼睛！别再受虚拟现实摆布了！"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "Have you ever heard of an Egyptian king who was once believed to be a son of a god? His name is ^3355FFPharoah^000000.",
      "translation" : "你听说过那位曾被认为是神之子的埃及国王吗？他名叫^3355FF法老王^000000。"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "[Ninno]",
      "translation" : "[尼诺]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "He was rumored to be a high sorcerer that used his power to curse innocents. It is said that he is still around, placing his curses on people.",
      "translation" : "据说他是强大的魔法师，曾用力量诅咒无辜之人。传闻他至今仍四处游荡，诅咒他人。"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "[Ninno]",
      "translation" : "[尼诺]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Juno Despot",
      "state" : "translated",
      "text" : "As an adventurer, it's possible that you may see him in your travels. Be careful...",
      "translation" : "冒险途中你可能会遇见他。千万小心..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "[Le Morpheus]",
      "translation" : "[勒·莫菲斯]"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "Look in my hand. I am holding two different kinds of herbs.",
      "translation" : "看看我手里。我拿着两种不同的草药。"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "[Le Morpheus]",
      "translation" : "[勒·莫菲斯]"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "One is a ^3355FFBlue Herb^000000 which will make you forget about reality and keep you in this virtual reality^000000.",
      "translation" : "一种是^3355FF蓝色药草^000000，能让你忘记现实，继续留在这个虚拟世界^000000。"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "[Le Morpheus]",
      "translation" : "[勒·莫菲斯]"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "The other is a ^FF3355Red Herb^000000 which will reveal to you what is true and real.",
      "translation" : "另一种是^FF3355红色药草^000000，能让你看清真相。"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "[Le Morpheus]",
      "translation" : "[勒·莫菲斯]"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "Whichever one you choose, you must spend ^3355FF5,000 zeny^000000. Now, please select one.",
      "translation" : "无论选哪一种，都要花费^3355FF5,000 ZENY^000000。现在请选择。"
    },
    {
      "kind" : "option",
      "line" : 169,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "Choose ^FF3355Red Herb^000000",
      "translation" : "选择^FF3355红色药草^000000"
    },
    {
      "kind" : "option",
      "line" : 169,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "Choose ^3355FFBlue Herb^000000.",
      "translation" : "选择^3355FF蓝色药草^000000。"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "[Le Morpheus]",
      "translation" : "[勒·莫菲斯]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "As you have chosen, you will forget everything, and remain in this virtual reality.",
      "translation" : "既然你已经做出选择，就会忘记一切，继续留在这个虚拟世界。"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "[Le Morpheus]",
      "translation" : "[勒·莫菲斯]"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "You will see the truth.",
      "translation" : "你会看见真相。"
    },
    {
      "kind" : "message",
      "line" : 187,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "Hmm. I'm sorry to say you just missed a fortunate chance. However, I can tell you don't have enough wealth to bring this fortune to fruition.",
      "translation" : "嗯。很遗憾，你刚刚错过了一次好运。不过，我看得出你没有足够的钱财来实现这份好运。"
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "^3355FFApocalypse^000000...",
      "translation" : "^3355FF天使波利^000000..."
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "It is the name of an android that used to guard Juno long ago.",
      "translation" : "这是很久以前守卫朱诺的一台机器人之名。"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "[Le Morpheus]",
      "translation" : "[勒·莫菲斯]"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Juno Sage",
      "state" : "translated",
      "text" : "Because its artificial intelligence has corrupted over the years, it can no longer distinguish comrades from enemies. Sadly, that android is nothing but a mindless monster now.",
      "translation" : "它的人工智能随着岁月流逝而损坏，已经无法分辨敌我。可悲的是，那台机器人如今只是一头失去理智的魔物。"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "*Mumble mumble...*",
      "translation" : "*嘟囔嘟囔...*"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "Oh, hello there. Let me introduce myself. I am an artisan who tries to succeed the rights and duties of item makers in Juno.",
      "translation" : "哦，你好。让我自我介绍一下。我是一名工匠，想继承朱诺道具制作师的权利与职责。"
    },
    {
      "kind" : "option",
      "line" : 208,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "About Powerful Equipment",
      "translation" : "关于强力装备"
    },
    {
      "kind" : "option",
      "line" : 208,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "About Unique Items",
      "translation" : "关于稀有道具"
    },
    {
      "kind" : "option",
      "line" : 208,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "About Authentic Food",
      "translation" : "关于正宗料理"
    },
    {
      "kind" : "option",
      "line" : 208,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "End Conversation",
      "translation" : "结束对话"
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "Let me suggest the ^3355FFHoly Guard^000000 and ^3355FFHoly Avenger^000000 which are special items for Crusaders.",
      "translation" : "我推荐^3355FF圣职之盾^000000和^3355FF圣者之剑^000000，它们是十字军专用的特殊装备。"
    },
    {
      "kind" : "message",
      "line" : 213,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 214,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "These pieces of equipment are very light and have sufficient abilities. They also happen to possess holy power.",
      "translation" : "这些装备非常轻巧，性能也很出色，而且还拥有圣属性力量。"
    },
    {
      "kind" : "message",
      "line" : 216,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 217,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "Therefore, this equipment is more powerful over some kinds of monsters such as Ghosts or the Undead.",
      "translation" : "因此，它们对幽灵或不死系等某些魔物尤其有效。"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "However it is rumored that only a few chosen Crusaders are able to obtain those items due of their rarity.",
      "translation" : "不过据说这些装备十分稀有，只有少数被选中的十字军才能获得。"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "It looks like a simple scroll marked with concentric circles and a star. Although the ^FF3355Worn-Out Magic Scroll^000000 is very old, it's wanted by many Sages for research purposes.",
      "translation" : "这看起来是一张画着同心圆和星星的简易卷轴。虽然^FF3355陈旧的魔法卷轴^000000年代久远，却有许多贤者想用它来研究。"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "It seems you can use that item when you chant a high-level magic spell.",
      "translation" : "似乎可以在咏唱高级魔法时使用这个道具。"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "^3355FFRice Cake^000000! Yes, it's a traditional food that's favored by a lot of people. There's a lot of nostalgic memories of old fashioned markets that are connected to the Rice Cake.",
      "translation" : "^3355FF年糕^000000！没错，这是一种深受许多人喜爱的传统食物。年糕总让人想起旧时市场的许多怀旧回忆。"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "Ahhh~",
      "translation" : "啊~"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "I wish I could eat a bit of Rice Cake right now.",
      "translation" : "真想现在就吃点年糕。"
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "[Artisan]",
      "translation" : "[工匠]"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Juno Artisan",
      "state" : "translated",
      "text" : "Although Juno is known as a city of Sages, I hope you understand that ordinary people live and prosper here as well. Please enjoy the unique atmosphere that Juno has to offer.",
      "translation" : "虽然朱诺以贤者之城闻名，也希望你明白，普通人同样在这里生活、繁荣。请尽情感受朱诺独特的氛围。"
    },
    {
      "kind" : "message",
      "line" : 245,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 246,
      "state" : "translated",
      "text" : "Welcome to Juno, the city of noble-mindedness.",
      "translation" : "欢迎来到高尚之城朱诺。"
    },
    {
      "kind" : "message",
      "line" : 248,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 249,
      "state" : "translated",
      "text" : "There is a monster near here known as Lava Golem. This golem is made from a stone heart whose power happened to be amplified with magic power when it was swept away by molten rock.",
      "translation" : "附近有一种叫熔岩魔人的魔物。它由石头构成，石心被熔岩卷走时，魔力恰好增强，最终变成了这种魔物。"
    },
    {
      "kind" : "message",
      "line" : 251,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 252,
      "state" : "translated",
      "text" : "The lava dripping from its body is so hot that it can melt down armor and weapons made out of high quality steel.",
      "translation" : "它身上滴落的熔岩极其炽热，能融化用上等钢材打造的防具和武器。"
    },
    {
      "kind" : "message",
      "line" : 254,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 255,
      "state" : "translated",
      "text" : "You'd better be careful when you encounter this monster. It will damage armor and weapons in the twinkling of an eye.",
      "translation" : "遇到这种魔物时最好小心。转眼之间，它就能损坏你的防具和武器。"
    },
    {
      "kind" : "message",
      "line" : 260,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 261,
      "state" : "translated",
      "text" : "Welcome to Juno, the city of noble-mindedness.",
      "translation" : "欢迎来到高尚之城朱诺。"
    },
    {
      "kind" : "message",
      "line" : 263,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 264,
      "state" : "translated",
      "text" : "Geographer...",
      "translation" : "地理学者..."
    },
    {
      "kind" : "message",
      "line" : 265,
      "state" : "translated",
      "text" : "That monster looks like a flower blooming from the ground.",
      "translation" : "那种魔物看起来像是从地面长出来的花。"
    },
    {
      "kind" : "message",
      "line" : 267,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 268,
      "state" : "translated",
      "text" : "Strangely, it can extend its body a long distance. Even if you're far away from it, it can still pose a threat.",
      "translation" : "奇怪的是，它能把身体伸得很远。即使你离它很远，仍然会受到威胁。"
    },
    {
      "kind" : "message",
      "line" : 270,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 271,
      "state" : "translated",
      "text" : "The name of this monster originated from a story about a poor geographer who, unfortunately, was eaten by this monster while he was immersed in his studies.",
      "translation" : "这种魔物的名字源自一个故事：一位可怜的地理学者专心研究时，不幸被它吞掉了。"
    },
    {
      "kind" : "message",
      "line" : 276,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 277,
      "state" : "translated",
      "text" : "Welcome to Juno, the city of noble-mindedness.",
      "translation" : "欢迎来到高尚之城朱诺。"
    },
    {
      "kind" : "message",
      "line" : 279,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 280,
      "state" : "translated",
      "text" : "Near Juno, there exists a fallen angel named 'False Angel.' It feigns innocence, pretending to bless adventurers and then stabbing them in the back without any warning.",
      "translation" : "朱诺附近有一种堕落天使，名叫“伪天使”。它装出纯洁的样子，假意祝福冒险者，再毫无预警地从背后袭击。"
    },
    {
      "kind" : "message",
      "line" : 282,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 283,
      "state" : "translated",
      "text" : "Don't be fooled by its appearance, or you'll find yourself in trouble.",
      "translation" : "别被它的外表骗了，否则你会惹上麻烦。"
    },
    {
      "kind" : "message",
      "line" : 288,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 289,
      "state" : "translated",
      "text" : "Welcome to Juno, the city of noble-mindedness.",
      "translation" : "欢迎来到高尚之城朱诺。"
    },
    {
      "kind" : "message",
      "line" : 291,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 292,
      "state" : "translated",
      "text" : "'Goat' is a monster that was an antelope living in the high mountains that was somehow turned into a monster.",
      "translation" : "“山羊”是一种魔物。它原本是生活在高山上的羚羊，不知为何变成了魔物。"
    },
    {
      "kind" : "message",
      "line" : 294,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 295,
      "state" : "translated",
      "text" : "Even if you manage to dodge to its horns, you still need to be wary of its powerful legs.",
      "translation" : "就算你设法躲开它的角，也要提防它强劲的双腿。"
    },
    {
      "kind" : "message",
      "line" : 297,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 298,
      "state" : "translated",
      "text" : "Goat's legs are so strong because it's always climbing cliffs when it's not busy slaughtering the innocent.",
      "translation" : "山羊的腿如此有力，是因为它不忙着屠杀无辜者时，总在攀爬峭壁。"
    },
    {
      "kind" : "message",
      "line" : 303,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 304,
      "state" : "translated",
      "text" : "Welcome to Juno, the city of noble-mindedness.",
      "translation" : "欢迎来到高尚之城朱诺。"
    },
    {
      "kind" : "message",
      "line" : 306,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 307,
      "state" : "translated",
      "text" : "Have you ever",
      "translation" : "你见过"
    },
    {
      "kind" : "message",
      "line" : 308,
      "state" : "translated",
      "text" : "seen a Large Jellopy?",
      "translation" : "大型杰洛米吗？"
    },
    {
      "kind" : "message",
      "line" : 309,
      "state" : "translated",
      "text" : "Those things are huuuge!",
      "translation" : "那东西可大——得惊人！"
    },
    {
      "kind" : "message",
      "line" : 311,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 312,
      "state" : "translated",
      "text" : "It's hard to believe",
      "translation" : "真难以置信，"
    },
    {
      "kind" : "message",
      "line" : 313,
      "state" : "translated",
      "text" : "that such a large and",
      "translation" : "竟然有这么大、"
    },
    {
      "kind" : "message",
      "line" : 314,
      "state" : "translated",
      "text" : "shining jellopy even exists!",
      "translation" : "还闪闪发亮的杰洛米！"
    },
    {
      "kind" : "message",
      "line" : 319,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 320,
      "state" : "translated",
      "text" : "Welcome to Juno, the city of noble-mindedness.",
      "translation" : "欢迎来到高尚之城朱诺。"
    },
    {
      "kind" : "message",
      "line" : 322,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 323,
      "state" : "translated",
      "text" : "Among the Sage's weapons, there is a 'Dagger of Counter.'",
      "translation" : "贤者使用的武器中，有一种叫“反击短剑”。"
    },
    {
      "kind" : "message",
      "line" : 325,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 326,
      "state" : "translated",
      "text" : "Its use is limited to the Sage class, and it increases the chance of inflicting critical attacks. So, for Sages, that dagger can be very useful, as well as make them look stylish in battle.",
      "translation" : "它只限贤者使用，并能提高造成暴击的几率。因此，这把短剑对贤者来说既实用，在战斗中也很时髦。"
    },
    {
      "kind" : "message",
      "line" : 331,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 332,
      "state" : "translated",
      "text" : "Welcome to Juno, the city of noble-mindedness.",
      "translation" : "欢迎来到高尚之城朱诺。"
    },
    {
      "kind" : "message",
      "line" : 334,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 335,
      "state" : "translated",
      "text" : "There is a holy shield named 'Sacred Mission' which can only be used by Crusaders.",
      "translation" : "有一面名为“神圣使命”的圣盾，只有十字军能够使用。"
    },
    {
      "kind" : "message",
      "line" : 337,
      "state" : "translated",
      "text" : "[Juno Soldier]",
      "translation" : "[朱诺士兵]"
    },
    {
      "kind" : "message",
      "line" : 338,
      "state" : "translated",
      "text" : "It's a long and narrow shield with an angel wing engraved in the center of the front side. Against Devil and Undead monsters, it is especially powerful.",
      "translation" : "这是一面狭长的盾牌，正面中央刻有天使之翼。它对恶魔系和不死系魔物尤其有效。"
    },
    {
      "kind" : "message",
      "line" : 343,
      "npc" : "Airship Representative",
      "state" : "translated",
      "text" : "[Airship Representative]",
      "translation" : "[飞艇服务员]"
    },
    {
      "kind" : "message",
      "line" : 344,
      "npc" : "Airship Representative",
      "state" : "translated",
      "text" : "Good day, I am here to inform you",
      "translation" : "您好，我来向您介绍"
    },
    {
      "kind" : "message",
      "line" : 345,
      "npc" : "Airship Representative",
      "state" : "translated",
      "text" : "about the Juno Airship which",
      "translation" : "我们计划近期运营的"
    },
    {
      "kind" : "message",
      "line" : 346,
      "npc" : "Airship Representative",
      "state" : "translated",
      "text" : "we plan to operate in the near future.",
      "translation" : "朱诺飞艇。"
    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "Airship Representative",
      "state" : "translated",
      "text" : "[Air ship Representative]",
      "translation" : "[飞艇服务员]"
    },
    {
      "kind" : "message",
      "line" : 349,
      "npc" : "Airship Representative",
