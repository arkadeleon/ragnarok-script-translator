      "line" : 106,
      "npc" : "Undead Familiar",
      "state" : "translated",
      "text" : "Mwahahaha~",
      "translation" : "哇哈哈哈~"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Undead Familiar",
      "state" : "translated",
      "text" : "Foolish mortal!",
      "translation" : "愚蠢的凡人！"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Undead Familiar",
      "state" : "translated",
      "text" : "Beware my powers!",
      "translation" : "尝尝我的力量吧！"
