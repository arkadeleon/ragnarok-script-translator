    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Where...where am I...?",
      "translation" : "我...我在哪里...？"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I remember I was sleeping",
      "translation" : "我记得我当时在睡觉，"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Child",
      "state" : "translated",
      "text" : "and when I woke up, I was here...",
      "translation" : "醒来后就到了这里..."
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Mommy, have you seen my mommy?",
      "translation" : "妈妈，你看到我妈妈了吗？"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I wanna go home...*Sob*",
      "translation" : "我想回家...*啜泣*"
    },
    {
      "kind" : "option",
      "line" : 120,
      "npc" : "Child",
      "state" : "translated",
      "text" : "About the witch",
      "translation" : "关于女巫"
    },
    {
      "kind" : "option",
      "line" : 120,
      "npc" : "Child",
      "state" : "translated",
      "text" : "About the curse",
      "translation" : "关于诅咒"
    },
    {
      "kind" : "option",
      "line" : 120,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Witch...? I've never seen a witch, but I've read about them in books. I'm not sure if they exist or not, but it would be so horrifying if they did...",
      "translation" : "女巫...？我从没见过女巫，只在书里读到过。我不确定她们是不是真的存在，但要是真的有，那一定很可怕..."
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Why is it so cold in here...?",
      "translation" : "这里为什么这么冷...？"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Child",
      "state" : "translated",
      "text" : "A-aren't you cold, or even scared? I wanna go home... It's warm over there. Could you help me get back... Please...? H-help me...",
      "translation" : "你...你不冷吗？不害怕吗？我想回家...那里很温暖。你能帮我回去吗...求求你...帮...帮帮我..."
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Child",
      "state" : "translated",
      "text" : "A c-curse...?",
      "translation" : "诅...诅咒...？"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Child",
      "state" : "translated",
      "text" : "My grandma says that there are lots of curses in the world. Some of them, you can tell it's a curse. But there are other curses that follow you throughout life...",
      "translation" : "奶奶说世界上有很多诅咒。有些一看就知道是诅咒，但还有一些会伴随你一生..."
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Grandma says curses can take other forms... Like if someone's always mad at you, and won't forgive you, you can see that as a curse too.",
      "translation" : "奶奶说诅咒也会以其他形式出现...比如有人总是生你的气，不肯原谅你，你也可以把那看作一种诅咒。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Child",
      "state" : "translated",
      "text" : "My grandma told me there's only one spell that can break a strong curse that you can't lift with Blessings...",
      "translation" : "奶奶告诉我，有一种咒语可以解除强大的诅咒，即使用祝福也无法消除的那种..."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Klaatu...",
      "translation" : "克拉图..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Verata.....",
      "translation" : "维拉塔..."
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Ne...ni...umm...?",
      "translation" : "尼...尼...嗯...？"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Child",
      "state" : "translated",
      "text" : "What was the last part?",
      "translation" : "最后一句是什么来着？"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I-I can't remember",
      "translation" : "我...我想不起来"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Child",
      "state" : "translated",
      "text" : "the last part of the spell!",
      "translation" : "咒语的最后一句了！"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Child",
      "state" : "translated",
      "text" : "If you repeat the spell in that order, it will release you from someone's anger and hate. And if you do it near a bad spirit, they might get the curse instead.",
      "translation" : "按顺序念出咒语，就能让你摆脱某人的愤怒和憎恨。如果在恶灵附近念，它们可能会代替你承受诅咒。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Why are you asking me about these scary kind of things...? I just wanna go home...",
      "translation" : "你为什么问我这些可怕的事情...？我只想回家..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Child",
      "state" : "translated",
      "text" : "It's so cold in here...",
      "translation" : "这里好冷..."
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I'm freezing...",
      "translation" : "我快冻僵了..."
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Child",
      "state" : "translated",
      "text" : "And I wanna go home and",
      "translation" : "我想回家，"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Child",
      "state" : "translated",
      "text" : "get away from this scary place...",
      "translation" : "离开这个可怕的地方..."
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Please... help me.",
      "translation" : "求求你...帮帮我。"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Could you take me with you...?",
      "translation" : "你能带我一起走吗...？"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Cursed Spirit",
      "state" : "translated",
      "text" : "[Ashe Bruce]",
      "translation" : "[阿什·布鲁斯]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Cursed Spirit",
      "state" : "translated",
      "text" : "I sense you're cursed",
      "translation" : "我感觉到你中了"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Cursed Spirit",
      "state" : "translated",
      "text" : "by a powerful spell...",
      "translation" : "强大的咒语..."
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Cursed Spirit",
      "state" : "translated",
      "text" : "Hmm... It's clear what",
      "translation" : "嗯...我知道"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Cursed Spirit",
