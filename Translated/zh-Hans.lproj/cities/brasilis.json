      "translation" : "[船员]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "state" : "translated",
      "text" : "Cool~!! Let's go~!",
      "translation" : "太棒了~！！出发吧~！"
    },
    {
      "kind" : "message",
      "line" : 47,
      "state" : "translated",
      "text" : "[Crewman]",
      "translation" : "[船员]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "Well if you're ever interested, let me know and I can take you there.",
      "translation" : "如果你哪天想去，告诉我一声，我可以带你过去。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "[Crewman]",
      "translation" : "[船员]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "My ship is going to back to Alberta, do you want to join us?",
      "translation" : "我的船正要返回艾尔贝塔，你想和我们一起走吗？"
    },
    {
      "kind" : "option",
      "line" : 57,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "Go back to Alberta.",
      "translation" : "返回艾尔贝塔。"
    },
    {
      "kind" : "option",
      "line" : 57,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "Not yet~.",
      "translation" : "还不要~。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "[Crewman]",
      "translation" : "[船员]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "I sure do miss home.",
      "translation" : "我真想念家乡。"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "[Crewman]",
      "translation" : "[船员]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Crewman",
      "state" : "translated",
      "text" : "Ok, suit yourself. We'll see you when we get back then.",
      "translation" : "好吧，随你。那我们回来时再见。"
