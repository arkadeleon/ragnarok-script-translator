    },
    {
      "kind" : "message",
      "line" : 18,
      "state" : "translated",
      "text" : "Hey, have you heard of a place called Brasilis?",
      "translation" : "喂，听说过一个叫巴西利斯的地方吗？"
    },
    {
      "kind" : "message",
      "line" : 19,
      "state" : "translated",
      "text" : "It's a tropical city that's hot like the desert but also rainy. It is a very mysterious place.",
      "translation" : "那里是座热带城市，像沙漠一样炎热，却又多雨，是个非常神秘的地方。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "state" : "translated",
      "text" : "[Crewman]",
      "translation" : "[船员]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "state" : "translated",
      "text" : "We recently found a new ocean route to get there easily.",
      "translation" : "我们最近发现了一条新的海上航线，可以轻松抵达那里。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "state" : "translated",
      "text" : "It's just 10,000 zeny for a round trip, and 1,000 for VIP! So do you want to go?",
      "translation" : "往返只要10,000金币，VIP只要1,000金币！想去吗？"
    },
    {
      "kind" : "message",
      "line" : 28,
      "state" : "translated",
      "text" : "It's just 10,000 zeny for a round trip! So do you want to go?",
      "translation" : "往返只要10,000金币！想去吗？"
    },
    {
      "kind" : "option",
      "line" : 31,
      "state" : "translated",
      "text" : "Take me to Brasilis!",
      "translation" : "带我去巴西利斯！"
    },
    {
      "kind" : "option",
      "line" : 31,
      "state" : "translated",
      "text" : "I'll stay here.",
      "translation" : "我留在这里。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "state" : "translated",
      "text" : "[Crewman]",
      "translation" : "[船员]"
    },
    {
