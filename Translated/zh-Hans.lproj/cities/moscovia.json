{
  "file" : "npc/cities/moscovia.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "state" : "translated",
      "text" : "Moscovia! Do you know Moscovia?",
      "translation" : "莫斯科比亚！你听说过莫斯科比亚吗？"
    },
    {
      "kind" : "message",
      "line" : 22,
      "state" : "translated",
      "text" : "the paradise spreading on the endless seas...",
      "translation" : "那是无尽海洋中绵延展开的天堂..."
    },
    {
      "kind" : "message",
      "line" : 23,
      "state" : "translated",
      "text" : "Welcome to Moscovia",
      "translation" : "欢迎来到莫斯科比亚"
    },
    {
      "kind" : "message",
      "line" : 24,
      "state" : "translated",
      "text" : "It's adventurous and mystic.",
      "translation" : "这里充满冒险与神秘。"
    },
    {
      "kind" : "option",
      "line" : 26,
      "state" : "translated",
      "text" : "About Moscovia...",
      "translation" : "关于莫斯科比亚..."
    },
    {
      "kind" : "option",
      "line" : 26,
      "state" : "translated",
      "text" : "Go to Moscovia.",
      "translation" : "前往莫斯科比亚。"
    },
    {
      "kind" : "option",
      "line" : 26,
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 28,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "state" : "translated",
      "text" : "Moscovia is a beautiful kingdom",
      "translation" : "莫斯科比亚是一个美丽的王国"
    },
    {
      "kind" : "message",
      "line" : 30,
      "state" : "translated",
      "text" : "on an island located north of Rune-",
      "translation" : "它位于一座岛上，岛在卢恩-"
    },
    {
      "kind" : "message",
      "line" : 31,
      "state" : "translated",
      "text" : "Midgarts.",
      "translation" : "米德加尔特以北。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "state" : "translated",
      "text" : "I'm sure that you will be",
      "translation" : "我相信你一定会"
    },
    {
      "kind" : "message",
      "line" : 35,
      "state" : "translated",
      "text" : "absolutely fascinated",
      "translation" : "完全为之着迷"
    },
    {
      "kind" : "message",
      "line" : 36,
      "state" : "translated",
      "text" : "by Moscovia's beautiful scenery",
      "translation" : "莫斯科比亚美丽的风景"
    },
    {
      "kind" : "message",
      "line" : 37,
      "state" : "translated",
      "text" : "and gorgeous palace.",
      "translation" : "以及宏伟的宫殿。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "state" : "translated",
      "text" : "Now that our long winter has",
      "translation" : "漫长的冬天终于"
    },
    {
      "kind" : "message",
      "line" : 41,
      "state" : "translated",
      "text" : "passed,",
      "translation" : "过去了，"
    },
    {
      "kind" : "message",
      "line" : 42,
      "state" : "translated",
      "text" : "I'm happy that I can now show you",
      "translation" : "我很高兴现在能带你看看"
    },
    {
      "kind" : "message",
      "line" : 43,
      "state" : "translated",
      "text" : "our gorgeous hometown.",
      "translation" : "我们美丽的家乡。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "state" : "translated",
      "text" : "If you feel like visiting Moscovia",
      "translation" : "如果你想游览莫斯科比亚"
    },
    {
      "kind" : "message",
      "line" : 47,
      "state" : "translated",
      "text" : "take the chance now!",
      "translation" : "现在就抓住机会吧！"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "I'll help you to have a nice trip",
      "translation" : "我会帮你开启一段愉快的"
    },
    {
      "kind" : "message",
      "line" : 49,
      "state" : "translated",
      "text" : "to Moscovia!",
      "translation" : "莫斯科比亚之旅！"
    },
    {
      "kind" : "message",
      "line" : 53,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "state" : "translated",
      "text" : "Ok then, let us start now.",
      "translation" : "好吧，那我们现在出发。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "state" : "translated",
      "text" : "You should pay me 10,000 zeny",
      "translation" : "你需要支付我10,000 Zeny"
    },
    {
      "kind" : "message",
      "line" : 56,
      "state" : "translated",
      "text" : "to go to Moscovia.",
      "translation" : "才能前往莫斯科比亚。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "state" : "translated",
      "text" : "But when you come back,",
      "translation" : "不过回来时"
    },
    {
      "kind" : "message",
      "line" : 58,
      "state" : "translated",
      "text" : "you don't have to pay.",
      "translation" : "你不必付钱。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "state" : "translated",
      "text" : "Can we leave now?",
      "translation" : "我们现在可以出发了吗？"
    },
    {
      "kind" : "option",
      "line" : 63,
      "state" : "translated",
      "text" : "Let's go!",
      "translation" : "出发吧！"
    },
    {
      "kind" : "option",
      "line" : 63,
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 64,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "state" : "translated",
      "text" : "If you're too busy now,",
      "translation" : "如果你现在太忙，"
    },
    {
      "kind" : "message",
      "line" : 66,
      "state" : "translated",
      "text" : "please tell me again whenever you want.",
      "translation" : "想去的时候再来找我就行。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "state" : "translated",
      "text" : "I'm always ready to guide anyone to Moscovia.",
      "translation" : "我随时都能带你去莫斯科比亚。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "state" : "translated",
      "text" : "I'm sorry but you don't have",
      "translation" : "很抱歉，你现在没有足够的"
    },
    {
      "kind" : "message",
      "line" : 73,
      "state" : "translated",
      "text" : "enough zeny now",
      "translation" : "Zeny。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "state" : "translated",
      "text" : "You need 10,000 zeny",
      "translation" : "你需要10,000 Zeny"
    },
    {
      "kind" : "message",
      "line" : 75,
      "state" : "translated",
      "text" : "to go to Moscovia",
      "translation" : "才能前往莫斯科比亚。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "state" : "translated",
      "text" : "Thank you.",
      "translation" : "谢谢。"
    },
    {
      "kind" : "message",
      "line" : 79,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "state" : "translated",
      "text" : "Ok then, we're leaving now.",
      "translation" : "好吧，那我们现在出发。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "state" : "translated",
      "text" : "If you're too busy now,",
      "translation" : "如果你现在太忙，"
    },
    {
      "kind" : "message",
      "line" : 89,
      "state" : "translated",
      "text" : "please tell me again whenever you want.",
      "translation" : "想去的时候再来找我就行。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "state" : "translated",
      "text" : "I'm always ready to guide anyone to Moscovia.",
      "translation" : "我随时都能带你去莫斯科比亚。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "How was your trip?",
      "translation" : "旅途怎么样？"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Do you have good memories from Moscovia?",
      "translation" : "你在莫斯科比亚留下了美好的回忆吗？"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "A ship is now leaving",
      "translation" : "一艘船即将启航"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "for Rune-Midgarts.",
      "translation" : "前往卢恩米德加尔特。"
    },
    {
      "kind" : "option",
      "line" : 102,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Return to Alberta",
      "translation" : "返回艾尔贝塔"
    },
    {
      "kind" : "option",
      "line" : 102,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "If you want to see more",
      "translation" : "如果你还想四处看看"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "please take your time.",
      "translation" : "请慢慢来。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亚宣传员]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Please come and visit soon.",
      "translation" : "请尽快再来游玩。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Ok then, Let's get going.",
      "translation" : "好吧，我们出发吧。"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Our dear Csar Alexsay III is in the palace.",
      "translation" : "我们敬爱的沙皇阿列克谢三世在宫殿里。"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "He rules over Moscovia.",
      "translation" : "他统治着莫斯科比亚。"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Please be careful not to cause him any trouble.",
      "translation" : "请小心行事，别给他添麻烦。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Please be silent or the Csar will be angry.",
      "translation" : "请保持安静，否则沙皇会生气的。"
    }
  ]
}