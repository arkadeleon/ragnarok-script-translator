    {
      "kind" : "message",
      "line" : 40,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "Do you wish to return to your honorable place?",
      "translation" : "你们想回到自己荣耀的归处吗？"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "Return to the guild castle.",
      "translation" : "返回公会城堡"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "Quit.",
      "translation" : "退出"
