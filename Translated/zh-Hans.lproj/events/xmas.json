    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Merry Christmas!",
      "translation" : "圣诞快乐！"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "I have a gift for you! Ho Ho Ho!",
      "translation" : "我给你准备了一份礼物！吼吼吼！"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "I'm having a bit of a problem...",
      "translation" : "我遇到了一点麻烦..."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Do you care to listen?",
      "translation" : "你愿意听我说说吗？"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Listen to Santa Claus.",
      "translation" : "听圣诞老人说。"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Give Santa Claus proof.",
      "translation" : "给圣诞老人看证据。"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "[Santa Claus]",
      "translation" : "[圣诞老人]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "My problem is this.",
      "translation" : "事情是这样的。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "There seems to be a man out there",
      "translation" : "外面似乎有个人"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "that is impersonating me and spreading",
      "translation" : "冒充我，还在各地散播"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "terror throughout the land.",
      "translation" : "恐慌。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "[Santa Claus]",
      "translation" : "[圣诞老人]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Like the Grinch of legend, he's taking",
      "translation" : "他就像传说中的格林奇，正在把"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "all the childrens' toys and keeping them",
      "translation" : "所有孩子的玩具都拿走，"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "for himself.",
      "translation" : "据为己有。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "[Santa Claus]",
      "translation" : "[圣诞老人]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "I'm too busy here creating my batch of ",
      "translation" : "我正忙着制作明年要送的"
