      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 2",
      "translation" : "传送点2"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 3",
      "translation" : "传送点3"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 4",
      "translation" : "传送点4"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "a grudge against me. Also it costs 5,000 zeny.",
      "translation" : "也别怨我，另外还要支付5,000金币。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Would you really like to take the challenge?",
      "translation" : "你真的想接受挑战吗？"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Ok, just choose the course.",
      "translation" : "好，选一条路线吧。"
    },
    {
