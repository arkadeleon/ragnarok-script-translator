      "state" : "translated",
      "text" : "Fourth",
      "translation" : "第四条路线"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 1",
      "translation" : "传送点1"
    },
    {
      "kind" : "option",
