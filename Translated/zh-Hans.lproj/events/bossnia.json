      "text" : "Third",
      "translation" : "第三条路线"
    },
    {
      "kind" : "option",
      "line" : 111,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Fourth",
      "translation" : "第四条路线"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Take care, boy~",
      "translation" : "小心点，年轻人~"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Don't hold a grudge against me.",
      "translation" : "别怨我。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "You don't have enough money...",
      "translation" : "你的钱不够..."
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Come back when you have at least 5,000 zeny.",
      "translation" : "至少准备5,000金币再回来。"
    }
  ]
