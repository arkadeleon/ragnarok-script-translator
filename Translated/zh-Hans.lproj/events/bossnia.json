{
  "file" : "npc/events/bossnia.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Hello?",
      "translation" : "你好？"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I found some beautiful places",
      "translation" : "我在环游世界时"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "while I travelled all over the world.",
      "translation" : "发现了不少美丽的地方。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I am an adventurer.",
      "translation" : "我是一名冒险者。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Haha~",
      "translation" : "哈哈~"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "What? My name is...",
      "translation" : "什么？我的名字是..."
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "'Bossnia Staff'?? No no...",
      "translation" : "“Boss尼亚工作人员”？不不..."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Well, my name is not so important.",
      "translation" : "嗯，我的名字没那么重要。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Sometimes you should be generous.",
      "translation" : "有时候应该大方一点。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "No time for considering that kind of small stuff",
      "translation" : "专心处理更重要的事情时，"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "when you have to concentrate on more important things.",
      "translation" : "就别计较这些小事了。"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Hum... anyway I want to say... something..",
      "translation" : "嗯...总之我想说...有件事..."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "While I was travelling through some places,",
      "translation" : "我在旅行途中，"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I found a really fearful place.",
      "translation" : "发现了一个非常可怕的地方。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Most of the time when you come to a place,",
      "translation" : "通常你去到一个地方时，"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "there is one strong and fearful monster.",
      "translation" : "那里会有一只强大又可怕的魔物。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Isn't it?",
      "translation" : "对吧？"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "But... but... in there...",
      "translation" : "但...但是...那里..."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "There are lots of fearful and strong monsters in there...",
      "translation" : "有很多可怕又强大的魔物..."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "That was really frightful.",
      "translation" : "真是吓坏我了。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "If I had reacted a bit later... a few seconds...",
      "translation" : "如果我反应再慢一点...哪怕几秒..."
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I might have been killed.",
      "translation" : "可能就被杀掉了。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "What?",
      "translation" : "什么？"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "You want to go in there?",
      "translation" : "你想进去？"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Oh~ Boy~ you didn't get me.",
      "translation" : "哦~天哪~你可真没听懂我的话。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "In there.......",
      "translation" : "那里..."
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Uh... you already know?",
      "translation" : "咦...你已经知道了？"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Although you know the place, you want to go in...",
      "translation" : "你明知道那个地方，还想进去..."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Good, I will send you there.",
      "translation" : "好吧，我送你过去。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "But after you went there, don't hold",
      "translation" : "不过进去之后，可别"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "a grudge against me. It'll cost you 1 Reset Stone for 5 access.",
      "translation" : "怨我。每5次入场需要1颗重置石。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉丝]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Bossnia Staff",
      "placeholders" : [
        "bossnia_event"
      ],
      "state" : "translated",
      "text" : "Remaining access: {0}",
      "translation" : "剩余入场次数：{0}"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Do you want to go?",
      "translation" : "要进去吗？"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "You don't have a ticket now.....",
      "translation" : "你现在没有入场券..."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "So come to me again with a Reset Stone later.",
      "translation" : "之后带着重置石再来找我。"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Enter",
      "translation" : "进入"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Leave",
      "translation" : "离开"
    },
    {
