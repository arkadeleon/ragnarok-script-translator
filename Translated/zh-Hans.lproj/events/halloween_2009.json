      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究员]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "I've been studying about an upgraded Pumpkin Hat.",
      "translation" : "我一直在研究强化版南瓜帽。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "I have discovered that it is a very simple process.",
      "translation" : "我发现制作过程非常简单。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究员]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "The process is quite simple.",
      "translation" : "过程很简单。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "If you bring me ^4a4aff20 Jack o' Pumpkin^000000 I can show you.",
      "translation" : "只要给我^4a4aff20个南瓜^000000，我就能演示给你看。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "Isn't that a tempting proposal?",
      "translation" : "这个提议很诱人吧？"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究员]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "This upgraded pumpkin hat is powerful stuff!",
      "translation" : "这顶强化南瓜帽可厉害了！"
