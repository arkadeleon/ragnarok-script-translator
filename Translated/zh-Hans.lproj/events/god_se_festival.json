      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This is the flower.",
      "translation" : "就是这朵花。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This is just a formality, but let me check your qualifications.",
      "translation" : "虽然只是例行公事，还是让我确认一下你的资格。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Your qualification is verified as a Guild master.",
      "translation" : "已确认，你是公会会长。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I wonder if you know what this flower's use is... Let me explain it to you.",
      "translation" : "不知道你是否了解这朵花的用途...让我解释一下。"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This is the holy flower given by the Wish Maiden in Valkyrie, it can summon certain monsters by certain summoners.",
      "translation" : "这是战乙女祈望女神赐予的圣花，特定的召唤师可以用它召唤特定的魔物。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "There are only two summoners in this world...",
      "translation" : "这个世界上只有两位召唤师..."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Me and my sister Rhehe...",
      "translation" : "我和我的妹妹雷赫..."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "We are totllly different, but we can...",
      "translation" : "我们完全不同，但我们可以..."
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "...................................",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Anyway,",
      "translation" : "总之，"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Do you want to summon monsters?",
      "translation" : "你想召唤魔物吗？"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Do not summon",
      "translation" : "不召唤"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Summon, please",
      "translation" : "请召唤"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I don't like to be interrupted by others..",
      "translation" : "我不喜欢被别人打断.."
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "But it's just business.",
      "translation" : "但这只是公事。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I will explain to you how to summon monsters.",
      "translation" : "我来向你解释如何召唤魔物。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This flower can summon the monsters 'Valkyrie's Blessing' and 'Valkyrie's Present' for one hour here in Juno.",
      "translation" : "这朵花可以在朱诺召唤“瓦尔基里的赐福”和“瓦尔基里的礼物”，持续一小时。"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "An announcement will be made stating which monster is summoned.",
      "translation" : "届时会发布公告，说明召唤的是哪种魔物。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This festival is given by the Wish maiden for all adventurers to enjoy all over the world.",
      "translation" : "这是祈望女神为世界各地的冒险者准备的庆典，让大家一起尽兴。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Now, are you ready to summon monsters?",
      "translation" : "那么，你准备好召唤魔物了吗？"
    },
    {
      "kind" : "option",
      "line" : 101,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "No, I'm not ready now.",
      "translation" : "还没准备好"
    },
    {
      "kind" : "option",
      "line" : 101,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Yes! I'm ready for that.",
      "translation" : "准备好了"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "If you are not ready, why did you come to me?",
      "translation" : "如果你还没准备好，为什么还要来找我？"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I'll be waiting until you are ready.",
      "translation" : "我会等你准备好。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "It is just business afterall.",
      "translation" : "毕竟这只是公事。"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Now we are ready.",
      "translation" : "现在，我们准备好了。"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Ok, we would ge started to summon monsters.",
      "translation" : "好的，我们要开始召唤魔物了。"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Have a good time.",
      "translation" : "祝你玩得愉快。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "It seems that a Valkyrie's Blessing summoning ritual is already in progress elsewhere.",
      "translation" : "似乎其他地方已经有人在进行“瓦尔基里的赐福”召唤仪式了。"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Please try again later.",
      "translation" : "请稍后再试。"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "It seems you are not worthy.",
      "translation" : "看来你并不具备资格。"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I don't know how you obtained that flower, but if you're not capable of leading others.. then you cannot continue.",
      "translation" : "我不知道你是怎么得到那朵花的，但如果你没有能力领导他人...那你就无法继续了。"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Too tough?",
      "translation" : "太难了吗？"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Well, what can you do, that's part of the job.",
      "translation" : "唉，没办法，这也是工作的一部分。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[尔米米·拉维斯]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Don't you have any voucher?",
      "translation" : "你没有凭证吗？"
    },
    {
