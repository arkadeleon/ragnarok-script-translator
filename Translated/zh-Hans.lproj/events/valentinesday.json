{
  "file" : "npc/events/valentinesday.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Guess what I've got?",
      "translation" : "猜猜我这里有什么？"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "A tasty treat not easily found in Midgard....",
      "translation" : "米德加尔特不容易买到的美味甜点..."
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Chocolate!",
      "translation" : "巧克力！"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "That's right, don't you love chocolate.... I do.",
      "translation" : "没错，你不喜欢巧克力吗...我可喜欢了。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "And you are in luck, because I'm selling them for only 5,000 zeny a piece!",
      "translation" : "而且你运气很好，我只卖5,000金币一块！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I want some chocolate!",
      "translation" : "我想要巧克力！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不了，谢谢。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You don't want any chocolate?",
      "translation" : "你不想要巧克力吗？"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm telling you! You'll regret it!",
      "translation" : "我告诉你！你会后悔的！"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You better get some now... you won't come across Chocolate like this ever again!",
      "translation" : "现在最好买一些...这种巧克力你再也遇不到了！"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Think it over and visit me again sometime.",
      "translation" : "想好了再来找我吧。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Hah!",
      "translation" : "哈！"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I knew it!",
      "translation" : "我就知道！"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "But I can't sell you more than 5 at once... but, if you really need more....",
      "translation" : "不过我一次最多只能卖5块...但如果你真的还想要更多..."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "you can come back again.",
      "translation" : "可以再回来买。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "So how many do you want?",
      "translation" : "那么你要几块？"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm sorry, but I can't give you that many.",
      "translation" : "抱歉，我不能给你那么多。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm sorry, but it seems you can't afford to buy these off me.",
      "translation" : "抱歉，看来你买不起这些巧克力。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "There you go!",
      "translation" : "给你！"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You can give that to someone as a gift, or enjoy it yourself!",
      "translation" : "你可以送给别人，也可以自己享用！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Mmm... sweet chocolate...",
      "translation" : "嗯...甜甜的巧克力..."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Visit me anytime...!",
      "translation" : "随时欢迎再来...！"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "You know what? The chocolate that my boyfriend sells are from me!",
      "translation" : "你知道吗？我男朋友卖的巧克力其实是我做的！"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I made them by myself.",
      "translation" : "都是我亲手制作的。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "You know ... In cetain countries, there's a tradition of presenting chocolates to a person that you love...",
      "translation" : "你知道吗...在某些国家，人们有个传统，会把巧克力送给心爱的人..."
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "They call it, ^3355FFValentine's Day^000000.",
      "translation" : "他们称之为^3355FF情人节^000000。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "So I gave him my delicious chocolate...",
      "translation" : "所以我把自己做的美味巧克力送给了他..."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "And then he made me cook a lot more...",
      "translation" : "结果他让我做了更多..."
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "And now he is selling them to everyone.",
      "translation" : "现在他把巧克力卖给所有人。"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I guess he really enjoyed it.",
      "translation" : "我想他真的很喜欢。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "But, I do feel good when people buy something I have made.",
      "translation" : "不过，看到大家买我做的东西，我也很开心。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[杰妮]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "It would be great if you bought some too...",
      "translation" : "如果你也买一些就好了..."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I will be making chocolates for a while so...",
      "translation" : "我还会做一阵子巧克力，所以..."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Yes?",
      "translation" : "是吗？"
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I want some hand made chocolate...",
      "translation" : "我想要手工巧克力..."
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I'm lost, sorry to bother you.",
      "translation" : "我迷路了，抱歉打扰你。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Oh... well, if you want me to make some of my special Hand Made Chocolate....",
      "translation" : "哦...好吧，如果你想要我做一些特别的手工巧克力..."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "You will need to give me at least ^0000FF 3 Chocolates^000000.",
      "translation" : "你至少要给我^0000FF 3块巧克力^000000。"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "That's right, only ^0000FF 3 Chocolates^000000",
      "translation" : "没错，只要^0000FF 3块巧克力^000000"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Bring them to me and you'll get what you came for.",
      "translation" : "把它们带给我，你就能拿到想要的东西。"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "See You.",
      "translation" : "再见。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Well, I just might be able to fulfill your needs...",
      "translation" : "嗯，我也许能满足你的需求..."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I'm sorry, you don't have enough Chocolate Bars to do this.",
      "translation" : "抱歉，你的巧克力棒不够，没法制作。"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "You got 3 pieces of pure chocolate, I see.",
      "translation" : "我看你带来了3块纯巧克力。"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Give them to me...",
      "translation" : "把它们给我..."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Ok, now I will only create my special hand made chocolates if you promise to use it wisely.",
      "translation" : "好，现在我只会制作特别的手工巧克力，希望你能好好使用。"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "....Hmmmmmm.....",
      "translation" : "...嗯嗯嗯..."
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Well...",
      "translation" : "那么..."
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Here.",
      "translation" : "给你。"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I hope you give it to someone special, because its a special chocolate.",
      "translation" : "希望你能把它送给特别的人，因为这是一块特别的巧克力。"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "As you know... only I can create this.",
      "translation" : "你知道的...只有我能做出这种巧克力。"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡尔·奥尔良]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Enjoy.",
      "translation" : "享用吧。"
    }
  ]
}