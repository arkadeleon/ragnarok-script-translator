{
  "file" : "npc/events/MemorialDay_2008.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Hey, yo!",
      "translation" : "喂，哟！"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What are you doing there!?",
      "translation" : "你在那儿干什么！？"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Do you know what day it is!?",
      "translation" : "你知道今天是什么日子吗！？"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "It's a very important date!",
      "translation" : "这是个非常重要的日子！"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "A very important date to remember!",
      "translation" : "值得铭记的重要日子！"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What is this!?",
      "translation" : "这是什么！？"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Where is your towel!?",
      "translation" : "你的毛巾呢！？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Lauds",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "My what?",
      "translation" : "我的什么？"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "How are you supposed to go on your trip without your towel!?",
      "translation" : "没有毛巾，你打算怎么去旅行！？"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "If you think this is just another holiday, I'm not going to waste my breath.",
      "translation" : "如果你觉得这不过是又一个节日，那我也懒得费口舌。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "But if you like to pay a tribute to great soldiers, I will help you ready yourself.",
      "translation" : "但如果你想向伟大的战士致敬，我可以帮你做好准备。"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "I guess so...",
      "translation" : "我想也是..."
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Are you crazy or something?",
      "translation" : "你疯了吗？"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Fine, be unprepared!",
      "translation" : "好吧，那你就毫无准备地去吧！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "^FF0000YOU WILL RUE THE DAY!^000000",
      "translation" : "^FF0000你会后悔的！^000000"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Great!",
      "translation" : "很好！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Then listen to me carefully.",
      "translation" : "那就仔细听我说。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Now before you can pay tribute to the fallen soldiers you must be properly equipped.",
      "translation" : "向阵亡的战士致敬之前，你得先做好充分准备。"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Without your towel you will be lost!",
      "translation" : "没有毛巾，你会迷路的！"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "If you bring me the materials, I can make you a towel.",
      "translation" : "把材料带给我，我就能为你做一条毛巾。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Listen closely.",
      "translation" : "仔细听好。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Bring me ^FF000030 Fabric and 20 Fluffs^000000.",
      "translation" : "带给我^FF000030块布和20个绒毛^000000。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What are these? They aren't enough?!",
      "translation" : "这是什么？还不够吗？！"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "*Sigh* Do I really have to tell you again?!",
      "translation" : "*唉* 还要我再说一遍吗？！"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Bring me ^FF000030 Fabric and 20 Fluffs^000000.",
      "translation" : "带给我^FF000030块布和20个绒毛^000000。"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "***Mad Sago Lauds appears to be muttering to himself***",
      "translation" : "***疯癫的萨戈·劳兹似乎正在自言自语***"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "So, did you bring the towel materials?",
      "translation" : "那么，做毛巾的材料带来了吗？"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Excellent; you've brought them all.",
      "translation" : "太好了，材料都带齐了。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Then I shall make you a Towel of Memory as I promised.",
      "translation" : "我这就照约定为你制作一条回忆毛巾。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Give me a moment.",
      "translation" : "稍等一下。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "There you go!",
      "translation" : "给你！"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Ah, you have fluffy new towel now I even put your name on it",
      "translation" : "啊，你有一条蓬松的新毛巾了，我还把你的名字写在上面了"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Say, how do you like to go on a journey to pay a tribute to Memorial Day?",
      "translation" : "对了，你想不想踏上旅程，向阵亡将士纪念日致敬？"
    },
    {
      "kind" : "option",
      "line" : 107,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Sure.",
      "translation" : "好啊。"
    },
    {
      "kind" : "option",
      "line" : 107,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "No, I'm Busy.",
      "translation" : "不行，我很忙。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Don't come crying to me if someone decides to build a highway through your home!",
      "translation" : "要是有人决定在你家上面修公路，可别哭着来找我！"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Good. By the way, do you even know what the towel is for?",
      "translation" : "很好。对了，你知道这条毛巾是做什么用的吗？"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "It seems you're just carrying it without understanding its meaning.",
      "translation" : "看来你只是带着它，却不明白它的意义。"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What a shame! You should go speak to ^FF0000Grast in Prontera^000000.",
      "translation" : "真可惜！去普隆德拉找^FF0000格拉斯特^000000谈谈吧。"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What are you still doing here?",
      "translation" : "你怎么还在这儿？"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "I told you to go speak to Grast in Prontera!",
      "translation" : "我让你去普隆德拉找格拉斯特！"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Go help Grast, and then come back.",
      "translation" : "去帮帮格拉斯特，然后再回来。"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Oh, you've brought them all.",
      "translation" : "哦，你把东西都带来了。"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Hahaha!",
      "translation" : "哈哈哈！"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "HAHAHAHAHAHA!!!! cough cough",
      "translation" : "哈哈哈哈哈哈！！！！咳咳"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Please give them to me. Thank you for your hard work, by the way.",
      "translation" : "把东西给我吧。顺便谢谢你辛苦收集。"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Say, have you learned anything from the journey?",
      "translation" : "对了，你这趟旅程有什么收获吗？"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Now is to go visit the plaque at 12 o'clock direction in Prontera.",
      "translation" : "现在去普隆德拉正北方的纪念碑看看。"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What do you mean you were just there?",
      "translation" : "你说你刚去过那里是什么意思？"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What? Why are you giving me your garbage!",
      "translation" : "什么？你为什么把垃圾给我！"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Those items are not useful to me at all.",
      "translation" : "这些东西对我一点用处也没有。"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "You should be going to the plaque!",
      "translation" : "你该去看纪念碑！"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Stop trying to give me your garbage!",
      "translation" : "别再想把垃圾塞给我了！"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Go to the plaque at 12 o'clock direction in Prontera for your journey!",
      "translation" : "去普隆德拉正北方的纪念碑，开启你的旅程！"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Don't panic!",
      "translation" : "别慌！"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[疯癫的萨戈·劳兹]"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Life... is like a grapefruit.",
      "translation" : "人生...就像葡萄柚。"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "It's orange and squishy, and has a few pips in it, and some folks have half a one for breakfast.",
      "translation" : "它橙黄多汁，里面有几颗籽，有些人还会在早餐时吃半个。"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
