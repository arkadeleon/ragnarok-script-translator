    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "You're carrying too many items in your inventory. Visit Kafra storage and try again.",
      "translation" : "你的物品栏里物品太多了。请先去卡普拉仓库存放物品，再来尝试。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "You cannot proceed because you're overweight.",
      "translation" : "你的负重过高，无法继续。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "My job is to drill a card slot into RWC Memorial accessories.",
      "translation" : "我的工作是为RWC纪念饰品开卡槽。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "I'm sorry but you don't have any item equipped on your right accessory position.",
      "translation" : "抱歉，你右侧饰品栏没有装备任何物品。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "My job is to drill a card slot into RWC Memorial accessories. Moreover, I only treat ^ff0000pure items^000000, or those which have not been enchanted.",
      "translation" : "我的工作是为RWC纪念饰品开卡槽。另外，我只处理^ff0000未附魔的纯净物品^000000。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "However, I can see that the accessory you are wearing on the right side cannot be treated. Please equip a RWC Memorial accessory.",
      "translation" : "不过，你右侧佩戴的饰品不适合处理。请装备RWC纪念饰品。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "You should also know that making a card slot it extremely dangerous. ^ff0000Chances to succeed are about 50%.^000000 Do you wish to proceed?",
      "translation" : "另外，开卡槽非常危险。^ff0000成功率大约为50%。^000000要继续吗？"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "Let's go!",
      "translation" : "开始吧！"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "See ya then.",
      "translation" : "那回头见。"
    },
    {
      "kind" : "message",
      "line" : 61,
