      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "I can't identify the accessory item you're wearing on your right hand. I can't work on it.",
      "translation" : "我无法辨认你右侧佩戴的饰品，不能为它开槽。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[钻孔师]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "This item has already been enchanted. I can't work on this as it is against the rules.",
