      "placeholders" : [
        ".@name$"
      ],
      "state" : "translated",
      "text" : "Yay! Success! Your {0} now has a card slot. Check it out!",
      "translation" : "太好了！成功了！你的{0}现在有卡槽了，快检查一下！"
    },
