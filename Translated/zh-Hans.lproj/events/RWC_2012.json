      "placeholders" : [
        ".@str$"
      ],
      "state" : "translated",
      "text" : "Awww... Damn weak {0}... It broke during the procedure. I'm sorry.",
      "translation" : "啊...可恶，脆弱的{0}...它在处理过程中损坏了。抱歉。"
