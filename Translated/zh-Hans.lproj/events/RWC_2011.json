{
  "file" : "npc/events/RWC_2011.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "You have too many items. Please make room in your inventory and come back.",
      "translation" : "你携带的物品太多了。请整理背包后再回来。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Wow~ Finally!! It's the season we've all been waiting for!",
      "translation" : "哇～终于来了！这可是大家期待已久的季节！"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It's RWC time!",
      "translation" : "RWC大赛开始了！"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "What is RWC?",
      "translation" : "RWC是什么？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Are you a New Agent?",
      "translation" : "你是新任专员吗？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I don't care.",
      "translation" : "我不在乎。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "You must be a new adventurer. I will kindly explain it to you.",
      "translation" : "你一定是刚来的冒险者吧。我来给你介绍一下。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It seems you've traveled quite enough but you're not good with hearing the news around the world.",
      "translation" : "看来你旅行了不少地方，却不太了解世界各地的消息。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "There are few adventurers in Midgard whose lives are dedicated to battle, who never skip their training, live in seclusion, and are experts in their art.",
      "translation" : "米德加尔特有一些冒险者，一生都在战斗，从不间断训练，隐居修行，精通自己的技艺。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "The RWC is the festival where those adventurers can compete with each other and find out who is the best!",
      "translation" : "RWC就是让这些冒险者互相较量、决出最强者的庆典！"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "But this cannot be achieved all alone. Your friends will have a huge role in the competition.",
      "translation" : "不过，单靠一个人可办不到。你的朋友在比赛中会发挥重要作用。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "If you're interested in this festival, start looking for friends you can trust!",
      "translation" : "如果你对这个庆典感兴趣，就去找值得信赖的伙伴吧！"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Many events are organized for RWC promotion every year.",
      "translation" : "每年都会为RWC举办各种宣传活动。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "And this year, a special mission has been entrusted to a new agent... myself!",
      "translation" : "而今年，一项特别任务交给了一位新任专员...那就是我！"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I am supposed to attach blue cards with the letters RWC2011 all over the world to promote the event. But... but...",
      "translation" : "我本该在世界各地贴上印有RWC2011字样的蓝色卡片来宣传活动。可是...可是..."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- He thought of something and then looked at your eyes. -",
      "translation" : "- 他想到了什么，接着看向你的眼睛。 -"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Would you like to listen to my story?",
      "translation" : "你愿意听我说说吗？"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Sure, let me hear it.",
      "translation" : "好啊，说来听听。"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "No, thank you.",
      "translation" : "不了，谢谢。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Arrgg!! Are you ignoring me because I'm new? Usually people listen...",
      "translation" : "啊！你是因为我是新人，才不理我吗？平时大家都会听我说的..."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- New Agent is looking at you with pitiable eyes. -",
      "translation" : "- 新任专员用可怜巴巴的眼神看着你。 -"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- His brimming small eyes seem to tell you something. ^FF0000Please talk to me again...^000000 -",
      "translation" : "- 他那双闪闪发亮的小眼睛仿佛在说：^FF0000请再来和我说说话...^000000 -"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "This is my first mission but people's reaction is not good.",
      "translation" : "这是我的第一次任务，可大家的反应都不太好。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- New Agent is looking at you with pitiable eyes. -",
      "translation" : "- 新任专员用可怜巴巴的眼神看着你。 -"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- His twinkling small eyes seem to tell you something. ^FF0000Please talk to me again...^000000 -",
      "translation" : "- 他那双闪闪发亮的小眼睛仿佛在说：^FF0000请再来和我说说话...^000000 -"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I used to be a very normal boy in Morocc.",
      "translation" : "我以前只是个住在梦罗克的普通男孩。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I am not an adventurer and I don't even know how to buy/sell things. Sometimes I'm just very happy to see adventurers. You know... I am just an ordinary boy.",
      "translation" : "我不是冒险者，甚至连买卖东西都不会。有时看到冒险者，我就特别开心。你知道...我只是个普通男孩。"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "People used to tell me that since I was very shy.",
      "translation" : "因为我很害羞，大家以前总这么说。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I would spend my life in a suburb.",
      "translation" : "我大概会一辈子住在郊区吧。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "But eventually, my patience and restrained personality motivated me to become an agent for RWC2011!",
      "translation" : "不过后来，我凭着耐心和内敛的性格，成为了RWC2011专员！"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I was so happy that I couldn't sleep! I would finally have a chance to meet lots of adventurers and get to know them.",
      "translation" : "我高兴得睡不着！终于有机会见到许多冒险者，和他们认识了。"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "This mission was so important to me,",
      "translation" : "这次任务对我非常重要，"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I was afraid of being attacked by monsters when attaching the blue cards for RWC2011 in the streets.",
      "translation" : "我很怕在街上张贴RWC2011蓝色卡片时被怪物袭击。"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "......",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "And you know what?",
      "translation" : "你猜怎么着？"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "^FF0000It really happened!^000000",
      "translation" : "^FF0000真的发生了！^000000"
    },
    {
      "kind" : "option",
      "line" : 113,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Are you serious!?",
      "translation" : "你没开玩笑吧！？"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I had turned off the light and was trying to get some sleep, then I saw this bright light through the window.",
      "translation" : "我关了灯正准备睡觉，突然看到窗外透进一道亮光。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Suddenly, the window was broken and it appeared!",
      "translation" : "窗户突然碎了，然后它就出现了！"
    },
    {
      "kind" : "option",
      "line" : 118,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It?",
      "translation" : "它？"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It was a shining poring! And it ate all blue cards I had prepared in less than a second!",
      "translation" : "是一只闪闪发光的波利！不到一秒，它就把我准备好的蓝色卡片全吃光了！"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I was so shocked, I tried to calm down and think... I had neither heard about nor seen any shining poring!",
      "translation" : "我吓坏了，努力冷静下来思考...我以前从没听说过，也没见过闪光波利！"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "^FF0000Yes! It must be a dream!^000000 That's the conclusion I came up with and went back to sleep.",
      "translation" : "^FF0000没错！一定是在做梦！^000000我得出这个结论后，就回去睡了。"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "But it wasn't a dream. When I woke up, I realized all the blue cards were gone...",
      "translation" : "可那不是梦。醒来后，我发现蓝色卡片全都不见了..."
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "If I ruin this promotion, I might lose the job and have to go back to where I used to live alone...",
      "translation" : "如果我搞砸了这次宣传，可能会丢掉工作，只能回到以前独自生活的地方..."
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "If you see the Golden Poring, could you please find the precious blue cards for me?",
      "translation" : "如果你看见黄金波利，能帮我找回那些珍贵的蓝色卡片吗？"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- He looks at you with imploring eyes. -",
      "translation" : "- 他用恳求的眼神看着你。 -"
    },
    {
      "kind" : "option",
      "line" : 140,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Ok, I will help you!",
      "translation" : "好，我会帮你！"
    },
    {
      "kind" : "option",
      "line" : 140,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "How much money can you offer me?",
      "translation" : "你能给我多少报酬？"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Have you decided to help me? Well, I will prepare some gifts. I'm sure you'll like them.",
      "translation" : "你决定帮我了吗？我会准备一些礼物，你一定会喜欢的。"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "What you are looking for are large cards with the letters ^FF0000RWC2011^000000. Some of them might already be digested though.",
      "translation" : "你要找的是印有^FF0000RWC2011^000000字样的大卡片。有些可能已经被消化掉了。"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Try to gather remaining cards until you make the word, 'RWC2011'.",
      "translation" : "试着收集剩下的卡片，拼出“RWC2011”吧。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任专员]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Please help me out!! My life is in your hands!",
