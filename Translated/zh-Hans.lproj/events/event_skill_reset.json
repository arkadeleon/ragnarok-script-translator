    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "if you ever want a reset!!",
      "translation" : "随时可以来找我！！"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "This skill reset is not FREE OF CHARGE!!",
      "translation" : "技能重置可不是免费的！！"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Expense for the reset of skill is ^D5A50020000 Zeny x BaseLv^000000.",
      "translation" : "重置技能的费用为^D5A500基础等级×20000 Zeny^000000。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Yeah ...each One BaseLv costs 20000 Zeny to reset skill.",
      "translation" : "没错...每个基础等级需要支付20000 Zeny才能重置技能。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Oh yeah, one more thing!",
      "translation" : "对了，还有一件事！"
