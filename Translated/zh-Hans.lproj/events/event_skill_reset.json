      "kind" : "message",
      "line" : 74,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Any carts, falcons or pecos you have equiped",
      "translation" : "重置技能后，你装备的手推车、猎鹰或大嘴鸟"
