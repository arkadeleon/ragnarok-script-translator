{
  "file" : "npc/events/event_skill_reset.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "I already told you that you may only complete this event once.",
      "translation" : "我已经告诉过你，这个活动只能完成一次。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please return when you reach BaseLv 60 or higher.",
      "translation" : "达到基础等级60级或以上后再来吧。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "You will need to use up all of your skill points if you want me to continue.",
      "translation" : "如果你想让我继续，就必须用完所有技能点。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please come again soon!",
      "translation" : "欢迎很快再来！"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Would you like to reset skills?",
      "translation" : "要重置技能吗？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "I'm sorry, but...",
      "translation" : "抱歉，不过..."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "You cannot reset skills",
      "translation" : "你无法重置技能"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "when you keep",
      "translation" : "如果你携带"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "any items.",
      "translation" : "任何物品。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please, drop your cart and we'll continue.",
      "translation" : "请卸下手推车，我们就继续。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please, free your Falcon and we'll continue.",
      "translation" : "请放走猎鹰，我们就继续。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please, free your PecoPeco and we'll continue.",
      "translation" : "请解除大嘴鸟坐骑，我们就继续。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Come back soon!",
      "translation" : "欢迎再来！"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Hello, I am the Skill Resetter.",
      "translation" : "你好，我是技能重置师。"
