      "kind" : "message",
      "line" : 414,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "[Cain]",
      "translation" : "[凱恩]"
    },
    {
      "kind" : "message",
      "line" : 415,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "I'm talkin' rare items.",
      "translation" : "我說的可是稀有物品。"
    },
    {
      "kind" : "message",
      "line" : 416,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "I took the liberty of sneaking a peek at what she owns, and saw she's got a helmet with goat horns and even a crown! She's so rich it's ridiculous!",
