    {
      "kind" : "option",
      "line" : 45,
      "npc" : "Kachua",
      "state" : "translated",
      "text" : "Would you like to have mine?",
      "translation" : "你想要我的鑽石嗎？"
    },
    {
      "kind" : "option",
      "line" : 45,
      "npc" : "Kachua",
      "state" : "translated",
      "text" : "Ah, what a shame...",
      "translation" : "啊，真遺憾..."
