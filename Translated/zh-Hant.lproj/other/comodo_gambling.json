      "kind" : "message",
      "line" : 437,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "[Cain]",
      "translation" : "[凱恩]"
    },
    {
      "kind" : "message",
      "line" : 438,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "I guess it can't hurt to gather some Diamonds there and try to exchange them for whatever the old lady's got. Take care, pal~",
