      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "No, thanks.",
      "translation" : "不了，謝謝。"
    },
    {
      "kind" : "option",
      "line" : 421,
      "npc" : "Suspicious Guy",
      "state" : "translated",
      "text" : "Sweet, I'm in!",
