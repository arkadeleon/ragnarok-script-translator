    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "- Wait a minute !! -\n- Currently you're carrying -\n- too many items with you. -\n- Please try again -\n- after you lose some weight. -",
      "translation" : "- 請等一下！ -\n- 你攜帶的物品太多了。 -\n- 請減輕負重後再試。 -"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nChildren are not allowed in here.",
      "translation" : "[松武道]\n小孩子不能進來。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nHey hey~ This is not something\nyou can see everyday.\nOh~ you look strong!\nWanna try?",
      "translation" : "[松武道]\n嘿，嘿~ 這可不是天天都能見到的。\n哦~ 你看起來很強壯！\n要不要試試？"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "Why not?",
      "translation" : "試試看"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "?????",
      "translation" : "?????"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不用了，謝謝"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nHaha~ I knew you would try.\nIf you could lift this up,\nI'll tell you something interesting.\nReady?",
      "translation" : "[松武道]\nHaha~ 我就知道你會試。\n能把它舉起來，我就告訴你一件有趣的事。\n準備好了嗎？"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "^0000FFSongmoodoo points to a rock\nand asks you to lift it.",
      "translation" : "^0000FF松武道指著一塊岩石，讓你把它舉起來。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nThat's not a big deal.\nIf you believe you're strong,\nthis might be a good chance to experience\nsomething new. Wanna try??",
      "translation" : "[松武道]\n沒什麼大不了的。\n要是覺得自己夠強，這倒是個體驗新鮮事物的好機會。\n要不要試試？"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nI guess not...",
      "translation" : "[松武道]\n看來不行啊..."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nGood to see you again!\nWanna go??",
      "translation" : "[松武道]\n很高興再次見到你！\n要開始嗎？"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "Sure",
      "translation" : "當然"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "Maybe next time",
      "translation" : "下次再說吧"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Iron man",
      "state" : "translated",
      "text" : "[Songmoodoo]\nGood! Haha.\nI like your confidence.\nGood luck to you~",
      "translation" : "[松武道]\n好！Haha.\n我喜歡你的自信。\n祝你好運~"
