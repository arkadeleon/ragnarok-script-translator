  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凱琪]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Hello there, adventurer.",
      "translation" : "你好，冒險者。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I've been studying magic from all over Rune-Midgarts to upgrade what I believe to be one of the greatest skills available to the acolyte class.",
      "translation" : "我一直在研究盧恩米德加爾特各地的魔法，希望提升我認為是服事者職業最強技能之一的能力。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凱琪]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I am the one and only Acolyte that has attained the Level 10 Warp Portal skill!",
      "translation" : "我是唯一一個將瞬間移動技能練到10級的服事者！"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凱琪]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "That's right! And...",
      "translation" : "沒錯！而且..."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I promise you that I don't forget locations that I have already memorized.",
      "translation" : "我保證不會忘記已經記下來的地點。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "One day I will level up my skills to warp to wherever I please~",
      "translation" : "總有一天，我會提升技能等級，想傳送到哪裡就傳送到哪裡~"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凱琪]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I am willing to warp you to the many locations that I have memorized for a small fee.",
      "translation" : "只要付少量費用，我願意把你送到許多我記下來的地點。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Would you like to use this service?",
      "translation" : "要使用這項服務嗎？"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凱琪]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Where would you like to go to?",
      "translation" : "你想去哪裡？"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I wish you goodluck on your journey.",
      "translation" : "祝你旅途順利。"
    },
    {
      "kind" : "option",
      "line" : 56,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Keiki]",
      "translation" : "[凱琪]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "I'm sorry, but you don't have",
      "translation" : "抱歉，你的"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "enough zeny for the Teleport",
      "translation" : "Zeny 不夠，無法支付傳送"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Service. The fee to teleport",
      "translation" : "服務。傳送費用為"
