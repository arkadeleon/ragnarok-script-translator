    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Isalei]",
      "translation" : "[伊莎蕾]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Hello, adventurer.",
      "translation" : "你好，冒險者。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "My companion Keiki and I have discovered a way to increase our warp portal abilities.",
      "translation" : "我的同伴凱琪和我發現了一種提升瞬間移動能力的方法。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Isalei]",
      "translation" : "[伊莎蕾]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Though I have not mastered up to the level that she has, I have been able to attain Level 5.",
      "translation" : "雖然我還沒有像她那樣掌握更高等級的技能，但已經練到了5級。"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "[Isalei]",
      "translation" : "[伊莎蕾]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Acolyte",
      "state" : "translated",
      "text" : "Maybe one day I can level up my skills enough so that I can use Warp portal to more saved locations.",
      "translation" : "也許有一天，我能把技能練得更高，就可以用瞬間移動前往更多已記錄的地點。"
