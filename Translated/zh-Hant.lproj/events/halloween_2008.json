{
  "file" : "npc/events/halloween_2008.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Kkkkkkkkk!",
      "translation" : "咯咯咯咯！"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "I have a special event this Halloween that tests your luck and agility.",
      "translation" : "今年萬聖節我準備了特別活動，考驗你的運氣和敏捷。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Are you interested?",
      "translation" : "有興趣嗎？"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Come on! Don't be a wuss!",
      "translation" : "來嘛！別當膽小鬼！"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "If you collect enough tickets you can get good prizes!",
      "translation" : "收集足夠的入場券，就能換好東西！"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "So what do you say?",
      "translation" : "怎麼樣？"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You a 'fraidy cat or something?!",
      "translation" : "你是膽小鬼嗎？！"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You know you want to try again...",
      "translation" : "你明明還想再試一次..."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Do you know the rules?",
      "translation" : "知道規則嗎？"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Yes, I know.",
      "translation" : "知道。"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "No, I don't know.",
      "translation" : "不知道。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Oh, well done! You are alright!",
      "translation" : "哦，幹得不錯！你還挺行的！"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Isn't it fun with zombies??",
      "translation" : "和殭屍一起玩很有趣吧？"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You know, zombies were people too!",
      "translation" : "你知道嗎，殭屍以前也是人！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Ha!",
      "translation" : "哈！"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Kkkkkkk.",
      "translation" : "咯咯咯。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "As I promised",
      "translation" : "就像我答應過你的，"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You can get Halloween tickets for cool items.",
      "translation" : "你可以用萬聖節入場券兌換酷炫道具。"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Well, do you want to hear the rules again or, just get back to it...",
      "translation" : "那麼，你想再聽一遍規則，還是直接繼續？"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "This village is like a virtual Payon.",
      "translation" : "這個村子就像虛擬版的斐揚。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "There are zombies and ghouls roaming around and three southern exits, but only one works.",
      "translation" : "有殭屍和食屍鬼四處遊蕩，南邊有三個出口，但只有一個能用。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "That's up to you to find out.",
      "translation" : "哪個出口能用，就由你自己找出來。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You can't use any skills to kill the ghouls or zombies.",
      "translation" : "不能使用任何技能殺死食屍鬼或殭屍。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "And one more thing...",
      "translation" : "還有一件事..."
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "you shouldn't forget...",
      "translation" : "別忘了..."
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "All participants should be wearing nothing.",
      "translation" : "所有參加者都不能穿戴裝備。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Put all belongings in your storage and come back here when your weight is '0'.",
      "translation" : "把所有物品存進倉庫，負重歸零後再回來。"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Oh and one more thing!",
      "translation" : "哦，還有一件事！"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You can't be riding a PecoPeco or have a Cart.",
      "translation" : "不能騎大嘴鳥，也不能推手推車。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "If you are, then I will remove them before you enter.",
      "translation" : "如果你騎著或推著，我會在你進入前幫你卸下來。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Got it?",
      "translation" : "明白了嗎？"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Remember, there are three exits but only one works randomly, the zombies and ghouls roaming around there can't be killed and you can't be wearing anything.",
      "translation" : "記住，三個出口裡只有一個會隨機開放；那裡的殭屍和食屍鬼殺不死，而且你不能穿戴任何裝備。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Hey...",
      "translation" : "嘿..."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Come back once you're ready.",
      "translation" : "準備好之後再回來。"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Ok, you are ready.",
      "translation" : "好了，你準備好了。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Let me check your weight.",
      "translation" : "我來檢查一下你的負重。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Gosh!",
      "translation" : "天哪！"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "There's always a black sheep anywhere.",
      "translation" : "到處都有害群之馬。"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You think I wouldn't notice that your weight is above '0'?",
      "translation" : "你以為我沒發現你的負重不是“0”嗎？"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You're overweight...",
      "translation" : "你超重了..."
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You seem good to go, and your weight is just right.",
      "translation" : "你看起來準備好了，負重也剛剛好。"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "I was quite swamped with my work, so I'm exhausted.",
      "translation" : "工作實在太忙，我都累壞了。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "I sometimes forget to send you there...",
      "translation" : "我有時會忘記把你送過去..."
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "I hope you come back well.",
      "translation" : "希望你能平安回來。"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "You want to exchange tickets for prizes?",
      "translation" : "你想用入場券兌換獎品嗎？"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Good job! Kkkkkk!",
      "translation" : "幹得好！咯咯咯！"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Lemme tell you what items you can exchange for.",
      "translation" : "我來告訴你可以兌換哪些物品。"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "5 tickets for Pumpkin Pie.",
      "translation" : "南瓜派：5張入場券。"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "20 tickets for Pumpkin-Head.",
      "translation" : "南瓜頭：20張入場券。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "50 tickets for Old Blue Box.",
      "translation" : "藍色舊箱子：50張入場券。"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "70 tickets for Old Purple Box.",
      "translation" : "紫色舊箱子：70張入場券。"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "200 tickets for Old Card Album.",
      "translation" : "舊卡冊：200張入場券。"
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "What would you like to exchange for?",
      "translation" : "你想兌換什麼？"
    },
    {
      "kind" : "option",
      "line" : 158,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Pumpkin Pie",
      "translation" : "南瓜派"
    },
    {
      "kind" : "option",
      "line" : 158,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Pumpkin-Head",
      "translation" : "南瓜頭"
    },
    {
      "kind" : "option",
      "line" : 158,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Old Blue Box",
      "translation" : "藍色舊箱子"
    },
    {
      "kind" : "option",
      "line" : 158,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Old Purple Box",
      "translation" : "紫色舊箱子"
    },
    {
      "kind" : "option",
      "line" : 158,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Old Card Album",
      "translation" : "舊卡冊"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "[Halloween Magician]",
      "translation" : "[萬聖節魔術師]"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Ok, see you then.",
      "translation" : "好，那回頭見。"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Kkkkkkkk.",
      "translation" : "咯咯咯咯。"
    },
    {
      "kind" : "option",
      "line" : 212,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "Explain it to me.",
      "translation" : "給我說明規則。"
    },
    {
      "kind" : "option",
      "line" : 212,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "I want to participate.",
      "translation" : "我要參加。"
    },
    {
      "kind" : "option",
      "line" : 212,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "I want to exchange tickets for prizes.",
      "translation" : "我想用入場券兌換獎品。"
    },
    {
      "kind" : "option",
      "line" : 212,
      "npc" : "Halloween Magician",
      "state" : "translated",
      "text" : "I'll come back next time.",
      "translation" : "我下次再來。"
    },
    {
      "kind" : "option",
      "line" : 215,
