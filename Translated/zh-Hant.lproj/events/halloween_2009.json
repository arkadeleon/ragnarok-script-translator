      "state" : "translated",
      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究員]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "I'm a Pumpkin Hat researcher, Why don't you listen to my story?",
      "translation" : "我是南瓜帽研究員，要不要聽聽我的故事？"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "Listen to the story.",
      "translation" : "聽故事。"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "Ask about Pumpkin Hat.",
      "translation" : "詢問南瓜帽。"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "Get a Pumpkin Hat.",
      "translation" : "領取南瓜帽。"
    },
    {
