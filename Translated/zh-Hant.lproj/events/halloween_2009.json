      "kind" : "message",
      "line" : 57,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究員]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "It can make a Pumpkin Pie that restores a large percentage of HP & SP using condensed energy to the person who wears it.",
      "translation" : "戴上它的人可以用凝聚的能量製作南瓜派，大幅恢復HP和SP。"
