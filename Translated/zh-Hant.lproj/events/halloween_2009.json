    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "Go reach a level that can fight with stronger monsters and come back.",
      "translation" : "等你等級高些，能和更強的怪物戰鬥時再回來。"
    },
    {
      "kind" : "message",
