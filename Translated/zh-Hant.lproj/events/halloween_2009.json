    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究員]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "I've been studying about an upgraded Pumpkin Hat.",
      "translation" : "我一直在研究強化版南瓜帽。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "I have discovered that it is a very simple process.",
      "translation" : "我發現製作過程非常簡單。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究員]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "The process is quite simple.",
      "translation" : "過程很簡單。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "If you bring me ^4a4aff20 Jack o' Pumpkin^000000 I can show you.",
      "translation" : "只要給我^4a4aff20個南瓜^000000，我就能演示給你看。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "Isn't that a tempting proposal?",
      "translation" : "這個提議很誘人吧？"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "[Pumpkin Hat Researcher]",
      "translation" : "[南瓜帽研究員]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Pumpkin Hat Researcher",
      "state" : "translated",
      "text" : "This upgraded pumpkin hat is powerful stuff!",
      "translation" : "這頂強化南瓜帽可厲害了！"
    },
