{
  "file" : "npc/events/MemorialDay_2008.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Hey, yo!",
      "translation" : "喂，喲！"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What are you doing there!?",
      "translation" : "你在那兒幹什麼！？"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Do you know what day it is!?",
      "translation" : "你知道今天是什麼日子嗎！？"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "It's a very important date!",
      "translation" : "這是個非常重要的日子！"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "A very important date to remember!",
      "translation" : "值得銘記的重要日子！"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What is this!?",
      "translation" : "這是什麼！？"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Where is your towel!?",
      "translation" : "你的毛巾呢！？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Lauds",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "My what?",
      "translation" : "我的什麼？"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "How are you supposed to go on your trip without your towel!?",
      "translation" : "沒有毛巾，你打算怎麼去旅行！？"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "If you think this is just another holiday, I'm not going to waste my breath.",
      "translation" : "如果你覺得這不過是又一個節日，那我也懶得費口舌。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "But if you like to pay a tribute to great soldiers, I will help you ready yourself.",
      "translation" : "但如果你想向偉大的戰士致敬，我可以幫你做好準備。"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "I guess so...",
      "translation" : "我想也是..."
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Are you crazy or something?",
      "translation" : "你瘋了嗎？"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Fine, be unprepared!",
      "translation" : "好吧，那你就毫無準備地去吧！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "^FF0000YOU WILL RUE THE DAY!^000000",
      "translation" : "^FF0000你會後悔的！^000000"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Great!",
      "translation" : "很好！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Then listen to me carefully.",
      "translation" : "那就仔細聽我說。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Now before you can pay tribute to the fallen soldiers you must be properly equipped.",
      "translation" : "向陣亡的戰士致敬之前，你得先做好充分準備。"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Without your towel you will be lost!",
      "translation" : "沒有毛巾，你會迷路的！"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "If you bring me the materials, I can make you a towel.",
      "translation" : "把材料帶給我，我就能為你做一條毛巾。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Listen closely.",
      "translation" : "仔細聽好。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Bring me ^FF000030 Fabric and 20 Fluffs^000000.",
      "translation" : "帶給我^FF000030塊布和20個絨毛^000000。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What are these? They aren't enough?!",
      "translation" : "這是什麼？還不夠嗎？！"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "*Sigh* Do I really have to tell you again?!",
      "translation" : "*唉* 還要我再說一遍嗎？！"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Bring me ^FF000030 Fabric and 20 Fluffs^000000.",
      "translation" : "帶給我^FF000030塊布和20個絨毛^000000。"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "***Mad Sago Lauds appears to be muttering to himself***",
      "translation" : "***瘋癲的薩戈·勞茲似乎正在自言自語***"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "So, did you bring the towel materials?",
      "translation" : "那麼，做毛巾的材料帶來了嗎？"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Excellent; you've brought them all.",
      "translation" : "太好了，材料都帶齊了。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Then I shall make you a Towel of Memory as I promised.",
      "translation" : "我這就照約定為你製作一條回憶毛巾。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Give me a moment.",
      "translation" : "稍等一下。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "There you go!",
      "translation" : "給你！"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Ah, you have fluffy new towel now I even put your name on it",
      "translation" : "啊，你有一條蓬鬆的新毛巾了，我還把你的名字寫在上面了"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Say, how do you like to go on a journey to pay a tribute to Memorial Day?",
      "translation" : "對了，你想不想踏上旅程，向陣亡將士紀念日致敬？"
    },
    {
      "kind" : "option",
      "line" : 107,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Sure.",
      "translation" : "好啊。"
    },
    {
      "kind" : "option",
      "line" : 107,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "No, I'm Busy.",
      "translation" : "不行，我很忙。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Don't come crying to me if someone decides to build a highway through your home!",
      "translation" : "要是有人決定在你家上面修公路，可別哭著來找我！"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Good. By the way, do you even know what the towel is for?",
      "translation" : "很好。對了，你知道這條毛巾是做什麼用的嗎？"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "It seems you're just carrying it without understanding its meaning.",
      "translation" : "看來你只是帶著它，卻不明白它的意義。"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What a shame! You should go speak to ^FF0000Grast in Prontera^000000.",
      "translation" : "真可惜！去普隆德拉找^FF0000葛拉斯特^000000談談吧。"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What are you still doing here?",
      "translation" : "你怎麼還在這兒？"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "I told you to go speak to Grast in Prontera!",
      "translation" : "我讓你去普隆德拉找葛拉斯特！"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Go help Grast, and then come back.",
      "translation" : "去幫幫葛拉斯特，然後再回來。"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Oh, you've brought them all.",
      "translation" : "哦，你把東西都帶來了。"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Hahaha!",
      "translation" : "哈哈哈！"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "HAHAHAHAHAHA!!!! cough cough",
      "translation" : "哈哈哈哈哈哈！！！！咳咳"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Please give them to me. Thank you for your hard work, by the way.",
      "translation" : "把東西給我吧。順便謝謝你辛苦收集。"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Say, have you learned anything from the journey?",
      "translation" : "對了，你這趟旅程有什麼收穫嗎？"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Now is to go visit the plaque at 12 o'clock direction in Prontera.",
      "translation" : "現在去普隆德拉正北方的紀念碑看看。"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What do you mean you were just there?",
      "translation" : "你說你剛去過那裡是什麼意思？"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "What? Why are you giving me your garbage!",
      "translation" : "什麼？你為什麼把垃圾給我！"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Those items are not useful to me at all.",
      "translation" : "這些東西對我一點用處也沒有。"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "You should be going to the plaque!",
      "translation" : "你該去看紀念碑！"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Stop trying to give me your garbage!",
      "translation" : "別再想把垃圾塞給我了！"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Go to the plaque at 12 o'clock direction in Prontera for your journey!",
      "translation" : "去普隆德拉正北方的紀念碑，開啟你的旅程！"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Don't panic!",
      "translation" : "別慌！"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "[Mad Sago Lauds]",
      "translation" : "[瘋癲的薩戈·勞茲]"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Lauds",
      "state" : "translated",
      "text" : "Life... is like a grapefruit.",
      "translation" : "人生...就像葡萄柚。"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Lauds",
      "state" : "translated",
