{
  "file" : "npc/events/RWC_2011.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "You have too many items. Please make room in your inventory and come back.",
      "translation" : "你攜帶的物品太多了。請整理背包後再回來。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Wow~ Finally!! It's the season we've all been waiting for!",
      "translation" : "哇～終於來了！這可是大家期待已久的季節！"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It's RWC time!",
      "translation" : "RWC大賽開始了！"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "What is RWC?",
      "translation" : "RWC是什麼？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Are you a New Agent?",
      "translation" : "你是新任專員嗎？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I don't care.",
      "translation" : "我不在乎。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "You must be a new adventurer. I will kindly explain it to you.",
      "translation" : "你一定是剛來的冒險者吧。我來給你介紹一下。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It seems you've traveled quite enough but you're not good with hearing the news around the world.",
      "translation" : "看來你旅行了不少地方，卻不太瞭解世界各地的訊息。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "There are few adventurers in Midgard whose lives are dedicated to battle, who never skip their training, live in seclusion, and are experts in their art.",
      "translation" : "米德加爾特有一些冒險者，一生都在戰鬥，從不間斷訓練，隱居修行，精通自己的技藝。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "The RWC is the festival where those adventurers can compete with each other and find out who is the best!",
      "translation" : "RWC就是讓這些冒險者互相較量、決出最強者的慶典！"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "But this cannot be achieved all alone. Your friends will have a huge role in the competition.",
      "translation" : "不過，單靠一個人可辦不到。你的朋友在比賽中會發揮重要作用。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "If you're interested in this festival, start looking for friends you can trust!",
      "translation" : "如果你對這個慶典感興趣，就去找值得信賴的夥伴吧！"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Many events are organized for RWC promotion every year.",
      "translation" : "每年都會為RWC舉辦各種宣傳活動。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "And this year, a special mission has been entrusted to a new agent... myself!",
      "translation" : "而今年，一項特別任務交給了一位新任專員...那就是我！"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I am supposed to attach blue cards with the letters RWC2011 all over the world to promote the event. But... but...",
      "translation" : "我本該在世界各地貼上印有RWC2011字樣的藍色卡片來宣傳活動。可是...可是..."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- He thought of something and then looked at your eyes. -",
      "translation" : "- 他想到了什麼，接著看向你的眼睛。 -"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Would you like to listen to my story?",
      "translation" : "你願意聽我說說嗎？"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Sure, let me hear it.",
      "translation" : "好啊，說來聽聽。"
    },
    {
      "kind" : "option",
      "line" : 69,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "No, thank you.",
      "translation" : "不了，謝謝。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Arrgg!! Are you ignoring me because I'm new? Usually people listen...",
      "translation" : "啊！你是因為我是新人，才不理我嗎？平時大家都會聽我說的..."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- New Agent is looking at you with pitiable eyes. -",
      "translation" : "- 新任專員用可憐巴巴的眼神看著你。 -"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- His brimming small eyes seem to tell you something. ^FF0000Please talk to me again...^000000 -",
      "translation" : "- 他那雙閃閃發亮的小眼睛彷彿在說：^FF0000請再來和我說說話...^000000 -"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "This is my first mission but people's reaction is not good.",
      "translation" : "這是我的第一次任務，可大家的反應都不太好。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- New Agent is looking at you with pitiable eyes. -",
      "translation" : "- 新任專員用可憐巴巴的眼神看著你。 -"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- His twinkling small eyes seem to tell you something. ^FF0000Please talk to me again...^000000 -",
      "translation" : "- 他那雙閃閃發亮的小眼睛彷彿在說：^FF0000請再來和我說說話...^000000 -"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I used to be a very normal boy in Morocc.",
      "translation" : "我以前只是個住在夢羅克的普通男孩。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I am not an adventurer and I don't even know how to buy/sell things. Sometimes I'm just very happy to see adventurers. You know... I am just an ordinary boy.",
      "translation" : "我不是冒險者，甚至連買賣東西都不會。有時看到冒險者，我就特別開心。你知道...我只是個普通男孩。"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "People used to tell me that since I was very shy.",
      "translation" : "因為我很害羞，大家以前總這麼說。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I would spend my life in a suburb.",
      "translation" : "我大概會一輩子住在郊區吧。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "But eventually, my patience and restrained personality motivated me to become an agent for RWC2011!",
      "translation" : "不過後來，我憑著耐心和內斂的性格，成為了RWC2011專員！"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I was so happy that I couldn't sleep! I would finally have a chance to meet lots of adventurers and get to know them.",
      "translation" : "我高興得睡不著！終於有機會見到許多冒險者，和他們認識了。"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "This mission was so important to me,",
      "translation" : "這次任務對我非常重要，"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I was afraid of being attacked by monsters when attaching the blue cards for RWC2011 in the streets.",
      "translation" : "我很怕在街上張貼RWC2011藍色卡片時被怪物襲擊。"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "......",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "And you know what?",
      "translation" : "你猜怎麼著？"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "^FF0000It really happened!^000000",
      "translation" : "^FF0000真的發生了！^000000"
    },
    {
      "kind" : "option",
      "line" : 113,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Are you serious!?",
      "translation" : "你沒開玩笑吧！？"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I had turned off the light and was trying to get some sleep, then I saw this bright light through the window.",
      "translation" : "我關了燈正準備睡覺，突然看到窗外透進一道亮光。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Suddenly, the window was broken and it appeared!",
      "translation" : "窗戶突然碎了，然後它就出現了！"
    },
    {
      "kind" : "option",
      "line" : 118,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It?",
      "translation" : "它？"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "It was a shining poring! And it ate all blue cards I had prepared in less than a second!",
      "translation" : "是一隻閃閃發光的波利！不到一秒，它就把我準備好的藍色卡片全吃光了！"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "I was so shocked, I tried to calm down and think... I had neither heard about nor seen any shining poring!",
      "translation" : "我嚇壞了，努力冷靜下來思考...我以前從沒聽說過，也沒見過閃光波利！"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "^FF0000Yes! It must be a dream!^000000 That's the conclusion I came up with and went back to sleep.",
      "translation" : "^FF0000沒錯！一定是在做夢！^000000我得出這個結論後，就回去睡了。"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "But it wasn't a dream. When I woke up, I realized all the blue cards were gone...",
      "translation" : "可那不是夢。醒來後，我發現藍色卡片全都不見了..."
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "If I ruin this promotion, I might lose the job and have to go back to where I used to live alone...",
      "translation" : "如果我搞砸了這次宣傳，可能會丟掉工作，只能回到以前獨自生活的地方..."
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "If you see the Golden Poring, could you please find the precious blue cards for me?",
      "translation" : "如果你看見黃金波利，能幫我找回那些珍貴的藍色卡片嗎？"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "- He looks at you with imploring eyes. -",
      "translation" : "- 他用懇求的眼神看著你。 -"
    },
    {
      "kind" : "option",
      "line" : 140,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Ok, I will help you!",
      "translation" : "好，我會幫你！"
    },
    {
      "kind" : "option",
      "line" : 140,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "How much money can you offer me?",
      "translation" : "你能給我多少報酬？"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Have you decided to help me? Well, I will prepare some gifts. I'm sure you'll like them.",
      "translation" : "你決定幫我了嗎？我會準備一些禮物，你一定會喜歡的。"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "What you are looking for are large cards with the letters ^FF0000RWC2011^000000. Some of them might already be digested though.",
      "translation" : "你要找的是印有^FF0000RWC2011^000000字樣的大卡片。有些可能已經被消化掉了。"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "[New Agent]",
      "translation" : "[新任專員]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "RWC2011 Agent",
      "state" : "translated",
      "text" : "Try to gather remaining cards until you make the word, 'RWC2011'.",
      "translation" : "試著收集剩下的卡片，拼出“RWC2011”吧。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "RWC2011 Agent",
