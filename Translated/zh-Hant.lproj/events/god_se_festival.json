    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This is the flower.",
      "translation" : "就是這朵花。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This is just a formality, but let me check your qualifications.",
      "translation" : "雖然只是例行公事，還是讓我確認一下你的資格。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Your qualification is verified as a Guild master.",
      "translation" : "已確認，你是公會會長。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I wonder if you know what this flower's use is... Let me explain it to you.",
      "translation" : "不知道你是否瞭解這朵花的用途...讓我解釋一下。"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This is the holy flower given by the Wish Maiden in Valkyrie, it can summon certain monsters by certain summoners.",
      "translation" : "這是戰乙女祈望女神賜予的聖花，特定的召喚師可以用它召喚特定的魔物。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "There are only two summoners in this world...",
      "translation" : "這個世界上只有兩位召喚師..."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Me and my sister Rhehe...",
      "translation" : "我和我的妹妹雷赫..."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "We are totllly different, but we can...",
      "translation" : "我們完全不同，但我們可以..."
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "...................................",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Anyway,",
      "translation" : "總之，"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Do you want to summon monsters?",
      "translation" : "你想召喚魔物嗎？"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Do not summon",
      "translation" : "不召喚"
    },
    {
      "kind" : "option",
      "line" : 79,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Summon, please",
      "translation" : "請召喚"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I don't like to be interrupted by others..",
      "translation" : "我不喜歡被別人打斷.."
