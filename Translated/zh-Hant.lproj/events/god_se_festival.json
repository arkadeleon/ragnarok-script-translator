      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I'll be waiting until you are ready.",
      "translation" : "我會等你準備好。"
