    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "But it's just business.",
      "translation" : "但這只是公事。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "I will explain to you how to summon monsters.",
      "translation" : "我來向你解釋如何召喚魔物。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This flower can summon the monsters 'Valkyrie's Blessing' and 'Valkyrie's Present' for one hour here in Juno.",
      "translation" : "這朵花可以在朱諾召喚“瓦爾基里的賜福”和“瓦爾基里的禮物”，持續一小時。"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "An announcement will be made stating which monster is summoned.",
      "translation" : "屆時會發布公告，說明召喚的是哪種魔物。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "This festival is given by the Wish maiden for all adventurers to enjoy all over the world.",
      "translation" : "這是祈望女神為世界各地的冒險者準備的慶典，讓大家一起盡興。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "Now, are you ready to summon monsters?",
      "translation" : "那麼，你準備好召喚魔物了嗎？"
    },
    {
      "kind" : "option",
      "line" : 101,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "No, I'm not ready now.",
      "translation" : "還沒準備好"
