      "kind" : "message",
      "line" : 103,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "[Rmimi Ravies]",
      "translation" : "[爾米米·拉維斯]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Rmimi Ravies",
      "state" : "translated",
      "text" : "If you are not ready, why did you come to me?",
      "translation" : "如果你還沒準備好，為什麼還要來找我？"
