    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "You're carrying too many items in your inventory. Visit Kafra storage and try again.",
      "translation" : "你的物品欄裡物品太多了。請先去卡普拉倉庫存放物品，再來嘗試。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "You cannot proceed because you're overweight.",
      "translation" : "你的負重過高，無法繼續。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[鑽孔師]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "My job is to drill a card slot into RWC Memorial accessories.",
      "translation" : "我的工作是為RWC紀念飾品開卡槽。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[鑽孔師]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "I'm sorry but you don't have any item equipped on your right accessory position.",
      "translation" : "抱歉，你右側飾品欄沒有裝備任何物品。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[鑽孔師]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "My job is to drill a card slot into RWC Memorial accessories. Moreover, I only treat ^ff0000pure items^000000, or those which have not been enchanted.",
      "translation" : "我的工作是為RWC紀念飾品開卡槽。另外，我只處理^ff0000未附魔的純淨物品^000000。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[鑽孔師]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "However, I can see that the accessory you are wearing on the right side cannot be treated. Please equip a RWC Memorial accessory.",
      "translation" : "不過，你右側佩戴的飾品不適合處理。請裝備RWC紀念飾品。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[鑽孔師]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "You should also know that making a card slot it extremely dangerous. ^ff0000Chances to succeed are about 50%.^000000 Do you wish to proceed?",
      "translation" : "另外，開卡槽非常危險。^ff0000成功率大約為50%。^000000要繼續嗎？"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "Let's go!",
      "translation" : "開始吧！"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[鑽孔師]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "See ya then.",
      "translation" : "那回頭見。"
