      "state" : "translated",
      "text" : "[Driller]",
      "translation" : "[鑽孔師]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Driller",
      "state" : "translated",
      "text" : "This item has already been enchanted. I can't work on this as it is against the rules.",
