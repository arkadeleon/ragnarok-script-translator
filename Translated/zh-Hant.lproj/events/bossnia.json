{
  "file" : "npc/events/bossnia.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Hello?",
      "translation" : "你好？"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I found some beautiful places",
      "translation" : "我在環遊世界時"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "while I travelled all over the world.",
      "translation" : "發現了不少美麗的地方。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I am an adventurer.",
      "translation" : "我是一名冒險者。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Haha~",
      "translation" : "哈哈~"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "What? My name is...",
      "translation" : "什麼？我的名字是..."
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "'Bossnia Staff'?? No no...",
      "translation" : "“Boss尼亞工作人員”？不不..."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Well, my name is not so important.",
      "translation" : "嗯，我的名字沒那麼重要。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Sometimes you should be generous.",
      "translation" : "有時候應該大方一點。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "No time for considering that kind of small stuff",
      "translation" : "專心處理更重要的事情時，"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "when you have to concentrate on more important things.",
      "translation" : "就別計較這些小事了。"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Hum... anyway I want to say... something..",
      "translation" : "嗯...總之我想說...有件事..."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "While I was travelling through some places,",
      "translation" : "我在旅行途中，"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I found a really fearful place.",
      "translation" : "發現了一個非常可怕的地方。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Most of the time when you come to a place,",
      "translation" : "通常你去到一個地方時，"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "there is one strong and fearful monster.",
      "translation" : "那裡會有一隻強大又可怕的魔物。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Isn't it?",
      "translation" : "對吧？"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "But... but... in there...",
      "translation" : "但...但是...那裡..."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "There are lots of fearful and strong monsters in there...",
      "translation" : "有很多可怕又強大的魔物..."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "That was really frightful.",
      "translation" : "真是嚇壞我了。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "If I had reacted a bit later... a few seconds...",
      "translation" : "如果我反應再慢一點...哪怕幾秒..."
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "I might have been killed.",
      "translation" : "可能就被殺掉了。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "What?",
      "translation" : "什麼？"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "You want to go in there?",
      "translation" : "你想進去？"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Oh~ Boy~ you didn't get me.",
      "translation" : "哦~天哪~你可真沒聽懂我的話。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "In there.......",
      "translation" : "那裡..."
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Uh... you already know?",
      "translation" : "咦...你已經知道了？"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Although you know the place, you want to go in...",
      "translation" : "你明知道那個地方，還想進去..."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Good, I will send you there.",
      "translation" : "好吧，我送你過去。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "But after you went there, don't hold",
      "translation" : "不過進去之後，可別"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "a grudge against me. It'll cost you 1 Reset Stone for 5 access.",
      "translation" : "怨我。每5次入場需要1顆重置石。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Bossnia Staff",
      "placeholders" : [
        "bossnia_event"
      ],
      "state" : "translated",
      "text" : "Remaining access: {0}",
      "translation" : "剩餘入場次數：{0}"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Do you want to go?",
      "translation" : "要進去嗎？"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "You don't have a ticket now.....",
      "translation" : "你現在沒有入場券..."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "So come to me again with a Reset Stone later.",
      "translation" : "之後帶著重置石再來找我。"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Enter",
      "translation" : "進入"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Leave",
      "translation" : "離開"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "First",
      "translation" : "第一條路線"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Second",
      "translation" : "第二條路線"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Third",
      "translation" : "第三條路線"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Fourth",
      "translation" : "第四條路線"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 1",
      "translation" : "傳送點1"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 2",
      "translation" : "傳送點2"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 3",
      "translation" : "傳送點3"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Warp 4",
      "translation" : "傳送點4"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "a grudge against me. Also it costs 5,000 zeny.",
      "translation" : "也別怨我，另外還要支付5,000金幣。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Would you really like to take the challenge?",
      "translation" : "你真的想接受挑戰嗎？"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Ok, just choose the course.",
      "translation" : "好，選一條路線吧。"
    },
    {
      "kind" : "option",
      "line" : 111,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "First",
      "translation" : "第一條路線"
    },
    {
      "kind" : "option",
      "line" : 111,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Second",
      "translation" : "第二條路線"
    },
    {
      "kind" : "option",
      "line" : 111,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Third",
      "translation" : "第三條路線"
    },
    {
      "kind" : "option",
      "line" : 111,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Fourth",
      "translation" : "第四條路線"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Take care, boy~",
      "translation" : "小心點，年輕人~"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Don't hold a grudge against me.",
      "translation" : "別怨我。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "[Riss]",
      "translation" : "[莉絲]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "You don't have enough money...",
      "translation" : "你的錢不夠..."
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Bossnia Staff",
      "state" : "translated",
      "text" : "Come back when you have at least 5,000 zeny.",
      "translation" : "至少準備5,000金幣再回來。"
    }
  ]
}