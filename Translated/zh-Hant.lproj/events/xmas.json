      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "I see. Well, at the very least",
      "translation" : "我知道了。至少"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Father Christmas",
      "state" : "translated",
