      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "So I would like you to go out and",
      "translation" : "所以我想請你出去"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Destroy this man for me.",
      "translation" : "替我除掉這個人。"
