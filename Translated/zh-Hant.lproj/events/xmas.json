    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Merry Christmas!",
      "translation" : "聖誕快樂！"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "I have a gift for you! Ho Ho Ho!",
      "translation" : "我給你準備了一份禮物！吼吼吼！"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "I'm having a bit of a problem...",
      "translation" : "我遇到了一點麻煩..."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Do you care to listen?",
      "translation" : "你願意聽我說說嗎？"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Listen to Santa Claus.",
      "translation" : "聽聖誕老人說。"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Give Santa Claus proof.",
      "translation" : "給聖誕老人看證據。"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "[Santa Claus]",
      "translation" : "[聖誕老人]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "My problem is this.",
      "translation" : "事情是這樣的。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "There seems to be a man out there",
      "translation" : "外面似乎有個人"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "that is impersonating me and spreading",
      "translation" : "冒充我，還在各地散播"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "terror throughout the land.",
      "translation" : "恐慌。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "[Santa Claus]",
      "translation" : "[聖誕老人]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "Like the Grinch of legend, he's taking",
      "translation" : "他就像傳說中的格林奇，正在把"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "all the childrens' toys and keeping them",
      "translation" : "所有孩子的玩具都拿走，"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "for himself.",
      "translation" : "據為己有。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "[Santa Claus]",
      "translation" : "[聖誕老人]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "I'm too busy here creating my batch of ",
      "translation" : "我正忙著製作明年要送的"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "toys for next year, so I can't go",
