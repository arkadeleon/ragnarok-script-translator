      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "[Santa Claus]",
      "translation" : "[聖誕老人]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Father Christmas",
      "state" : "translated",
      "text" : "He has in his posession one of my",
      "translation" : "不過，他手裡有我的一個"
