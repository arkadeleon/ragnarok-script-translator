      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "This skill reset is not FREE OF CHARGE!!",
      "translation" : "技能重置可不是免費的！！"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Expense for the reset of skill is ^D5A50020000 Zeny x BaseLv^000000.",
      "translation" : "重置技能的費用為^D5A500基礎等級×20000 Zeny^000000。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Yeah ...each One BaseLv costs 20000 Zeny to reset skill.",
