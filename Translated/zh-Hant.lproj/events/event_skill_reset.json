      "state" : "translated",
      "text" : "Your name is ^0080FF{0}^000000.",
      "translation" : "你的名字是^0080FF{0}^000000。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "How can I help you?",
      "translation" : "需要我幫你做什麼？"
    },
