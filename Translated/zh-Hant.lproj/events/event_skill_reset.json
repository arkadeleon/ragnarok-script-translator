{
  "file" : "npc/events/event_skill_reset.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "I already told you that you may only complete this event once.",
      "translation" : "我已經告訴過你，這個活動只能完成一次。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please return when you reach BaseLv 60 or higher.",
      "translation" : "達到基礎等級60級或以上後再來吧。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "You will need to use up all of your skill points if you want me to continue.",
      "translation" : "如果你想讓我繼續，就必須用完所有技能點。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please come again soon!",
      "translation" : "歡迎很快再來！"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Would you like to reset skills?",
      "translation" : "要重置技能嗎？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "I'm sorry, but...",
      "translation" : "抱歉，不過..."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "You cannot reset skills",
      "translation" : "你無法重置技能"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "when you keep",
      "translation" : "如果你攜帶"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "any items.",
      "translation" : "任何物品。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please, drop your cart and we'll continue.",
      "translation" : "請卸下手推車，我們就繼續。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please, free your Falcon and we'll continue.",
      "translation" : "請放走獵鷹，我們就繼續。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Hypnotist Teacher",
      "state" : "translated",
      "text" : "Please, free your PecoPeco and we'll continue.",
