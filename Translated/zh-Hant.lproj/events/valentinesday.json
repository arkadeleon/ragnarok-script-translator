{
  "file" : "npc/events/valentinesday.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Guess what I've got?",
      "translation" : "猜猜我這裡有什麼？"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "A tasty treat not easily found in Midgard....",
      "translation" : "米德加爾特不容易買到的美味甜點..."
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Chocolate!",
      "translation" : "巧克力！"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "That's right, don't you love chocolate.... I do.",
      "translation" : "沒錯，你不喜歡巧克力嗎...我可喜歡了。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "And you are in luck, because I'm selling them for only 5,000 zeny a piece!",
      "translation" : "而且你運氣很好，我只賣5,000金幣一塊！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I want some chocolate!",
      "translation" : "我想要巧克力！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不了，謝謝。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You don't want any chocolate?",
      "translation" : "你不想要巧克力嗎？"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm telling you! You'll regret it!",
      "translation" : "我告訴你！你會後悔的！"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You better get some now... you won't come across Chocolate like this ever again!",
      "translation" : "現在最好買一些...這種巧克力你再也遇不到了！"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Think it over and visit me again sometime.",
      "translation" : "想好了再來找我吧。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Hah!",
      "translation" : "哈！"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I knew it!",
      "translation" : "我就知道！"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "But I can't sell you more than 5 at once... but, if you really need more....",
      "translation" : "不過我一次最多隻能賣5塊...但如果你真的還想要更多..."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "you can come back again.",
      "translation" : "可以再回來買。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "So how many do you want?",
      "translation" : "那麼你要幾塊？"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "[Stephen]",
      "translation" : "[斯蒂芬]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm sorry, but I can't give you that many.",
      "translation" : "抱歉，我不能給你那麼多。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "I'm sorry, but it seems you can't afford to buy these off me.",
      "translation" : "抱歉，看來你買不起這些巧克力。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "There you go!",
      "translation" : "給你！"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "You can give that to someone as a gift, or enjoy it yourself!",
      "translation" : "你可以送給別人，也可以自己享用！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Mmm... sweet chocolate...",
      "translation" : "嗯...甜甜的巧克力..."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Stephen",
      "state" : "translated",
      "text" : "Visit me anytime...!",
      "translation" : "隨時歡迎再來...！"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[傑妮]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "You know what? The chocolate that my boyfriend sells are from me!",
      "translation" : "你知道嗎？我男朋友賣的巧克力其實是我做的！"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I made them by myself.",
      "translation" : "都是我親手製作的。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[傑妮]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "You know ... In cetain countries, there's a tradition of presenting chocolates to a person that you love...",
      "translation" : "你知道嗎...在某些國家，人們有個傳統，會把巧克力送給心愛的人..."
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "They call it, ^3355FFValentine's Day^000000.",
      "translation" : "他們稱之為^3355FF情人節^000000。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[傑妮]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "So I gave him my delicious chocolate...",
      "translation" : "所以我把自己做的美味巧克力送給了他..."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "And then he made me cook a lot more...",
      "translation" : "結果他讓我做了更多..."
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "And now he is selling them to everyone.",
      "translation" : "現在他把巧克力賣給所有人。"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I guess he really enjoyed it.",
      "translation" : "我想他真的很喜歡。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "But, I do feel good when people buy something I have made.",
      "translation" : "不過，看到大家買我做的東西，我也很開心。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "[Jainie]",
      "translation" : "[傑妮]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "It would be great if you bought some too...",
      "translation" : "如果你也買一些就好了..."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Jainie",
      "state" : "translated",
      "text" : "I will be making chocolates for a while so...",
      "translation" : "我還會做一陣子巧克力，所以..."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Yes?",
      "translation" : "是嗎？"
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I want some hand made chocolate...",
      "translation" : "我想要手工巧克力..."
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I'm lost, sorry to bother you.",
      "translation" : "我迷路了，抱歉打擾你。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Oh... well, if you want me to make some of my special Hand Made Chocolate....",
      "translation" : "哦...好吧，如果你想要我做一些特別的手工巧克力..."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "You will need to give me at least ^0000FF 3 Chocolates^000000.",
      "translation" : "你至少要給我^0000FF 3塊巧克力^000000。"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "That's right, only ^0000FF 3 Chocolates^000000",
      "translation" : "沒錯，只要^0000FF 3塊巧克力^000000"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Bring them to me and you'll get what you came for.",
      "translation" : "把它們帶給我，你就能拿到想要的東西。"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "See You.",
      "translation" : "再見。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Well, I just might be able to fulfill your needs...",
      "translation" : "嗯，我也許能滿足你的需求..."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I'm sorry, you don't have enough Chocolate Bars to do this.",
      "translation" : "抱歉，你的巧克力棒不夠，沒法制作。"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "You got 3 pieces of pure chocolate, I see.",
      "translation" : "我看你帶來了3塊純巧克力。"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Give them to me...",
      "translation" : "把它們給我..."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Ok, now I will only create my special hand made chocolates if you promise to use it wisely.",
      "translation" : "好，現在我只會製作特別的手工巧克力，希望你能好好使用。"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "....Hmmmmmm.....",
      "translation" : "...嗯嗯嗯..."
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Well...",
      "translation" : "那麼..."
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Here.",
      "translation" : "給你。"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "I hope you give it to someone special, because its a special chocolate.",
      "translation" : "希望你能把它送給特別的人，因為這是一塊特別的巧克力。"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "As you know... only I can create this.",
      "translation" : "你知道的...只有我能做出這種巧克力。"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "[Carl Orleans]",
      "translation" : "[卡爾·奧爾良]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Carl Orleans",
      "state" : "translated",
      "text" : "Enjoy.",
      "translation" : "享用吧。"
    }
  ]
}