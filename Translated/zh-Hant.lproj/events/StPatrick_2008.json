    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Hmm...",
      "translation" : "嗯..."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Tis a fine day it be.",
      "translation" : "今天天氣真不錯。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "If you have a moment to spare.",
      "translation" : "如果你有空的話，"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Come here to me now, come here and I'll tell ya something.",
      "translation" : "過來一下，我告訴你一件事。"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Go ahead.",
      "translation" : "請說。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "These past years I've come to see the world and each time the snakes have stolen me treasure.",
      "translation" : "這些年來我四處遊歷，每次出門，蛇都會偷走我的寶藏。"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Oh?",
      "translation" : "哦？"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Ye fine folks of this land have been so gracious to recover me treasure again and again.",
      "translation" : "這片土地上的好心人一次又一次幫我找回寶藏，真是太感謝你們了。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I've learned me lesson and will never forget how those vile snakes have wronged me.",
      "translation" : "我吸取了教訓，永遠不會忘記那些可惡的蛇是怎樣害我的。"
    },
    {
      "kind" : "option",
      "line" : 54,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "What did you do?",
      "translation" : "你做了什麼？"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I made a safe place to hide me treasure.",
      "translation" : "我找了個安全的地方藏起寶藏。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Hidden in a secret place the treasure would be safe until I returned to the world the following year.",
      "translation" : "把寶藏藏在秘密地點後，它就能安全地待在那裡，直到我明年再次來到這個世界。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "This year, I have made me journey to see the outside world once again.",
      "translation" : "今年我又踏上旅程，來看看外面的世界。"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I traveled to me cache of gold I found it to be safe and undisturbed.",
      "translation" : "我去檢視藏金處，發現寶藏安然無恙，沒人動過。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I thought to meself, I am very clever to hide the treasure from the snakes.",
      "translation" : "我心想，自己真聰明，竟然能把寶藏藏起來，不讓蛇找到。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Oh, but I was a fool still.",
      "translation" : "唉，可我還是太傻了。"
    },
    {
      "kind" : "option",
      "line" : 67,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "What happened?",
      "translation" : "發生什麼事了？"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "My hiding place was too clever.",
      "translation" : "我藏得太巧妙了。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I pulled and I heaved and pushed, but the hiding place would not budge.",
      "translation" : "我又拉又推又使勁，可藏寶處紋絲不動。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "So once again, I am without treasure this year.",
      "translation" : "所以今年我還是一無所有。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I have not even begun brewing me famous green ale on account of this mess.",
      "translation" : "出了這檔子事，我連著名的綠啤酒都還沒開始釀。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I will ask ye, will ya help get me treasure back?",
      "translation" : "我問你，願意幫我找回寶藏嗎？"
    },
    {
      "kind" : "option",
      "line" : 77,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Sure, I can help you.",
      "translation" : "當然，我來幫你。"
    },
    {
      "kind" : "option",
      "line" : 77,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I'm too busy.",
      "translation" : "我太忙了。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Aye, I understand.",
      "translation" : "好吧，我理解。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Thank you for listening to me tale.",
      "translation" : "謝謝你聽我講完這段故事。"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "To find my treasure it be true.",
      "translation" : "想找到我的寶藏，確有其事。"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "To my treasure I give my secret to you.",
      "translation" : "我把秘密告訴你，帶你找到寶藏。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "So, listen well and make no omissions.",
      "translation" : "所以，仔細聽著，別漏掉任何細節。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Make the journey to the city of magicians.",
      "translation" : "前往魔法師之城。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Over the bridge and across the water",
      "translation" : "越過橋梁，渡過水麵"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Climb the mountain until north ye can travel no farther.",
      "translation" : "爬上山，直到無法再往北走。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Passed the stone steps set into the air.",
      "translation" : "經過懸在空中的石階。"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Hidden in the mountain side, me treasure is there.",
      "translation" : "我的寶藏就藏在山壁裡。"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Ye must find a way to break it open.",
      "translation" : "你得想辦法把它炸開。"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Ye will need a mighty explosion to free the cache to be sure.",
      "translation" : "要取出藏匿的寶物，肯定得來一場威力巨大的爆炸。"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Ye might try some Firecrackers.",
      "translation" : "你可以試試鞭炮。"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Course, Ye would need a great number of them, Ye would need at least ^FF0000200 Firecreackers^000000",
      "translation" : "當然，你得準備很多，至少需要^FF0000200個鞭炮^000000。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Tis a fine day it be.",
      "translation" : "今天天氣真不錯。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Have you found me treasure yet, have you?",
      "translation" : "你找到我的寶藏了嗎？"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Me hiding spot is a might hard to crack.",
      "translation" : "我的藏身處可不容易開啟。"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Ye might try some Firecrackers.",
      "translation" : "你可以試試鞭炮。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Course, Ye would need a great number of them, Ye would need at least ^FF0000200 Firecreackers^000000",
      "translation" : "當然，你得準備很多，至少需要^FF0000200個鞭炮^000000。"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I be understanding if you can't get to it to be sure to be sure.",
      "translation" : "如果你實在弄不開，我也能理解，真的。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Oh, welcome back!",
      "translation" : "哦，歡迎回來！"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Thank you for returning me treasure!",
      "translation" : "謝謝你把我的寶藏帶回來！"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Me gratitude knows no bounds!",
      "translation" : "我感激不盡！"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I am so happy,",
      "translation" : "我真高興，"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "I'll be starting up me brew right away",
      "translation" : "這就馬上開始釀酒。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "It seems that the snakes have returned this year and are here to steal my treasure again.",
      "translation" : "看來今年蛇又來了，還想再偷我的寶藏。"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "The snakes carry the coins of my kinsmen and must be punished.",
      "translation" : "蛇偷走了我族人的硬幣，必須懲罰它們。"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "But ye have had a long journey, for which I am very grateful.",
      "translation" : "不過你一路奔波，我非常感激。"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "When ye have had a moment to rest ye legs, come talk to me again and we may speak again",
      "translation" : "等你休息一會兒、讓雙腿恢復後，再來和我聊聊。"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Ah, well rested I hope?",
      "translation" : "啊，休息得還好嗎？"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "[O'Riley the Leprechaun]",
      "translation" : "[妖精奧萊利]"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "Thank you for coming by again.",
      "translation" : "謝謝你又來看我。"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Anxious Leprechaun",
      "state" : "translated",
      "text" : "The snakes carry the coins of my kindsmen and must be punished.",
      "translation" : "蛇偷走了我族人的硬幣，必須懲罰它們。"
    },
    {
      "kind" : "message",
      "line" : 154,
