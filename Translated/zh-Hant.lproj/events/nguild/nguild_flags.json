      "line" : 40,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "Do you wish to return to your honorable place?",
      "translation" : "你們想回到自己榮耀的歸處嗎？"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "Return to the guild castle.",
      "translation" : "返回公會城堡"
