    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "We declare that",
      "translation" : "我們在此宣告："
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "there is no formal master of this castle.",
      "translation" : "這座城堡尚無正式主人。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "2. To the one who can ",
      "translation" : "2. 對於能夠"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "overcome all trials",
      "translation" : "克服一切試煉"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "and destroy the Emperium,",
      "translation" : "並摧毀華麗金屬的人，"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "the king will endow the one with",
      "translation" : "國王將授予其"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "ownership of this castle.",
      "translation" : "這座城堡的所有權。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "F_Flags",
      "state" : "translated",
      "text" : "Brave ones...",
      "translation" : "勇士們..."
