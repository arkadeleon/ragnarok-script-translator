      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "Clang! Clang! Clang!",
      "translation" : "鏗！鏗！鏗！"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "[Suhnbi]",
      "translation" : "[順比]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Suhnbi",
      "state" : "translated",
      "text" : "There you go! It's done.",
      "translation" : "好了！完成了。"
    },
    {
