    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "My service fee, the required materials and the chance of success all depend on the specific item I'm working on.",
      "translation" : "服務費、所需材料和成功率都取決於我處理的具體裝備。"
    },
    {
      "kind" : "message",
      "line" : 47,
