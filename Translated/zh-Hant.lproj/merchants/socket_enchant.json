      "kind" : "message",
      "line" : 223,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "[Seiyablem]",
      "translation" : "[賽亞佈雷姆]"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "In some towns, Slot addition attempts are more successful for equipment with fewer upgrades.",
      "translation" : "有些城鎮裡，精煉次數較少的裝備更容易成功新增插槽。"
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "In other towns, the opposite is true.",
      "translation" : "另一些城鎮則正好相反。"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "isn't that really peculiar?",
      "translation" : "這不是很奇怪嗎？"
    },
    {
      "kind" : "message",
      "line" : 228,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "[Seiyablem]",
      "translation" : "[賽亞佈雷姆]"
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "Oh, there's also something really important that you should know.",
      "translation" : "還有一件非常重要的事，你一定要知道。"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "If you ask me to add a Slot to something, make sure that you don't have multiples of it in your inventory.",
      "translation" : "如果要我為某件裝備新增插槽，請確保背包裡沒有多件同名裝備。"
    },
    {
      "kind" : "message",
      "line" : 232,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "[Seiyablem]",
      "translation" : "[賽亞佈雷姆]"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "Here's an example: if you have a +7 Manteau and a normal Manteau in your inventory, then I will randomly pick one of them for my Slot Addition attempt.",
      "translation" : "舉個例子：如果你的背包裡有一件+7斗篷和一件普通斗篷，我會隨機挑選其中一件來嘗試新增插槽。"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "Just remember to be careful.",
      "translation" : "記得小心一點。"
    },
