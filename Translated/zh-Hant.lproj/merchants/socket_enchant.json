  "scripts" : [
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "- Wait a minute !! -\n- Currently you're carrying -\n- too many items with you. -\n- Please try again -\n- after you lose some weight. -",
      "translation" : "- 等等！！ -\n- 您現在攜帶的物品 -\n- 太多了。 -\n- 請在減輕負重後 -\n- 再試一次。 -"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "[Seiyablem]\nI'm an engineer that specializes in adding Slots to normal Weapons and Armor.\nMy service fee, the required materials and the chance of success all depend on the specific item I'm working on.",
      "translation" : "[賽亞佈雷姆]\n我是一名專門負責為普通武器和防具新增插槽的工程師。\n我的服務費用、所需材料以及成功率，都取決於具體操作的物品。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "[Seiyablem]\nAdding Slots may seem simple, but it's far more complicated than it looks.\nIf you're interested in my service, let me know.",
      "translation" : "[賽亞佈雷姆]\n新增插槽看似簡單，實則遠比表面複雜。\n如果您對我的服務感興趣，請告訴我。"
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "Add Slot to Weapon",
      "translation" : "為武器新增插槽"
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Seiyablem",
      "state" : "translated",
      "text" : "Add Slot to Armor",
      "translation" : "為防具新增插槽"
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Seiyablem",
      "state" : "translated",
