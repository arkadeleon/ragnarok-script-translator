      "line" : 123,
      "npc" : "Morrison",
      "state" : "translated",
      "text" : "[Little Morrison]",
      "translation" : "[小莫里森]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Morrison",
      "state" : "translated",
      "text" : "Ooh! M-Meaaat~",
      "translation" : "噢！肉、肉~"
