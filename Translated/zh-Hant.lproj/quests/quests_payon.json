{
  "file" : "npc/quests/quests_payon.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "^3355FFWait a second! Right now, you're carrying too many items with you. Please come back after putting some of your things into Kafra Storage.^000000",
      "translation" : "^3355FF請稍等！你身上帶的東西太多了。把部分物品存入卡普拉倉庫後再來吧。^000000"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "I wish I could make some clothing for my grandchildren for the festival season...",
      "translation" : "真希望能在節日期間給孫兒們做些衣服..."
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Oh! Would you give me your ^3355FFSkirt of Virgin^000000? I'd need four of them. Please, I'm begging you.",
      "translation" : "哦！能把你的^3355FF處女裙^000000給我嗎？我需要4條。拜託你了。"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Alright.",
      "translation" : "好吧。"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "No way!",
      "translation" : "才不要！"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Oh! Thank you so much~ Now I can make some clothes for Kitty Cutty~",
      "translation" : "哦！太感謝你了~現在我可以給小貓咪做衣服了~"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Ah, Wait! I almost forgot. I was quite a popular actress back in my youth. My actor friends gave me a wedding present when I left the Troupe. I've kept it to remind me of those precious times.",
      "translation" : "啊，等等！我差點忘了。年輕時我可是很受歡迎的演員。離開劇團時，演員朋友們送了我一份結婚禮物。我一直留著它，紀念那段珍貴時光。"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "If it's okay...",
      "translation" : "如果你不介意..."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "I'd like to give you this.",
      "translation" : "我想把這個送給你。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Goodbye, adventurer~!",
      "translation" : "再見，冒險者~！"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Thank you for making an old woman so happy...",
      "translation" : "謝謝你讓一個老婆婆這麼開心..."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "*Sigh* How can I get ^3355FFSkirt of Virgin^000000 by myself? I'm just so weak and feeble, even rolling in my rocking chair exhausts me. *Sniff* All I want is to make my grandchildren happy...",
      "translation" : "*嘆氣*我這麼虛弱，連在搖椅上晃一晃都會累，怎麼可能自己找到^3355FF處女裙^000000呢？*抽泣*我只想讓孫兒們開心..."
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "I gather Mushrooms on the Mountain of Payon everyday. Time passes and before I know it, it's already fesitval season. I wish I could make clothing for my family this time of the year.",
      "translation" : "我每天都在斐揚山採蘑菇。時光飛逝，轉眼又到了節日季節。真希望今年能給家人做些衣服。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "...",
      "translation" : "..."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "But for that, I need ^3355FF4 Skirt of Virgin^000000...",
      "translation" : "不過，為了做衣服，我需要^3355FF4條處女裙^000000..."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "[Granny]",
      "translation" : "[老奶奶]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Granny",
      "state" : "translated",
      "text" : "Young traveler, please help me. When you find some ^3355FFSkirt of Virgin^000000, please bring them to me. I'd really appreciate it...",
      "translation" : "年輕的旅人，請幫幫我。找到^3355FF處女裙^000000後，請帶來給我。我會非常感激..."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "My family has produced and sold the special Winter product ^3355FFEar Muffs^000000 for many years. We just moved here, but the weather is always warm so we can hardly make a living.",
      "translation" : "我們家多年來一直製作和出售冬季特色商品^3355FF耳罩^000000。我們剛搬到這裡，可天氣總是很暖和，生意都快做不下去了。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "If you plan to travel to colder regions, I suggest that you bring some ^3355FFEar Muffs^000000...",
      "translation" : "如果你打算去更寒冷的地方旅行，我建議你帶上^3355FF耳罩^000000..."
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Ear Muffs are my family's specialty, and we provide it to customers who have ^FF33551 Cursed Ruby^000000, ^3311AA1 Headset,^000000 ^3355FF 200 Feathers^000000 and ^DDDD005000 Zeny^000000.",
      "translation" : "耳罩是我們家的特產。只要帶來^FF33551顆詛咒紅寶石^000000、^3311AA1個耳機^000000、^3355FF200根羽毛^000000和^DDDD005000澤尼^000000，就能換取一副。"
    },
    {
      "kind" : "option",
      "line" : 89,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Oh Yeah? That sounds good.",
      "translation" : "真的嗎？聽起來不錯。"
    },
    {
      "kind" : "option",
      "line" : 89,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "No thank you, Ma'am.",
      "translation" : "不了，謝謝您。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Here, I will give you this pre-made one.",
      "translation" : "來，這副是我事先做好的，送給你。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Thank you for buying our product. You won't regret purchasing our Ear Muffs: Satisfaction guaranteed~",
      "translation" : "謝謝你購買我們的商品。買了耳罩絕不會後悔，保證滿意~"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "Oh dear...",
      "translation" : "哎呀..."
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "You don't have enough money or items. Unfortunately, we can't give any discounts. Please understand that we have to make a living...",
      "translation" : "你的錢或物品不夠。很遺憾，我們不能打折。請理解，我們也要維持生計..."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "[Mystic Lady]",
      "translation" : "[神秘女士]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "That's fine.",
      "translation" : "沒關係。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "I believe we",
      "translation" : "我相信我們"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "will meet again.",
      "translation" : "還會再見。"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Mystic Lady",
      "state" : "translated",
      "text" : "...One of these days.",
      "translation" : "...總有一天。"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "ArrrGggghh!",
      "translation" : "啊啊啊！"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Ah, No I can't...",
      "translation" : "啊，不行..."
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "*Huk*",
      "translation" : "*哈*"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Now even my eyes have gone mad!! Why do these bugs suddenly seem so cute?! Nooooooo~!!!",
      "translation" : "現在連我的眼睛都出問題了嗎！！這些蟲子怎麼突然變得這麼可愛？！不——！！！"
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Show Ora Ora",
      "translation" : "展示奧拉奧拉"
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Give Ora Ora",
      "translation" : "交出奧拉奧拉"
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Oooooohhhh!!!",
      "translation" : "哦哦哦哦！！！"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Is, is this",
      "translation" : "這、這就是"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "the one?!",
      "translation" : "我要找的東西嗎？！"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "This is...",
      "translation" : "這是..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Ora Ora!!",
      "translation" : "奧拉奧拉！！"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I'll make it short! Give it to me, and I will give you my treasure! So how's my idea? Wanna deal?",
      "translation" : "我就直說了！把它給我，我就把寶物給你！怎麼樣？成交嗎？"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Muhahahahah!!!",
      "translation" : "哇哈哈哈哈！！！"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I finally have this!",
      "translation" : "我終於拿到它了！"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Ora Ora!",
      "translation" : "奧拉奧拉！"
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Stupid and Disgusting",
      "translation" : "又蠢又噁心的"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Thief Bugs!!",
      "translation" : "盜蟲！！"
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "You will pay!!!",
      "translation" : "你們給我等著！！！"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Huk...Huk...",
      "translation" : "哈...哈..."
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Sorry, I was out of control with pleasure for a while. Now, I will give my treasure as promised.",
      "translation" : "抱歉，我剛才高興得有些失控了。現在我會兌現承諾，把寶物給你。"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "When you wear this over your mouth and start to breathe, it filters junk out before getting to your lungs.",
      "translation" : "把這個戴在嘴上呼吸時，它會在雜質進入肺部前將其過濾掉。"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Kakakakakaka!",
      "translation" : "咔咔咔咔咔！"
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I can't wait",
      "translation" : "我等不及了"
    },
    {
