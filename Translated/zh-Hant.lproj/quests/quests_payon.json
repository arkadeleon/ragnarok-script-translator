      "line" : 171,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Ora Ora!",
      "translation" : "奧拉奧拉！"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Huhuhuhuhu...",
      "translation" : "呵呵呵呵..."
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "What if I can't get rid of all these Thief Bugs? I might even grow to love them... *Huk*",
      "translation" : "如果我沒法除掉這些盜蟲怎麼辦？說不定我會愛上它們...*哈*"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "[Young Man]",
      "translation" : "[年輕男子]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "Wahhhhhh! I, I...",
      "translation" : "哇啊啊！我、我..."
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Boy",
      "state" : "translated",
      "text" : "I can't take it any more!",
      "translation" : "我再也受不了了！"
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Boy",
      "state" : "translated",
