      "state" : "translated",
      "text" : "[Roberto]",
      "translation" : "[羅伯托]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Roberto",
      "state" : "translated",
      "text" : "An archer in Morocc!?",
      "translation" : "斐揚的弓箭手！？"
