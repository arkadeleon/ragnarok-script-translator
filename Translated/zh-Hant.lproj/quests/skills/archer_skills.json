    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Roberto",
      "state" : "translated",
      "text" : "time in a place like this.",
      "translation" : "辛苦吧。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Roberto",
      "state" : "translated",
      "text" : "Isn't it hard to find arrows?",
