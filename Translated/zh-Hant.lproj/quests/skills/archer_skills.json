    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Roberto",
      "state" : "translated",
      "text" : "Yes. Thank you...",
      "translation" : "是啊。謝謝你..."
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Roberto",
      "state" : "translated",
      "text" : "You must be having a hard",
      "translation" : "你在這種地方一定也過得很"
