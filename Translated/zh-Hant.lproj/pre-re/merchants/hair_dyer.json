      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理髮師約沃維奇]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Welcome~!",
      "translation" : "歡迎光臨~！"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "How may I help you?",
      "translation" : "有什麼可以幫你的嗎？"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理髮師約沃維奇]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Oh, no! Your hair is damaged. It seems as if you may need professional treatment. Come sit over here, please. Come.",
      "translation" : "哎呀！你的頭髮受損了。看來需要專業護理。請坐到這邊來，來嘛。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Eh!? Oh my! Oh no no no no! Your hair is sooo damaged! It's not good if you leave your hair like this.",
      "translation" : "咦！？天哪！糟了糟了糟了！你的頭髮受損得太嚴重了！這樣放任不管可不行。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理髮師約沃維奇]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Would you let me treat your hair? Please?",
      "translation" : "讓我幫你護理頭髮，好嗎？拜託啦！"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Wow! Your hair would be perfect once it's dyed~ How about dying your hair for a change?",
      "translation" : "哇！染過之後，你的頭髮一定會美極了~要不要換個顏色試試？"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Dye Hair",
      "translation" : "染髮"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Tips and Information",
      "translation" : "護理建議與說明"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理髮師約沃維奇]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Yes yes, good choice~",
      "translation" : "是啊是啊，選得真好~"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Well then, this is your chance for a make-over, your chance to blossom in beauty! Choose the color you would like.",
      "translation" : "那麼，這就是讓你煥然一新的機會，讓你綻放美麗的機會！選個喜歡的顏色吧。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理髮師約沃維奇]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "What do you think? Did you want a different color?",
      "translation" : "怎麼樣？想換個顏色嗎？"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "想"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "No",
      "translation" : "不想"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理髮師約沃維奇]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Okay! Choose the color that you would like.",
      "translation" : "好！選個你喜歡的顏色吧。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "[Hairdresser Jovovich]",
      "translation" : "[理髮師約沃維奇]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Hmm, I'm sort of disappointed. I wanted to do a better job. But I promise I'll do it better next time. Please come again~",
      "translation" : "嗯，我有點失望。本來想做得更好一些。不過我保證下次會做得更好。記得再來哦~"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Red, please.",
      "translation" : "請染成紅色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Yellow, please.",
      "translation" : "請染成黃色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Violet, please.",
      "translation" : "請染成紫色。"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Jovovich",
      "state" : "translated",
      "text" : "Orange, please.",
      "translation" : "請染成橙色。"
