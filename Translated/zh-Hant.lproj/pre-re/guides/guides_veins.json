{
  "file" : "npc/pre-re/guides/guides_veins.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Desert City Veins welcomes adventurers seeking shelter from harsh sandstorms.",
      "translation" : "沙漠城市維因斯歡迎各位冒險者前來，在狂暴的沙塵暴中尋求庇護。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If this is the first time for you to use the guide services, why don't you check the...",
      "translation" : "如果這是你第一次使用導覽服務，不妨先檢視..."
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Village Guide",
      "translation" : "村莊導覽"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Remove Marks from Mini-Map",
      "translation" : "移除小地圖示記"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Notice",
      "translation" : "公告"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "I can tell you any building location as long as it is in Veins.",
      "translation" : "只要在維因斯城內，我都能告訴你各棟建築的位置。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "So where do you want to go?",
      "translation" : "你想去哪裡？"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Would you like me",
      "translation" : "要我幫你"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "to mark locations",
      "translation" : "在小地圖上"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "on your Mini-Map?",
      "translation" : "標記位置嗎？"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "要"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "No",
      "translation" : "不要"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Temple",
      "translation" : "神殿"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Inn",
      "translation" : "旅館"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Weapon Shop",
      "translation" : "武器店"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Tool Shop",
      "translation" : "道具店"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Airship",
      "translation" : "飛艇"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Tavern",
      "translation" : "酒吧"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Geological Research Institute",
      "translation" : "地質研究所"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Our temple is located north,",
      "translation" : "我們的神殿位於北邊，"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "and always crowded with sincere followers of Goddess Freya.",
      "translation" : "那裡總是擠滿了芙蕾雅女神的虔誠信徒。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "You can rest your fatigue of the journey in the Inn.",
      "translation" : "旅途勞累的話，可以到旅館休息。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "The left building next to me is the Inn of Veins.",
      "translation" : "我旁邊左側的建築就是維因斯旅館。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Yes, you should protect yourself from danger on your own.",
      "translation" : "是的，你應該靠自己保護自己，免受危險。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Purchase high quality weapons at affordable prices.",
      "translation" : "這裡可以買到價格實惠的優質武器。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "The Veins Weapon Shop is located to the West.",
      "translation" : "維因斯武器店位於西邊。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Have you packed enough necessities  for your adventure?",
      "translation" : "冒險所需的物品都準備齊了嗎？"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If not, I suggest you check what the Veins in the Center can offer you.",
      "translation" : "如果沒有，我建議你去看看維因斯中央區有什麼可買的。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Please be aware that Veins only operates cargo airships.",
      "translation" : "請注意，維因斯只有貨運飛艇。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If you'd like to make friends with",
      "translation" : "如果你想結識"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "the townspeople, I suggest you",
      "translation" : "鎮上的居民，我建議你"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "go have a drink at the tavern to",
      "translation" : "去西邊的酒吧"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "the west.",
      "translation" : "喝一杯。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Are you interested in studying geology?",
      "translation" : "你對地質學有興趣嗎？"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Then you'd better go check out the",
      "translation" : "那你最好去看看"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Geological Research Institute on",
      "translation" : "武器店二樓的"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "the 2nd floor of the weapon shop.",
      "translation" : "地質研究所。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If you like to get rid of all the location marks on your Mini-Map,",
      "translation" : "如果想移除小地圖上的所有位置標記，"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "just ask me again, and choose 'Remove Marks from Mini-Map' menu.",
      "translation" : "再來找我，並選擇“移除小地圖示記”選單即可。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Okay, they are gone now. If you have more locations to ask, just let me know.",
      "translation" : "好了，標記已經移除了。還想查詢其他地點的話，告訴我就行。"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Enjoy your stay in Veins.",
      "translation" : "祝你在維因斯逗留愉快。"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "When you are using the ''Village Guide'' menu,",
      "translation" : "使用“村莊導覽”選單時，"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "make sure that building locations will be marked on your mini-map at the upper right side of your screen.",
      "translation" : "請留意建築位置會標記在螢幕右上角的小地圖上。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "If you cannot see your mini-map, use the short cut key ''ctrl+tab'' or press the ''Map'' button on your basic information windows, okay?",
      "translation" : "如果看不到小地圖，可以按快捷鍵“Ctrl+Tab”，或點選基本資訊視窗中的“地圖”按鈕。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "And you can also zoom out your mini-map by using the ''-'' button in case you cannot view the entire map of the village.",
      "translation" : "如果無法看到整個村莊地圖，也可以按“-”按鈕縮小小地圖。"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "[Veins Guide]",
      "translation" : "[維因斯導覽員]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Veins Guide",
      "state" : "translated",
      "text" : "Enjoy your stay in Veins.",
      "translation" : "祝你在維因斯逗留愉快。"
    }
  ]
}