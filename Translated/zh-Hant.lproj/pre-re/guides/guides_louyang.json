    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Welcome to Luoyang,",
      "translation" : "歡迎來到龍之城，"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "a city with a long",
      "translation" : "這是一座歷史悠久"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "and colorful history.",
      "translation" : "且多姿多彩的城市。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Recently we've developed",
      "translation" : "最近，我們開闢了"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "an ocean lane to accomodate",
      "translation" : "一條海上航線，以促進"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "positive exchange with",
      "translation" : "友好往來"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "foreign nations.",
      "translation" : "與外國之間的交流。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Luoyang is well-known for various specialties in addition to its rich history. Here you can find many things unique to our land.",
      "translation" : "龍之城不僅歷史悠久，也以各種特產聞名。在這裡，您能找到許多本地獨有的事物。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Please take your time",
      "translation" : "請慢慢遊覽，"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "and we invite you to enjoy",
      "translation" : "祝您在這裡"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "your trip here in Luoyang.",
      "translation" : "度過愉快的時光。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Ask Building Locations.",
      "translation" : "詢問建築位置。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Remove all marks from mini-map.",
      "translation" : "清除小地圖上的所有標記。"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Where would you like to go?",
      "translation" : "您想去哪裡？"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Dragon Castle",
      "translation" : "龍宮"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Doctor's Office",
      "translation" : "診所"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "City Hall",
      "translation" : "市政廳"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Weapon Shop",
      "translation" : "武器店"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Tool Shop",
      "translation" : "道具店"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Tavern",
      "translation" : "酒館"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Dragon Castle is located at ^FF3355+^000000. It is where all the nobles reside, including our lord.",
      "translation" : "龍宮位於^FF3355+^000000標記處。包括領主在內，所有貴族都住在那裡。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Since you're an outsider, I guess it would be appropriate for you to visit our lord first.",
      "translation" : "您是外地來的客人，我想先去拜訪領主比較合適。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "We have a very skillful doctor.",
      "translation" : "這裡有一位醫術高明的醫生。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "You can find her office at ^CE6300+^000000.",
      "translation" : "她的診所位於^CE6300+^000000標記處。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "It is said that there",
      "translation" : "據說沒有"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "is no disease she cannot cure. Well, I can't guarantee if that's true or not.",
      "translation" : "她治不好的病。不過這話是真是假，我可不敢保證。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "We have a City Hall where the federal government operates.",
      "translation" : "這裡設有市政廳，聯邦政府就在此辦公。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "It is located at ^A5BAAD+^000000.",
      "translation" : "市政廳位於^A5BAAD+^000000標記處。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "If you have any problems,",
      "translation" : "如果您遇到問題，"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "you should talk with the",
      "translation" : "可以向市政廳的"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "employees in City Hall.",
      "translation" : "工作人員諮詢。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Weapon Shop is located at ^55FF33+^000000.",
      "translation" : "武器店位於^55FF33+^000000標記處。"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "You will see",
      "translation" : "在那裡，您可以看到"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "marvelous weapons forged",
      "translation" : "由龍之城經驗豐富的鐵匠"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "by the well-experienced",
      "translation" : "精心打造的"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "blacksmiths of Luoyang.",
      "translation" : "精良武器。"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Tool Shop is located at ^3355FF+^000000.",
      "translation" : "道具店位於^3355FF+^000000標記處。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Knowing your enemy",
      "translation" : "瞭解敵人"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "is half the battle!",
      "translation" : "就成功了一半！"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "It's also safer to prepare yourself than to be sorry later. Why don't you go check their supplies?",
      "translation" : "事先做好準備，總比事後後悔要穩妥。不妨去看看店裡的補給品？"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "When you get tired during your trip, I suggest that you visit the Tavern. It's located at ^00FF00+^000000.",
      "translation" : "旅途中累了，不妨去酒館休息一下。酒館位於^00FF00+^000000標記處。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "The Tavern is a good place",
      "translation" : "酒館是結識其他遊客的好地方，"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "to meet other tourists, as well as to hear of any news that may be helpful to know.",
      "translation" : "也能打聽到一些有用的訊息。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "If you wish to remove all marks",
      "translation" : "如果您想清除小地圖上的所有標記，"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "on your mini-map, please choose 'Remove all marks from mini-map.' from the menu.",
      "translation" : "請在選單中選擇“清除小地圖上的所有標記”。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "There, I've erased all the marks on your mini-map. Feel free to ask me about building locations whenever you need to.",
      "translation" : "好了，您小地圖上的所有標記都已清除。需要詢問建築位置時，隨時來找我。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "I guess it's fun",
      "translation" : "有時候，"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "sometimes to go exploring",
      "translation" : "自己四處探索"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "on your own. Take care.",
      "translation" : "也挺有趣。保重。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "[Representative]",
      "translation" : "[代表]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "Welcome to Luoyang,",
      "translation" : "歡迎來到龍之城，"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "an ancient land with",
      "translation" : "這片古老的土地，"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "a history full of tales",
      "translation" : "流傳著許多"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "of bravery.",
      "translation" : "英勇的故事。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "[Representative]",
      "translation" : "[代表]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "We now provide an ocean lane to accomodate foreign travelers and intercultural exchange from which all can benefit.",
      "translation" : "我們已開闢海上航線，方便外國旅客往來，促進文化交流，讓大家都能從中受益。"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "[Representative]",
      "translation" : "[代表]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "Luoyang is famous for",
      "translation" : "龍之城以悠久的歷史"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Representative",
      "state" : "translated",
      "text" : "its elaborate history, as well as specialties that are unique to this nation. Please take your time and enjoy your stay.",
      "translation" : "和本國獨有的特產聞名。請慢慢遊覽，祝您在此度過愉快的時光。"
    },
    {
      "kind" : "option",
