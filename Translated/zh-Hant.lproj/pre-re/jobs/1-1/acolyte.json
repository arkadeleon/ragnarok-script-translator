      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Good Lord! Haven't you accomplished the Basic Training yet?! It's important that you finish that!",
      "translation" : "天哪！你還沒完成基本訓練嗎？！完成訓練非常重要！"
