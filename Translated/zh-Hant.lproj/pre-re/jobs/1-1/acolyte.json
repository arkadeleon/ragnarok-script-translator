    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "May God be",
      "translation" : "願上帝"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "with you.",
      "translation" : "與你同在。"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Well, I welcome you",
      "translation" : "歡迎你從瓦爾哈拉"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "back from Valhalla and",
      "translation" : "回來，願你在"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "wish you luck on your",
      "translation" : "新的人生旅程中"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "new life's journey.",
      "translation" : "一切順利。"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Now, venture forth and seek those who need your help. May God light your path.",
      "translation" : "現在，出去尋找需要幫助的人吧。願上帝照亮你的道路。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Now, venture forth to seek people who need your help. May God enlighten your way.",
      "translation" : "現在，出去尋找需要幫助的人吧。願上帝指引你的道路。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "I sense that you have endured a past life experience. You must have learned many things before entering Valhalla.",
      "translation" : "我感覺你經歷過前世的人生。進入瓦爾哈拉之前，你一定學到了許多東西。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "However, I can tell that you are not suited to be an Acolyte. Please remember who you were in your past life and find your path.",
      "translation" : "不過，我看得出你並不適合成為服事者。請記住前世的自己，找到屬於你的道路。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "What is it that you seek?",
      "translation" : "你想要什麼？"
    },
    {
      "kind" : "option",
      "line" : 84,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Father, I want to be a Acolyte.",
      "translation" : "神父，我想成為服事者。"
    },
    {
      "kind" : "option",
      "line" : 84,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Acolyte Requirements.",
      "translation" : "服事者轉職條件。"
    },
    {
      "kind" : "option",
      "line" : 84,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Just looking around.",
      "translation" : "只是隨便看看。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Are you feeling okay today? I can tell by your attire that you are already an Acolyte. You're not joking around, are you?",
      "translation" : "你今天感覺還好嗎？看你的裝扮，已經是服事者了。你不是在開玩笑吧？"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "I'm sorry, but we can only accept Novices as applicants for the job change to Acolyte.",
      "translation" : "抱歉，只有初心者才能申請轉職為服事者。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Do you truly",
      "translation" : "你真的"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "wish to become",
      "translation" : "想成為"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "a servant of God?",
      "translation" : "上帝的僕人嗎？"
    },
    {
      "kind" : "option",
      "line" : 100,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Yes Father, I do.",
      "translation" : "是的，神父，我願意。"
    },
    {
      "kind" : "option",
      "line" : 100,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Nope, I lied.",
      "translation" : "不了，我撒謊的。"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Cleric",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "Good. I accept {0}'s will to become an Acolyte. You understand that you must do penance before you can become a servant of God, right?",
      "translation" : "很好。我接受{0}成為服事者的心願。你明白成為上帝的僕人之前，必須先接受苦行考驗吧？"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Well, I will",
      "translation" : "那麼，我會"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "give you a mission...",
      "translation" : "給你一項任務..."
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Please visit ^000077Father Rubalkabara^000000, a member of the Prontera Parish, and return here. He has been practicing asceticism in the ^000077Relics NorthEast of Prontera City^000000.",
      "translation" : "請拜訪^000077魯巴卡巴拉神父^000000（普隆德拉教區成員），然後回來找我。他在^000077普隆德拉城東北方的遺蹟^000000苦修。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Please visit ^000077Mother Mathilda^000000 and then return to me. She has been practicing asceticism near ^000077Morocc Town, SouthWest of Prontera City^000000.",
      "translation" : "請拜訪^000077瑪蒂爾達修女^000000，然後回來找我。她在^000077普隆德拉城西南方的夢羅克鎮^000000附近苦修。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Please visit ^000077Father Yosuke^000000 and return here. He has been practicing asceticism around ^000077a bridge somewhere NorthWest of Prontera^000000.",
      "translation" : "請拜訪^000077約斯克神父^000000，然後回來找我。他在^000077普隆德拉西北方某處的橋邊^000000苦修。"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "May the grace of God light your path and guide you during your journey of penance.",
      "translation" : "願上帝的恩典照亮你的道路，在苦行旅程中指引你。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "You lied?",
      "translation" : "你撒謊了？"
