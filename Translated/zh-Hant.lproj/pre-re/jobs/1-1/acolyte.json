      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "You should have trained more! Go back and make sure you reach Novice Job Level 9 and learn all of the Basic Skills!",
      "translation" : "你應該再多訓練！回去升到初心者職業等級9，並學會所有基本技能！"
