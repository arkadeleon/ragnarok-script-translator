    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "[Father Mareusis]",
      "translation" : "[馬雷修斯神父]"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Always use your gifts to serve Him by helping others. In chaos and times of difficulty, face your hardships with unwavering faith.",
      "translation" : "要善用上帝賜予你的才能幫助他人。在混亂和艱難時刻，也要以堅定的信念面對困境。"
    },
    {
      "kind" : "message",
      "line" : 202,
