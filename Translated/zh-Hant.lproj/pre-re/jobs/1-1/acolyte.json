      "text" : "peace, my son.",
      "translation" : "願你平安，我的孩子。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Cleric",
      "state" : "translated",
      "text" : "Oh, you've come back. Let me check and see if you are ready to serve God. Let's see...",
      "translation" : "哦，你回來了。讓我看看你是否準備好侍奉上帝。嗯..."
