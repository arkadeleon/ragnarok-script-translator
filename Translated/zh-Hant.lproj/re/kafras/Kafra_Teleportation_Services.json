    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "F_KafTeleDoram",
      "state" : "translated",
      "text" : "[Kafra Employee]\nSir! You do not have enough value that we are asking for.\nPlease check back again.",
      "translation" : "[卡普拉職員]\n這位客人，您帶的費用不夠。\n請再確認一下。"
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Kafra Teleportation",
      "state" : "translated",
      "text" : "[Kafra Employee]\nWelcome.\nThe Kafra services are always on your side.",
      "translation" : "[卡普拉職員]\n歡迎光臨。\n卡普拉服務永遠在您身邊。"
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Kafra Teleportation",
      "state" : "translated",
      "text" : "[Kafra Employee]\nTo reward adventurer support, the Kafra Corporation in cooperation with the Eden Group provides free services for ^ff0000Beginner Adventurers Below Level 39^000000.",
      "translation" : "[卡普拉職員]\n為答謝冒險者們的支援，卡普拉總公司與樂園團合作，為^ff000039級以下的新手冒險者^000000提供免費服務。"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Kafra Teleportation",
      "state" : "translated",
      "text" : "[Kafra Employee]\nWe do not offer free teleportation services for adventurers ^ff0000above level 40^000000.\nSearch for Kafra Teleportation services in the city.",
      "translation" : "[卡普拉職員]\n我們不為^ff000040級以上^000000的冒險者提供免費傳送服務。\n請使用城裡的卡普拉傳送服務。"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Kafra Teleportation",
      "state" : "translated",
      "text" : "[Kafra Employee]\nPlease choose your destination.",
      "translation" : "[卡普拉職員]\n請選擇您的目的地。"
    },
    {
      "kind" : "option",
      "line" : 243,
      "npc" : "Kafra Teleportation",
