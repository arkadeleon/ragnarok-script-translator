    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "The monsters here are able to control time.",
      "translation" : "這裡的魔物能夠操控時間。"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Come back when you've reached ^0000FFLevel 150^000000.",
      "translation" : "達到^0000FF150級^000000後再回來。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Time, memories, environments... all can become warped here.",
      "translation" : "時間、記憶、環境...在這裡一切都可能扭曲。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "I'm begging you not to ask more about it. It might put your life in danger.",
      "translation" : "求你別再問下去了。這可能會讓你丟掉性命。"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Don't ask",
      "translation" : "不再詢問"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Go to 2nd floor of warped tower",
      "translation" : "前往扭曲之塔2樓"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Go to 3rd floor of warped tower",
      "translation" : "前往扭曲之塔3樓"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Be careful with your choice.",
      "translation" : "慎重選擇。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "I need ^0000FF10,000z^000000 to let you in. It's a pretty dangerous place to be.",
      "translation" : "我需要^0000FF10,000 Zeny^000000才能讓你進去。那裡相當危險。"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Quit",
      "translation" : "退出"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Pay 10,000z",
      "translation" : "支付10,000 Zeny"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Why do you need money?",
      "translation" : "你為什麼需要錢？"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Really? You don't have the money and asked me to take you there?",
      "translation" : "真的嗎？你沒錢，還要我帶你去那裡？"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "I'm not sure how you'll keep track of time in there but be as careful as you can.",
      "translation" : "我不確定你在裡面該如何判斷時間，但無論如何都要小心。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "I am here all day for the safety of adventurers. I always alert them about the danger. That's why I need some form of payment.",
      "translation" : "我整天都在這裡保護冒險者，也總是提醒他們那裡很危險。所以我需要收取一些費用。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Phew...You've made a good choice. This place is brutal so you should probably get back to a safe area.",
      "translation" : "呼...你做了正確的選擇。那裡非常殘酷，最好回到安全的地方。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Perhaps you've seen me before?",
      "translation" : "你以前也許見過我？"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "You saw me in a different place, with a different look.",
      "translation" : "你在別的地方見過我，當時我的模樣不同。"
    },
    {
      "kind" : "option",
      "line" : 82,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Who are you?",
      "translation" : "你是誰？"
    },
    {
      "kind" : "option",
      "line" : 82,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Get me out of here!",
      "translation" : "帶我離開這裡！"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Can you explain to me what you've seen, what you've done?",
      "translation" : "你能告訴我你看到了什麼、做了什麼嗎？"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Me too. You might also be a missing one. Unaware, with no purpose nor idea.",
      "translation" : "我也一樣。你可能也是個失蹤者，渾然不覺，沒有目的，也不知道該做什麼。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "It's time to go back. Please cherish your time some more.",
      "translation" : "該回去了。請再好好珍惜這段時光。"
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Stay a little bit more",
      "translation" : "再多待一會兒"
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "Please take me back",
      "translation" : "請帶我回去"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "You must really like this place. Well, do whatever you want.",
      "translation" : "你真的很喜歡這裡啊。那就隨你吧。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Belljamin Button",
      "state" : "translated",
      "text" : "[Belljamin Button]",
      "translation" : "[貝爾傑明·巴頓]"
    },
    {
