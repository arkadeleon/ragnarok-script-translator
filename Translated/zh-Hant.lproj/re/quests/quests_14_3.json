      "line" : 32,
      "npc" : "Interdimensional Device",
      "state" : "translated",
      "text" : "This teleporter is connected to the recently discovered hideout of the Demon God.",
      "translation" : "這個傳送裝置連線著最近發現的魔神藏身處。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Interdimensional Device",
      "state" : "translated",
      "text" : "Only those allowed to enter the hideout can use this teleporter.",
      "translation" : "只有獲准進入藏身處的人才能使用這個傳送裝置。"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Interdimensional Device",
      "state" : "translated",
      "text" : "This teleporter is connected to the recently discovered hideout of the Demon God.",
      "translation" : "這個傳送裝置連線著最近發現的魔神藏身處。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Interdimensional Device",
      "state" : "translated",
      "text" : "Do you want to use it?",
      "translation" : "要使用它嗎？"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Interdimensional Device",
      "state" : "translated",
      "text" : "Move to the Demon God's hideout.",
      "translation" : "前往魔神的藏身處。"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Interdimensional Device",
      "state" : "translated",
      "text" : "Quit.",
      "translation" : "退出。"
    },
    {
