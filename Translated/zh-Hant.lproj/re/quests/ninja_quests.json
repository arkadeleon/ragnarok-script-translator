      "line" : 67,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "[Gyo]",
      "translation" : "[京]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "Ninja Scale Armor... It's said that a legendary Ninja once wore it.",
      "translation" : "忍者鱗甲...據說曾有一位傳奇忍者穿過它。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "[Gyo]",
      "translation" : "[京]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "This is truly a legendary armor...",
      "translation" : "這確實是一件傳說中的防具..."
