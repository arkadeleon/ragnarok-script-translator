    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "How would you define victory?",
      "translation" : "你如何定義勝利？"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "To fell the enemy...",
      "translation" : "擊倒敵人..."
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "However, the most important thing is...",
      "translation" : "然而，最重要的是..."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "Never to fall yourself!",
      "translation" : "自己絕不能倒下！"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "[Gyo]",
      "translation" : "[京]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "For that, you must better protect yourself.",
      "translation" : "因此，你必須更好地保護自己。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "You cannot protect 'others' while you hinder your 'own' protection.",
      "translation" : "連自己都保護不好，又怎麼保護“他人”？"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "Combine armor.",
      "translation" : "組合防具"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "End conversation.",
      "translation" : "結束對話"
