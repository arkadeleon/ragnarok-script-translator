    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Master Armor Craftsman",
      "state" : "translated",
      "text" : "Crescent Armguard... A thing of beauty and strength... With none the lesser.",
      "translation" : "月紋護手...美麗與力量並存，二者都毫不遜色。"
