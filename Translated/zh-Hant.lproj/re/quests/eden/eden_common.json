    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Eden members will review the missions and help those who post them up.",
      "translation" : "樂園團成員會檢視委託，並幫助釋出委託的人。"
    },
