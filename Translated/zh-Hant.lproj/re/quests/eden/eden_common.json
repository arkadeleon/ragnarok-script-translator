      "state" : "translated",
      "text" : "[Lime Evenor]",
      "translation" : "[萊姆·艾弗諾]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "There you go. Come back again~",
      "translation" : "給您。歡迎再來~"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "[Lime Evenor]",
      "translation" : "[萊姆·艾弗諾]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "People who follow their dreams and romances listen to me. We are representatives of the paradise called 'The garden of Eden' called the Eden group . There is no place like this anywhere.",
      "translation" : "追尋夢想與浪漫的人們，請聽我說！我們是樂園團的代表，這裡就像名為“伊甸園”的樂園，世上獨一無二。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Hello. Can I help you?",
      "translation" : "您好，有什麼能幫您的嗎？"
    },
    {
      "kind" : "option",
      "line" : 62,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "What is Eden group?",
      "translation" : "什麼是樂園團？"
    },
    {
      "kind" : "option",
      "line" : 62,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Join the Eden Group.",
      "translation" : "加入樂園團"
    },
    {
      "kind" : "option",
      "line" : 62,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Register new mission.",
      "translation" : "登記新委託"
    },
    {
      "kind" : "option",
      "line" : 62,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Search for missions.",
      "translation" : "查詢委託"
