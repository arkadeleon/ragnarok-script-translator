    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "Eden Group is a group that helps people who are suffering from distresses in Midgard.",
      "translation" : "樂園團是一個幫助米德加爾特受苦民眾的組織。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "[Lime Evenor]",
      "translation" : "[萊姆·艾弗諾]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Secretary Lime Evenor",
      "state" : "translated",
      "text" : "If people need help, we put up the case on the bulletin board and introduce it to our members who are eager to help those in need.",
      "translation" : "有人需要幫助時，我們會把委託張貼在公告欄上，再介紹給願意助人的團員。"
