    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Long time no see!",
      "translation" : "好久不見！"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Hey, you didn't quit",
      "translation" : "喂，你沒有放棄"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "your business, did you?",
      "translation" : "自己的生意吧？"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "What happened?",
      "translation" : "怎麼了？"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[會長曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Whoa...",
      "translation" : "哇..."
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "You've actually been to Valhalla?! Wow, you've come a long way...",
      "translation" : "你真的去過英靈殿？！哇，真是成長了不少..."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[會長曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Hmmm...",
      "translation" : "嗯..."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "It seems that you're not ready to become a Merchant again. Go finish learning the Basic Novice Skills first.",
      "translation" : "看來你還沒準備好再次成為商人。先去學完初學者的基本技能吧。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[會長曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Don't worry, we'll always have a Merchant position open for you. Just come back when you're ready, okay?",
      "translation" : "別擔心，我們隨時都為你留著商人的位置。準備好後再回來，好嗎？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[會長曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I guess it's destiny that we meet like this once more. Alright. Once again, let me change you into a Merchant!",
      "translation" : "我想我們再次相遇一定是命運安排。好吧，我再幫你轉職為商人！"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[會長曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Ah~ How nostalgic. Just like old times! Alright, do your best!",
      "translation" : "啊~真令人懷念。就像以前一樣！好好努力吧！"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Chief Mahnsoo]",
      "translation" : "[會長曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "^333333*Sigh*^000000",
      "translation" : "^333333*嘆氣*^000000"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I'm so bored...",
      "translation" : "真無聊..."
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "When will I hear from my lovely Blossom?",
      "translation" : "我什麼時候才能收到可愛的花花的訊息呢？"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Hey, why are you here?",
      "translation" : "喂，你來這裡做什麼？"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I want to be a merchant.",
      "translation" : "我想成為商人。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "I want to know more about merchants.",
      "translation" : "我想了解更多關於商人的事。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Ask him the requirements to be a merchant.",
      "translation" : "問他成為商人的條件。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Nothing.",
      "translation" : "沒事。"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : ".....? Sorry? What are you saying?",
      "translation" : "...？抱歉？你在說什麼？"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "You are already a merchant. Oh my..",
      "translation" : "你已經是商人了。哎呀..."
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Huh?! ...Do I need to laugh right now?!",
      "translation" : "什麼？！...現在是要我笑嗎？！"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Ahh? Are you trying to have both ways?",
      "translation" : "啊？你想兩邊都佔著嗎？"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "How about just giving yourself over to your original job?",
      "translation" : "不如回去做你原本的職業吧？"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "We have business ethics you know.",
      "translation" : "我們可是講商業道德的。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Want to be a merchant? Hmm...",
      "translation" : "想成為商人？嗯..."
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "But if you want to be a merchant, your basic skill level must reach Level 9 or you must spend all of your skill points.",
      "translation" : "不過想成為商人，基本技能等級必須達到9級，或者用完所有技能點。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Don't you think we need to learn some basic skills although we just deal with money?",
      "translation" : "你不覺得即使我們只跟錢打交道，也得學一些基本技能嗎？"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Good, I think you're fully ready for it seeing that your basic skill level is fulfilled.",
      "translation" : "很好，你的基本技能等級已經達標，我想你完全準備好了。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Now I allow you to be a merchant.",
      "translation" : "現在我批准你成為商人。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Congratulations on becoming a merchant!",
      "translation" : "恭喜你成為商人！"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Congratulations again for being a member of the merchant guild and one of our colleagues. I expect your active participation from now on!",
      "translation" : "再次恭喜你加入商人公會，成為我們的同伴。從現在起，我期待你積極參與！"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Absolutely, we need young people who have passion to achieve our great goal for securing 20% of the worldwide currency volume. You get it? Huh?",
      "translation" : "當然，我們需要有幹勁的年輕人，幫助實現掌握全球20%貨幣流通量的宏偉目標。明白嗎？嗯？"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Well, I'm just saying... it means let's make lots of money in the end. You guys know that~",
      "translation" : "哎，我只是說說...總之就是要賺大錢。你們懂的~"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Merchant? To put it simply, the person who sells good and makes money is a merchant.",
      "translation" : "簡單來說，商人就是出售商品賺錢的人。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Not good at fighting and doesn't have special attack/recovery skills... but a merchant can buy things at a low price and then sell them and make money.",
      "translation" : "商人不擅長戰鬥，也沒有特別的攻擊或恢復技能...但可以低價買進，再高價賣出賺錢。"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Well, a merchant has an ultimate skill called Mammonite which strikes an enemy with his/her money... We can equip everything except Bows, Rods, and Two-Handed Swords. But we can always sell and buy those.",
      "translation" : "商人有一種終極技能叫金錢攻擊，可以用錢砸擊敵人...除了弓、手杖和雙手劍，其他武器我們都能裝備。不過這些也可以低買高賣。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Yes... we merchants always have money on our minds, got it?",
      "translation" : "沒錯...我們商人腦子裡想的總是錢，明白了嗎？"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "To become a merchant, although just selling and receiving money is our job, you must reach at least basic skill level 9.",
      "translation" : "要成為商人，雖然我們的工作只是買賣收錢，基本技能等級也必須至少達到9級。"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Well, we used to receive a start-up fee before. Wasn't it hard to make that money?",
      "translation" : "以前我們會收取創業費。要湊齊那筆錢很難吧？"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "There were too many people who couldn't gather that money and kept crying.",
      "translation" : "有太多人湊不齊錢，只能一直哭訴。"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "[Guildsman Mahnsoo]",
      "translation" : "[公會職員曼蘇]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "So recently, we decided to allow any Novice who wants to be a merchant become one.",
      "translation" : "所以最近我們決定，任何想成為商人的初學者都可以轉職。"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Merchant",
      "state" : "translated",
      "text" : "Because to be alive or not later is all up to one's ability.",
      "translation" : "因為以後能不能活下去，全看個人本事。"
    }
  ]
}