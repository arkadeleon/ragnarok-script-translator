{
  "file" : "npc/re/jobs/3-2/sorcerer.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "You packed so much in your bag. Try again after emptying your bag.",
      "translation" : "你的背包塞得太滿了。清空一些物品後再試。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Please get on with the sprits well~ You should~!",
      "translation" : "好好和精靈相處哦~一定要哦~！"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Wow~ you are a young adventurer. I envy you.",
      "translation" : "哇~你真是個年輕的冒險者，真讓人羨慕。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Ahh~ I think you don't need to have a conversation with me.",
      "translation" : "啊~我想你沒必要和我交談。"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Welcome. What can I help you with?",
      "translation" : "歡迎。有什麼我能幫你的嗎？"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Do you know about Sorcerers?",
      "translation" : "你瞭解妖術師嗎？"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Wouldn't it be more comfortable to just live as a scholar? Sorcerers are busy communicating with the spirits and don't have much time to read books...",
      "translation" : "當個學者安穩地生活，不是更舒服嗎？妖術師整天忙著和精靈交流，沒多少時間看書..."
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "What made you want to be a sorcerer?",
      "translation" : "你為什麼想成為妖術師？"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "The spirit of fire led me here.",
      "translation" : "火之精靈指引我來到這裡"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "The spirit of water led me here.",
      "translation" : "水之精靈指引我來到這裡"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "The spirit of earth led me here",
      "translation" : "地之精靈指引我來到這裡"
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "The spirit of meat led me here.",
      "translation" : "肉之精靈指引我來到這裡"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "That kind of spirit doesn't exist!",
      "translation" : "根本沒有那種精靈！"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Oh, I see.",
      "translation" : "哦，原來如此。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "You must be born with the natural ability to see that you already communicated with the spirits, or you must be an excellent liar.",
      "translation" : "你可能天生就有看見精靈的能力，已經和精靈交流過了；也可能只是個特別會撒謊的人。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Hmm... Then first, can you write down your name on this list?",
      "translation" : "嗯...首先，能把你的名字寫在這張名單上嗎？"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Write name.",
      "translation" : "寫下名字"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "I won't.",
      "translation" : "我不寫"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Well, okay. See you again when you get a chance.",
      "translation" : "好吧。有機會再來見我。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Merito",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "So, you are [{0}].",
      "translation" : "那麼，你就是[{0}]。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Give me a second to register your name.",
      "translation" : "等我一下，我先登記你的名字。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Talk to me again in a second.",
      "translation" : "稍後再和我說話。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Good, then I'll give you a short explanation about the Sorcerer.",
      "translation" : "好，我先簡單介紹一下妖術師。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Merito",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}], can you handle magic skillfully?",
      "translation" : "[{0}]，你擅長使用魔法嗎？"
    },
    {
      "kind" : "option",
      "line" : 78,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Yes, I can.",
      "translation" : "是的，我可以"
    },
    {
      "kind" : "option",
      "line" : 78,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "No, I'm not really good at it.",
      "translation" : "不，我不太擅長"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "What!? You don't know how to use magic?",
      "translation" : "什麼？！你不會使用魔法？"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "What are you doing here then? Get out of here. Right now!",
      "translation" : "那你來這裡做什麼？快出去，現在就走！"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Okay, that should be obvious.",
      "translation" : "好，這還用說嗎？"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Of course, Sorcerers use magic, too. But, do you know the main difference Sorcerers have from other magical jobs?",
      "translation" : "當然，妖術師也會使用魔法。不過，你知道妖術師和其他魔法職業最大的區別是什麼嗎？"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "They know how to sing.",
      "translation" : "他們知道怎麼唱歌"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "They're all old fogies.",
      "translation" : "他們都是一群老古董"
    },
    {
      "kind" : "option",
      "line" : 88,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "They can deal with the spirits.",
      "translation" : "他們能與精靈溝通"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Well maybe some but that's not the main difference.",
      "translation" : "嗯，也許有些人會唱歌，但這不是主要區別。"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "What! How dare you!?!",
      "translation" : "什麼！你竟敢這麼說？！"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "That's right. That is the most distinguishing feature that Sorcerers have.",
      "translation" : "沒錯。這就是妖術師最顯著的特徵。"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "When the people who want to be a Sorcerer come, the first thing we do is to check whether they can communicate with spirits or not.",
      "translation" : "想成為妖術師的人來報名時，我們首先會確認他們能不能與精靈溝通。"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "So that's the basic introduction, so you just need to decide whether or not you want to take the qualification test.",
      "translation" : "基本介紹就到這裡。你只需要決定是否參加資格考試。"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Well, it's all up to you. What are you going to do?",
      "translation" : "決定權在你。你打算怎麼做？"
    },
    {
      "kind" : "option",
      "line" : 112,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "I will take the test.",
      "translation" : "我要參加測試"
    },
    {
      "kind" : "option",
      "line" : 112,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "I'll do it later.",
      "translation" : "以後再來"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Okay. ",
      "translation" : "好。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "Then I'll hand it over to Karacas who is on the 4th floor. He will guide you through the process of the test.",
      "translation" : "那我會把你交給在4樓的卡拉卡斯。他會指導你完成考試。"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "[Merito]",
      "translation" : "[梅里托]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "What? I was sure that you wanted to become a Sorcerer.",
      "translation" : "什麼？我還以為你想成為妖術師呢。"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Merito",
      "state" : "translated",
      "text" : "How about your test? Well, Karacas is a little lazy, so that might bother you some... kkk",
      "translation" : "你的考試怎麼樣了？卡拉卡斯有點懶，可能會讓你覺得麻煩...呵呵。"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Oh, it seems that you're too heavy. Empty your bag and then come again.",
      "translation" : "你看起來負重太多了。清空背包後再來。"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "You look happy. Have a great journey.",
      "translation" : "你看起來心情不錯。祝你旅途愉快。"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Is there anything I can do for you?",
      "translation" : "有什麼事嗎？"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "I belong to the Sorcerer association. I don't think you have any business with me.",
      "translation" : "我屬於妖術師協會。我想你沒什麼事要找我。"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "More people are visiting Geffen Tower these days.",
      "translation" : "最近來吉芬塔的人越來越多了。"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "....",
      "translation" : "..."
    },
    {
      "kind" : "option",
      "line" : 161,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Ah... excuse me~",
      "translation" : "啊...打擾了~"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "... (Z z z~)",
      "translation" : "...（Z z z~）"
    },
    {
      "kind" : "option",
      "line" : 165,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Hm hm!!!~",
      "translation" : "咳咳！！~"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Aaaak!! ",
      "translation" : "啊啊啊！"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Oh, my... ",
      "translation" : "哦，天哪..."
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Wh... where are you from?",
      "translation" : "你...你是從哪裡來的？"
    },
    {
      "kind" : "option",
      "line" : 173,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Merito told me to visit you.",
      "translation" : "梅里托讓我來找你"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "I see, give me a moment.",
      "translation" : "我知道了，等我一下。"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "The list... has already arrived.",
      "translation" : "名單...已經送到了。"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Karacas",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "So, you are [{0}]... right?",
      "translation" : "那麼，你是[{0}]...對吧？"
    },
    {
      "kind" : "option",
      "line" : 181,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "Yes, I am.",
      "translation" : "是的，我是"
    },
    {
      "kind" : "option",
      "line" : 181,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "No, I'm not!",
      "translation" : "不，我不是！"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Karacas",
      "state" : "translated",
