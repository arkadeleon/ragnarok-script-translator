      "line" : 208,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "[Karacas]",
      "translation" : "[卡拉卡斯]"
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Karacas",
      "state" : "translated",
      "text" : "For example, if you visit the place where the spirit of wind stays with a certain amount of Wind of Verdure, the reaction of the spirit is amplified.",
