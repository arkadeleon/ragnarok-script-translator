{
  "file" : "npc/re/other/dimensional_gap.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 10,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Are you going to enter the ^0000FFDimensional Gap^000000?  Please use this Transport Device you see here.",
      "translation" : "要進入^0000FF次元裂隙^000000嗎？請使用這裡的傳送裝置。"
    },
    {
      "kind" : "option",
      "line" : 13,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "What is the Dimensional Gap?",
      "translation" : "什麼是次元裂隙？"
    },
    {
      "kind" : "option",
      "line" : 13,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "End Conversation.",
      "translation" : "結束對話。"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "As you know we've already entered through the Dimensional Rift to get to Ash Vacuum right?  The Dimensional Gap is an expansion of that initial discovery.",
      "translation" : "你知道，我們已經通過次元裂縫進入了灰燼虛空，對吧？次元裂隙就是在那項發現的基礎上進一步擴充套件而成的。"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "A member of the Expedition team found these backdoor passages to get through the Dimensional Rifts.",
      "translation" : "遠征隊的一名成員發現了這些秘密通道，可以穿越次元裂縫。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "This is like a Midgard Alliance version of the Bifrost bridge so it can connect us to different parts of the New World.",
      "translation" : "這就像是米德加爾特聯盟版本的畢弗羅斯特橋，能夠連線新世界的不同區域。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Time and space is distorted in the Dimensional Gap.  Not all passageways have been discovered so please be sure to use caution when entering an unverified area.",
      "translation" : "次元裂隙中的時空十分扭曲。我們還沒有發現所有通道，所以進入未經確認的區域時務必小心。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Anyone who has become lost here has yet to return.",
      "translation" : "在這裡迷路的人，至今都沒有回來。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Take care.",
      "translation" : "保重。"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "[Expedition Guide]",
      "translation" : "[遠征隊嚮導]"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Expedition Guide",
      "state" : "translated",
      "text" : "Please use a ^0000FFTransport Device^000000 if you wish to travel through the dimensional rift.  The insides have not been fully explored yet so please be careful in there.",
      "translation" : "想要穿越次元裂縫，請使用^0000FF傳送裝置^000000。裡面還沒有完全探索過，請務必小心。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "[Allied Forces Soldier]",
      "translation" : "[同盟軍士兵]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "This dimensional rift is connected to the Allied Forces ^0000FFExpedition Camp^000000 in Jotunheim.",
      "translation" : "這道次元裂縫連線著約頓海姆的同盟軍^0000FF遠征營地^000000。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "[Allied Forces Soldier]",
      "translation" : "[同盟軍士兵]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Allied Forces Soldier",
      "state" : "translated",
      "text" : "Do not worry, it has been set up after testing hundreds of experiments for safe teleportation.",
      "translation" : "放心吧，我們經過數百次實驗測試，才設定好這條安全傳送通道。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "[Morocc Soldier]",
      "translation" : "[夢羅克士兵]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "This dimensional rift is connected to ^0000FFMorocc^000000 back in Midgard.",
      "translation" : "這道次元裂縫連線著米德加爾特的^0000FF夢羅克^000000。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "[Morocc Soldier]",
      "translation" : "[夢羅克士兵]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Morocc Soldier",
      "state" : "translated",
      "text" : "This is the fastest gateway back to our world.  The area is still destroyed but restoration efforts will soon be on the way.",
      "translation" : "這是返回我們世界最快的通道。雖然那片地區仍是一片廢墟，但很快就會開始重建。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "[Spledide Soldier]",
      "translation" : "[斯普蘭迪德士兵]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "This dimensional rift is connected to the south of ^0000FFBifrost^000000.  It enables quick travel to the Splendide frontline.",
      "translation" : "這道次元裂縫連線著^0000FF畢弗羅斯特^000000南部，可以快速前往斯普蘭迪德前線。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "[Spledide Soldier]",
      "translation" : "[斯普蘭迪德士兵]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "If we use it properly, it enables us to advance more easily to the capital of the Sapha.",
      "translation" : "善加利用的話，我們就能更輕鬆地推進到薩帕的首都。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "[Spledide Soldier]",
      "translation" : "[斯普蘭迪德士兵]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Spledide Soldier",
      "state" : "translated",
      "text" : "The Mayor has asked us to cooperate as best we can instead of fighting, so I'm under orders not to do anything.  Since we have a common enemy we won't fight the Sapha... for now...",
      "translation" : "市長要求我們儘可能合作而不是開戰，所以我奉命不得輕舉妄動。既然我們有共同的敵人，暫時不會和薩帕開戰..."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "[Dispatched Sapha]",
      "translation" : "[派遣的薩帕]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "This dimensional rift is connected to the southern area of the ^0000FFKamidal Mountains^000000 in El Dicastes.  I just dropped by for my research, but it is incredible.",
      "translation" : "這道次元裂縫連線著艾爾迪卡斯特斯的^0000FF卡米達爾山脈^000000南部。我只是順道來做研究，但這裡真令人驚歎。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "[Dispatched Sapha]",
      "translation" : "[派遣的薩帕]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Dispatched Sapha",
      "state" : "translated",
      "text" : "Moreover it is next to the Laphine capital..... Hmm... Do not worry, I do not want to fight in such a place.",
      "translation" : "而且這裡就在拉斐內首都旁邊...嗯...放心，我不想在這種地方開戰。"
    },
    {
