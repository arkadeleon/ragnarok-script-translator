      "text" : "[Guild Clerk]",
      "translation" : "[公會職員]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Guild Clerk",
      "state" : "translated",
      "text" : "It seems that many people are looking for Emperium today. It's just a personal feeling.",
      "translation" : "感覺今天好像有很多人來找華麗金屬。只是我個人的感覺。"
