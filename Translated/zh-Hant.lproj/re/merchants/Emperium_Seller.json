      "text" : "[Guild Clerk]",
      "translation" : "[公會職員]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Guild Clerk",
      "state" : "translated",
      "text" : "Our guild office actively supports the smooth gathering of adventurers.",
      "translation" : "我們的公會辦事處會積極協助冒險者順利集結。"
    },
    {
