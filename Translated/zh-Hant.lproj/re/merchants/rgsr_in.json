  "scripts" : [
    {
      "kind" : "message",
      "line" : 8,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[裝備改良宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 9,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Hello, adventurer!",
      "translation" : "你好，冒險者！"
    },
    {
      "kind" : "message",
      "line" : 10,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Are you unhappy with your equipment now?",
      "translation" : "你對現在的裝備不滿意嗎？"
    },
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Don't you want to try a new modification than just any other normal method?",
      "translation" : "想不想試試與眾不同的改造方式？"
    },
    {
      "kind" : "message",
      "line" : 12,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Join the Regenschirm Institute!",
      "translation" : "加入雷根施爾姆研究所吧！"
    },
    {
      "kind" : "option",
      "line" : 14,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Let's go.",
      "translation" : "出發吧。"
    },
    {
      "kind" : "option",
      "line" : 14,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Listen to the explanation.",
      "translation" : "聽聽說明。"
    },
    {
      "kind" : "option",
      "line" : 14,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Quit.",
      "translation" : "離開。"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[裝備改良宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Good! Other facilities in the institute are confidential and are not accessible, so we will guide you on a special path where you outsiders can enter!",
      "translation" : "很好！研究所裡的其他設施屬於機密，外人無法進入，所以我們會帶你走一條特別通道，讓你們這些外來者也能進去！"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[裝備改良宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "All around the world research is being conducted at the Regenschirm Institute to modify weapons, armor, accessories and other equipment items...",
      "translation" : "雷根施爾姆研究所正在世界各地研究武器、防具、飾品等裝備的改造..."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "We're still collecting data and researching modifications, so we need a lot of adventurer's equipment to increase our modification research.",
      "translation" : "我們仍在收集資料、研究改造方式，因此需要大量冒險者的裝備來推進研究。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[裝備改良宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "Research is ongoing, so please look forward to the addition of multiple new equipment as soon as it is completed!",
      "translation" : "研究仍在進行中，完成後敬請期待陸續推出更多新裝備改造！"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "[Equipment Reform PR Agent]",
      "translation" : "[裝備改良宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Equipment Reform PR Agent",
      "state" : "translated",
      "text" : "If you're interested later, come back!",
      "translation" : "以後有興趣的話，歡迎再來！"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Enchant Researcher",
      "state" : "translated",
      "text" : "[Torus]",
      "translation" : "[托魯斯]"
