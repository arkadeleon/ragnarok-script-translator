      "npc" : "Enchant Researcher",
      "state" : "translated",
      "text" : "Huh? Do you have anyone else to see on our team other than the team leader?",
      "translation" : "嗯？除了隊長之外，你們隊伍裡還有別人要見嗎？"
    },
