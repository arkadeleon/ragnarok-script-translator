{
  "file" : "npc/re/merchants/blessed_refiner.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[鐵匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "state" : "translated",
      "text" : "In this highly competitive society, we must be different in order to survive!",
      "translation" : "在競爭如此激烈的社會裡，我們必須與眾不同才能生存！"
    },
    {
      "kind" : "message",
      "line" : 21,
      "state" : "translated",
      "text" : "I only refine equipment at the +6 ~ 12 levels.",
      "translation" : "我只精煉+6到+12等級的裝備。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[鐵匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "state" : "translated",
      "text" : "I will need ^ff9999Blessed Oridecon^000000 for weapons, and ^ff9999Blessed Elunium^000000 for armors.",
      "translation" : "武器需要^ff9999祝福神之金屬^000000，防具需要^ff9999祝福鋁^000000。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "state" : "translated",
      "text" : "Failed refines ^FF0000will not break or reduce the refine level^000000.",
      "translation" : "精煉失敗^FF0000不會損壞裝備，也不會降低精煉等級^000000。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[鐵匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "state" : "translated",
      "text" : "How about it? Do you want to refine?",
      "translation" : "怎麼樣？要精煉嗎？"
    },
    {
      "kind" : "message",
      "line" : 35,
      "state" : "translated",
      "text" : "[Blacksmith Dister]",
      "translation" : "[鐵匠迪斯特]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "state" : "translated",
      "text" : "I'm a blacksmith, not a hairstylist.",
      "translation" : "我是鐵匠，不是髮型師。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "state" : "translated",
      "text" : "With my hammer, I will make you a star of the sky.",
      "translation" : "用我的鐵錘，我會讓你成為天上的明星。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "state" : "translated",
      "text" : "Making artificial hands is not my specialty.",
      "translation" : "製作義肢可不是我的專長。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "Bring out the item so I can refine it!",
      "translation" : "把裝備拿出來，我才能幫你精煉！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "state" : "translated",
      "text" : "Where is this weird smell coming from?",
      "translation" : "這股怪味是從哪裡來的？"
    },
    {
      "kind" : "message",
      "line" : 55,
      "state" : "translated",
      "text" : "Where is the accessory?",
      "translation" : "飾品在哪裡？"
