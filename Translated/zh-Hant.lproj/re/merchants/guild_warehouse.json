{
  "file" : "npc/re/merchants/guild_warehouse.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 12,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "How are you? We are specialized in guild warehouses. This is our ^0000cdstory^000000:",
      "translation" : "最近如何？我們專營公會倉庫。這是我們的^0000cd故事^000000："
    },
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Why can't guild members share a storage? We started off with that simple question.",
      "translation" : "為什麼公會成員不能共用倉庫？我們最初就是從這個簡單的問題開始的。"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "You can open the warehouse for 1000 Zeny or look up the usage history of the guild.",
      "translation" : "支付1000 Zeny即可開啟公會倉庫，也可以查詢公會倉庫的使用記錄。"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "How can I help you?",
      "translation" : "需要我幫你做什麼？"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Open guild warehouse",
      "translation" : "開啟公會倉庫"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "View warehouse usage history",
      "translation" : "檢視倉庫使用記錄"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "The guild storage is only available for guild members.",
      "translation" : "只有公會成員才能使用公會倉庫。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "It seems that it is not yet possible for your guild to use the guild warehouse or you do not have access permissions for the warehouse.",
      "translation" : "貴公會似乎尚未解鎖公會倉庫，或者你沒有倉庫使用許可權。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Please come back after checking the guild skill and the permission to access the warehouse.",
      "translation" : "請檢查公會技能和倉庫使用許可權後再來。"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I am afraid you do not have enough money to settle the fee.",
      "translation" : "恐怕你的錢不夠支付費用。"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "The fee is 1000 Zeny.",
      "translation" : "費用是1000 Zeny。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I will open the guild storage for you then. Have a memorable time!",
      "translation" : "那我為你開啟公會倉庫。祝你度過難忘的時光！"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I am afraid someone else is using the warehouse right now.",
      "translation" : "恐怕現在有人正在使用倉庫。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Please try again after a while.",
      "translation" : "請過一會兒再試。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "The guild storage is only available for guild members.",
      "translation" : "只有公會成員才能使用公會倉庫。"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "It seems that it is not yet possible for your guild to use the guild warehouse or you do not have access permissions for the warehouse.",
      "translation" : "貴公會似乎尚未解鎖公會倉庫，或者你沒有倉庫使用許可權。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Please come back after checking the guild skill and the permission to access the warehouse.",
      "translation" : "請檢查公會技能和倉庫使用許可權後再來。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "[Warehouse Manager]",
      "translation" : "[倉庫管理員]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "I will show you the usage history of the warehouse. Usage history will be retained for up to 3 months.",
      "translation" : "我來為你顯示倉庫使用記錄。記錄最多保留3個月。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "GuildWarehouse",
      "state" : "translated",
      "text" : "Have a memorable time!",
      "translation" : "祝你度過難忘的時光！"
    }
  ]
}