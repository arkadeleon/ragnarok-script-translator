    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Rebellion",
      "state" : "translated",
      "text" : "[Rebellion]",
      "translation" : "[反叛軍]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Rebellion",
      "state" : "translated",
