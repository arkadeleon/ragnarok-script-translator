    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "I'm sorry. Adventurer.",
      "translation" : "抱歉，冒險者。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Dynite Refinement can only be refined up to 100 at a time? The machine is small, so there is no help. Please understand.",
      "translation" : "達因石一次最多隻能精煉100個。機器太小，實在沒辦法。請諒解。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Cancel?",
      "translation" : "要取消嗎？"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "If you need refinement of the Dynite, please find it anytime. There is no one who can do it without me.",
      "translation" : "如果還需要精煉達因石，隨時來找我。除了我，沒人能做這件事。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Hey! This makes it difficult for each other, don't you run out of materials needed for refining? The materials!",
      "translation" : "喂！這可讓人很為難啊。精煉需要的材料可不能短缺！材料啊！"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Site manager Elmen",
      "placeholders" : [
        ".@val"
      ],
      "state" : "translated",
      "text" : "{0} Dynite have been refined. It's perfect today!",
      "translation" : "已經精煉了{0}個達因石。今天的狀態真不錯！"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "There are various accessories and modification permits. Look carefully at what you want before buying.",
      "translation" : "這裡有各種飾品和改造許可證。購買前請仔細看看你想要什麼。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "I can exchange the equipment with the Dynite, but it's already in a tightly sealed box.",
      "translation" : "我可以用達因石兌換裝備，不過裝備已經裝在密封箱裡了。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Give me 50 ^4d4dffDynites^000000 and I will open a ^4d4dffweapon box^000000 for you.",
      "translation" : "給我50個^4d4dff達因石^000000，我就為你開啟一個^4d4dff武器箱^000000。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "I don't know what will come out, but the quality is good. Would you like to open it?",
      "translation" : "我也不知道里面會開出什麼，不過品質不錯。要開啟嗎？"
    },
    {
      "kind" : "option",
      "line" : 74,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Close your eyes and exchange.",
      "translation" : "閉上眼睛進行兌換。"
    },
    {
      "kind" : "option",
      "line" : 74,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Do not exchange.",
      "translation" : "不兌換。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "Kee, this is a waste, it was a good deal.",
      "translation" : "唉，真可惜，這可是筆好交易。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "[Elmen]",
      "translation" : "[埃爾門]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "You don't have enough Dynite friends.",
      "translation" : "你的達因石不夠，朋友。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Site manager Elmen",
      "state" : "translated",
      "text" : "I don't know what's going to come out, so it's hard to go anywhere and get this kind of equipment at this price.",
      "translation" : "我也不知道會開出什麼；以這個價格，很難在別處買到這種裝備。"
