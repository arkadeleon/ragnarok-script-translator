  "scripts" : [
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 12,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "Hello~",
      "translation" : "你好~"
    },
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "This guide wants to be the one to take you to a special place.",
      "translation" : "我想親自帶你去一個特別的地方。"
    },
    {
      "kind" : "message",
      "line" : 14,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "What kind of place is that?",
      "translation" : "那是個什麼樣的地方？"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "It's a place full of mysterious items to collect and sell.",
      "translation" : "那裡有許多神秘物品，可以收集後出售。"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "To buy stuff there you need special money.",
      "translation" : "在那裡買東西需要使用特殊貨幣。"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "So, are you ready to go there?",
      "translation" : "那麼，你準備好去那裡了嗎？"
    },
    {
      "kind" : "option",
      "line" : 23,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 23,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "Okay~",
      "translation" : "好呀~"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "But don't get frustrated.",
      "translation" : "不過別灰心。"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "There's always more chances~",
      "translation" : "機會總是還有的~"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "Yeah~ You're really ready.",
      "translation" : "嗯~你真的準備好了。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "Well then, get some good stuff~",
      "translation" : "那就去挑些好東西吧~"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "Oops, I forgot. When you come out be sure to come back here.",
      "translation" : "哎呀，我忘了。出來之後記得回到這裡。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Cash Sales Guide",
      "state" : "translated",
      "text" : "Rember this~",
      "translation" : "記住哦~"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "Have you had a good time?",
      "translation" : "玩得開心嗎？"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "Thank you very much for using our item mall.",
      "translation" : "非常感謝你光顧我們的道具商城。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "We will continue to bring you valuable items.",
      "translation" : "我們會繼續為你帶來實用的好物。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "Would you like to return from where you came from?",
      "translation" : "要回到你來時的地方嗎？"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 63,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
