    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "There are still more things to see.",
      "translation" : "還有很多東西等著你去看。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "Have a good time.",
      "translation" : "玩得開心。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "[Guide]",
      "translation" : "[嚮導]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "Thank you for coming.",
      "translation" : "感謝光臨。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Exit Guide",
      "state" : "translated",
      "text" : "I'll send you back from where you came from.",
      "translation" : "我會送你回到來時的地方。"
