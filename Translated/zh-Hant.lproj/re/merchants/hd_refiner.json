{
  "file" : "npc/re/merchants/hd_refiner.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "state" : "translated",
      "text" : "Unlike others, I am a blacksmith who refines a very limited number of items.",
      "translation" : "我跟其他鐵匠不同，只精煉少數幾種裝備。"
    },
    {
      "kind" : "message",
      "line" : 22,
      "state" : "translated",
      "text" : "I refine only items that are ^CC0000+7 to +9^000000.",
      "translation" : "我只精煉^CC0000+7到+9^000000的裝備。"
    },
    {
      "kind" : "message",
      "line" : 24,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "state" : "translated",
      "text" : "My specialty is that even if my refining fails, the refine level decreases by 1 without losing the gear. Isn't it great?",
      "translation" : "我的特色是精煉失敗時裝備不會損毀，只降低1級精煉值。很不錯吧？"
    },
    {
      "kind" : "message",
      "line" : 27,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "state" : "translated",
      "text" : "So lets kick this into overdrive, what d' ya say? What item do you want to refine?",
      "translation" : "那就火力全開吧，怎麼樣？你想精煉什麼裝備？"
    },
    {
      "kind" : "message",
      "line" : 35,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "state" : "translated",
      "text" : "I'm a blacksmith, not a hairstylist.",
      "translation" : "我是鐵匠，不是理髮師。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "state" : "translated",
      "text" : "With my hammer, I will make you a star of the sky.",
      "translation" : "我會用這把錘子把你打上天，變成一顆星星。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "state" : "translated",
      "text" : "Making artificial hands is not my specialty.",
      "translation" : "製作假手不是我的專長。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "Bring out the item so I can refine it!",
      "translation" : "把裝備拿出來，我才能幫你精煉！"
    },
    {
      "kind" : "message",
      "line" : 51,
      "state" : "translated",
      "text" : "Where is this foot odor coming from?",
      "translation" : "這股腳臭味是從哪裡來的？"
    },
    {
      "kind" : "message",
      "line" : 55,
      "state" : "translated",
      "text" : "Where is the accessory?",
      "translation" : "飾品呢？"
    },
    {
      "kind" : "message",
      "line" : 58,
      "state" : "translated",
      "text" : "What do you want me to refine?",
      "translation" : "你想讓我精煉什麼？"
    },
    {
      "kind" : "message",
      "line" : 61,
      "state" : "translated",
      "text" : "Huh? What do you want me to do?",
      "translation" : "嗯？你想讓我做什麼？"
    },
    {
      "kind" : "message",
      "line" : 67,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "state" : "translated",
      "text" : "This item can't be refined.",
      "translation" : "這件物品無法精煉。"
