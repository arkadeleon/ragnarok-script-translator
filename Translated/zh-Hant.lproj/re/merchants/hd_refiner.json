      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "state" : "translated",
      "text" : "Only those who overcome fear of failure will obtain a masterpiece.",
