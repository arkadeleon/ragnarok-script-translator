    {
      "kind" : "message",
      "line" : 82,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "state" : "translated",
      "text" : "I only handle items with refine levels from +7 to +9.",
