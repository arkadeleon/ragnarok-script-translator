      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 99,
      "state" : "translated",
      "text" : "[Blacksmith Mighty Hammer]",
      "translation" : "[鐵匠 巨力鐵錘]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "state" : "translated",
      "text" : "I will wait until you are ready.",
      "translation" : "我會等你準備好。"
