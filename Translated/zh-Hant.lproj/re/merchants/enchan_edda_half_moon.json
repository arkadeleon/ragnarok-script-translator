{
  "file" : "npc/re/merchants/enchan_edda_half_moon.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Temple Item Manager",
      "placeholders" : [
        "getitemname(28387)",
        "getitemname(25088)"
      ],
      "state" : "translated",
      "text" : "If you have 1 ^0000cd{0}^000000 and a ^0000cd{1}^000000, I will grant you the power of the Goddess.",
      "translation" : "只要您有1個^0000cd{0}^000000和1個^0000cd{1}^000000，我就能賜予您女神的力量。"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I'll do a good job. Leave it to me.",
      "translation" : "放心交給我，保證辦得妥妥當當。"
    },
    {
      "kind" : "option",
      "line" : 23,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "What is a Goddess' power?",
      "translation" : "女神的力量是什麼？"
    },
    {
      "kind" : "option",
      "line" : 23,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Well then, please.",
      "translation" : "那就拜託了"
    },
    {
      "kind" : "option",
      "line" : 23,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "It's nothing.",
      "translation" : "沒什麼"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "What is the power of a Goddess? Did you just ask about the power of the Goddess?",
      "translation" : "女神的力量是什麼？您剛才問的是女神的力量嗎？"
    },
    {
      "kind" : "option",
      "line" : 28,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不"
    },
    {
      "kind" : "option",
      "line" : 28,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Yes. I asked.",
      "translation" : "是，我問的"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I'd like to talk to you, please listen.",
      "translation" : "我想和您談談，請聽我說。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Power of the Goddess!!! I love the Goddess! Goddess, you're awesome!!!",
      "translation" : "女神的力量！！！我愛女神！女神，您太棒了！！！"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "There's a story that needs to be told first.",
      "translation" : "這得先從一段往事說起。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I've always been a fan of the ^0000cdGoddess^000000. As I entered the temple and started my life as a devoted follower, my life began to blossom.",
      "translation" : "我一直仰慕著^0000cd女神^000000。進入神殿成為虔誠的信徒後，我的人生便煥發了光彩。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "One day before I went to sleep, I had a ^0000cddream^000000 while I way praying to the Goddess.",
      "translation" : "有一天臨睡前，我向女神祈禱時做了一個^0000cd夢^000000。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I heard the ^0000cdvoice^000000 of Goddess Freya in the full light.",
      "translation" : "在明亮的光芒中，我聽到了女神芙蕾雅的^0000cd聲音^000000。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "But unfortunately, as soon as I woke up, I forgot all about my dream. That's how dreams are.",
      "translation" : "可惜一醒來，我就把夢忘得一乾二淨。夢總是這樣啊。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I cried endlessly because I felt sorry for that fact. But if the Goddess lets me hear her voice through a dream, wouldn't we too, be able to reach the Goddess through dreaming?",
      "translation" : "我為此傷心得哭個不停。不過，既然女神能在夢中向我傳達聲音，我們是不是也能通過夢境與女神溝通呢？"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I started to study dreams with all my passion. I thought this was the will of the Goddess, who's trying to convey to me through them.",
      "translation" : "於是，我滿懷熱情地研究起夢境。我想，這一定是女神借夢境傳達給我的旨意。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "While I was working hard on my research, I made the ^0000cdPassage of Dreams^000000 at the request of our aunt, High Priestess Niren, who's right next to me. It's the result of what I dedicated my life to.",
      "translation" : "潛心研究期間，我應身旁這位尼倫阿姨，也就是大祭司的請求，造出了^0000cd夢境通道^000000。那是我畢生心血的結晶。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I can't reach the Goddess yet... But there aren't many people who encounter the Goddess in their dreams... Like me...",
      "translation" : "雖然還無法真正與女神溝通...但像我這樣能在夢中見到女神的人...可沒幾個..."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Anyway, when I first heard the request from our aunt, High Priestess Niren, I was surprised.",
      "translation" : "總之，尼倫阿姨第一次向我提出這個請求時，我可是嚇了一跳。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Would you dare to enter the Pope's dream...? The High Priestess Niren convinced me to enter her dream, but there was nothing that I could do to help her.",
      "translation" : "竟然要進入教皇的夢境...誰敢這麼做啊？後來尼倫大祭司說服了我，可當時我也實在幫不上她的忙。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "And the persuasion was surprisingly convincing.",
      "translation" : "不過，她那番話還真把我說服了。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Temple Item Manager",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "So what's the Power of the Goddess?",
      "translation" : "那麼，女神的力量究竟是什麼？"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "When I first entered the Pope's dream, I was amazed.",
      "translation" : "當我第一次進入教皇的夢境時，我驚呆了。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Temple Item Manager",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Why?",
      "translation" : "為什麼？"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Of my ^0000cdgenius^000000.",
      "translation" : "因為我實在是個^0000cd天才^000000。"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Can anyone else in the world create a device that allows them to enter other people's dreams and experience them vividly? Kya- After all, Goddess' beloved lamb.",
      "translation" : "這世上還有誰能造出這樣的裝置，讓人進入他人的夢境並身臨其境地體驗一切？呀——不愧是女神鍾愛的羔羊！"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "As I was walking through the Pope's dream, I accidentally found a ^0000cdPriest's Necklace^000000 from the priest and a special energetic ^0000cdFragment^000000 from the faceless shrine there.",
      "translation" : "探索教皇的夢境時，我偶然從牧師那裡得到了一枚^0000cd牧師項鍊^000000，還在無面神龕那裡找到一塊蘊含特殊能量的^0000cd碎片^000000。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "And I went around trying to find out as much as I could in my dreams, but when the Pope found me, she rejected me fiercely in fear.",
      "translation" : "我在夢裡四處探索，想盡量多瞭解一些。可教皇一發現我，就嚇得拼命排斥我。"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I'm not the Pope's closest confidant, so I must have been just a stranger to her.",
      "translation" : "我並非教皇最親密的知己，對她來說，我大概只是個陌生人吧。"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "So I was thrown out of the Pope's dream.",
      "translation" : "於是，我被趕出了教皇的夢境。"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "By the way. When I woke up from my dream, I had the Priest's Necklace from the shrine and the strange fragment still in my hands. What do you think?",
      "translation" : "對了，醒來時，神龕裡得到的牧師項鍊和那塊奇怪的碎片竟然還在我手裡。您覺得呢？"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Temple Item Manager",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Amazing.",
      "translation" : "太不可思議了。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "Oh Goddess, please pity the blunt sensibility of an adventurer who can express these tremendous results in a word that is just amazing-",
      "translation" : "噢，女神啊，請憐憫這位感覺遲鈍的冒險者吧！如此驚人的成果，竟然只會用“不可思議”來形容..."
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I was able to bring out the things I got from other people's dreams. This is a big deal! Let's get down to business because you don't seem to empathize.",
      "translation" : "我居然能把從別人夢裡得到的東西帶出來！這可是了不起的發現！看來您沒什麼共鳴，我們還是言歸正傳吧。"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I began to study the necklace and the strange fragment of the shrine. The strange fragment was named the ^0000cdDream Fragment^000000, meaning the fragment obtained in a dream. Kyah- Name Sense!",
      "translation" : "我開始研究項鍊和神龕裡的奇怪碎片，並把碎片命名為^0000cd夢之碎片^000000，也就是從夢中得到的碎片。呀——這名字起得真妙！"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "They seemed normal when being separated, however I felt a subtle energy when I stacked them on top of each other.",
      "translation" : "它們分開時看起來都很普通，但疊放在一起時，我感到了一股微妙的能量。"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "From then on, I entered the Pope's dream and began to study by collecting them one by one, without being noticed by the Pope.",
      "translation" : "從那以後，我便偷偷進入教皇的夢境，避開她的注意，一點點收集材料進行研究。"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "I discovered that by collecting about ^0000cd100 Dream Fragments^000000, compressing them with force, and putting them into the ^0000cdPriest's Necklace^000000, I can grant it ^0000cdspecial powers^000000.",
      "translation" : "後來我發現，只要收集大約^0000cd100個夢之碎片^000000，用力壓縮後放入^0000cd牧師項鍊^000000，就能賦予項鍊^0000cd特殊力量^000000。"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "[Temple Item Manager]",
      "translation" : "[神殿物品管理員]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Temple Item Manager",
      "state" : "translated",
      "text" : "And by continuously researching and researching, I've succeeded in separating that power into three degrees.",
