  "scripts" : [
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I'm carrying too many types of items. I should lighten my bag first.",
      "translation" : "我帶的物品種類太多了。得先整理一下背包。"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I'm overweight. I'd better lighten my bag first.",
      "translation" : "我超重了。得先整理一下背包。"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[違禁品加工師]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Have you tried to buy some contraband items with Rock Ridge Coins? I can make your contraband items better.",
      "translation" : "你用洛克裡奇金幣買過違禁品嗎？我可以幫你強化違禁品。"
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Make them better? How?",
      "translation" : "怎麼強化？"
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Enchant contraband items.",
      "translation" : "附魔違禁品。"
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Reset contraband item Enchantment level.",
      "translation" : "重置違禁品的附魔等級。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[違禁品加工師]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Ah, have we met before? I meet so many people every day that I can't remember all of their faces. Let me catch you up to speed.",
      "translation" : "啊，我們以前見過嗎？我每天見的人太多，記不清所有人的臉。讓我再跟你說明一下。"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[違禁品加工師]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I can enchant the equipment that you can buy with Rock Ridge Coins, for up to 3 sockets for Armor and Garments and up to 2 sockets for Accessories.",
      "translation" : "我可以為用洛克裡奇金幣購買的裝備附魔：鎧甲和披肩最多可附加3個插槽，飾品最多可附加2個插槽。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[違禁品加工師]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "I charge 2 Rock Ridge Coins per socket for both enchanting and resetting.",
      "translation" : "無論附魔還是重置，每個插槽都要收取2枚洛克裡奇金幣。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[違禁品加工師]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "Oh, and note that these contraband items are prone to destruction, especially when they are reset.",
      "translation" : "還有，這些違禁品很容易損壞，尤其是在重置時。"
    },
