      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "[Contraband Processor]",
      "translation" : "[違禁品加工師]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Contraband Processor",
      "state" : "translated",
      "text" : "It's not enchanted. What do you expect me to reset?",
