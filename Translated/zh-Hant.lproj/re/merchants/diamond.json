      "kind" : "message",
      "line" : 51,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "It is the ^FF82FF'17 Carat Diamond'^000000!",
      "translation" : "它就是^FF82FF“17克拉鑽石”^000000！"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Yes!",
      "translation" : "是！"
