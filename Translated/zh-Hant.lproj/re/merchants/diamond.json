    {
      "kind" : "message",
      "line" : 29,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "You've heard rumors but you've never once seen with your own eyes",
      "translation" : "你們可能聽說過這個傳聞，卻從未親眼見過"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "the world's rarest diamond!",
      "translation" : "世界上最稀有的鑽石！"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "The ^FF82FF'17 Carat Diamond'^000000 is currently on sale for a cheap price!!",
      "translation" : "^FF82FF“17克拉鑽石”^000000現在正以超低價出售！！"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "If valuable diamonds interest you then listen up!",
      "translation" : "如果你對珍貴鑽石感興趣，就聽好了！"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "You can give the diamond as a gift to your lover.",
      "translation" : "你可以把它送給心愛的人。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "The receiver of the ^FF82FF'17 Carat Diamond'^000000 will cherish it",
      "translation" : "收到^FF82FF“17克拉鑽石”^000000的人會珍藏它，"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "and treasure you in their heart.",
      "translation" : "並將你銘記在心。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "What? You don't have a lover?",
      "translation" : "什麼？你沒有戀人？"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "You can still just hang on to it for yourself.",
      "translation" : "那就自己留著也行。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "The enchanting aura of the ^FF82FF'17 Carat Diamond'^000000 is likely",
      "translation" : "^FF82FF“17克拉鑽石”^000000散發的迷人氣息"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "to bring love into your life.",
      "translation" : "或許會為你帶來愛情。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "RareDiamondMerchant",
      "state" : "translated",
      "text" : "Known as the captivating diamond of diamonds...",
      "translation" : "它被譽為鑽石中的絕世珍品..."
