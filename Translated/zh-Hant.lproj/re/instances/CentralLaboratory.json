    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Even better if you show me around if you find an interesting object.",
      "translation" : "如果你發現有趣的物品，也帶我去看看就更好了。"
    },
    {
      "kind" : "option",
      "line" : 98,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "Not interested.",
      "translation" : "沒興趣。"
