      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "[Civilization Explorer]",
      "translation" : "[文明探索家]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "You are an adventurer. Tell me what you decide to do.",
      "translation" : "你是冒險者。告訴我你的決定吧。"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "How can I assist you?",
      "translation" : "我能為你做什麼？"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Civilization Explorer",
      "state" : "translated",
      "text" : "What do you want to do this time?",
      "translation" : "這次你想做什麼？"
    },
