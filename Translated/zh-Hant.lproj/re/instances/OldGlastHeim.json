    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "The time gap is not yet open.",
      "translation" : "時空裂縫尚未開啟。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "[Hugin]",
      "translation" : "[休金]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "Your body is not fit to enter the time gap. You won't be able to get in if you're not in a party.",
      "translation" : "你的身體狀況不適合進入時空裂縫。沒有隊伍的話也無法進入。"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "[Hugin]",
      "translation" : "[休金]"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "Oh, my...",
      "translation" : "哦，天哪..."
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "You still have after-effects of time travel. You can't travel again with this condition.",
      "translation" : "你身上還殘留著時空旅行的後遺症，當前狀態無法再次旅行。"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "[Hugin]",
      "translation" : "[休金]"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "Staying healthy is important, so please take a break and come back again later.",
      "translation" : "保持健康很重要，請先休息一下，稍後再來。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Hugin",
      "state" : "translated",
      "text" : "^0000ffAll traces of access to Old Glast Heim have been removed. Now you can talk with Hugin again.^000000",
      "translation" : "^0000ff進入舊葛拉斯特海姆的痕跡已全部消失，現在可以再次找休金交談了。^000000"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Where's your leader? I need his help.",
      "translation" : "你們的隊長在哪裡？我需要他的幫助。"
    },
    {
      "kind" : "message",
      "line" : 187,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "You have a previous clear record. You can skip the scenario and proceed accordingly.",
      "translation" : "你有之前的通關記錄。你可以跳過劇情，直接繼續。"
    },
    {
      "kind" : "option",
      "line" : 189,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Omit moderately.",
      "translation" : "跳過部分劇情"
    },
    {
      "kind" : "option",
      "line" : 189,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Appreciate everything.",
      "translation" : "完整體驗"
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "Varmundt",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "state" : "translated",
      "text" : "I've seen you, {0}.",
      "translation" : "我見過你，{0}。"
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "I'm sure I can trust you. Let's leave right away.",
      "translation" : "我相信你。我們馬上出發吧。"
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Are you the one ^0000ffHerico^000000 sent to help me?",
      "translation" : "你就是^0000ff赫里科^000000派來幫我的人嗎？"
    },
    {
      "kind" : "option",
      "line" : 214,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Oh. Well I...",
      "translation" : "哦，那個我..."
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "Varmundt",
      "placeholders" : [
        ".@player_name$"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 216,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Ah yes, I am. Herico told me to meet you.",
      "translation" : "是的，赫里科讓我來見你。"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "We don't have much time. We must report to Sir Heinrich about Himelmez's invasion.",
      "translation" : "時間不多了。我們必須向海因裡希大人報告希梅爾茲入侵的事。"
    },
    {
      "kind" : "option",
      "line" : 224,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Himelmez...",
      "translation" : "希梅爾茲..."
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Varmundt",
      "placeholders" : [
        ".@player_name$"
      ],
      "state" : "translated",
      "text" : "[{0}]",
      "translation" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Who is Himelmez?",
      "translation" : "希梅爾茲是誰？"
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Herico didn't tell you?",
      "translation" : "赫里科沒告訴你嗎？"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "She is the Ruler of Death, Dead man's Valkyrie. Himelmez is looking to take the heart of Ymir from us.",
      "translation" : "她是死亡的統治者，也是死者的女武神。希梅爾茲想從我們手中奪走尤彌爾之心。"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "She might even destroy this whole castle if she wanted to.",
      "translation" : "如果她願意，甚至能摧毀整座城堡。"
    },
    {
      "kind" : "message",
      "line" : 243,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "[Varmundt]",
      "translation" : "[瓦爾蒙特]"
    },
    {
      "kind" : "message",
      "line" : 244,
      "npc" : "Varmundt",
      "state" : "translated",
      "text" : "Hurry! Report to Sir. Heinrich about Himelmez. I must check the defense barrier here!",
      "translation" : "快去向海因裡希大人報告希梅爾茲的事。我得檢查這裡的防禦屏障！"
    },
    {
      "kind" : "message",
      "line" : 259,
      "npc" : "Khalitzburg Knightage",
      "state" : "translated",
      "text" : "[Khalitzburg Knightage]",
      "translation" : "[卡利斯格騎士團成員]"
    },
    {
      "kind" : "message",
      "line" : 260,
      "npc" : "Khalitzburg Knightage",
      "state" : "translated",
      "text" : "My work shift will be over soon, but the next crew is not coming.",
      "translation" : "我的班快結束了，可下一班的人還沒來。"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "Khalitzburg Knightage",
      "state" : "translated",
      "text" : "[Khalitzburg Knightage]",
      "translation" : "[卡利斯格騎士團成員]"
    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Khalitzburg Knightage",
      "state" : "translated",
      "text" : "Something you want to tell me?",
      "translation" : "你有事要跟我說嗎？"
    },
    {
