      "line" : 42,
      "npc" : "Chief of Staff",
      "state" : "translated",
      "text" : "Given the tight internal security, you should prepare yourself.",
      "translation" : "這裡內部戒備森嚴，你最好做好準備。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Chief of Staff",
      "state" : "translated",
      "text" : "Wait here for a minute.",
