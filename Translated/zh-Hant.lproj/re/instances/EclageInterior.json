    },
    {
      "kind" : "message",
      "line" : 299,
      "npc" : "Avant",
      "state" : "translated",
      "text" : "Right...Shenime. He excited my curiosity on purpose.",
      "translation" : "沒錯...謝尼梅。他是故意激起我的好奇心。"
