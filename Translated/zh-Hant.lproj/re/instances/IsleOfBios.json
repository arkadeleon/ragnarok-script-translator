    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I'm afraid you're not up for this yet.",
      "translation" : "恐怕你還不夠資格。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "You have to be at least Level 160.",
      "translation" : "你的等級必須至少達到160級。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "...Where am I?",
      "translation" : "...我在哪裡？"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I don't know when it began...",
      "translation" : "我不知道這是從什麼時候開始的..."
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "The same nightmare has been plaguing me for a long time.",
      "translation" : "同一個噩夢已經摺磨我很久了。"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "In my nightmare, Demon King Morocc awakens from his century-long slumber and fills the world with darkness and horror.",
      "translation" : "在我的噩夢裡，魔王夢羅克從沉睡百年的長眠中醒來，讓整個世界陷入黑暗與恐懼。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I couldn't shake off the vivid images I saw in that nightmare. I've wandered off and around like a madman and finally arrived here.",
      "translation" : "那個噩夢中的景象如此真實，我無法忘懷。我像瘋子一樣四處遊蕩，最後來到了這裡。"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I saw this place in my dream. It's where Demon God Morocc awakens from his slumber. My dream was showing me a possible future.",
      "translation" : "我在夢裡見過這裡。魔神夢羅克將在此處從沉睡中甦醒。我的夢預示著一種可能的未來。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "If my dream really is a premonition, the forces of Demon God Morocc's are within that yellow seed.",
      "translation" : "如果我的夢真的是預兆，那麼魔神夢羅克的力量就在那顆黃色種子裡。"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "I tried to enter the seed, but to no avail: I'm just too old and weak. But perhaps you can.",
      "translation" : "我試過進入那顆種子，但沒能成功：我實在太老也太虛弱了。不過你或許可以做到。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "Please investigate that yellow seed.",
      "translation" : "請調查那顆黃色種子。"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "It's too dangerous for you to go alone. You should take at least one comrade with you.",
      "translation" : "你獨自前往太危險了，至少帶一位同伴一起去。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "[Wandering Old Man]",
      "translation" : "[流浪老人]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "Please investigate that yellow seed.",
      "translation" : "請調查那顆黃色種子。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Wandering Old Man",
      "state" : "translated",
      "text" : "It's too dangerous for you to go alone. You should take at least one comrade with you.",
      "translation" : "你獨自前往太危險了，至少帶一位同伴一起去。"
    },
    {
