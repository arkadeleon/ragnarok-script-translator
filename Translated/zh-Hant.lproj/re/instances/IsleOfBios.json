      "state" : "translated",
      "text" : "this Hero Token by accident.",
      "translation" : "得到了這枚英雄徽章。"
    },
    {
      "kind" : "message",
      "line" : 354,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "I want to give it to you. You deserve it.",
      "translation" : "我想把它送給你。這是你應得的。"
    },
    {
