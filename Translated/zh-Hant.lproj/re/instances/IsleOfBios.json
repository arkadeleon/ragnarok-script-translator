      "translation" : "[弗裡德]"
    },
    {
      "kind" : "message",
      "line" : 352,
      "npc" : "Vrid",
      "state" : "translated",
      "text" : "I came by",
      "translation" : "我偶然間"
    },
    {
      "kind" : "message",
      "line" : 353,
