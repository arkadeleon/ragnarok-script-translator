{
  "file" : "npc/re/instances/HorrorToyFactory.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 14,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Aaa.. Are you going to go into there?",
      "translation" : "啊...你要進去嗎？"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "You'd better release your transformation if you'd like to enter. It could be dangerous in some ways.",
      "translation" : "想進去的話，最好先解除變身。變身狀態可能會帶來危險。"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Catherine Jet Johnson",
      "placeholders" : [
        "( Sex ? \"man\" : \"woman\" )"
      ],
      "state" : "translated",
      "text" : "Ah, wait! Please wait. This is not a good place for a promising young {0} like you!",
      "translation" : "啊，等等！請等一下。這種地方不適合你這樣前途無量的{0}！"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "If you must, come back later after you become far stronger. Hmmm.. I would say.. Lv.140?",
      "translation" : "如果你執意要去，等變得更強之後再來吧。嗯...我覺得至少要140級？"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^ff0000Be cautious taming or other ways than hunting monsters are not considered as normal killing counts.^000000",
      "translation" : "^ff0000請注意，馴服怪物或其他非狩獵方式不計入正常擊殺數。^000000"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Do.. Don't be afraid of me. Now I look ugly, but I wasn't like this before.",
      "translation" : "別...別怕我。我現在看起來很醜，但以前不是這樣的。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffThe skull-faced girl in front of you is speaking in a tearful voice. Void holes where there should be eyes are staring at you.^000000",
      "translation" : "^0000ff眼前這位骷髏臉少女含淚說著話。她眼睛的位置空洞洞的，正凝視著你。^000000"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "What's wrong with your face?",
      "translation" : "你的臉怎麼了？"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "This is a long story.. Would you mind if I talk to you? If you waste your time on someone like me?",
      "translation" : "說來話長...你願意聽我說嗎？會不會覺得把時間花在我這種人身上很浪費？"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Quit.",
      "translation" : "離開。"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Please keep talking.",
      "translation" : "請繼續說。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Okay, take care of yourself. And don't ever come near that odd entrance.",
      "translation" : "好吧，保重。千萬別靠近那個奇怪的入口。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Mmm.. Where should I start.. The story of this town first?...",
      "translation" : "嗯...該從哪裡說起呢...先講講這個鎮子的故事吧？"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffWith a sigh, the girl begins to speak in a subdued tone like a bard who tells an old story.^000000",
      "translation" : "^0000ff少女嘆了口氣，壓低聲音，像吟遊詩人講述古老傳說一樣開始說起往事。^000000"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "There was a toy factory in this town. All of the people in this town work there and I was one of the employees.",
      "translation" : "這個鎮上曾有一座玩具工廠。鎮上的人都在那裡工作，我也是其中一員。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "We all were happy in the beginning. We used to gather around together and have a friendly chat having gingerbread and hot tea after work.",
      "translation" : "一開始大家都很快樂。下班後，我們常聚在一起，邊吃薑餅、喝熱茶，邊愉快地聊天。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I couldn't even imagine, seeing this mood...",
      "translation" : "看到現在這副景象，我簡直不敢想像..."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Yes, because we couldn't earn a living by packaging toys forever. The situations got tough after the villagers left in ones and twos.",
      "translation" : "是啊，我們不可能永遠靠包裝玩具謀生。村民陸陸續續離開後，日子就越來越難了。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I was the one who worked as an assistant beside the doll craftsman who made dolls to the end.",
      "translation" : "我是一直陪在玩偶工匠身邊、協助他製作玩偶的人。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffI could feel her slender jawbone is trembling due to the subtle change of her emotion.^000000",
      "translation" : "^0000ff她的情緒微微變化，我能感覺到她纖細的下頜骨在顫抖。^000000"
    },
    {
      "kind" : "option",
      "line" : 68,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Ask her to continue.",
      "translation" : "請她繼續說。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "On the day when the factory is decided to be closed, the doll maker dressed the last doll he made and shed tears.",
      "translation" : "工廠決定關閉那天，玩偶工匠為自己製作的最後一個玩偶穿好衣服，流下了眼淚。"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Perhaps he thought he wouldn't make dolls anymore.",
      "translation" : "也許他覺得自己再也不會製作玩偶了。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "He named the last doll ^0000ffCeline Kimi^000000 and stopped all the lines in the factory.",
      "translation" : "他給最後一個玩偶取名為^0000ff塞琳·琪米^000000，隨後關停了工廠的所有生產線。"
    },
    {
      "kind" : "option",
      "line" : 78,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Did he give a doll a name?",
      "translation" : "他給玩偶取了名字？"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Sometimes so much work goes into a doll as if it were their child to doll makers. Kimi was the one for him.",
      "translation" : "對玩偶工匠來說，製作玩偶時常傾注許多心血，就像在製作自己的孩子。琪米就是他的孩子。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I guess his earnestness breathed life to Kimi.",
      "translation" : "我想，是他的真心賦予了琪米生命。"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Do you mean the doll is alive?",
      "translation" : "你是說那個玩偶活過來了？"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Yes, ^0000ffShe^000000 became a living creature. I don't know how, but she is striding in the toy factory with heavy sorrow and rage.",
      "translation" : "是的，^0000ff她^000000變成了活生生的生命。我不知道這是怎麼發生的，但她如今帶著深深的悲傷與憤怒，在玩具工廠裡徘徊。"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "When I first saw her, she was standing beside the doll maker who died and collapsed. She stood there with a bare expression.",
      "translation" : "我第一次看到她時，她站在已經倒下身亡的玩偶工匠身邊，臉上毫無表情。"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "That's the end. I was outside when I woke up again after I had blacked out. My face has become like this.",
      "translation" : "故事就是這樣。我昏過去後醒來時，發現自己已經在外面，臉也變成了這副模樣。"
    },
    {
      "kind" : "option",
      "line" : 95,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Did Kimi do that?",
      "translation" : "是琪米做的嗎？"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I don't know.. She would do it, or it could be a different problem. I have no memory of it.",
      "translation" : "我不知道...可能是她做的，也可能另有原因。我完全不記得發生了什麼。"
    },
    {
      "kind" : "option",
      "line" : 99,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Do you blame her?",
      "translation" : "你怪她嗎？"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Ah, no. I don't blame her! I just want to know what happened to the doll craftsman on that day.",
      "translation" : "啊，不，我不怪她！我只是想知道那天玩偶工匠身上發生了什麼。"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I don't think the scene I saw was everything. However, getting into the factory again is.. Re-entering there is...",
      "translation" : "我覺得自己看到的並非全部真相。不過，再次進入工廠...要重新進去的話..."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Yes, I am scared and reluctant to do it. If there's someone who can help me..",
      "translation" : "是的，我既害怕又不情願。如果有人能幫我..."
    },
    {
      "kind" : "option",
      "line" : 109,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "I am not very helpful to you.",
      "translation" : "我幫不了你什麼。"
    },
    {
      "kind" : "option",
      "line" : 109,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Maybe I can help you with it.",
      "translation" : "也許我能幫你。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Thank you for.. for listening to me. Hope you will enjoy your trip..",
      "translation" : "謝...謝謝你願意聽我說。祝你旅途愉快..."
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Heh? You would do me a favor?",
      "translation" : "咦？你願意幫我？"
    },
    {
      "kind" : "option",
      "line" : 117,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Let's get into the factory.",
      "translation" : "我們進工廠吧。"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "We.. Well, I cannot help you at all except for providing you with directions. Besides, this can be very dangerous to you.",
      "translation" : "我...嗯，除了告訴你路線，我幫不上別的忙。而且那裡對你來說很危險。"
    },
    {
      "kind" : "option",
      "line" : 121,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "You can reunite with Kimi, can't you?",
      "translation" : "你可以再見到琪米，對吧？"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "Kimi, you mean Kimi..",
      "translation" : "琪米...你是說琪米嗎..."
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "^0000ffShe is thinking about something intently with gaping eyes.^000000",
      "translation" : "^0000ff她睜大雙眼，專注地思索著什麼。^000000"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Catherine Jet Johnson",
      "state" : "translated",
      "text" : "[Catherine Jet Johnson]",
      "translation" : "[凱瑟琳·杰特·約翰遜]"
    },
    {
      "kind" : "message",
      "line" : 128,
