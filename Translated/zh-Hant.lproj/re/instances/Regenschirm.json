{
  "file" : "npc/re/instances/Regenschirm.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Oscar",
      "state" : "translated",
      "text" : "[Oscar]",
      "translation" : "[奧斯卡]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Oscar",
      "state" : "translated",
      "text" : "The captain sneaked in the control panel room.",
      "translation" : "隊長偷偷潛入了控制面板室。"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Oscar",
      "state" : "translated",
      "text" : "Move quietly.",
      "translation" : "輕聲行動。"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "The door is normally locked with the security system, so I have to stay there and work with the controller.",
      "translation" : "這扇門平時由安保系統鎖住，所以我得留在這裡操作控制器。"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "As you can see most of the entrances have been blocked already.",
      "translation" : "如你所見，大部分入口已經封鎖了。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Hi",
      "translation" : "喂。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "It will take some time to go through them one by one.",
      "translation" : "逐個檢查需要一些時間。"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "I'll keep helping you through the intercom.",
      "translation" : "我會通過對講機繼續協助你。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "You'll have to go through the restaurant to reach the hallway.",
      "translation" : "你得穿過餐廳才能到走廊。"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Est will be performing the operation alone.",
      "translation" : "艾絲特會獨自執行行動。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "If there's a disturbance, Est may have caused it. So please check out with her before continuing.",
      "translation" : "如果發生騷動，可能是艾絲特那邊出了狀況。繼續行動前先去確認她的情況。"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "You should go now adventurer. I'll keep working on securing the security controller.",
      "translation" : "冒險者，你現在出發吧。我會繼續設法控制安保系統。"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "There may be researchers detained inside.",
      "translation" : "裡面可能還有被拘留的研究員。"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Please consider their safety first.",
      "translation" : "請優先確保他們的安全。"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Now go ahead.",
      "translation" : "現在出發吧。"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究員]"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Researcher",
      "state" : "translated",
      "text" : "The biometric scan is still operational, I'll be staying here to keep the door open.",
      "translation" : "生物識別掃描仍在運作，我會留在這裡保持門開著。"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Researcher",
      "state" : "translated",
      "text" : "If you're in a hurry, please go...",
      "translation" : "趕時間的話，請先走..."
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Are you the one who removed the poison gas outside?",
      "translation" : "外面的毒氣是你處理的嗎？"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Est",
      "state" : "translated",
      "text" : "You arrived at a good time.",
      "translation" : "你來得正是時候。"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Because of the gas, the door was forcibly locked down!",
      "translation" : "因為毒氣，門被強制鎖上了！"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Est",
      "state" : "translated",
      "text" : "It takes time for Aas to come hack the controller and release the gas.",
      "translation" : "等阿斯過來破解控制器、解除毒氣需要時間。"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Est",
      "state" : "translated",
      "text" : "I was going to do it myself.",
      "translation" : "我本來打算自己動手。"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Est",
      "state" : "translated",
      "text" : "The guards here were wearing the same clothes as those Heart Hunters we saw before.",
      "translation" : "這裡的守衛穿著和我們之前遇到的心臟獵人一樣的制服。"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Est",
      "state" : "translated",
      "text" : "I don't think I can save all the researchers alone.",
      "translation" : "我一個人恐怕救不了所有研究員。"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Est",
      "state" : "translated",
      "text" : "It seems we've gathered most of them here already.",
      "translation" : "看來大部分研究員都已經聚集到這裡了。"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Let's organize our next strategy.",
      "translation" : "我們來商量下一步的行動。"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Est",
      "state" : "translated",
      "text" : "There are laboratories on the other side and it's likely to be a mess.",
      "translation" : "另一邊還有實驗室，裡面恐怕一片混亂。"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Est",
      "state" : "translated",
      "text" : "I wonder if there will be a big fight.",
      "translation" : "不知道會不會爆發激戰。"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Est",
      "state" : "translated",
      "text" : "From now on the Rebellion Special Forces will prioritize on rescuing the Detained Researchers.",
      "translation" : "接下來，反叛軍特種部隊會優先營救被拘留的研究員。"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Est",
      "state" : "translated",
      "text" : "If you get it, move quickly!",
      "translation" : "明白的話就快行動！"
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Okay, adventurer, find a communication device and get in contact with Aas.",
      "translation" : "好，冒險者，找到通訊裝置並聯系阿斯。"
    },
    {
      "kind" : "message",
      "line" : 188,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Est",
      "state" : "translated",
      "text" : "You have to open the entrance of the private labs.",
      "translation" : "你得開啟私人實驗室的入口。"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Est",
      "state" : "translated",
      "text" : "[Est]",
      "translation" : "[艾絲特]"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Huh. We'll focus on rescuing the hostages first.",
      "translation" : "嗯，我們先集中精力營救人質。"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Est",
      "state" : "translated",
      "text" : "Look for the Security Guard's room that Aas talked about.",
      "translation" : "去找阿斯提到的保安室。"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "Code is inactive.",
      "translation" : "程式碼已失效。"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "The communication has been terminated.",
      "translation" : "通訊已中斷。"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "Voice Transmission Connected.",
      "translation" : "語音傳輸已連線。"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "Code is inactive.",
      "translation" : "程式碼已失效。"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Access Controller",
      "state" : "translated",
      "text" : "The communication has been terminated.",
      "translation" : "通訊已中斷。"
    },
    {
      "kind" : "message",
      "line" : 248,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 249,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Hey, Did you check all the labs yet?",
      "translation" : "喂，實驗室都檢查過了嗎？"
    },
    {
      "kind" : "message",
      "line" : 250,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Please check if there are still Detained Researchers.",
      "translation" : "請確認是否還有被拘留的研究員。"
    },
    {
      "kind" : "message",
      "line" : 254,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 255,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "The spare Master Key still remains.",
      "translation" : "備用萬能鑰匙還在。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Without it, I wouldn't have been able to control over the security systems. Are you okay?",
      "translation" : "沒有它，我就沒法控制安保系統了。你沒事吧？"
    },
    {
      "kind" : "message",
      "line" : 258,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 259,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Now you only need to check the Central Room.",
      "translation" : "現在只要檢查中央室了。"
    },
    {
      "kind" : "message",
      "line" : 260,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Did you say Heart Hunters?",
      "translation" : "你說心臟獵人？"
    },
    {
      "kind" : "message",
      "line" : 261,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "The traitors from Schlein have already escaped.",
      "translation" : "來自施萊因的叛徒已經逃走了。"
    },
    {
      "kind" : "message",
      "line" : 263,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 264,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "We've got our focus on that room.",
      "translation" : "我們已經把注意力集中到那個房間了。"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "That's the main idea.",
      "translation" : "大致就是這樣。"
    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Where is Est?",
      "translation" : "艾絲特在哪裡？"
    },
    {
      "kind" : "message",
      "line" : 269,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Goni]",
      "translation" : "[戈尼]"
    },
    {
      "kind" : "message",
      "line" : 270,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "... ... ...",
      "translation" : "... ... ..."
    },
    {
      "kind" : "message",
      "line" : 273,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 274,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "You have to keep looking for all the Researchers?",
      "translation" : "還得繼續尋找所有研究員嗎？"
    },
    {
      "kind" : "message",
      "line" : 275,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "That's necessary, I understand.",
      "translation" : "這是必要的，我明白了。"
    },
    {
      "kind" : "message",
      "line" : 277,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 278,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Adventurer, we head to the Central Room.",
      "translation" : "冒險者，我們去中央室。"
    },
    {
      "kind" : "message",
      "line" : 279,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Meet me over there.",
      "translation" : "到那邊和我會合。"
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "[Aas]",
      "translation" : "[阿斯]"
    },
    {
      "kind" : "message",
      "line" : 291,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Adventurer, we head to the Central Room.",
      "translation" : "冒險者，我們去中央室。"
    },
    {
      "kind" : "message",
      "line" : 292,
      "npc" : "Aas",
      "state" : "translated",
      "text" : "Meet me over there.",
      "translation" : "到那邊和我會合。"
    },
    {
      "kind" : "message",
      "line" : 298,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究員]"
    },
    {
      "kind" : "message",
      "line" : 299,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "My... my search... materials...",
      "translation" : "我的...我的研究...材料..."
    },
    {
      "kind" : "message",
      "line" : 300,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "They took it all!",
      "translation" : "他們全都拿走了！"
    },
    {
      "kind" : "message",
      "line" : 301,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "They took everything!",
      "translation" : "什麼都被拿走了！"
    },
    {
      "kind" : "message",
      "line" : 304,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Goni]",
      "translation" : "[戈尼]"
    },
    {
      "kind" : "message",
      "line" : 305,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "... ... ...",
      "translation" : "... ... ..."
    },
    {
      "kind" : "message",
      "line" : 309,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Oh, you're here to protect me?",
      "translation" : "哦，你是來保護我的嗎？"
    },
    {
      "kind" : "message",
      "line" : 310,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I'll go with you, thank you!",
      "translation" : "我跟你走，謝謝！"
    },
    {
      "kind" : "message",
      "line" : 312,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究員]"
    },
    {
      "kind" : "message",
      "line" : 313,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "Oh, you're there to protect me?",
      "translation" : "哦，你是來保護我的？"
    },
    {
      "kind" : "message",
      "line" : 314,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I'll go with you, thank you!",
      "translation" : "我跟你走，謝謝！"
    },
    {
      "kind" : "message",
      "line" : 324,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "[Researcher]",
      "translation" : "[研究員]"
    },
    {
      "kind" : "message",
      "line" : 325,
      "npc" : "Detained Researcher",
      "state" : "translated",
      "text" : "I thought they kicked out all the crazy guy...",
      "translation" : "我還以為他們把那些瘋子全趕走了..."
    },
    {
