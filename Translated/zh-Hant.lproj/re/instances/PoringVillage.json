    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "[Emily]",
      "translation" : "[艾米莉]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "Well, come one. Don't be stern. Listen, you can decide after listening to my story. Of course, I can give you a proper reward.",
