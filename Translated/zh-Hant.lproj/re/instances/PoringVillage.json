      "text" : "[Emily]",
      "translation" : "[艾米莉]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "I should find another adventurer who is similar with my level. It's been nice knowing you.",
      "translation" : "我該找個等級和我差不多的冒險者了。認識你很高興。"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "[Emily]",
      "translation" : "[艾米莉]"
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "My name is Emily. I was waiting for someone who will go on adventures with me!",
      "translation" : "我叫艾米莉。我一直在等一個能和我一起冒險的人！"
    },
    {
      "kind" : "option",
      "line" : 157,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "Who said I will adventure with you?",
      "translation" : "誰說我要和你一起冒險？"
