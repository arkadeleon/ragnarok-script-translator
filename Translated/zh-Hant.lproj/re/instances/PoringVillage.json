      "state" : "translated",
      "text" : "[Emily]",
      "translation" : "[艾米莉]"
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "This drives me crazy. OK, 50-50. Let's go with this.",
