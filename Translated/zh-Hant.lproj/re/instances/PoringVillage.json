      "text" : "[Emily]",
      "translation" : "[艾米莉]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "Oh, now you are stronger than me. How did you grow so fast?",
