      "state" : "translated",
      "text" : "[Emily]",
      "translation" : "[艾米莉]"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "How about 60-40!!",
      "translation" : "那六四分怎麼樣！！"
    },
    {
      "kind" : "option",
      "line" : 183,
      "npc" : "Emily",
      "state" : "translated",
      "text" : "50-50 ...",
