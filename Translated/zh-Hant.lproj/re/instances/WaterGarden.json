    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : " Guests, welcome to the water garden,",
      "translation" : "客人，歡迎來到水之庭園，"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "Are you going to see Papilla? Papilla's been very sensitive about the intruders lately...",
      "translation" : "你要去見帕皮拉嗎？最近帕皮拉對入侵者變得很敏感..."
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "[Hetilla]",
      "translation" : "[赫蒂拉]"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "Papillas are playing around here and there.",
      "translation" : "帕皮拉們正在各處玩耍。"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "They use psychedelic materials from their wings to make short distance movements or use a dangerous magic over them.",
      "translation" : "它們會利用翅膀上的致幻物質進行短距離移動，或對它們施展危險的魔法。"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "[Hetilla]",
      "translation" : "[赫蒂拉]"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "I warned you on advanced, but be careful.",
      "translation" : "我提前提醒過你了，請務必小心。"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Gardener",
      "state" : "translated",
      "text" : "Pruning all overgrown plants and animals opens the door to the next area at 3 o'clock.",
      "translation" : "修剪所有過度生長的植物和動物，就能在三點鐘方向開啟通往下一區域的門。"
