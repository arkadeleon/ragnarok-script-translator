    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "Hello, guest.",
      "translation" : "你好，客人。"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "This place is the docks.",
      "translation" : "這裡是碼頭。"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "[Harad]",
      "translation" : "[哈拉德]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "We don't have any ships operating right now. But the scenery is nice, feel free to take a look around for a while!",
      "translation" : "目前沒有船隻執行。不過這裡的風景不錯，請隨意四處看看，放鬆一會兒！"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "[Harad]",
      "translation" : "[哈拉德]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "In accordance with the Gardeners' plant cultivation and herbicide plans. Admission to the water garden is limited once per day for both the normal and hard water garden.",
      "translation" : "根據園丁的植物培育與除草計劃，普通水之庭園和困難水之庭園每天都限制進入一次。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "[Harad]",
      "translation" : "[哈拉德]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "Thank you for your understanding.",
      "translation" : "感謝你的理解。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "Please take enough rest and come back again after dawn!",
      "translation" : "好好休息，天亮後再來吧！"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "[Harad]",
      "translation" : "[哈拉德]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "Would you like to take a ride to the water garden?",
      "translation" : "要乘船前往水之庭園嗎？"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "The ship only run once a day!",
      "translation" : "船每天只執行一次！"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "^FF0000Please note that, any abnormal monster handling inside the instance such as taming, is not considered normal.^000000",
      "translation" : "^FF0000請注意，在例項內馴服魔物等異常操作不計為正常進度。^000000"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "^FF0000The party leader who received the quest for the 'Water Garden' or 'Water Garden Hard' must enter the instance to proceed. In the case of party leader changes, the instance will be cancelled and you may not proceed.^000000",
      "translation" : "^FF0000已接取“水之庭園”或“水之庭園（困難）”任務的隊長必須進入例項才能繼續。若更換隊長，例項將會取消，無法繼續進行。^000000"
    },
    {
      "kind" : "option",
      "line" : 54,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "^0000CDGarden Entrance^000000",
      "translation" : "^0000CD庭園入口^000000"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "[Harad]",
      "translation" : "[哈拉德]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "You can tell me if you want to enter the water garden.",
      "translation" : "想進入水之庭園的話可以告訴我。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Harad",
      "state" : "translated",
      "text" : "But it's dangerous inside. You can't enter right now.",
      "translation" : "不過裡面很危險，你現在還不能進去。"
    },
