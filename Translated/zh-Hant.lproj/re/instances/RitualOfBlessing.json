    {
      "kind" : "message",
      "line" : 607,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克羅內克]"
    },
    {
      "kind" : "message",
      "line" : 608,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Does it mean...",
      "translation" : "難道說..."
    },
    {
      "kind" : "message",
      "line" : 609,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "...Well, first things first, There are things to find out.",
      "translation" : "...總之，當務之急是先查清一些事情。"
    },
    {
      "kind" : "message",
      "line" : 611,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克羅內克]"
    },
    {
      "kind" : "message",
      "line" : 612,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Let's get out of here now.",
      "translation" : "我們現在先離開這裡。"
    },
    {
      "kind" : "message",
      "line" : 613,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "There is much left for use to find out.",
      "translation" : "還有很多事情等著我們調查。"
    },
    {
      "kind" : "message",
      "line" : 618,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克羅內克]"
    },
    {
      "kind" : "message",
      "line" : 619,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Whoever left here, clear out with the wounded near you!",
      "translation" : "不管是誰留在這裡，都帶上身邊的傷者撤離！"
    },
    {
      "kind" : "message",
      "line" : 620,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "The Room of Consciousness will be closed for a while!",
      "translation" : "意識之間將暫時關閉！"
    },
    {
      "kind" : "message",
      "line" : 625,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克羅內克]"
    },
    {
      "kind" : "message",
      "line" : 626,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Peter has been wounded.",
      "translation" : "彼得受傷了。"
    },
    {
      "kind" : "message",
      "line" : 627,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "We need to move him fast.",
      "translation" : "我們得儘快轉移他。"
    },
    {
      "kind" : "message",
      "line" : 629,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克羅內克]"
    },
    {
      "kind" : "message",
      "line" : 630,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "I'll see you out there.",
