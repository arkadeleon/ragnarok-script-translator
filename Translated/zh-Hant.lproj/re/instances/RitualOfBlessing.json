      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Peter is in a critical condition.",
      "translation" : "彼得傷勢很重。"
    },
    {
      "kind" : "message",
      "line" : 587,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "...Would you mind fighting against the intruder for us?",
