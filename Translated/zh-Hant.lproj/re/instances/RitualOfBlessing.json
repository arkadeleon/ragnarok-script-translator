    {
      "kind" : "message",
      "line" : 597,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "It is the crown passed down in the palace of Rune-Midgarts.",
      "translation" : "這是盧恩米德加爾特王宮世代相傳的王冠。"
    },
    {
      "kind" : "message",
      "line" : 598,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "It means more than an ordinary crown.",
      "translation" : "它的意義遠不止一頂普通的王冠。"
    },
    {
      "kind" : "message",
      "line" : 600,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克羅內克]"
    },
    {
      "kind" : "message",
      "line" : 601,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "Has it been taken by them?",
      "translation" : "被他們拿走了嗎？"
    },
    {
      "kind" : "message",
      "line" : 602,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "What on earth...!",
      "translation" : "這到底是怎麼回事...！"
