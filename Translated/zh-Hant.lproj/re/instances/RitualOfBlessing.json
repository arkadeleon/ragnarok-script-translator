      "kind" : "message",
      "line" : 604,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "[Kronecker]",
      "translation" : "[克羅內克]"
    },
    {
      "kind" : "message",
      "line" : 605,
      "npc" : "Kronecker G. Heine",
      "state" : "translated",
      "text" : "What is hidden here is not known to anyone... Except the seven royal families...!",
      "translation" : "這裡藏著什麼，除了七大家族之外，沒有任何人知道...！"
