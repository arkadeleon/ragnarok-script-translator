{
  "file" : "npc/re/instances/VillaofHighPriest.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亞姆]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "Are you all gathered?",
      "translation" : "人都到齊了嗎？"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亞姆]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I think I should check to see if there are other employees and go up to the second floor.",
      "translation" : "我想確認一下還有沒有其他員工，然後上二樓看看。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亞姆]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I feel a sharp presence beyond the central stairs.",
      "translation" : "我感覺中央樓梯那邊有一股強烈的氣息。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "Probably the Heart Hunter who fought in the temple.",
      "translation" : "應該是那個在神殿交過手的心臟獵人。"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亞姆]"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I'm worried about the missing piece of Ymir's heart.",
      "translation" : "我很擔心依米爾之心缺失的碎片。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "If it's about inciting trouble, what happened at the temple is enough.",
      "translation" : "如果是想挑起事端，神殿發生的事已經夠了。"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亞姆]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "What if my father has other plans...",
      "translation" : "要是父親還有別的打算..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "If you try to go down the wrong path again, I have to stop him.",
      "translation" : "如果他又想走錯路，我就必須阻止他。"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亞姆]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "First, shall we get some information from the villa employees?",
      "translation" : "我們先從別墅員工那裡打聽些訊息，好嗎？"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I see a male employee over there.",
      "translation" : "我看到那邊有位男員工。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "[Miriam]",
      "translation" : "[米莉亞姆]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "I'll go to that employee.",
      "translation" : "我去找那位員工。"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Miriam",
      "state" : "translated",
      "text" : "Adventurer, please find another employee and ask him about the mansion.",
      "translation" : "冒險者，請再找一名員工，向他打聽這座宅邸的情況。"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[別墅員工]"
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "This is my first time meeting you. Who are you?",
      "translation" : "這是我第一次見到你。你是誰？"
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Are you the elder's guest?",
      "translation" : "你是長老的客人嗎？"
    },
    {
      "kind" : "option",
      "line" : 223,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Where is Amal?",
      "translation" : "阿瑪爾在哪裡？"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[別墅員工]"
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Wouldn't he be at the chapel?",
      "translation" : "他不在禮拜堂嗎？"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Whenever you come here, please look for the chapel first...",
      "translation" : "你每次來這裡，都請先去禮拜堂看看..."
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[別墅員工]"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Yes. He seemed to be a man of faith, so he built a chapel inside the mansion.",
      "translation" : "是的。他似乎很虔誠，所以在宅邸裡建了一座禮拜堂。"
    },
    {
      "kind" : "option",
      "line" : 232,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "What about other people?",
      "translation" : "其他人呢？"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[別墅員工]"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Most were suddenly fired.",
      "translation" : "大多數人都突然被解僱了。"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "I also heard someone tell me to leave a little while ago. Is this a sign of mass layoff!?",
      "translation" : "剛才我也聽人叫我離開。難道要大規模裁員！？"
    },
    {
      "kind" : "message",
      "line" : 237,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[別墅員工]"
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "The atmosphere was so heavy that I couldn't even ask.",
      "translation" : "氣氛太壓抑了，我連問都不敢問。"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "The chapel can be reached by going up the central stairs and past the banquet hall.",
      "translation" : "上中央樓梯，穿過宴會廳就能到達禮拜堂。"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Then, go do your business.",
      "translation" : "那麼，你去辦自己的事吧。"
    },
    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "[Villa Employee]",
      "translation" : "[別墅員工]"
    },
    {
      "kind" : "message",
      "line" : 246,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Sir Amal went to chapel.",
      "translation" : "阿瑪爾先生去了禮拜堂。"
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "Go up the central stairs, pass the banquet hall, and you will reach the chapel.",
      "translation" : "上中央樓梯，穿過宴會廳，就能到達禮拜堂。"
    },
    {
      "kind" : "message",
      "line" : 253,
      "npc" : "Villa Employee",
      "state" : "translated",
      "text" : "This is the person Miriam decided to investigate. Let's find another one.",
      "translation" : "這是米莉亞姆決定調查的人。我們再找一個吧。"
    },
    {
      "kind" : "message",
      "line" : 456,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "Firmly Locked Door.",
      "translation" : "牢牢鎖住的門。"
    },
    {
      "kind" : "message",
      "line" : 457,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "There is a Silver Key hole.",
      "translation" : "上面有一個銀鑰匙孔。"
    },
    {
      "kind" : "message",
      "line" : 593,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "Firmly Locked Door.",
      "translation" : "牢牢鎖住的門。"
    },
    {
      "kind" : "message",
      "line" : 594,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "There is a small key hole.",
      "translation" : "上面有一個小鑰匙孔。"
    },
    {
      "kind" : "message",
      "line" : 598,
      "npc" : "Locked Door",
      "state" : "translated",
      "text" : "I used a spare key.",
      "translation" : "我用了備用鑰匙。"
    },
    {
      "kind" : "message",
      "line" : 639,
      "npc" : "Ornate Door",
      "state" : "translated",
      "text" : "The door won't budge.",
      "translation" : "門紋絲不動。"
    },
    {
      "kind" : "message",
      "line" : 640,
      "npc" : "Ornate Door",
      "state" : "translated",
      "text" : "It feels like a strong magical force is blocking the door.",
      "translation" : "感覺有一股強大的魔力擋住了門。"
    },
    {
      "kind" : "message",
      "line" : 732,
      "npc" : "Elegant Door",
      "state" : "translated",
      "text" : "There is a door with an elegant ^4d4dffLily^000000 engraved on it.",
      "translation" : "有一扇門，上面刻著優雅的^4d4dff百合花^000000。"
    },
    {
      "kind" : "message",
      "line" : 733,
      "npc" : "Elegant Door",
      "state" : "translated",
      "text" : "I feel an unknown magical power.",
      "translation" : "我感覺到一股未知的魔力。"
    }
  ]
}