    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Hey. This is too dangerous a place for you. You cannot keep yourself safe. Get out of here and go to the village right now!",
      "translation" : "嘿，這裡太危險了，你保護不了自己。快離開這裡，馬上回村子去！"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "We are gonna be killed all by that Bakonawa. Ah, we must slay him but unfortunately we are not prepared.",
      "translation" : "我們會被巴科納瓦殺光的。唉，我們必須殺了它，可惜現在還沒準備好。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Isn't there any company who can go with you? Or even if you wanna go alone, come after organizing a party.",
      "translation" : "沒有其他人能和你一起去嗎？即使你想獨自前往，也先組好隊再來。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Are you the leader of the Bakonawa slayers? The road is not well so we have to go down the cliff with a rope, is that OK?",
      "translation" : "你是討伐巴科納瓦的隊長嗎？這條路不好走，我們得用繩子下懸崖，可以嗎？"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Please weave a rope.",
      "translation" : "請編一條繩子。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Now I will go down.",
      "translation" : "我現在下去。"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "[Taho]",
      "translation" : "[塔霍]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "You came for slaying Bakonawa. The leader of your party has to help me weaving the rope for going down.",
      "translation" : "你是來討伐巴科納瓦的吧。你的隊長必須幫我編好下懸崖用的繩子。"
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Now I will go down.",
      "translation" : "我現在下去。"
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Taho",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
