      "npc" : "invest_TE",
      "state" : "translated",
      "text" : "Please select a guardian to defend us.",
      "translation" : "請選擇要召喚來守護我們的守護者。"
    },
    {
      "kind" : "message",
      "line" : 401,
      "npc" : "invest_TE",
      "state" : "translated",
      "text" : "Will you summon the chosen guardian? 10,000 zeny are required to summon a Guardian.",
