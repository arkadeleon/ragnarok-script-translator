      "line" : 427,
      "npc" : "invest_TE",
      "state" : "translated",
      "text" : "We are currently hiring a Kafra Employee... Do you want to fire the Kafra Employee?",
      "translation" : "我們目前僱用了一位卡普拉職員...你要解僱她嗎？"
