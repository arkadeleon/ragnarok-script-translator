      "line" : 13,
      "npc" : "Training Instructor",
      "state" : "needs_review",
      "text" : "[Training Instructor]\nThe training ground is divided into two main areas.",
      "translation" : "[訓練指導員]\n訓練場主要分為兩個區域。"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Training Instructor",
      "state" : "needs_review",
      "text" : "[Training Instructor]\nUpper area where you can check the applied force based on monster size.",
