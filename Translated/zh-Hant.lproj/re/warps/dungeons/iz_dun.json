{
  "file" : "npc/re/warps/dungeons/iz_dun.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守門人]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Halt!",
      "translation" : "站住！"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "What brings you here, Adventurer?",
      "translation" : "冒險者，來這裡做什麼？"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "We've discovered a new floor of this underwater city.",
      "translation" : "我們在這座水下城市發現了新的一層。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守門人]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Do you think you're up to the challenge?",
      "translation" : "你覺得自己能應付這裡的挑戰嗎？"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "The monsters here are between levels 110 and 124.",
      "translation" : "這裡的魔物等級在110到124級之間。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "And you must beware of the Kraken!",
      "translation" : "還得當心克拉肯！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Release the Kraken!",
      "translation" : "放出克拉肯！"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "I'll stay here.",
      "translation" : "我留在這裡。"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守門人]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Be cautious and good luck.",
      "translation" : "小心行事，祝你好運。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "If you see the Kraken be sure you have your friends to help or do what we do and run.",
      "translation" : "要是遇到克拉肯，記得找朋友幫忙；或者像我們一樣，趕緊逃跑。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守門人]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "It's always best to be prepared before exploring a new area.",
      "translation" : "探索新區域前，最好先做好準備。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Gatekeeper",
      "state" : "translated",
      "text" : "Come back when you're ready to go.",
      "translation" : "準備好出發時再回來。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守門人]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "So I guess you want to go back to the fifth floor?",
      "translation" : "看來你想回到第五層？"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "Yes!",
      "translation" : "是！"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "No, I'll stay.",
      "translation" : "不，我留在這裡。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守門人]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "Be safe, adventurer.",
      "translation" : "冒險者，保重。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "[Gatekeeper]",
      "translation" : "[守門人]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "You're not going?",
      "translation" : "你不打算走嗎？"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Guard",
      "state" : "translated",
      "text" : "You're braver than I thought.",
      "translation" : "你比我想像的還勇敢。"
    }
  ]
}