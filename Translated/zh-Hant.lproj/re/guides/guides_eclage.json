    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Welcome, Adventurer. This is the plaza of Eclage, a great and sacred tree. How can I help you?",
      "translation" : "歡迎你，冒險者。這裡是埃克拉珠這棵偉大神樹的廣場。有什麼需要幫忙嗎？"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Palace",
      "translation" : "宮殿"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Orb",
      "translation" : "光球"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Store",
      "translation" : "商店"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Prison",
      "translation" : "監獄"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Clinic",
      "translation" : "診所"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Residential Area",
      "translation" : "居住區"
    },
    {
      "kind" : "option",
      "line" : 19,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Finish the conversation",
      "translation" : "結束對話"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠衛兵]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Our great king, courageous generals, and scholars are all staying at the palace.",
      "translation" : "我們偉大的國王、英勇的將軍和學者都住在宮殿裡。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "The palace is located at the top of Eclage. We usually fly there, but I see you don't have wings. Follow the path on your right then. It will lead you to the palace.",
      "translation" : "宮殿位於埃克拉珠頂端。我們通常飛過去，不過看起來你沒有翅膀，那就沿右邊的小路走吧，它會通往宮殿。"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠衛兵]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "The Orb behind me is like a symbol of us Laphines.",
      "translation" : "我身後的光球是我們拉菲尼族的象徵。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "It's filled with great and mysterious power. We always keep an eye on it and guard it carefully.",
      "translation" : "它蘊含著強大而神秘的力量。我們一直密切關注並小心守護著它。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠衛兵]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "This is the plaza of Eclage. You'll find everything you need around here.",
      "translation" : "這裡是埃克拉珠廣場，附近能找到你需要的一切。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠衛兵]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Prison is a place for criminals. Why would an adventurer like you go there?",
      "translation" : "監獄是關押罪犯的地方。你這樣的冒險者為什麼要去那裡？"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Well, it's a little suspicious...but I'll tell you the location. Follow the path on your left. They don't let anyone in though.",
      "translation" : "嗯，是有點可疑...不過我還是告訴你位置吧。沿左邊的小路走就能到，但他們不會讓任何人進去。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠衛兵]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "All your pain and weariness melt away in the arms of nature. Restore your mind and body at Eclage Clinic.",
      "translation" : "在大自然的懷抱中，所有傷痛與疲憊都會消散。到埃克拉珠診所恢復身心吧。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Follow the path on your left.",
      "translation" : "沿左邊的小路走。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "[Eclage Guard]",
      "translation" : "[埃克拉珠衛兵]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Eclage Guard",
      "state" : "translated",
      "text" : "Haven't you seen our decorations for Yai? Take a trip outside. You'll see our residential area.",
      "translation" : "你沒看過我們為雅伊準備的裝飾嗎？到外面走走，就能看到居住區。"
    }
  ]
