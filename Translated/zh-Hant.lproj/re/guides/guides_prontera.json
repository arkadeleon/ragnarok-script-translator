        "F_Navi(\"Trading Merchants\",\"prontera,178,244\",\"^800080\")",
        ".@str$"
      ],
      "state" : "needs_review",
      "text" : "[Prontera Guide]\nThe Rune Merchant, Amatsu Trader, and other\n{0} have been marked\non your mini-map.\n{1}",
      "translation" : "[普隆德拉向導]\n符文商人、櫻花城商人以及其他\n{0}已在您的小地圖上標記。\n{1}"
