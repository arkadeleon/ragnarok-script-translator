      ],
      "state" : "needs_review",
      "text" : "[Prontera Guide]\nThe {0} provides services for\n^FF5400Rune Knights^000000 and ^FF5400Royal Guards^000000.\nLet me mark his location\non your mini-map.\n{1}",
