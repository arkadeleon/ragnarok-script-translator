      "placeholders" : [
        ".@str$"
      ],
      "state" : "translated",
      "text" : "[Moscovia Guide]\nI'll remove all marks from your mini-map.\n{0}",
      "translation" : "[莫斯科比亞嚮導]\n我會清除您小地圖上的所有標記。\n{0}"
