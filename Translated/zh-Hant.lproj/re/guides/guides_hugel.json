    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Hugel Guide Granny",
      "state" : "translated",
      "text" : "If this is the first time for you to use the guide services, you should ask a lot of questions.",
      "translation" : "如果你是第一次使用導覽服務，就儘管多問些問題吧。"
    },
