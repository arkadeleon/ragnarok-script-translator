    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "You can find great weapons there.",
      "translation" : "那裡有很多好武器。"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Is there anything else I can do for you?",
      "translation" : "還有什麼需要我幫忙的嗎？"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Ayothaya Guide Noi",
      "placeholders" : [
        "F_Navi(\"Tool Shop\",\"ayothaya,131,86\",\"^006400\")"
      ],
      "state" : "translated",
      "text" : "Our citizens purchase many products in the {0}.",
      "translation" : "我們的居民常常在{0}購買各種商品。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Make sure you get all you need there.",
      "translation" : "記得在那裡買齊所需物品。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Do you need anything else?",
      "translation" : "還需要其他幫助嗎？"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Part of adventuring is collecting information.",
      "translation" : "冒險的一部分就是收集情報。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Ayothaya Guide Noi",
      "placeholders" : [
        "F_Navi(\"Tavern\",\"ayothaya,229,72\",\"^008080\")"
      ],
      "state" : "translated",
      "text" : "The {0} is crowded with lots of travelers where you can get useful information.",
      "translation" : "{0}裡聚集著許多旅行者，你可以在那裡打聽有用的訊息。"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Is there anything else I can do for you?",
      "translation" : "還有什麼需要我幫忙的嗎？"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Ayothaya Guide Noi",
      "placeholders" : [
        "F_Navi(\"Shrine\",\"ayothaya,208,280\",\"^FF1493\")"
      ],
      "state" : "translated",
      "text" : "To calm your heart, go to the {0} and say a prayer.",
      "translation" : "想讓內心平靜下來，就去{0}祈禱吧。"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Is there anything else I can do for you?",
      "translation" : "還有什麼需要我幫忙的嗎？"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Ayothaya is close to the beach, so most people enjoy fishing.",
      "translation" : "阿尤塔雅靠近海灘，所以大多數人都喜歡釣魚。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "They really love to fish.",
      "translation" : "大家真的很喜歡釣魚。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Ayothaya Guide Noi",
      "placeholders" : [
        "F_Navi(\"fishing\",\"ayothaya,255,99\",\"^8B4513\")"
      ],
      "state" : "translated",
      "text" : "Go {0} and try to grab a big fish.",
      "translation" : "去{0}試著釣條大魚吧。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Is there anything else I can do for you?",
      "translation" : "還有什麼需要我幫忙的嗎？"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "If you want to return home",
      "translation" : "如果你想回家，"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Ayothaya Guide Noi",
      "placeholders" : [
        "F_Navi(\"Aibakthing\",\"ayothaya,151,68\",\"^00BFFF\")"
      ],
      "state" : "translated",
      "text" : "find {0}",
      "translation" : "找到{0}"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "and ask him to send you back.",
      "translation" : "請他送你回去。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Is there anything else I can do for you?",
      "translation" : "還有什麼需要我幫忙的嗎？"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "I'll remove all marks from your mini-map.",
      "translation" : "我會清除你小地圖上的所有標記。"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Ayothaya Guide Noi",
      "state" : "translated",
      "text" : "Do you need anything else??",
      "translation" : "還需要其他幫助嗎？？"
