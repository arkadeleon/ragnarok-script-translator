    {
      "kind" : "message",
      "line" : 14,
      "npc" : "Spectator",
      "state" : "translated",
      "text" : "If you tell me to not go in, isn't it going to make me want to go inside even more? But it doesn't look like there's anything interesting to see.",
      "translation" : "你越是叫我別進去，我不就越想進去看看嗎？不過裡面好像也沒什麼有趣的東西。"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "Spectator",
      "state" : "translated",
      "text" : "I see no monsters here...",
      "translation" : "我沒看到這裡有魔物..."
    },
    {
      "kind" : "message",
      "line" : 20,
