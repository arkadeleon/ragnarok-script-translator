    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Traveler",
      "state" : "translated",
      "text" : "Rumors have been spreading that there are monsters living here. People claim to hear the ground rumbling because of them...",
      "translation" : "聽說這裡有魔物出沒。有人聲稱聽見地面隆隆作響，說那是魔物鬧出來的動靜..."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Traveler",
      "state" : "translated",
      "text" : "[Traveler]",
      "translation" : "[旅行者]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Traveler",
      "state" : "translated",
      "text" : "I want to go explore inside...",
      "translation" : "我想進去探索一番..."
