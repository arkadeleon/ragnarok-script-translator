      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Alright. Let's go to the heaven of the cats, ^A2314BMalangdo^000000~",
