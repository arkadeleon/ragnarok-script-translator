      "line" : 90,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Don't forget to give him notice of your arrival.",
      "translation" : "別忘了通知他你已經到了。"
