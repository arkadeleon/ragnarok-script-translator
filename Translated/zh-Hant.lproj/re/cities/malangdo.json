      "line" : 77,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "And the next one is...",
      "translation" : "接下來還有一條..."
