    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "If you want to go back to ^A2314BMalangdo^000000, take the ship at Izlude or Alberta.",
      "translation" : "想回^A2314B綿綿島^000000的話，就在依斯魯得或阿爾貝塔搭船。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "If you enjoy that pleasant sea trip, you will arrive at the heaven of cats, ^A2314BMalangdo^000000.",
