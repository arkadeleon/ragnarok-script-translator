    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "So easy! Isn't it? Well, good bye~",
      "translation" : "很簡單吧？那麼，再見啦~"
