      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "Actually, let me tell you rule 53. I am an indulgent cat.",
      "translation" : "其實，我來告訴你第53條規矩吧。我是一隻寬容的貓。"
