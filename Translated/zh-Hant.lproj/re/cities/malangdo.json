    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "[Dolangmal]",
      "translation" : "[多朗馬爾]"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "How was it? You liked it? I knew it. Kakaka~",
      "translation" : "感覺怎麼樣？喜歡嗎？我就知道，嘎嘎嘎~"
