    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Dolangmal",
      "state" : "translated",
      "text" : "We are sent to here to take you to the heaven of cats, ^A2314BMalangdo^000000.",
      "translation" : "我們被派到這裡，是為了帶你去貓的天堂——^A2314B綿綿島^000000。"
