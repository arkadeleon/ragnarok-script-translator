      "text" : "[Receptionist]",
      "translation" : "[接待員]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Receptionist",
      "state" : "translated",
      "text" : "Welcome to Eclage Clinic.",
      "translation" : "歡迎來到艾克拉珠診所。"
    },
    {
      "kind" : "option",
      "line" : 32,
      "npc" : "Receptionist",
