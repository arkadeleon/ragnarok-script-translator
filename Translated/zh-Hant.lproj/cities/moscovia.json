{
  "file" : "npc/cities/moscovia.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "state" : "translated",
      "text" : "Moscovia! Do you know Moscovia?",
      "translation" : "莫斯科比亞！你聽說過莫斯科比亞嗎？"
    },
    {
      "kind" : "message",
      "line" : 22,
      "state" : "translated",
      "text" : "the paradise spreading on the endless seas...",
      "translation" : "那是無盡海洋中綿延展開的天堂..."
    },
    {
      "kind" : "message",
      "line" : 23,
      "state" : "translated",
      "text" : "Welcome to Moscovia",
      "translation" : "歡迎來到莫斯科比亞"
    },
    {
      "kind" : "message",
      "line" : 24,
      "state" : "translated",
      "text" : "It's adventurous and mystic.",
      "translation" : "這裡充滿冒險與神秘。"
    },
    {
      "kind" : "option",
      "line" : 26,
      "state" : "translated",
      "text" : "About Moscovia...",
      "translation" : "關於莫斯科比亞..."
    },
    {
      "kind" : "option",
      "line" : 26,
      "state" : "translated",
      "text" : "Go to Moscovia.",
      "translation" : "前往莫斯科比亞。"
    },
    {
      "kind" : "option",
      "line" : 26,
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 28,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "state" : "translated",
      "text" : "Moscovia is a beautiful kingdom",
      "translation" : "莫斯科比亞是一個美麗的王國"
    },
    {
      "kind" : "message",
      "line" : 30,
      "state" : "translated",
      "text" : "on an island located north of Rune-",
      "translation" : "它位於一座島上，島在盧恩-"
    },
    {
      "kind" : "message",
      "line" : 31,
      "state" : "translated",
      "text" : "Midgarts.",
      "translation" : "米德加爾特以北。"
    },
    {
      "kind" : "message",
      "line" : 33,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "state" : "translated",
      "text" : "I'm sure that you will be",
      "translation" : "我相信你一定會"
    },
    {
      "kind" : "message",
      "line" : 35,
      "state" : "translated",
      "text" : "absolutely fascinated",
      "translation" : "完全為之著迷"
    },
    {
      "kind" : "message",
      "line" : 36,
      "state" : "translated",
      "text" : "by Moscovia's beautiful scenery",
      "translation" : "莫斯科比亞美麗的風景"
    },
    {
      "kind" : "message",
      "line" : 37,
      "state" : "translated",
      "text" : "and gorgeous palace.",
      "translation" : "以及宏偉的宮殿。"
    },
    {
      "kind" : "message",
      "line" : 39,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "state" : "translated",
      "text" : "Now that our long winter has",
      "translation" : "漫長的冬天終於"
    },
    {
      "kind" : "message",
      "line" : 41,
      "state" : "translated",
      "text" : "passed,",
      "translation" : "過去了，"
    },
    {
      "kind" : "message",
      "line" : 42,
      "state" : "translated",
      "text" : "I'm happy that I can now show you",
      "translation" : "我很高興現在能帶你看看"
    },
    {
      "kind" : "message",
      "line" : 43,
      "state" : "translated",
      "text" : "our gorgeous hometown.",
      "translation" : "我們美麗的家鄉。"
    },
    {
      "kind" : "message",
      "line" : 45,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "state" : "translated",
      "text" : "If you feel like visiting Moscovia",
      "translation" : "如果你想遊覽莫斯科比亞"
    },
    {
      "kind" : "message",
      "line" : 47,
      "state" : "translated",
      "text" : "take the chance now!",
      "translation" : "現在就抓住機會吧！"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "I'll help you to have a nice trip",
      "translation" : "我會幫你開啟一段愉快的"
    },
    {
      "kind" : "message",
      "line" : 49,
      "state" : "translated",
      "text" : "to Moscovia!",
      "translation" : "莫斯科比亞之旅！"
    },
    {
      "kind" : "message",
      "line" : 53,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "state" : "translated",
      "text" : "Ok then, let us start now.",
      "translation" : "好吧，那我們現在出發。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "state" : "translated",
      "text" : "You should pay me 10,000 zeny",
      "translation" : "你需要支付我10,000 Zeny"
    },
    {
      "kind" : "message",
      "line" : 56,
      "state" : "translated",
      "text" : "to go to Moscovia.",
      "translation" : "才能前往莫斯科比亞。"
    },
    {
      "kind" : "message",
      "line" : 57,
      "state" : "translated",
      "text" : "But when you come back,",
      "translation" : "不過回來時"
    },
    {
      "kind" : "message",
      "line" : 58,
      "state" : "translated",
      "text" : "you don't have to pay.",
      "translation" : "你不必付錢。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "state" : "translated",
      "text" : "Can we leave now?",
      "translation" : "我們現在可以出發了嗎？"
    },
    {
      "kind" : "option",
      "line" : 63,
      "state" : "translated",
      "text" : "Let's go!",
      "translation" : "出發吧！"
    },
    {
      "kind" : "option",
      "line" : 63,
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 64,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "state" : "translated",
      "text" : "If you're too busy now,",
      "translation" : "如果你現在太忙，"
    },
    {
      "kind" : "message",
      "line" : 66,
      "state" : "translated",
      "text" : "please tell me again whenever you want.",
      "translation" : "想去的時候再來找我就行。"
    },
    {
      "kind" : "message",
      "line" : 67,
      "state" : "translated",
      "text" : "I'm always ready to guide anyone to Moscovia.",
      "translation" : "我隨時都能帶你去莫斯科比亞。"
    },
    {
      "kind" : "message",
      "line" : 71,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "state" : "translated",
      "text" : "I'm sorry but you don't have",
      "translation" : "很抱歉，你現在沒有足夠的"
    },
    {
      "kind" : "message",
      "line" : 73,
      "state" : "translated",
      "text" : "enough zeny now",
      "translation" : "Zeny。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "state" : "translated",
      "text" : "You need 10,000 zeny",
      "translation" : "你需要10,000 Zeny"
    },
    {
      "kind" : "message",
      "line" : 75,
      "state" : "translated",
      "text" : "to go to Moscovia",
      "translation" : "才能前往莫斯科比亞。"
    },
    {
      "kind" : "message",
      "line" : 76,
      "state" : "translated",
      "text" : "Thank you.",
      "translation" : "謝謝。"
    },
    {
      "kind" : "message",
      "line" : 79,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "state" : "translated",
      "text" : "Ok then, we're leaving now.",
      "translation" : "好吧，那我們現在出發。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "state" : "translated",
      "text" : "If you're too busy now,",
      "translation" : "如果你現在太忙，"
    },
    {
      "kind" : "message",
      "line" : 89,
      "state" : "translated",
      "text" : "please tell me again whenever you want.",
      "translation" : "想去的時候再來找我就行。"
    },
    {
      "kind" : "message",
      "line" : 90,
      "state" : "translated",
      "text" : "I'm always ready to guide anyone to Moscovia.",
      "translation" : "我隨時都能帶你去莫斯科比亞。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "How was your trip?",
      "translation" : "旅途怎麼樣？"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Do you have good memories from Moscovia?",
      "translation" : "你在莫斯科比亞留下了美好的回憶嗎？"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "A ship is now leaving",
      "translation" : "一艘船即將啟航"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "for Rune-Midgarts.",
      "translation" : "前往盧恩米德加爾特。"
    },
    {
      "kind" : "option",
      "line" : 102,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Return to Alberta",
      "translation" : "返回艾爾貝塔"
    },
    {
      "kind" : "option",
      "line" : 102,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Cancel",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "If you want to see more",
      "translation" : "如果你還想四處看看"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "please take your time.",
      "translation" : "請慢慢來。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "[Moscovia P.R. Officer]",
      "translation" : "[莫斯科比亞宣傳員]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Please come and visit soon.",
      "translation" : "請儘快再來遊玩。"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Moscovia P.R. Officer",
      "state" : "translated",
      "text" : "Ok then, Let's get going.",
      "translation" : "好吧，我們出發吧。"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Our dear Csar Alexsay III is in the palace.",
      "translation" : "我們敬愛的沙皇阿列克謝三世在宮殿裡。"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "He rules over Moscovia.",
      "translation" : "他統治著莫斯科比亞。"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Please be careful not to cause him any trouble.",
      "translation" : "請小心行事，別給他添麻煩。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "[Soldier]",
      "translation" : "[士兵]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Soldier",
      "state" : "translated",
      "text" : "Please be silent or the Csar will be angry.",
      "translation" : "請保持安靜，否則沙皇會生氣的。"
    }
  ]
