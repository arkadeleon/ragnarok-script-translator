{
  "file" : "npc/cities/ayothaya.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "state" : "translated",
      "text" : "Hoo! Hah! Hoo! Hah!",
      "translation" : "呼！哈！呼！哈！"
    },
    {
      "kind" : "message",
      "line" : 24,
      "state" : "translated",
      "text" : "Let me take you away to",
      "translation" : "讓我帶你前往"
    },
    {
      "kind" : "message",
      "line" : 25,
      "state" : "translated",
      "text" : "a distant spiritual place,",
      "translation" : "遙遠而寧靜的靈性之地，"
    },
    {
      "kind" : "message",
      "line" : 26,
      "state" : "translated",
      "text" : "a land of exotic mystery,",
      "translation" : "一個充滿異域神秘色彩的地方，"
    },
    {
      "kind" : "message",
      "line" : 27,
      "state" : "translated",
      "text" : "my hometown Ayothaya!",
      "translation" : "我的家鄉哎喲泰雅！"
    },
    {
      "kind" : "option",
      "line" : 29,
      "state" : "translated",
      "text" : "About Ayothaya.",
      "translation" : "瞭解哎喲泰雅"
    },
    {
      "kind" : "option",
      "line" : 29,
      "state" : "translated",
      "text" : "Go to Ayothaya.",
      "translation" : "前往哎喲泰雅"
    },
    {
      "kind" : "option",
      "line" : 29,
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 31,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "state" : "translated",
      "text" : "We Ayothayans are a pious people who value peace and sincerity. We endeavor to lead simple, yet noble, lives in harmony with nature.",
      "translation" : "我們哎喲泰雅人信仰虔誠，珍視和平與真誠。我們追求簡樸而高尚的生活，與自然和諧相處。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "state" : "translated",
      "text" : "Our traditional cuisine is world famous. It's no surprise when we serve dishes like Tom Yum Goong, made of Shrimp, Lemon and Chillies, which has a tantalizing aroma and flavor beyond imagining.",
      "translation" : "我們的傳統美食舉世聞名，這可不是浪得虛名。冬陰功湯以蝦、檸檬和辣椒烹製，香氣和滋味都誘人得難以想像。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "state" : "translated",
      "text" : "For those who crave adventure, there is an age old story about the Sa-mhing Tiger, an evil creature that haunts our temple ruins.",
      "translation" : "喜歡冒險的話，我們這裡還有一個古老傳說：邪惡的薩姆辛虎會在寺廟廢墟里出沒。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "state" : "translated",
      "text" : "Hoo! Hahh! Hoo! Hahh!",
      "translation" : "呼！哈！呼！哈！"
    },
    {
      "kind" : "message",
      "line" : 42,
      "state" : "translated",
      "text" : "No man alive can resist the",
      "translation" : "世上無人能抗拒"
    },
    {
      "kind" : "message",
      "line" : 43,
      "state" : "translated",
      "text" : "call of this beautiful land.",
      "translation" : "這片美麗土地的召喚。"
    },
    {
      "kind" : "message",
      "line" : 44,
      "state" : "translated",
      "text" : "Midgardians are",
      "translation" : "米德加爾特人"
    },
    {
      "kind" : "message",
      "line" : 45,
      "state" : "translated",
      "text" : "always welcome!",
      "translation" : "永遠受到歡迎！"
    },
    {
      "kind" : "message",
      "line" : 48,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "state" : "translated",
      "text" : "Ah, you must pay 10,000 Zeny",
      "translation" : "啊，前往哎喲泰雅需要支付10,000澤尼"
    },
    {
      "kind" : "message",
      "line" : 50,
      "state" : "translated",
      "text" : "if you wish to visit Ayothaya.",
      "translation" : "才能踏上旅程。"
    },
    {
      "kind" : "message",
      "line" : 51,
      "state" : "translated",
      "text" : "If you're ready, we can leave",
      "translation" : "如果你準備好了，我們現在"
    },
    {
      "kind" : "message",
      "line" : 52,
      "state" : "translated",
      "text" : "right now~",
      "translation" : "就可以出發~"
    },
    {
      "kind" : "option",
      "line" : 54,
      "state" : "translated",
      "text" : "I'm ready, let's go!",
      "translation" : "準備好了，出發！"
    },
    {
      "kind" : "option",
      "line" : 54,
      "state" : "translated",
      "text" : "No.",
      "translation" : "不了。"
    },
    {
      "kind" : "message",
      "line" : 56,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "state" : "translated",
      "text" : "Hoo! Hah! Hoo! Hah!",
      "translation" : "呼！哈！呼！哈！"
    },
    {
      "kind" : "message",
      "line" : 58,
      "state" : "translated",
      "text" : "Let us be off! Back to my",
      "translation" : "我們出發吧！回到我的"
    },
    {
      "kind" : "message",
      "line" : 59,
      "state" : "translated",
      "text" : "beautiful Ayothaya!",
      "translation" : "美麗故鄉哎喲泰雅！"
    },
    {
      "kind" : "message",
      "line" : 65,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "state" : "translated",
      "text" : "I am sorry, but you do not have the 10,000 Zeny to travel to Ayothaya. Such a price is nothing compared to the experiences that await you!",
      "translation" : "抱歉，你沒有足夠的10,000澤尼前往哎喲泰雅。和等待你的見聞相比，這點費用根本不算什麼！"
    },
    {
      "kind" : "message",
      "line" : 70,
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "state" : "translated",
      "text" : "Have you ever dreamed",
      "translation" : "你是否曾夢想過"
    },
    {
      "kind" : "message",
      "line" : 72,
      "state" : "translated",
      "text" : "of a beautiful place filled",
      "translation" : "一個美麗的地方，那裡充滿"
    },
    {
      "kind" : "message",
      "line" : 73,
      "state" : "translated",
      "text" : "with spiritual serenity? You",
      "translation" : "靈性的寧靜？你"
    },
    {
      "kind" : "message",
      "line" : 74,
      "state" : "translated",
      "text" : "must have been dreaming",
      "translation" : "一定是在夢見"
    },
    {
      "kind" : "message",
      "line" : 75,
      "state" : "translated",
      "text" : "of Ayothaya, my friend.",
      "translation" : "哎喲泰雅，我的朋友。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "Hoo! Hah! Hmm! Hah!",
      "translation" : "呼！哈！嗯！哈！"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "So, how did you like Ayothaya? Did you get a chance to try Tom Yum Goong? When you're ready, I shall take you back home.",
      "translation" : "哎喲泰雅之旅感覺如何？有機會嚐嚐冬陰功湯了嗎？等你準備好，我就送你回家。"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "Go back to Alberta.",
      "translation" : "返回阿爾貝塔"
    },
    {
      "kind" : "option",
      "line" : 85,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "You will be welcome to come back whenever you please. I hope that we will see each other again sometime soon. Thank you~",
      "translation" : "無論何時，你都歡迎再來。我希望我們很快還能再見。謝謝你~"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "[Aibakthing]",
      "translation" : "[艾巴克辛]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "Ah yes. I understand that it is difficult to take leave of such a beautiful place. Do not worry",
      "translation" : "啊，我明白。離開這麼美麗的地方確實不容易。別擔心"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Aibakthing",
      "state" : "translated",
      "text" : "and take your time.",
      "translation" : "慢慢來吧。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "[Thang]",
      "translation" : "[唐]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "There's an ancient,",
      "translation" : "有一座古老而"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "dreadful building in",
      "translation" : "可怕的建築，"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "Ayothaya that no one",
      "translation" : "就坐落在哎喲泰雅。"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "here dares approach...",
      "translation" : "這裡的人誰都不敢靠近..."
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "[Thang]",
      "translation" : "[唐]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "In the past, a few curious people went inside, despite the horror stories, and never returned. What on earth could be going on inside of that place?",
      "translation" : "過去，有幾個人出於好奇，儘管聽過那些恐怖傳聞，還是走了進去，之後就再也沒有回來。裡面到底發生了什麼事？"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "[Thang]",
      "translation" : "[唐]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "However, if you want to prove your courage to others, confronting the danger inside might be a worthy challenge for an adventurer...",
      "translation" : "不過，如果你想向別人證明自己的勇氣，冒險進入裡面面對危險，也許會是值得一試的挑戰..."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Young Man",
      "state" : "translated",
      "text" : "I think.",
      "translation" : "我是這麼想的。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "[Lalitha]",
      "translation" : "[拉莉塔]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "Hello!",
      "translation" : "你好！"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "I don't think",
      "translation" : "我想我們"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "we've met before.",
      "translation" : "以前沒見過。"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "[Lalitha]",
      "translation" : "[拉莉塔]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "You must be",
      "translation" : "你一定是"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "from Midgard.",
      "translation" : "米德加爾特來的。"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "After all, I know every single person living in this village.",
      "translation" : "畢竟，村裡每個人我都認識。"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "Heh heh~",
      "translation" : "嘿嘿~"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "[Lalitha]",
      "translation" : "[拉莉塔]"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "Hmm...",
      "translation" : "嗯..."
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "May I ask about the land you",
      "translation" : "我可以問問你來自什麼地方嗎？"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "come from? I'm curious about",
      "translation" : "我對外面的世界"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "a lot of things in the outside world.",
      "translation" : "有很多好奇的事。"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "[Lalitha]",
      "translation" : "[拉莉塔]"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Girl",
      "state" : "translated",
      "text" : "You know, like the dresses and jewelry that ladies wear in other countries, whether or not the men are good looking, what kind of songs you have, what kind of girls that guys over there like...",
      "translation" : "比如其他國家的女孩穿什麼衣服、戴什麼首飾，男人長得帥不帥，那邊流行什麼歌曲，還有那裡的男生喜歡什麼樣的女孩..."
    },
