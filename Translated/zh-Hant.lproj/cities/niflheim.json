    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Undead Familiar",
      "state" : "translated",
      "text" : "[Vatoman]",
      "translation" : "[瓦托曼]"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Undead Familiar",
      "state" : "translated",
      "text" : "Mwahahaha~",
      "translation" : "哇哈哈哈~"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Undead Familiar",
      "state" : "translated",
      "text" : "Foolish mortal!",
      "translation" : "愚蠢的凡人！"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Undead Familiar",
      "state" : "translated",
      "text" : "Beware my powers!",
      "translation" : "嚐嚐我的力量吧！"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Where...where am I...?",
      "translation" : "我...我在哪裡...？"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I remember I was sleeping",
      "translation" : "我記得我當時在睡覺，"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Child",
      "state" : "translated",
      "text" : "and when I woke up, I was here...",
      "translation" : "醒來後就到了這裡..."
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Mommy, have you seen my mommy?",
      "translation" : "媽媽，你看到我媽媽了嗎？"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I wanna go home...*Sob*",
      "translation" : "我想回家...*啜泣*"
    },
    {
      "kind" : "option",
      "line" : 120,
      "npc" : "Child",
      "state" : "translated",
      "text" : "About the witch",
      "translation" : "關於女巫"
    },
    {
      "kind" : "option",
      "line" : 120,
      "npc" : "Child",
      "state" : "translated",
      "text" : "About the curse",
      "translation" : "關於詛咒"
    },
    {
      "kind" : "option",
      "line" : 120,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Witch...? I've never seen a witch, but I've read about them in books. I'm not sure if they exist or not, but it would be so horrifying if they did...",
      "translation" : "女巫...？我從沒見過女巫，只在書裡讀到過。我不確定她們是不是真的存在，但要是真的有，那一定很可怕..."
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Why is it so cold in here...?",
      "translation" : "這裡為什麼這麼冷...？"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Child",
      "state" : "translated",
      "text" : "A-aren't you cold, or even scared? I wanna go home... It's warm over there. Could you help me get back... Please...? H-help me...",
      "translation" : "你...你不冷嗎？不害怕嗎？我想回家...那裡很溫暖。你能幫我回去嗎...求求你...幫...幫幫我..."
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Child",
      "state" : "translated",
      "text" : "A c-curse...?",
      "translation" : "詛...詛咒...？"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Child",
      "state" : "translated",
      "text" : "My grandma says that there are lots of curses in the world. Some of them, you can tell it's a curse. But there are other curses that follow you throughout life...",
      "translation" : "奶奶說世界上有很多詛咒。有些一看就知道是詛咒，但還有一些會伴隨你一生..."
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Grandma says curses can take other forms... Like if someone's always mad at you, and won't forgive you, you can see that as a curse too.",
      "translation" : "奶奶說詛咒也會以其他形式出現...比如有人總是生你的氣，不肯原諒你，你也可以把那看作一種詛咒。"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Child",
      "state" : "translated",
      "text" : "My grandma told me there's only one spell that can break a strong curse that you can't lift with Blessings...",
      "translation" : "奶奶告訴我，有一種咒語可以解除強大的詛咒，即使用祝福也無法消除的那種..."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Klaatu...",
      "translation" : "克拉圖..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Verata.....",
      "translation" : "維拉塔..."
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Ne...ni...umm...?",
      "translation" : "尼...尼...嗯...？"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Child",
      "state" : "translated",
      "text" : "What was the last part?",
      "translation" : "最後一句是什麼來著？"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I-I can't remember",
      "translation" : "我...我想不起來"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Child",
      "state" : "translated",
      "text" : "the last part of the spell!",
      "translation" : "咒語的最後一句了！"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Child",
      "state" : "translated",
      "text" : "If you repeat the spell in that order, it will release you from someone's anger and hate. And if you do it near a bad spirit, they might get the curse instead.",
      "translation" : "按順序念出咒語，就能讓你擺脫某人的憤怒和憎恨。如果在惡靈附近念，它們可能會代替你承受詛咒。"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Why are you asking me about these scary kind of things...? I just wanna go home...",
      "translation" : "你為什麼問我這些可怕的事情...？我只想回家..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Child",
      "state" : "translated",
      "text" : "It's so cold in here...",
      "translation" : "這裡好冷..."
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Child",
      "state" : "translated",
      "text" : "I'm freezing...",
      "translation" : "我快凍僵了..."
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Child",
      "state" : "translated",
      "text" : "And I wanna go home and",
      "translation" : "我想回家，"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Child",
      "state" : "translated",
      "text" : "get away from this scary place...",
      "translation" : "離開這個可怕的地方..."
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Child",
      "state" : "translated",
      "text" : "[Alakina Ann]",
      "translation" : "[阿拉基娜·安]"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Please... help me.",
      "translation" : "求求你...幫幫我。"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Child",
      "state" : "translated",
      "text" : "Could you take me with you...?",
      "translation" : "你能帶我一起走嗎...？"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Cursed Spirit",
      "state" : "translated",
      "text" : "[Ashe Bruce]",
      "translation" : "[阿什·布魯斯]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Cursed Spirit",
      "state" : "translated",
      "text" : "I sense you're cursed",
      "translation" : "我感覺到你中了"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Cursed Spirit",
      "state" : "translated",
      "text" : "by a powerful spell...",
      "translation" : "強大的咒語..."
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Cursed Spirit",
