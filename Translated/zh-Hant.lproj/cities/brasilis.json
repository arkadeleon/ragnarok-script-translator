    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Ice cream is the perfect snack for a hot day~",
      "translation" : "炎熱的天氣裡，冰淇淋是最棒的點心~"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "It's just ^3355FF100 Zeny^000000~",
      "translation" : "只要^3355FF100金幣^000000~"
