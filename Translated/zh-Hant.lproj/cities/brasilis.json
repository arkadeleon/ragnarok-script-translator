    {
      "kind" : "option",
      "line" : 112,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Give me one!",
      "translation" : "給我來一個！"
    },
    {
      "kind" : "option",
      "line" : 112,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Ice Cream?",
      "translation" : "冰淇淋？"
    },
    {
      "kind" : "option",
      "line" : 112,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Since there are so many people want to get a cool ice cream you can order only 5 at a time.",
      "translation" : "想吃冰涼冰淇淋的人太多了，每次最多隻能買5個。"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "So how many d'ya want?",
      "translation" : "你要幾個？"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "None?",
      "translation" : "一個也不要？"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Fine get outta the way, I have customers to serve.",
      "translation" : "好吧，別擋路了，我還要招呼其他客人。"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Wow.",
      "translation" : "哇。"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "You ordered too much.",
      "translation" : "你買得太多了。"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "If you eat over 5 you might need to fight with a monster in your stomach. Calm down buddy.",
      "translation" : "吃超過5個的話，肚子裡可能會有魔物打架。冷靜點，朋友。"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Dood~! You don't have enough money.",
      "translation" : "喂~！你的錢不夠。"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "It's only ^3355FF100 Zeny^000000~ Seriously!",
      "translation" : "真的只要^3355FF100金幣^000000~！"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "You seem to have too much stuff.",
      "translation" : "看來你帶的東西太多了。"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Lighten your pack before buying this.",
      "translation" : "買之前先把行李減輕些。"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "'Ice cream is...",
      "translation" : "“冰淇淋是..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Wait, don't you know",
      "translation" : "等等，你不知道"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "what Ice Cream is?",
      "translation" : "冰淇淋是什麼嗎？"
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "What rock have you",
      "translation" : "你是住在哪塊"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "been living under?",
      "translation" : "石頭底下啊？"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "I'm not going to even start with how weird that sounds.",
      "translation" : "這聽起來太奇怪了，我都不知道該從何說起。"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Anyway, get 'yer Ice Cream right here while it's nice and cold.",
      "translation" : "總之，趁冰淇淋還冰涼，快來買吧。"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "[Ice Cream Maker]",
      "translation" : "[冰淇淋商人]"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Don't miss your chance to eat the greatest Ice Cream in all the land~!",
      "translation" : "別錯過機會，嚐嚐全世界最好吃的冰淇淋吧~！"
