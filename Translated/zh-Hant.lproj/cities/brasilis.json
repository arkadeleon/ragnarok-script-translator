      "kind" : "message",
      "line" : 109,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Ice Cream~",
      "translation" : "冰淇淋~"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Ice-Cream Maker",
      "state" : "translated",
      "text" : "Get 'yer Ice Cream!",
      "translation" : "快來買冰淇淋！"
