      "npc" : "General Guillaume",
      "state" : "translated",
      "text" : "I'll be the one who will capture the flag!",
      "translation" : "我會親自奪下旗幟！"
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Teleporter",
      "state" : "translated",
      "text" : "[Teleporter]",
      "translation" : "[傳送師]"
    },
    {
      "kind" : "message",
      "line" : 187,
