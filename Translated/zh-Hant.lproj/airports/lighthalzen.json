      "text" : "[Airport Staff]",
      "translation" : "[機場工作人員]"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "Welcome to the",
      "translation" : "歡迎來到"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "Lighthalzen Airport,",
      "translation" : "雷根貝勒機場，"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "where we offer nonstop",
      "translation" : "這裡提供直飛航班，"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "flights to Einbroch, Juno and Hugel.",
      "translation" : "可前往艾音布羅克、朱諾和胡格爾。"
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "Board the Airship.",
      "translation" : "搭乘飛空艇。"
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "[Airport Staff]",
      "translation" : "[機場工作人員]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "The boarding fee is",
      "translation" : "搭乘費用為"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "1,200 zeny, but you can",
      "translation" : "1,200 Zeny，不過使用"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "waive the fee if you redeem",
      "translation" : "飛空艇免費票即可免除費用，"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "a Free Ticket for Airship.",
      "translation" : "兌換飛空艇免費票即可。"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "[Airship Staff]",
      "translation" : "[飛空艇工作人員]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "I'm sorry, but you don't",
      "translation" : "很抱歉，你沒有"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "have 1,200 zeny to pay",
      "translation" : "足夠支付1,200 Zeny"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "for the boarding fee.",
      "translation" : "搭乘費用。"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "[Airport Staff]",
      "translation" : "[機場工作人員]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "Thank you and",
      "translation" : "感謝惠顧，"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "please come again.",
      "translation" : "歡迎下次再來。"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Airport Staff",
      "state" : "translated",
      "text" : "Have a good day~",
      "translation" : "祝你今天愉快～"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "[Arrival Staff]",
      "translation" : "[抵達處工作人員]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "Welcome to Lighthalzen Airport.",
      "translation" : "歡迎來到雷根貝勒機場。"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "Please let me guide you to the",
      "translation" : "如果你剛搭機抵達，請讓我帶你前往"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "main terminal if you are arriving from your flight. Otherwise, please",
      "translation" : "主航站樓。否則，請"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "board the departing Airship to reach your intended destination.",
      "translation" : "搭乘出發的飛空艇前往目的地。"
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "Exit to main terminal.",
      "translation" : "前往主航站樓。"
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "Cancel.",
      "translation" : "取消。"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "[Arrival Staff]",
      "translation" : "[抵達處工作人員]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "Once you're in the main terminal, you will need to pay the fee again",
      "translation" : "進入主航站樓後，你需要再次付費"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "to board an Airship. You should",
      "translation" : "才能搭乘飛空艇。只有在"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "only exit if Lighthalzen is your intended destination. Shall we",
      "translation" : "目的地是雷根貝勒時才應離開。我們是否"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "proceed to the main terminal?",
      "translation" : "要前往主航站樓？"
    },
    {
      "kind" : "option",
      "line" : 71,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 71,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "No",
      "translation" : "否"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "[Arrival Staff]",
      "translation" : "[抵達處工作人員]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "Alright, thank you",
      "translation" : "好的，感謝你"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "for your patronage",
      "translation" : "選擇搭乘本航班，"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "and I hope you have",
      "translation" : "祝你"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Arrival Staff",
      "state" : "translated",
      "text" : "a pleasant flight~",
      "translation" : "旅途愉快～"
    }
  ]
}