    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Mersetzdeitz",
      "state" : "translated",
      "text" : "overcome all trials",
      "translation" : "克服所有試煉"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Mersetzdeitz",
      "state" : "translated",
      "text" : "and destroy the Emperium,",
      "translation" : "並摧毀華麗金屬的人，"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Mersetzdeitz",
      "state" : "translated",
      "text" : "the king will endow the one with",
      "translation" : "授予其"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Mersetzdeitz",
      "state" : "translated",
      "text" : "ownership of this castle.",
      "translation" : "這座城堡的所有權。"
