      "placeholders" : [
        "getitemname(.@id)"
      ],
      "state" : "translated",
      "text" : "Shall I sign your ^0055FF{0}^000000?",
      "translation" : "要我為你的^0055FF{0}^000000簽名嗎？"
    },
    {
      "kind" : "option",
      "line" : 106,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Ok!",
      "translation" : "好！"
    },
    {
      "kind" : "option",
      "line" : 106,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Leave",
      "translation" : "離開"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩爾奇克]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "See you...",
      "translation" : "再見..."
