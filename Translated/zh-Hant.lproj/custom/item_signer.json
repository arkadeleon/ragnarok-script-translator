    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I can ^0055FFsign your name^000000 on almost any rare item you hold.",
      "translation" : "我可以在你持有的幾乎所有稀有物品上^0055FF簽上你的名字^000000。"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Tell me more...",
      "translation" : "詳細說說..."
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Sign my items, please!",
      "translation" : "請幫我給物品簽名！"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩爾奇克]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I can put your name on any slotless equipment or weapon.",
      "translation" : "我可以在任何沒有插槽的裝備或武器上簽名。"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩爾奇克]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "For my work I accept:",
      "translation" : "我的服務收費如下："
    },
    {
      "kind" : "message",
