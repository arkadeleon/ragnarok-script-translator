    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩爾奇克]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Show me your items to sign...",
      "translation" : "把要簽名的物品給我看看..."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "[Perchik]",
      "translation" : "[佩爾奇克]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Nothing is equipped there!",
      "translation" : "那個位置沒有裝備物品！"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Alas, this item's already signed.",
      "translation" : "唉，這件物品已經簽過名了。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I would never touch a master's work.",
      "translation" : "我絕不會碰大師的作品。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "A card? Here?!",
      "translation" : "卡片？這裡面有卡片？！"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "As I said before, I don't sign items with cards.",
      "translation" : "我之前說過，我不為帶卡片的物品簽名。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Sorry, I don't sign slotted items.",
      "translation" : "抱歉，我不為有插槽的物品簽名。"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "Sorry, I don't sign rental items!",
      "translation" : "抱歉，我不為租賃物品簽名！"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Perchik",
      "state" : "translated",
      "text" : "I will need:",
      "translation" : "我需要："
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Perchik",
      "placeholders" : [
        ".@Item[.@i+1]",
        "getitemname(.@Item[.@i])"
      ],
      "state" : "translated",
      "text" : " ~ {0}x {1}",
      "translation" : " ~ {0}個{1}"
    },
    {
