      "line" : 22,
      "npc" : "Mason",
      "state" : "translated",
      "text" : "Prontera Chivalry",
      "translation" : "普隆德拉騎士團"
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Mason",
      "state" : "translated",
      "text" : "Trading Post",
      "translation" : "交易所"
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Mason",
