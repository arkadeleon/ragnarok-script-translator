      ],
      "state" : "translated",
      "text" : "[Ash]\nAhh, {0}! Welcome to the Official Treasure Hunter's Guild Shop.\nYou currently have ^FF0000{1}^000000 treasure tokens!!!",
      "translation" : "[阿什]\n啊，{0}！歡迎來到尋寶獵人公會的官方商店。\n你現在有^FF0000{1}^000000枚尋寶代幣！"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Treasure Hunter's Shop",
      "state" : "translated",
      "text" : "How does this place work?",
      "translation" : "這裡怎麼兌換"
    },
    {
      "kind" : "option",
      "line" : 26,
      "npc" : "Treasure Hunter's Shop",
      "state" : "translated",
      "text" : "What do you have in stock?",
      "translation" : "有什麼商品"
    },
