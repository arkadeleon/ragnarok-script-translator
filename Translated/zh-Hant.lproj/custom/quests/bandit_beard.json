    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Would you like a beard?",
      "translation" : "你想要一把鬍鬚嗎？"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Yes, I'd like some facial hair!",
      "translation" : "是啊，我想留點鬍子！"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "No thanks, thats gross!",
      "translation" : "不用了，太噁心！"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[鬍鬚男]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "HoHo~ So you want some whiskers.",
      "translation" : "呵呵~所以你想要點鬍鬚。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Well I would give you my beards but there not cheap.",
      "translation" : "我倒是願意把自己的鬍鬚給你，但它可不便宜。"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Matter of fact I have only one left...",
      "translation" : "事實上，我只剩下一把了..."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "but I'm not selling it.",
      "translation" : "不過我不賣。"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "But don't get mad! I can make you one.",
      "translation" : "別生氣！我可以給你做一把。"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[鬍鬚男]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "I would need some ^8080FFThread^000000 for the Beard.",
      "translation" : "做鬍鬚需要一些^8080FF線^000000。"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Talk to my friend in Izlude for some ^8080FFThread^000000.",
      "translation" : "去依斯魯得找我的朋友拿些^8080FF線^000000。"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[鬍鬚男]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Also I would need you to get me some things for the beard.",
      "translation" : "另外，你還得幫我收集一些鬍鬚材料。"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "They are:",
      "translation" : "需要這些："
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFElastic Band^000000",
      "translation" : "^8080FF橡皮筋^000000"
    },
