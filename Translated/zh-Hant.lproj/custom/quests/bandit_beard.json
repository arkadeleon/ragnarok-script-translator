      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[鬍鬚男]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Have a nice day!",
      "translation" : "祝你今天愉快！"
