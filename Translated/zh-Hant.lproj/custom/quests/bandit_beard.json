    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "[Bearded Man]",
      "translation" : "[鬍鬚男]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "Fine, be that way!",
      "translation" : "好吧，隨你便！"
