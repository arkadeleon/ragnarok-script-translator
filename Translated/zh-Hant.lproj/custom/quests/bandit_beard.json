      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFBlack Dye Stuff^000000",
      "translation" : "^8080FF黑色染料^000000"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFGranpa Beard^000000",
      "translation" : "^8080FF爺爺鬍鬚^000000"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FF100 sticky Mucus^000000",
      "translation" : "^8080FF粘稠液體100個^000000"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : "^8080FFCounteragent^000000",
      "translation" : "^8080FF中和劑^000000"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Bearded Man",
      "state" : "translated",
      "text" : " and one ^8080FF2 Carat Diamond^000000",
      "translation" : "還有一顆^8080FF二克拉鑽石^000000"
