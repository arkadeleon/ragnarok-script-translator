    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Kafra Clerk",
      "state" : "translated",
      "text" : "Sorry but we have not received any ^8080FFThread^000000.",
      "translation" : "抱歉，我們還沒收到^8080FF線^000000。"
