      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "[Mister Mobry]",
      "translation" : "[莫布里先生]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "In fact I know a secret about these spirits that can in some way... perhaps aid you...",
      "translation" : "其實我知道這些靈魂的一個秘密，也許能以某種方式...幫到你..."
