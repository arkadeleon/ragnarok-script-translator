      "line" : 33,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "What Do I Need?",
      "translation" : "我需要準備什麼？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "Where Can I find this Crap?",
      "translation" : "這些破爛要去哪裡找？"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "Make me a Dead Branch!",
      "translation" : "幫我製作一根枯樹枝！"
