      "line" : 27,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "[Mister Mobry]",
      "translation" : "[莫布里先生]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Mister Mobry",
      "state" : "translated",
      "text" : "I can create a spirited branch... That is, if you can provide me with the correct materials...",
      "translation" : "我能製作一根有靈性的樹枝...前提是你能提供正確的材料..."
