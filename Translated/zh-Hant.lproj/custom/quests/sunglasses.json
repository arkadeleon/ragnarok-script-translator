{
  "file" : "npc/custom/quests/sunglasses.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "There is nothing more I can tell you.",
      "translation" : "我沒什麼能再告訴你的了。"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Go see Maseph. She is somewhere north of Morocc.",
      "translation" : "去找瑪瑟普。她在夢羅克北邊某處。"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Hello. What can I do for you?",
      "translation" : "你好，有什麼事嗎？"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "I heard that you can make ^0000FFSlotted Sunglasses^000000.",
      "translation" : "聽說你會製作^0000FF開洞太陽鏡^000000。"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Nothing, sorry to bother you.",
      "translation" : "沒事，抱歉打擾了。"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Come back to me than you are ready.",
      "translation" : "等你準備好了再來找我。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "I do not make them, but I can tell you where to find the person who does. For a small fee...",
      "translation" : "我不製作太陽鏡，不過可以告訴你去哪裡找製作的人。只收一點費用..."
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "How much?",
      "translation" : "要多少錢？"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "No way, I will find her myself!",
      "translation" : "算了，我自己去找她！"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Suit yourself, the Maker will not make you ^0000FFSlotted Sunglasses^000000 unless she knows that you are coming.",
      "translation" : "隨你便。除非她知道你會去，否則製作者不會給你製作^0000FF開洞太陽鏡^000000。"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Only I can tell her you are coming.",
      "translation" : "只有我能通知她你要過去。"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Come back to me when you have given up. Hahaha...",
      "translation" : "等你放棄了再回來找我。哈哈哈..."
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "In order for me to tell you information on ^0000FFSlotted Sunglasses^000000 you need to get me:",
      "translation" : "想讓我告訴你^0000FF開洞太陽鏡^000000的訊息，你得先給我："
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : " - ^0000881 Carat Diamond^000000",
      "translation" : " - ^0000881顆鑽石^000000"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : " - ^00008850 Feathers^000000",
      "translation" : " - ^00008850根羽毛^000000"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : " - ^000088100000z^000000",
      "translation" : " - ^000088100000金幣^000000"
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Alright, here.",
      "translation" : "好，給你。"
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "That's too much!",
      "translation" : "太貴了！"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Suit yourself.",
      "translation" : "隨你便。"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "You're missing something. Come back when you've gathered all the materials.",
      "translation" : "你還缺東西。收集齊所有材料後再來。"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Great. Now, listen carefully.",
      "translation" : "很好。現在仔細聽。"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "[Sunglasses Trader]",
      "translation" : "[太陽鏡商人]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "Look for someone named Maseph somewhere north of Morocc.",
      "translation" : "去夢羅克北邊找一個叫瑪瑟普的人。"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Sunglasses Trader",
      "state" : "translated",
      "text" : "I will send her a message to let her know that you are coming.",
      "translation" : "我會給她捎個口信，讓她知道你要過去。"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[瑪瑟普]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Lovely day, isn't it ?",
      "translation" : "今天天氣真好，不是嗎？"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Hello there.",
      "translation" : "你好。"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "You came for the ^000088Slotted Sunglasses^000000, right?",
      "translation" : "你是來找^000088開洞太陽鏡^000000的，對吧？"
    },
    {
      "kind" : "option",
      "line" : 80,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Yes",
      "translation" : "是"
    },
    {
      "kind" : "option",
      "line" : 80,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "No, sorry to bother you.",
      "translation" : "不是，抱歉打擾了。"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[瑪瑟普]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Off you go, then.",
      "translation" : "那你去吧。"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[瑪瑟普]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "To make one, I will need one pair of ^000088Sunglasses^000000 and 400000z.",
      "translation" : "製作一副需要一副^000088太陽鏡^000000和400000金幣。"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Here you go.",
      "translation" : "給你。"
    },
    {
      "kind" : "option",
      "line" : 87,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "No, thanks.",
      "translation" : "不用了，謝謝。"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[瑪瑟普]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "As you wish.",
      "translation" : "如你所願。"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[瑪瑟普]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "I need one pair of ^000088Sunglasses^000000. Come back to me when you have one.",
      "translation" : "我需要一副^000088太陽鏡^000000。準備好後再來找我。"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "You do not have enough Zeny. Come back to me when you do.",
      "translation" : "你的金幣不夠。攢夠了再來找我。"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Thank you. I will get on it right away...",
      "translation" : "謝謝。我馬上就開始製作..."
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "[Maseph]",
      "translation" : "[瑪瑟普]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Here you go, my friend.",
      "translation" : "給你，我的朋友。"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Maseph",
      "state" : "translated",
      "text" : "Enjoy your ^000088Slotted Sunglasses^000000.",
      "translation" : "好好享用你的^000088開洞太陽鏡^000000。"
    }
  ]
}