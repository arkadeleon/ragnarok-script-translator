    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFJormungand^000000 is famous for its ability to poison the enemy.",
      "translation" : "^3355FF耶夢加得^000000以能使敵人中毒而聞名。"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFMuspellium^000000 is required to make ^3355FFJormungand^000000 and ^3355FFHervor^000000.",
      "translation" : "製作^3355FF耶夢加得^000000和^3355FF赫爾沃^000000需要^3355FF穆斯貝爾海姆之石^000000。"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFEssence Of Rune^000000 is required to make ^3355FFJormungand^000000 and ^3355FFHervor^000000.",
      "translation" : "製作^3355FF耶夢加得^000000和^3355FF赫爾沃^000000需要^3355FF盧恩精華^000000。"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^FF0000The items I need are as follows:^000000",
      "translation" : "^FF0000我需要以下物品：^000000"
