    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^3355FFMjolnir^000000 is the mighty Hammer of Thor.",
      "translation" : "^3355FF雷神之錘^000000是雷神托爾的強大武器。"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^3355FFSleipnir^000000 are boots made after Odin's War Horse.",
      "translation" : "^3355FF斯雷普尼爾^000000是以奧丁的戰馬為原型打造的靴子。"
