      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFGleipnir^000000 is a light yet strong rope required to make ^3355FFMegingjard^000000",
      "translation" : "^3355FF格萊普尼爾^000000是一條輕巧而堅韌的繩索，是製作^3355FF梅吉恩傑德^000000所需的材料。"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFMegingjard^000000 is the powerful Belt of Thor.",
      "translation" : "^3355FF梅吉恩傑德^000000是雷神托爾的強力腰帶。"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFAsprika^000000 is the light of gods.",
      "translation" : "^3355FF阿斯普里卡^000000是諸神之光。"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFBrynhild^000000 is the warrior's armor.",
      "translation" : "^3355FF布倫希爾德^000000是戰士的鎧甲。"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "The ^3355FFHervor^000000 is named after the valkyrie who ensures victory for her warriors.",
      "translation" : "^3355FF赫爾沃^000000以女武神命名，她負責確保戰士們取得勝利。"
