      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "[Lenneth]",
      "translation" : "[蕾娜絲]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Lenneth",
      "state" : "translated",
      "text" : "^3355FFBrisingammen^000000 is the magical Necklace of Freyja, goddess of Beauty.",
      "translation" : "^3355FF布里希嘉曼^000000是美與愛之女神芙蕾雅的魔法項鍊。"
