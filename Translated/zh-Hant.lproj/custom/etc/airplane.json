{
  "file" : "npc/custom/etc/airplane.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nThe plane is currently ported.  Would you like to board?",
      "translation" : "^FF0000[搬運工]^000000\n飛空艇目前停靠中。\n您想登船嗎？"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "Yes.",
      "translation" : "是的"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不"
    },
    {
      "kind" : "option",
      "line" : 244,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "View Hourly Itinerary.",
      "translation" : "檢視時刻表"
    },
    {
      "kind" : "message",
      "line" : 251,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nHave a good day.  Thank you for traveling with Airship.",
      "translation" : "^FF0000[搬運工]^000000\n祝您愉快。\n感謝您乘坐飛空艇。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nSorry, ma'am, but the plane currently isn't ported.  However, you can view the airplane's hourly itinerary.",
      "translation" : "^FF0000[搬運工]^000000\n女士，很抱歉，飛空艇目前未停靠。\n不過您可以檢視飛空艇的時刻表。"
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000\nSorry, sir, but the plane currently isn't ported.  However, you can view the airplane's hourly itinerary.",
      "translation" : "^FF0000[搬運工]^000000\n先生，很抱歉，飛空艇目前未停靠。\n不過您可以檢視飛空艇的時刻表。"
    },
    {
      "kind" : "option",
      "line" : 260,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "Yes, please.",
      "translation" : "好，請讓我看看"
    },
    {
      "kind" : "option",
      "line" : 260,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "No thanks.",
      "translation" : "不用了，謝謝"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "F_Porter",
      "state" : "translated",
      "text" : "^FF0000[Porter]^000000",
      "translation" : "^FF0000[搬運工]^000000"
    },
    {
      "kind" : "message",
      "line" : 342,
      "npc" : "Itinerary Schedule",
      "state" : "translated",
      "text" : "^FF0000[Itinerary]^000000",
      "translation" : "^FF0000[時刻表]^000000"
    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000",
      "translation" : "^FF0000[空乘人員]^000000"
    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "Docker",
      "placeholders" : [
        "$locationsname$[$destination]"
      ],
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nWe are currently docked at {0}.  Would you like to exit?",
      "translation" : "^FF0000[空乘人員]^000000\n我們目前停靠在{0}。\n您想下船嗎？"
    },
    {
      "kind" : "option",
      "line" : 353,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "Yes.",
      "translation" : "是的"
    },
    {
      "kind" : "option",
      "line" : 353,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "No.",
      "translation" : "不"
    },
    {
      "kind" : "message",
      "line" : 362,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nHave a good day.  Thank you for traveling with us.",
      "translation" : "^FF0000[空乘人員]^000000\n祝您愉快。\n感謝您乘坐我們的飛空艇。"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nSorry, ma'am, but the plane currently isn't docked.  Please wait.",
      "translation" : "^FF0000[空乘人員]^000000\n女士，很抱歉，飛空艇目前未停靠。\n請稍候。"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nSorry, sir, but the plane currently isn't docked.  Please wait.",
      "translation" : "^FF0000[空乘人員]^000000\n先生，很抱歉，飛空艇目前未停靠。\n請稍候。"
    },
    {
      "kind" : "message",
      "line" : 373,
      "npc" : "Docker",
      "state" : "translated",
      "text" : "^FF0000[Airplane Attendant]^000000\nWe're currently in air. Please wait until the pilot has announced that we have safely landed.",
      "translation" : "^FF0000[空乘人員]^000000\n我們目前正在空中飛行。請等飛行員宣佈安全著陸。"
    },
