      "kind" : "message",
      "line" : 80,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "[Valkyrie]",
      "translation" : "[女武神]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "When you are ready",
      "translation" : "準備好後，"
