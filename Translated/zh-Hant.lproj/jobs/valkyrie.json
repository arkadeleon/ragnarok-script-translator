    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "[Valkyrie]",
      "translation" : "[女武神]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "And I pray that the new life to which the goddess Skuld will guide you will be even more honorable than your last.",
      "translation" : "我也祈願女神詩寇蒂引領你開啟的新生活，比過去更加榮耀。"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Valkyrie",
