      "line" : 77,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "[Valkyrie]",
      "translation" : "[女武神]"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Valkyrie",
      "state" : "translated",
      "text" : "You cannot take anything with you to the next life. Your items, zeny, pets and Pushcart all have to be left behind.",
      "translation" : "你不能帶任何東西前往來世。物品、ZENY、寵物和手推車都必須留下。"
