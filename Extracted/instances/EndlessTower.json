    {
      "kind" : "message",
      "line" : 1192,
      "npc" : "Immortal Brazier",
      "text" : "- A Message is Engraved on the Brazier -"
    },
    {
      "kind" : "message",
      "line" : 1193,
      "npc" : "Immortal Brazier",
