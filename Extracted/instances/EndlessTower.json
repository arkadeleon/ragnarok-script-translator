    {
      "kind" : "message",
      "line" : 2129,
      "npc" : "Lost Soul",
      "text" : "[Lost Souls]"
    },
    {
      "kind" : "message",
      "line" : 2130,
      "npc" : "Lost Soul",
      "text" : "Hey, you have the remnants of Naght Sieger with you."
    },
    {
      "kind" : "message",
      "line" : 2132,
      "npc" : "Lost Soul",
      "text" : "[Lost Souls]"
    },
    {
      "kind" : "message",
      "line" : 2133,
      "npc" : "Lost Soul",
      "text" : "They may appear to be one-handed swords, but I can put them together to make a two-handed one if you want. That's the only way I can repay you for freeing me."
    },
    {
      "kind" : "option",
      "line" : 2135,
      "npc" : "Lost Soul",
      "text" : "Make a Two-Handed Sword."
    },
