    {
      "kind" : "message",
      "line" : 1741,
      "npc" : "Lucid Crystal",
      "text" : "[Mysterious Voice]"
    },
    {
      "kind" : "message",
      "line" : 1742,
      "npc" : "Lucid Crystal",
      "text" : "Welcome to my place, intruders. I've had fun watching you endure all the difficulties I've set before you."
    },
    {
      "kind" : "message",
