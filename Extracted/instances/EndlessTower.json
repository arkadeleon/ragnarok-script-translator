      "npc" : "Lucid Crystal",
      "text" : "[Mysterious Voice]"
    },
    {
      "kind" : "message",
      "line" : 1745,
      "npc" : "Lucid Crystal",
      "text" : "Unfortunately, the time has come to end the show."
    },
    {
      "kind" : "message",
      "line" : 1747,
      "npc" : "Lucid Crystal",
      "text" : "[Mysterious Voice]"
    },
    {
      "kind" : "message",
      "line" : 1748,
      "npc" : "Lucid Crystal",
      "text" : "It's still too early to celebrate your victory against my right-hand man Knothen because he isn't completely destroyed!"
    },
    {
      "kind" : "message",
      "line" : 1750,
      "npc" : "Lucid Crystal",
      "text" : "[Mysterious Voice]"
    },
    {
      "kind" : "message",
      "line" : 1751,
      "npc" : "Lucid Crystal",
      "text" : "I shall resurrect him for your next show. Defeat him again, and then I'll gladly accept your challenge."
    },
    {
      "kind" : "message",
      "line" : 1753,
      "npc" : "Lucid Crystal",
      "text" : "[Mysterious Voice]"
