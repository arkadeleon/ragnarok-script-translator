    {
      "kind" : "message",
      "line" : 2119,
      "npc" : "Lost Soul",
      "text" : "You're carrying too much stuff. Why don't you put some of it away, and then come back?"
    },
    {
      "kind" : "message",
      "line" : 2122,
      "npc" : "Lost Soul",
      "text" : "[Lost Souls]"
    },
    {
      "kind" : "message",
      "line" : 2123,
      "npc" : "Lost Soul",
      "text" : "It's you that have liberated us from the evil Naght Sieger."
    },
