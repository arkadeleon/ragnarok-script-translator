    {
      "kind" : "message",
      "line" : 217,
      "npc" : "Leablem",
      "text" : "You seem interested in using that service."
    },
    {
      "kind" : "message",
      "line" : 218,
      "npc" : "Leablem",
      "text" : "If you want, I can at least tell you about it."
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Leablem",
      "text" : "But you must promise to keep this a secret."
    },
