      "npc" : "Suhnbi",
      "text" : "[Suhnbi]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Suhnbi",
      "text" : "Go find another Blacksmith. You can't refine this thing."
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Suhnbi",
      "text" : "[Suhnbi]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Suhnbi",
      "text" : "Hmm... someone perfected this already. I don't think I can work on it further."
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Suhnbi",
      "text" : "[Suhnbi]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Suhnbi",
      "text" : "Clang! Clang! Clang!"
    },
    {
      "kind" : "message",
