      "npc" : "Suhnbi",
      "text" : "[Suhnbi]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Suhnbi",
      "text" : "I don't think I can refine any items you have..."
    },
    {
      "kind" : "message",
