{
  "file" : "npc/merchants/hair_style.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Roving Hair Dresser",
      "text" : "That Veronica..."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Roving Hair Dresser",
      "text" : "Hah! Best hair dresser my ass."
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Roving Hair Dresser",
      "text" : "She's not the best hair dresser..."
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Roving Hair Dresser",
      "text" : "..."
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Roving Hair Dresser",
      "text" : "I am!"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Roving Hair Dresser",
      "text" : "I, Rui Vishop, the man to whom"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Roving Hair Dresser",
      "text" : "all scalps are canvases"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Roving Hair Dresser",
      "text" : "waiting to be transformed into"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Roving Hair Dresser",
      "text" : "works of magnificent art~!"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Roving Hair Dresser",
      "text" : "What are you?"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Roving Hair Dresser",
      "text" : "Do my hair, please!"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Roving Hair Dresser",
      "text" : "....."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Roving Hair Dresser",
      "text" : "Do you not know that I, Rui"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Roving Hair Dresser",
      "text" : "Vishop, maestro of the shears"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Roving Hair Dresser",
      "text" : "and sculptor of hair, am an"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Roving Hair Dresser",
      "text" : "artist far ahead of his time?!"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Roving Hair Dresser",
      "text" : "Well, I suppose an adventurer"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Roving Hair Dresser",
      "text" : "like yourself wouldn't know..."
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Roving Hair Dresser",
      "text" : "As a hair sculptor, I find joy"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Roving Hair Dresser",
      "text" : "in bestowing upon others the"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Roving Hair Dresser",
      "text" : "supreme favour of doing their"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Roving Hair Dresser",
      "text" : "hairstyle at a reasonable price."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Roving Hair Dresser",
      "text" : "Recently, however, I happened to"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Roving Hair Dresser",
      "text" : "overhear that some tyro has had"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Roving Hair Dresser",
      "text" : "the audacity to call herself a"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Roving Hair Dresser",
      "text" : "hair dresser."
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Roving Hair Dresser",
      "text" : "So one day I went there,"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Roving Hair Dresser",
      "text" : "pretending to be a customer."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Roving Hair Dresser",
      "text" : "I was apalled to see the boring,"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Roving Hair Dresser",
      "text" : "lifeless hairstyles that she was"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Roving Hair Dresser",
      "text" : "giving all of her clients..."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Roving Hair Dresser",
      "text" : "It wasn't hard to notice that her"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Roving Hair Dresser",
      "text" : "skills, or lack thereof, are a"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Roving Hair Dresser",
      "text" : "joke. She brings shame to the"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Roving Hair Dresser",
      "text" : "great and honorable"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Roving Hair Dresser",
      "text" : "profession of hair dressing."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Roving Hair Dresser",
      "text" : "A complete and utter disgrace!"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Roving Hair Dresser",
      "text" : "But the worst part was..."
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Roving Hair Dresser",
      "text" : "she forced her customers to"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Roving Hair Dresser",
      "text" : "choose a hairstyle before she"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Roving Hair Dresser",
      "text" : "styled their hair!"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Roving Hair Dresser",
      "text" : "That's not how talented hair"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Roving Hair Dresser",
      "text" : "dressers do their job! She"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Roving Hair Dresser",
      "text" : "should know what hair style will"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Roving Hair Dresser",
      "text" : "fit a customer without ever"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Roving Hair Dresser",
      "text" : "asking them!"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Roving Hair Dresser",
      "text" : "If by any chance you decide to"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Roving Hair Dresser",
      "text" : "do your hair, don't even think"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Roving Hair Dresser",
      "text" : "about giving her patronage."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Roving Hair Dresser",
      "text" : "Instead, you may ask for my"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Roving Hair Dresser",
      "text" : "services. I assure you, I am"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Roving Hair Dresser",
      "text" : "faaaar better than her."
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Roving Hair Dresser",
      "text" : "Do you understand? I mean, don't"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Roving Hair Dresser",
      "text" : "let her ruin your hair needlessly!"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Roving Hair Dresser",
      "text" : "You could get a Swordman to hack"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Roving Hair Dresser",
      "text" : "away at your hair if you want a"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Roving Hair Dresser",
      "text" : "hairstyle that horrible~!"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Roving Hair Dresser",
      "text" : "Hmm, I must say, your current"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Roving Hair Dresser",
      "text" : "style fits you best. Trust me, I know what I am saying."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Roving Hair Dresser",
      "text" : "Ah, I see that that you can"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Roving Hair Dresser",
      "text" : "recognize genius when it is"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Roving Hair Dresser",
      "text" : "right before you. In light"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Roving Hair Dresser",
      "text" : "of your good taste, I will"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Roving Hair Dresser",
      "text" : "only require money for my"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Roving Hair Dresser",
      "text" : "services."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Roving Hair Dresser",
      "text" : "Simply pay me the small"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Roving Hair Dresser",
      "text" : "fee of 199,800 zeny. You must"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Roving Hair Dresser",
      "text" : "know that I am doing you a"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Roving Hair Dresser",
      "text" : "huge favor by charging you"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Roving Hair Dresser",
      "text" : "such a small amount. My"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Roving Hair Dresser",
      "text" : "art is priceless, after all."
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Roving Hair Dresser",
      "text" : "Alright, I will be taking my"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Roving Hair Dresser",
      "text" : "199,800 zeny service charge now."
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Roving Hair Dresser",
      "text" : "If you don't wish to do"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Roving Hair Dresser",
      "text" : "this right now, though I can't"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Roving Hair Dresser",
      "text" : "imagine why, you may ask that"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Roving Hair Dresser",
      "text" : "stupid hair dresser to"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Roving Hair Dresser",
      "text" : "do her clumsy work on you..."
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Roving Hair Dresser",
      "text" : "No, please do my hair."
    },
    {
      "kind" : "option",
      "line" : 135,
      "npc" : "Roving Hair Dresser",
      "text" : "Umm, I changed my mind."
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Roving Hair Dresser",
      "text" : "O~k~a~y!"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Roving Hair Dresser",
      "text" : "Now, let us begin~!"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Roving Hair Dresser",
      "text" : "Wooooo~oooohhhh!! Toohhhhh~oooohhhh!!"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Roving Hair Dresser",
      "text" : "Woooooo~aaaaaaahhhhh!!"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Roving Hair Dresser",
      "text" : "Voila!"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Roving Hair Dresser",
      "text" : "Oh, great~ it's awesome!"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Roving Hair Dresser",
      "text" : "Another Vishop masterpiece~"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Roving Hair Dresser",
      "text" : "Once more I've outdone myself."
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Roving Hair Dresser",
      "text" : "It's such a unique and talented"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Roving Hair Dresser",
      "text" : "style! Yes, I am the best! Wooohahahahahaha!"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Roving Hair Dresser",
      "text" : "Bah! Alright! It's your decision."
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Roving Hair Dresser",
      "text" : "But don't blame me later!"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Roving Hair Dresser",
      "text" : "One day you'll wake up, realize"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Roving Hair Dresser",
      "text" : "you're ugly and regret not"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Roving Hair Dresser",
      "text" : "having my genius shape every lock"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Roving Hair Dresser",
      "text" : "of hair on your head."
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Roving Hair Dresser",
      "text" : "[Rui Vishop]"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Roving Hair Dresser",
      "text" : "What? What a shame!"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Roving Hair Dresser",
      "text" : "Will you let that...that"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Roving Hair Dresser",
      "text" : "charlatan of a hair dresser ruin"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Roving Hair Dresser",
      "text" : "your hairstyle!? I'm sure the"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Roving Hair Dresser",
      "text" : "heavens are crying tears of"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Roving Hair Dresser",
      "text" : "pity at mankind's ignorance..."
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Assistant Beautician",
      "text" : "[Assistant Beautician]"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Assistant Beautician",
      "text" : "Wah?! Sweet Jiminy,"
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Assistant Beautician",
      "text" : "you freaked me out!"
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Assistant Beautician",
      "text" : "What are you doing?!"
    },
    {
      "kind" : "message",
      "line" : 188,
      "npc" : "Assistant Beautician",
      "text" : "[Assistant Beautician]"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Assistant Beautician",
      "text" : "Oh! Um, a customer!"
    },
    {
      "kind" : "message",
      "line" : 190,
      "npc" : "Assistant Beautician",
      "text" : "H-h-h-h-h-hello! Can"
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Assistant Beautician",
      "text" : "I help you with anything?"
    },
    {
      "kind" : "option",
      "line" : 193,
      "npc" : "Assistant Beautician",
      "text" : "What do you do?"
    },
    {
      "kind" : "option",
      "line" : 193,
      "npc" : "Assistant Beautician",
      "text" : "Please change my hairstyle."
    },
    {
      "kind" : "option",
      "line" : 193,
      "npc" : "Assistant Beautician",
      "text" : "Who is Prince Shammi?"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Assistant Beautician",
      "text" : "[Assistant Beautician]"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Assistant Beautician",
      "text" : "Oh! Me...? I'm"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Assistant Beautician",
      "text" : "just an assistant"
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Assistant Beautician",
      "text" : "beautician, but I'm"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Assistant Beautician",
      "text" : "training hard everyday"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Assistant Beautician",
      "text" : "so that I can become"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Assistant Beautician",
      "text" : "a real professional!"
    },
    {
