  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Black Marketeer",
      "text" : "You're too greedy, even compared to someone like me!"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Black Marketeer",
      "text" : "Why don't you go lighten your bag first?"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Black Marketeer",
      "text" : "Hey, you already made a contract with Hugh."
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Black Marketeer",
      "text" : "I don't have any business with you."
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Black Marketeer",
      "text" : "You must need something badly to come to find me."
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Black Marketeer",
      "text" : "What do you want?"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Black Marketeer",
      "text" : "Bulk Buyer Shop License"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Black Marketeer",
      "text" : "Who are you?"
    },
    {
      "kind" : "option",
      "line" : 37,
      "npc" : "Black Marketeer",
      "text" : "Nothing, nothing!"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Black Marketeer",
      "text" : "I knew it!"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Black Marketeer",
      "text" : "Sure, I can make it for you."
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Black Marketeer",
      "text" : "Mine looks just like the authentic one that Merchants get from that bastard Mr. Hugh!"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Black Marketeer",
      "text" : "And my license is better 'cuz you don't need ta' learn any skills."
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Black Marketeer",
      "text" : "How many do you want?"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Black Marketeer",
      "text" : "Just so you know, I can only make them in small quantities, up to 10 at a time."
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Black Marketeer",
      "text" : "It'll cost 500 zeny for each one."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Black Marketeer",
      "text" : "Don't you need those licenses?"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Black Marketeer",
      "text" : "I can only make up to 10 at a time, you know."
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Black Marketeer",
      "placeholders" : [
        "(.@input*500)"
      ],
      "text" : "It'll cost {0} zeny."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Black Marketeer",
      "text" : "but you don't have enough money."
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Black Marketeer",
      "text" : "Don't you know the basics of business? Everything has a price."
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Black Marketeer",
      "text" : "If you want something, you gotta pay for it."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Black Marketeer",
      "text" : "Ha... Ha ha ha!"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Black Marketeer",
      "text" : "Mr. Hugh, I'll take over your license business. You'll see!"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Black Marketeer",
      "text" : "*Giggle Giggle*"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Black Marketeer",
      "text" : "I left my hometown a long time ago."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Black Marketeer",
      "text" : "It's meaningless to ask who I am because all I've got left now is my hatred."
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Black Marketeer",
      "text" : "..."
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Black Marketeer",
      "text" : "Hugh is a corrupt merchant with no sense of business ethics."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Black Marketeer",
      "text" : "My sole purpose in life is to destroy Hugh."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Black Marketeer",
      "text" : "Aw, I drank too much... (*Hic*)"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Black Marketeer",
      "text" : "That's just the alohol talking."
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Black Marketeer",
      "text" : "Please forget anything I said."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Black Marketeer",
      "text" : "[Mr. Jass]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Black Marketeer",
      "text" : "Alright, alright! You don't have to yell."
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Black Marketeer",
      "text" : "Just leave me alone if you've got no business with me."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Purchasing Team",
      "text" : "- You cannot converse or perform the quest because you are carrying too many items. -"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Purchasing Team",
      "text" : "I'm Hugh from the Purchasing Team."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Purchasing Team",
      "text" : "How may I help you today?"
    },
    {
      "kind" : "option",
      "line" : 115,
      "npc" : "Purchasing Team",
      "text" : "Purchase Bulk Buyer Shop License"
    },
    {
      "kind" : "option",
      "line" : 115,
      "npc" : "Purchasing Team",
      "text" : "Quit"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Purchasing Team",
      "text" : "Please feel free to ask me if you need any Bulk Buyer Shop Licenses."
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Purchasing Team",
      "text" : "Come again~"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Purchasing Team",
      "text" : "It's 200 zeny for each Bulk Buyer Shop License, and you may purchase up to 50 at a time."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Purchasing Team",
      "text" : "How many licenses do you need?"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Purchasing Team",
      "text" : "You have cancelled the trade."
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Purchasing Team",
      "text" : "Have a good day."
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Purchasing Team",
      "text" : "Please enter a value of 50 or less."
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Purchasing Team",
      "placeholders" : [
        "(.@input*200)",
        ".@input"
      ],
      "text" : "It'll cost {0} zeny for {1} licenses."
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Purchasing Team",
      "text" : "but you don't seem to have enough money."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Purchasing Team",
      "text" : "Thank you for your patronage."
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Purchasing Team",
      "text" : "I'm Hugh from the Purchasing Team at the Alberta Merchant Guild."
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Purchasing Team",
      "text" : "You're..."
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Purchasing Team",
      "text" : "Did you know? Our guild has issued a license to allow individuals to buy goods from others."
    },
    {
      "kind" : "option",
      "line" : 154,
      "npc" : "Purchasing Team",
      "text" : "I've never had problems buying items..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Purchasing Team",
      "text" : "You're right, but think about it:"
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Purchasing Team",
      "text" : "haven't you had a hard time buying in bulk?"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Purchasing Team",
      "text" : "You'd have to find and talk to everyone that has an item you want."
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Purchasing Team",
      "text" : "Pretty inconvenient, isn't it?"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Purchasing Team",
      "text" : "Since buying in bulk is an important issue to us Merchants,"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Purchasing Team",
      "text" : "I've proposed an innovative plan to our guild, based on my 10 years of experience in making purchases."
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Purchasing Team",
      "text" : "'Let Individuals Open"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Purchasing Team",
      "text" : "a Bulk Buyer Shop!'"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Purchasing Team",
      "text" : "That's the title of my proposal."
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Purchasing Team",
      "text" : "You'll see, when you read it..."
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Purchasing Team",
      "text" : "..."
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Purchasing Team",
      "text" : "...(Mr. Hugh yammers on and on with all the details.)"
    },
    {
      "kind" : "option",
      "line" : 175,
      "npc" : "Purchasing Team",
      "text" : "Alright, what's your point?"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Purchasing Team",
      "text" : "Oh, yes. In summary,"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Purchasing Team",
      "text" : "you can buy certain items in bulk through Vending."
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Purchasing Team",
      "text" : "In order to open a Bulk Buyer Shop, you need a license issued from the Merchant Guild."
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Purchasing Team",
      "text" : "You need it every time you open the shop. We're expecting a significant increase in profits through this new kind of licensing."
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 187,
      "npc" : "Purchasing Team",
      "text" : "That's the point of my proposal!"
    },
    {
      "kind" : "message",
      "line" : 188,
      "npc" : "Purchasing Team",
      "text" : "Our president was so happy to hear that we're going to make big bucks!"
    },
    {
      "kind" : "message",
      "line" : 190,
      "npc" : "Purchasing Team",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Purchasing Team",
      "text" : "Please get to the point already!"
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Purchasing Team",
      "text" : "Don't be so impatient, alright?"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Purchasing Team",
      "text" : "My point is, we can let you open the Bulk Buyer Shop if you've learned Vending."
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Purchasing Team",
      "text" : "Of course, we charge 10,000 zeny as a one-time registration fee."
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Purchasing Team",
      "text" : "You will need the ^4A4AFFBulk Buyer Shop License^000000 every time you open the shop."
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Purchasing Team",
      "text" : "Say, would you like to register now?"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Purchasing Team",
      "text" : "If you do, I'll teach you how to open the Bulk Buyer Shop."
    },
    {
      "kind" : "option",
      "line" : 205,
      "npc" : "Purchasing Team",
      "text" : "Learn how to open Bulk Buyer Shop"
    },
    {
      "kind" : "option",
      "line" : 205,
      "npc" : "Purchasing Team",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Purchasing Team",
      "text" : "Man, that's disappointing!"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Purchasing Team",
      "text" : "Using this bulk buyer option can benefit your business in many ways, but it's your call."
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Purchasing Team",
      "text" : "I'm always open for consultation!"
    },
    {
      "kind" : "message",
      "line" : 212,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 214,
      "npc" : "Purchasing Team",
      "text" : "The registration fee is 10,000 zeny."
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "Purchasing Team",
      "text" : "Please have the fee ready first."
    },
    {
      "kind" : "message",
      "line" : 218,
      "npc" : "Purchasing Team",
      "text" : "You've made a good decision."
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Purchasing Team",
      "text" : "Please give me the registration fee, and sign right here...."
    },
    {
      "kind" : "message",
      "line" : 222,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Purchasing Team",
      "placeholders" : [
        ".@name$"
      ],
      "text" : "{0}...."
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Purchasing Team",
      "text" : "I like your handwriting."
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Purchasing Team",
      "text" : "Okay, you're now approved to open the Bulk Buyer Shop."
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Purchasing Team",
      "text" : "Currently, only normal items ^8C2121EXCEPT^000000 equipment, certain potions, and hand-crafted items can be purchased in bulk, but this can still be very beneficial to you, depending on how you use it."
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Purchasing Team",
      "text" : "Oh, and you need at least one of the item that you want to buy in your inventory because you have to show it to other through your shop."
    },
    {
      "kind" : "message",
      "line" : 236,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 237,
      "npc" : "Purchasing Team",
      "text" : "Your skill should now be registered in your skill window. If you can't see it you probably have to minimize your Skill List and check the 3rd Job Tab."
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Purchasing Team",
      "text" : "I've given you 5 Bulk Buyer Shop Licenses for your trial."
    },
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "Purchasing Team",
      "text" : "Enjoy shopping!"
    },
    {
      "kind" : "message",
      "line" : 246,
      "npc" : "Purchasing Team",
      "text" : "I'm Hugh from the Purchasing Team at the Alberta Merchant Guild."
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Purchasing Team",
      "text" : "I'd love to chat, but I'm too busy at the moment."
    },
    {
      "kind" : "message",
      "line" : 249,
      "npc" : "Purchasing Team",
      "text" : "[Mr. Hugh]"
    },
    {
      "kind" : "message",
      "line" : 250,
      "npc" : "Purchasing Team",
      "text" : "My time is solely dedicated to our customers in the Merchant industry."
    }
  ]
