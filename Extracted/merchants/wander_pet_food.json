  "scripts" : [
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Pet Enthusiast",
      "text" : "Oh, Hi there!"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Pet Enthusiast",
      "text" : "Are you a lover of animals like I am?"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Pet Enthusiast",
      "text" : "I know that it's really hard to keep your cute pets happy."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Pet Enthusiast",
      "text" : "All it takes is the right kind of food."
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Pet Enthusiast",
      "text" : "I know that sometimes it is really hard to get the right food for your pet."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Pet Enthusiast",
      "text" : "Do you have any food that you are looking for?"
    },
    {
      "kind" : "option",
      "line" : 32,
      "npc" : "Pet Enthusiast",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 32,
      "npc" : "Pet Enthusiast",
      "text" : "No"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Pet Enthusiast",
      "text" : "Oh, you have ^ff000020 Broken Liquor Jar^000000s and ^ff00001 Alcohol^000000!"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Pet Enthusiast",
      "text" : "Do you want to exchange them for"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Pet Enthusiast",
      "text" : "^ff000020 Spirit Liquor^000000 for your Wanderer pet?"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Pet Enthusiast",
      "text" : "Yes, please!"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Pet Enthusiast",
      "text" : "No thank you."
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Pet Enthusiast",
      "text" : "Ok here you go then."
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Pet Enthusiast",
      "text" : "I hope it keeps your"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Pet Enthusiast",
      "text" : "cute pet happy."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Pet Enthusiast",
      "text" : "Hehe, well just let me know if you change your mind."
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Pet Enthusiast",
      "text" : "Actually, right now I can help you get Spirit Liquor for Wanderer pets."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Pet Enthusiast",
      "text" : "[Pet Enthusiast Jenny]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Pet Enthusiast",
      "text" : "All you have to do is bring me ^FF0000 20 Broken Liquor Jars^000000 and ^FF0000 1 Alcohol^000000."
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Pet Enthusiast",
      "text" : "I can give you ^FF0000 20 Spirit Liquor^000000 for that."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Pet Enthusiast",
      "text" : "You can get the Broken Liquor Jars from Tengu monsters in Amatsu dungeon."
    }
  ]
}