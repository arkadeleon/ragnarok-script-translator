    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Java Dullihan",
      "text" : "Hmmm. Not enough..."
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Java Dullihan",
      "text" : "I don't think I'll be able to make the color you want with those materials. Why don't you go get some more materials...?"
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "Java Dullihan",
      "text" : "Hmm... It came out pretty well. A very rich color. Of course I'll be trying harder to make a more charming color..."
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Java Dullihan",
      "text" : "Well, then. Stop by whenever you need more dyes."
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Java Dullihan",
      "text" : "Eeeehhhh!! What's this?"
    },
    {
      "kind" : "message",
