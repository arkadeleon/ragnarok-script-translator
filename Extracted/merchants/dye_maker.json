    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Java Dullihan",
      "text" : "Eeeehhhh!! What's this? You change your mind now!? So disappointing..."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Java Dullihan",
      "text" : "I'm not bragging or anything. But I have the skills to make dyestuff. If you ever need dyestuff, please come to me. I'll make them for you at a reasonable price."
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 30 Red Herbs, 1 Counteragent, and 1 Empty Bottle to make Red Dyestuffs. The fee is only 3000 zeny to make it."
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 30 Yellow Herbs, 1 Couneragent, and 1 Empty Bottle to make Lemon Dyestuffs. The fee is only 3000 zeny to make it."
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 20 Blue Herbs, 1 Counteragent, and 1 Empty Bottle to make Cobaltblue Dyestuff. It's hard to use the Blue Herb, so the fee is going to be 3500 zeny."
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 5 Blue Herbs, 20 Green Herbs, 20 Yellow Herbs, 1 Counteragent, 1 Mixture, and 1 Empty Bottle to make Darkgreen Dyestuffs. Don't get all of the materials confused. The fee is only 5000 zeny."
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 20 Red Herbs, 20 Yellow Herbs, 1 Counteragent, 1 Mixture, and 1 Empty Bottle to make Orange Dyestuff. The fee is going to be 5000 zeny."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 10 Blue Herbs, 30 Red Herbs, 1 Counteragent, 1 Mixture, and 1 Empty Bottle to make Violet Dyestuffs. The fee will be 5000 zeny."
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 30 White Herbs, 1 Counteragent, and 1 Empty bottle to make White Dyestuffs. The fee will be 3000 zeny."
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Java Dullihan",
      "text" : "Mmm... I need 30 of each Red, Yellow, and Green Herb, 5 Blue Herbs, 1 Counteragent, 1 Mixture, and 1 Empty Bottle. The process takes longer and more effort than the others, so it is going to be 7000 zeny."
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Java Dullihan",
      "text" : "[Dye Maker Java Dullihan]"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Java Dullihan",
      "text" : "Ah! I think you would have everything ready. Would you like to start the process?"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Java Dullihan",
      "text" : "Okay! I believe you would have everything ready. Would you like to start the process?"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Java Dullihan",
      "text" : "Okay! I believe you would have everything ready. Shall we begin the process?"
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Java Dullihan",
      "text" : "Okay! I believe you would have everything prepared. Would you like to start the process?"
    },
