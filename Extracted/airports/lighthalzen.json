    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Airport Staff",
      "text" : "Lighthalzen Airport,"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Airport Staff",
      "text" : "where we offer nonstop"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Airport Staff",
      "text" : "flights to Einbroch, Juno and Hugel."
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Airport Staff",
      "text" : "Board the Airship."
    },
    {
      "kind" : "option",
      "line" : 22,
      "npc" : "Airport Staff",
      "text" : "Cancel."
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Airport Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Airport Staff",
      "text" : "The boarding fee is"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Airport Staff",
      "text" : "1,200 zeny, but you can"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Airport Staff",
      "text" : "waive the fee if you redeem"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Airport Staff",
      "text" : "a Free Ticket for Airship."
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Airport Staff",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Airport Staff",
      "text" : "No"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Airport Staff",
      "text" : "[Airship Staff]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Airport Staff",
      "text" : "I'm sorry, but you don't"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Airport Staff",
      "text" : "have 1,200 zeny to pay"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Airport Staff",
      "text" : "for the boarding fee."
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Airport Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Airport Staff",
      "text" : "Thank you and"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Airport Staff",
      "text" : "please come again."
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Airport Staff",
      "text" : "Have a good day~"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Arrival Staff",
      "text" : "[Arrival Staff]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Arrival Staff",
      "text" : "Welcome to Lighthalzen Airport."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Arrival Staff",
      "text" : "Please let me guide you to the"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Arrival Staff",
      "text" : "main terminal if you are arriving from your flight. Otherwise, please"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Arrival Staff",
      "text" : "board the departing Airship to reach your intended destination."
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Arrival Staff",
      "text" : "Exit to main terminal."
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Arrival Staff",
      "text" : "Cancel."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Arrival Staff",
      "text" : "[Arrival Staff]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Arrival Staff",
      "text" : "Once you're in the main terminal, you will need to pay the fee again"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Arrival Staff",
      "text" : "to board an Airship. You should"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Arrival Staff",
      "text" : "only exit if Lighthalzen is your intended destination. Shall we"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Arrival Staff",
      "text" : "proceed to the main terminal?"
    },
    {
      "kind" : "option",
      "line" : 71,
      "npc" : "Arrival Staff",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 71,
      "npc" : "Arrival Staff",
      "text" : "No"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Arrival Staff",
      "text" : "[Arrival Staff]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Arrival Staff",
      "text" : "Alright, thank you"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Arrival Staff",
      "text" : "for your patronage"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Arrival Staff",
      "text" : "and I hope you have"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Arrival Staff",
      "text" : "a pleasant flight~"
    }
  ]
