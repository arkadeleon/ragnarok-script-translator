    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Airport Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Airport Staff",
      "text" : "Welcome to Juno Airport where we offer domestic flights to Einbroch, Lighthalzen and Hugel,"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Airport Staff",
      "text" : "and international flights to Izlude and Rachel."
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Airport Staff",
      "text" : "How may I be of service?"
    },
    {
      "kind" : "option",
      "line" : 21,
      "npc" : "Airport Staff",
      "text" : "Board the Airship."
    },
    {
      "kind" : "option",
      "line" : 21,
      "npc" : "Airport Staff",
      "text" : "Cancel."
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Airport Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Airport Staff",
      "text" : "The boarding fee for all"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Airport Staff",
      "text" : "flights is 1,200 zeny. If you"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Airport Staff",
      "text" : "use a Free Ticket for Airship,"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Airport Staff",
      "text" : "the boarding fee will be waived.So would you like to depart?"
    },
    {
      "kind" : "option",
      "line" : 28,
      "npc" : "Airport Staff",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 28,
      "npc" : "Airport Staff",
      "text" : "No"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Airport Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Airport Staff",
      "text" : "I'm sorry, but you don't"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Airport Staff",
      "text" : "have 1,200 zeny to pay"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Airport Staff",
      "text" : "for the boarding fee."
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Airport Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Airport Staff",
      "text" : "Thank you and"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Airport Staff",
      "text" : "have a nice day."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Arrival Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Arrival Staff",
      "text" : "Welcome to Juno Airport. If you've just arrived from your"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Arrival Staff",
      "text" : "flight, let me guide you to the main terminal. Otherwise, please"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Arrival Staff",
      "text" : "board the departing Airship to reach your intended destination."
    },
    {
      "kind" : "option",
      "line" : 61,
      "npc" : "Arrival Staff",
      "text" : "Exit to main terminal"
    },
    {
      "kind" : "option",
      "line" : 61,
      "npc" : "Arrival Staff",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Arrival Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Arrival Staff",
      "text" : "Once you're in the main terminal, you must pay the fee once again"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Arrival Staff",
      "text" : "to board a departing Airship. You should only exit if your intended"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Arrival Staff",
      "text" : "destination is Juno. Proceed to"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Arrival Staff",
      "text" : "exit to the main terminal?"
    },
    {
      "kind" : "option",
      "line" : 68,
      "npc" : "Arrival Staff",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 68,
      "npc" : "Arrival Staff",
      "text" : "No"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Arrival Staff",
      "text" : "[Airport Staff]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Arrival Staff",
      "text" : "Alright, thank you"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Arrival Staff",
      "text" : "for your patronage"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Arrival Staff",
      "text" : "and I hope you have"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Arrival Staff",
      "text" : "a pleasant flight~"
    },
    {
