    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Domestic Boarding",
      "text" : "Very well, then."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Domestic Boarding",
      "text" : "Thank you for your"
    },
