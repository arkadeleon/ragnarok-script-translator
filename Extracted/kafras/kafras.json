    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Kafra Service",
      "text" : "Your Respawn Point has"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Kafra Service",
      "text" : "been saved here, inside"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Kafra Service",
      "text" : "of the Kafra Corporation"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Kafra Service",
      "text" : "Headquarters. Thank you."
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Kafra Service",
      "text" : "[Kafra Leilah]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Kafra Service",
      "text" : "Please make use of"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Kafra Service",
      "text" : "the Kafra Services that are"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Kafra Service",
      "text" : "available throughout all of"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Kafra Service",
      "text" : "Midgard. Thank you for"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Kafra Service",
      "text" : "visiting the Kafra Headquarters."
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Kafra Service",
      "text" : "[Kafra Leilah]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Kafra Service",
      "text" : "Excuse me, but it"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Kafra Service",
      "text" : "seems that you don't"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Kafra Service",
      "text" : "have the 20 zeny to pay"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Kafra Service",
      "text" : "the Storage access fee..."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Kafra Service",
      "text" : "[Kafra Leilah]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Kafra Service",
      "text" : "Although this facility is"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Kafra Service",
      "text" : "exclusively intended for"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Kafra Service",
      "text" : "the training of Kafra Employee"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Kafra Service",
      "text" : "and administrative functions,"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Kafra Service",
      "text" : "I'll access your Storage for you."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Kafra Service",
      "text" : "[Kafra Leilah]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Kafra Service",
      "text" : "In the future, please"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Kafra Service",
      "text" : "ask the Kafra Employee on"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Kafra Service",
      "text" : "duty if you wish to use"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Kafra Service",
      "text" : "any of the Kafra Services."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Kafra Service",
      "text" : "Thank you for your patronage."
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Kafra Service",
      "text" : "[Kafra Leilah]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Kafra Service",
      "text" : "My apologies, but I'm"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Kafra Service",
      "text" : "not on duty. I'd assist you"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Kafra Service",
      "text" : "if I could, but actually don't"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Kafra Service",
      "text" : "have any available Pushcarts."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Kafra Service",
      "text" : "Why don't you ask another Kafra"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Kafra Service",
      "text" : "Employee for assistance?"
