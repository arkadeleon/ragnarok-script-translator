    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Kafra Service",
      "text" : "[Kafra Leilah]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Kafra Service",
      "text" : "Kafra Employees are"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Kafra Service",
      "text" : "stationed all over the"
    },
