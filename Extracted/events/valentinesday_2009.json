  "scripts" : [
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Trader",
      "text" : "Hey, folks! Here's something you don't see everyday!"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Trader",
      "text" : "Something you can never find in Rune-Midgarts!"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Trader",
      "text" : "Something that makes you happy with just one bite!"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Trader",
      "text" : "It's the perfect dessert and the perfect gift for loved ones."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Trader",
      "text" : "High-quality, traditional homemade chocolate only 5000z each!"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Trader",
      "text" : "I'll take it, please!"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Trader",
      "text" : "I want to wrap the chocolate!"
    },
    {
      "kind" : "option",
      "line" : 38,
      "npc" : "Trader",
      "text" : "End trading."
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Trader",
      "text" : "Ahaha, my dear."
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Trader",
      "text" : "This chocolate is nothing like others."
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Trader",
      "text" : "Every piece bears the devotion of the person who made it!"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Trader",
      "text" : "So, that's why I can't sell more than 5 of them at a time."
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Trader",
      "text" : "If you really really want more, then talk to me again."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Trader",
      "text" : "How many do you want anyway?"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Trader",
      "text" : "Oh, it's such a shame!"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Trader",
      "text" : "I'm sure you'll miss this opportunity and regret you didn't buy it."
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Trader",
      "text" : "Remember, you can never find this anywhere else!"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Trader",
      "text" : "Come back anytime, when you change your mind."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Trader",
      "text" : "Ugh.. Didn't I tell you?"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Trader",
      "text" : "5 is the maximum!"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Trader",
      "text" : "I can't sell more than that to the same person."
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Trader",
      "text" : "And you know it's not like an everyday meal."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Trader",
      "text" : "Eating too much is not really good for you."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Trader",
      "text" : "You're carrying too many items."
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Trader",
      "text" : "Please use the Kafra Services."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Trader",
      "text" : "Looks like you don't have enough zeny with ya."
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Trader",
      "text" : "Maybe you should borrow some zeny from a friend."
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Trader",
      "text" : "Cuz, I'm not gonna be here everyday."
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Trader",
      "text" : "Good for you!"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Trader",
      "text" : "It's also perfect as a gift!"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Trader",
      "text" : "You know you can't get this kind of chocolate normally."
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Trader",
      "text" : "If you want more, you should come back."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Trader",
      "text" : "Might be a good idea to buy some more while you have a chance...!"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Trader",
      "text" : "If you want to gift-wrap the chocolate, of course, you need chocolate, plus, wrapping paper, wrapping strap and a box."
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Trader",
      "text" : "You also need to pay 500 zeny to carve your name on the box."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Trader",
      "text" : "Are you all prepared...?"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Trader",
      "text" : "Hmm.. Looks like you don't have enough materials to decorate the gift box.."
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Trader",
      "text" : "You can't just put your gift into some plain looking box.."
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Trader",
      "text" : "Don't you think?"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Trader",
      "text" : "You need to bring some wrapping paper, wrapping strap, and a box."
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Trader",
      "text" : "Oh, also bring 500 zeny, and don't forget to bring your true loving heart with you!!"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Trader",
      "text" : "[Marco Bassinio]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Trader",
      "text" : "Hey, look, adventurer!"
