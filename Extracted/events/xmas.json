{
  "file" : "npc/events/xmas.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Father Christmas",
      "text" : "Merry Christmas!"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Father Christmas",
      "text" : "I have a gift for you! Ho Ho Ho!"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Father Christmas",
      "text" : "I'm having a bit of a problem..."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Father Christmas",
      "text" : "Do you care to listen?"
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "text" : "Listen to Santa Claus."
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "text" : "Give Santa Claus proof."
    },
    {
      "kind" : "option",
      "line" : 40,
      "npc" : "Father Christmas",
      "text" : "Cancel."
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Father Christmas",
      "text" : "My problem is this."
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Father Christmas",
      "text" : "There seems to be a man out there"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Father Christmas",
      "text" : "that is impersonating me and spreading"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Father Christmas",
      "text" : "terror throughout the land."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Father Christmas",
      "text" : "Like the Grinch of legend, he's taking"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Father Christmas",
      "text" : "all the childrens' toys and keeping them"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Father Christmas",
      "text" : "for himself."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Father Christmas",
      "text" : "I'm too busy here creating my batch of "
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Father Christmas",
      "text" : "toys for next year, so I can't go"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Father Christmas",
      "text" : "out and find him myself."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Father Christmas",
      "text" : "So I would like you to go out and"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Father Christmas",
      "text" : "Destroy this man for me."
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Father Christmas",
      "text" : "He has in his posession one of my"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Father Christmas",
      "text" : "magic sacks, however, so he will"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Father Christmas",
      "text" : "escape into it to another place each"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Father Christmas",
      "text" : "time you attack him."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Father Christmas",
      "text" : "However,"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Father Christmas",
      "text" : "In his haste, he tends to drop things."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Father Christmas",
      "text" : "If by chance he drops one of his Stockings"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Father Christmas",
      "text" : "With Holes that he uses to steal the"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Father Christmas",
      "text" : "poor childrens' toys, pick it up."
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Father Christmas",
      "text" : "If you collect 3 of these, I will give"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Father Christmas",
      "text" : "you a prototype mystery box that"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Father Christmas",
      "text" : "I've been keeping around the"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Father Christmas",
      "text" : "lab. It spits out random presents"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Father Christmas",
      "text" : "and saves me a ton of work."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Father Christmas",
      "text" : "Seems you've been doing a"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Father Christmas",
      "text" : "good job of taking down those"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Father Christmas",
      "text" : "fake Santas. Keep it up!"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Father Christmas",
      "text" : "There's your reward."
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Father Christmas",
      "text" : "If you get 3 more, I'll give you another."
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Father Christmas",
      "text" : "Hope you get a good item."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Father Christmas",
      "text" : "You don't have enough socks as proof."
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Father Christmas",
      "text" : "Go take down those evil Santas"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Father Christmas",
      "text" : "and get more for me and I'll reward you."
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Father Christmas",
      "text" : "[Santa Claus]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Father Christmas",
      "text" : "I see. Well, at the very least"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Father Christmas",
      "text" : "we shall meet again on Christmas morning."
    }
  ]
}