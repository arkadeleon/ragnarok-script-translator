{
  "file" : "npc/events/bossnia.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Bossnia Staff",
      "text" : "Hello?"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Bossnia Staff",
      "text" : "I found some beautiful places"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Bossnia Staff",
      "text" : "while I travelled all over the world."
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Bossnia Staff",
      "text" : "I am an adventurer."
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Bossnia Staff",
      "text" : "Haha~"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Bossnia Staff",
      "text" : "What? My name is..."
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Bossnia Staff",
      "text" : "'Bossnia Staff'?? No no..."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Bossnia Staff",
      "text" : "Well, my name is not so important."
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Bossnia Staff",
      "text" : "Sometimes you should be generous."
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Bossnia Staff",
      "text" : "No time for considering that kind of small stuff"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Bossnia Staff",
      "text" : "when you have to concentrate on more important things."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Bossnia Staff",
      "text" : "Hum... anyway I want to say... something.."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Bossnia Staff",
      "text" : "While I was travelling through some places,"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Bossnia Staff",
      "text" : "I found a really fearful place."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Bossnia Staff",
      "text" : "Most of the time when you come to a place,"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Bossnia Staff",
      "text" : "there is one strong and fearful monster."
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Bossnia Staff",
      "text" : "Isn't it?"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Bossnia Staff",
      "text" : "But... but... in there..."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Bossnia Staff",
      "text" : "There are lots of fearful and strong monsters in there..."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Bossnia Staff",
      "text" : "That was really frightful."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Bossnia Staff",
      "text" : "If I had reacted a bit later... a few seconds..."
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Bossnia Staff",
      "text" : "I might have been killed."
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Bossnia Staff",
      "text" : "What?"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Bossnia Staff",
      "text" : "You want to go in there?"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Bossnia Staff",
      "text" : "Oh~ Boy~ you didn't get me."
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Bossnia Staff",
      "text" : "In there......."
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Bossnia Staff",
      "text" : "Uh... you already know?"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Bossnia Staff",
      "text" : "Although you know the place, you want to go in..."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Bossnia Staff",
      "text" : "Good, I will send you there."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Bossnia Staff",
      "text" : "But after you went there, don't hold"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Bossnia Staff",
      "text" : "a grudge against me. It'll cost you 1 Reset Stone for 5 access."
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Bossnia Staff",
      "text" : "[Riss]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Bossnia Staff",
      "placeholders" : [
        "bossnia_event"
      ],
      "text" : "Remaining access: {0}"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Bossnia Staff",
      "text" : "Do you want to go?"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Bossnia Staff",
      "text" : "You don't have a ticket now....."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Bossnia Staff",
      "text" : "So come to me again with a Reset Stone later."
