{
  "file" : "npc/events/valentinesday.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Stephen",
      "text" : "[Stephen]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Stephen",
      "text" : "Guess what I've got?"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Stephen",
      "text" : "A tasty treat not easily found in Midgard...."
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Stephen",
      "text" : "[Stephen]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Stephen",
      "text" : "Chocolate!"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Stephen",
      "text" : "That's right, don't you love chocolate.... I do."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Stephen",
      "text" : "And you are in luck, because I'm selling them for only 5,000 zeny a piece!"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Stephen",
      "text" : "I want some chocolate!"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Stephen",
      "text" : "No thanks."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Stephen",
      "text" : "[Stephen]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Stephen",
      "text" : "You don't want any chocolate?"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Stephen",
      "text" : "I'm telling you! You'll regret it!"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Stephen",
      "text" : "You better get some now... you won't come across Chocolate like this ever again!"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Stephen",
      "text" : "Think it over and visit me again sometime."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Stephen",
      "text" : "[Stephen]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Stephen",
      "text" : "Hah!"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Stephen",
      "text" : "I knew it!"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Stephen",
      "text" : "But I can't sell you more than 5 at once... but, if you really need more...."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Stephen",
      "text" : "you can come back again."
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Stephen",
      "text" : "So how many do you want?"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Stephen",
      "text" : "[Stephen]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Stephen",
      "text" : "I'm sorry, but I can't give you that many."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Stephen",
      "text" : "I'm sorry, but it seems you can't afford to buy these off me."
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Stephen",
      "text" : "There you go!"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Stephen",
      "text" : "You can give that to someone as a gift, or enjoy it yourself!"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Stephen",
      "text" : "Mmm... sweet chocolate..."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Stephen",
      "text" : "Visit me anytime...!"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Jainie",
      "text" : "[Jainie]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Jainie",
      "text" : "You know what? The chocolate that my boyfriend sells are from me!"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Jainie",
      "text" : "I made them by myself."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Jainie",
      "text" : "[Jainie]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Jainie",
      "text" : "You know ... In cetain countries, there's a tradition of presenting chocolates to a person that you love..."
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Jainie",
      "text" : "They call it, ^3355FFValentine's Day^000000."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Jainie",
      "text" : "[Jainie]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Jainie",
      "text" : "So I gave him my delicious chocolate..."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Jainie",
      "text" : "And then he made me cook a lot more..."
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Jainie",
      "text" : "And now he is selling them to everyone."
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Jainie",
      "text" : "I guess he really enjoyed it."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Jainie",
      "text" : "But, I do feel good when people buy something I have made."
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Jainie",
      "text" : "[Jainie]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Jainie",
      "text" : "It would be great if you bought some too..."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Jainie",
      "text" : "I will be making chocolates for a while so..."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Carl Orleans",
      "text" : "Yes?"
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Carl Orleans",
      "text" : "I want some hand made chocolate..."
    },
    {
      "kind" : "option",
      "line" : 92,
      "npc" : "Carl Orleans",
      "text" : "I'm lost, sorry to bother you."
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Carl Orleans",
      "text" : "Oh... well, if you want me to make some of my special Hand Made Chocolate...."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Carl Orleans",
      "text" : "You will need to give me at least ^0000FF 3 Chocolates^000000."
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Carl Orleans",
      "text" : "That's right, only ^0000FF 3 Chocolates^000000"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Carl Orleans",
      "text" : "Bring them to me and you'll get what you came for."
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Carl Orleans",
      "text" : "See You."
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Carl Orleans",
      "text" : "Well, I just might be able to fulfill your needs..."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Carl Orleans",
      "text" : "I'm sorry, you don't have enough Chocolate Bars to do this."
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Carl Orleans",
      "text" : "You got 3 pieces of pure chocolate, I see."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Carl Orleans",
      "text" : "Give them to me..."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Carl Orleans",
      "text" : "Ok, now I will only create my special hand made chocolates if you promise to use it wisely."
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Carl Orleans",
      "text" : "....Hmmmmmm....."
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Carl Orleans",
      "text" : "Well..."
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Carl Orleans",
      "text" : "Here."
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Carl Orleans",
      "text" : "I hope you give it to someone special, because its a special chocolate."
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Carl Orleans",
      "text" : "As you know... only I can create this."
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Carl Orleans",
      "text" : "[Carl Orleans]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Carl Orleans",
      "text" : "Enjoy."
    }
  ]
}