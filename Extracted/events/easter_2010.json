    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "Rina's Little Friend",
      "text" : "[Rina's Little Friend]"
    },
    {
      "kind" : "message",
      "line" : 349,
      "npc" : "Rina's Little Friend",
      "text" : "Hi."
    },
    {
      "kind" : "message",
      "line" : 350,
      "npc" : "Rina's Little Friend",
      "text" : "I guess you're the trustworthy friend."
    },
    {
