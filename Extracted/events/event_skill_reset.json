{
  "file" : "npc/events/event_skill_reset.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nI already told you that you may only complete this event once."
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nPlease return when you reach BaseLv 60 or higher."
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nYou will need to use up all of your skill points if you want me to continue.\nPlease come again soon!"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nWould you like to reset skills?\nI'm sorry, but..."
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$",
        "strcharinfo(0)"
      ],
      "text" : "{0}\nHello, I am the Skill Resetter.\nYour name is ^0080FF{1}^000000.\nHow can I help you?"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nPlease, free your PecoPeco and we'll continue."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nPlease, free your Falcon and we'll continue."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nPlease, drop your cart and we'll continue."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nYou cannot reset skills\nwhen you keep\nany items."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nCome back soon!"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Hypnotist Teacher",
      "text" : "^009500Information about Reset skills.^000000"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Hypnotist Teacher",
      "text" : "^00B6FFReset skills.^000000"
    },
    {
      "kind" : "option",
      "line" : 59,
      "npc" : "Hypnotist Teacher",
      "text" : "^000088Nevermind^000000"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nYou know where to find me,\nif you ever want a reset!!"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nThis skill reset is not FREE OF CHARGE!!\nExpense for the reset of skill is ^D5A50020000 Zeny x BaseLv^000000.\nYeah ...each One BaseLv costs 20000 Zeny to reset skill."
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nOh yeah, one more thing!\nAny carts, falcons or pecos you have equiped\nwill be removed if you reset your skills."
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nJust one time does again to shake the skill point\nCareful with your skills from here on."
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nBefore skill reset in starting.\nYou shall have to first tell me your Base Level."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "strcharinfo(0)",
        "BaseLevel"
      ],
      "text" : "^D5A500[{0}]^000000\nMy Base level is ^AA00AALevel {1}BaseLv.^000000"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$",
        "@zeny"
      ],
      "text" : "{0}\nTotal zeny to the reset of skill amount ^529DFF{1}Zeny^000000  for the skill reset service."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nIt seems that you don't have enough money.\nIn addition we wait for the opportunity."
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Hypnotist Teacher",
      "placeholders" : [
        "@npcname$"
      ],
      "text" : "{0}\nThank you."
    }
