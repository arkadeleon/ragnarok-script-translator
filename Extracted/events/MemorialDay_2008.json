{
  "file" : "npc/events/MemorialDay_2008.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Lauds",
      "text" : "Hey, yo!"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Lauds",
      "text" : "What are you doing there!?"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Lauds",
      "text" : "Do you know what day it is!?"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Lauds",
      "text" : "It's a very important date!"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Lauds",
      "text" : "A very important date to remember!"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Lauds",
      "text" : "What is this!?"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Lauds",
      "text" : "Where is your towel!?"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Lauds",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Lauds",
      "text" : "My what?"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Lauds",
      "text" : "How are you supposed to go on your trip without your towel!?"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Lauds",
      "text" : "If you think this is just another holiday, I'm not going to waste my breath."
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Lauds",
      "text" : "But if you like to pay a tribute to great soldiers, I will help you ready yourself."
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Lauds",
      "text" : "I guess so..."
    },
    {
      "kind" : "option",
      "line" : 47,
      "npc" : "Lauds",
      "text" : "Are you crazy or something?"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Lauds",
      "text" : "Fine, be unprepared!"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Lauds",
      "text" : "^FF0000YOU WILL RUE THE DAY!^000000"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Lauds",
      "text" : "Great!"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Lauds",
      "text" : "Then listen to me carefully."
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Lauds",
      "text" : "Now before you can pay tribute to the fallen soldiers you must be properly equipped."
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Lauds",
      "text" : "Without your towel you will be lost!"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Lauds",
      "text" : "If you bring me the materials, I can make you a towel."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Lauds",
      "text" : "Listen closely."
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Lauds",
      "text" : "Bring me ^FF000030 Fabric and 20 Fluffs^000000."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Lauds",
      "text" : "What are these? They aren't enough?!"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Lauds",
      "text" : "*Sigh* Do I really have to tell you again?!"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Lauds",
      "text" : "Bring me ^FF000030 Fabric and 20 Fluffs^000000."
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Lauds",
      "text" : "***Mad Sago Lauds appears to be muttering to himself***"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Lauds",
      "text" : "So, did you bring the towel materials?"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Lauds",
      "text" : "Excellent; you've brought them all."
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Lauds",
      "text" : "Then I shall make you a Towel of Memory as I promised."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Lauds",
      "text" : "Give me a moment."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Lauds",
      "text" : "There you go!"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Lauds",
      "text" : "Ah, you have fluffy new towel now I even put your name on it"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Lauds",
      "text" : "Say, how do you like to go on a journey to pay a tribute to Memorial Day?"
    },
    {
      "kind" : "option",
      "line" : 107,
      "npc" : "Lauds",
      "text" : "Sure."
    },
    {
      "kind" : "option",
      "line" : 107,
      "npc" : "Lauds",
      "text" : "No, I'm Busy."
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Lauds",
      "text" : "Don't come crying to me if someone decides to build a highway through your home!"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Lauds",
      "text" : "Good. By the way, do you even know what the towel is for?"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Lauds",
      "text" : "It seems you're just carrying it without understanding its meaning."
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Lauds",
      "text" : "What a shame! You should go speak to ^FF0000Grast in Prontera^000000."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Lauds",
      "text" : "What are you still doing here?"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Lauds",
      "text" : "I told you to go speak to Grast in Prontera!"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Lauds",
      "text" : "Go help Grast, and then come back."
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Lauds",
      "text" : "Oh, you've brought them all."
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Lauds",
      "text" : "Hahaha!"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Lauds",
      "text" : "HAHAHAHAHAHA!!!! cough cough"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Lauds",
      "text" : "Please give them to me. Thank you for your hard work, by the way."
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Lauds",
      "text" : "Say, have you learned anything from the journey?"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Lauds",
      "text" : "Now is to go visit the plaque at 12 o'clock direction in Prontera."
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Lauds",
      "text" : "What do you mean you were just there?"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Lauds",
      "text" : "What? Why are you giving me your garbage!"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Lauds",
      "text" : "Those items are not useful to me at all."
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Lauds",
      "text" : "You should be going to the plaque!"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Lauds",
      "text" : "Stop trying to give me your garbage!"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Lauds",
      "text" : "Go to the plaque at 12 o'clock direction in Prontera for your journey!"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Lauds",
      "text" : "Don't panic!"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Lauds",
      "text" : "Life... is like a grapefruit."
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Lauds",
      "text" : "It's orange and squishy, and has a few pips in it, and some folks have half a one for breakfast."
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Lauds",
      "text" : "There was a point to this story, but it has temporarily escaped the chronicler's mind."
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Lauds",
      "text" : "42!"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Lauds",
      "text" : "[Mad Sago Lauds]"
    },
    {
      "kind" : "message",
      "line" : 190,
      "npc" : "Lauds",
      "text" : "It is a mistake to think you can solve any major problems just with potatoes."
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Memorial Plaque",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Memorial Plaque",
      "text" : "- It's a dusty old plaque.-"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Memorial Plaque",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Memorial Plaque",
      "text" : "- It's a dusty old plaque.-"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Memorial Plaque",
      "text" : "'This must be what Lauds was talking about.'"
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Memorial Plaque",
      "text" : "'Let's dust it off with the towel.'"
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "Memorial Plaque",
      "text" : "- You see a message from the cleaned plaque.-"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Memorial Plaque",
      "text" : "-Although no sculptured marble should rise to their memory,-"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Memorial Plaque",
      "text" : "-nor engraved stone bear record of their deeds,-"
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Memorial Plaque",
      "text" : "-yet will their remembrance be as lasting as the land they honored.-"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Memorial Plaque",
      "text" : "-Daniel Webster-"
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Memorial Plaque",
      "text" : "-There's another message.-"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Memorial Plaque",
      "text" : "-I may not have gone where I intended to go,-"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Memorial Plaque",
      "text" : "-but I think I have ended up where I needed to be.-"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Memorial Plaque",
      "text" : "- Douglas Adams.-"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Memorial Plaque",
      "text" : "-This is the last message.-"
    },
    {
      "kind" : "message",
      "line" : 242,
      "npc" : "Memorial Plaque",
      "text" : "-True heroism is remarkably sober, very undramatic.-"
    },
    {
      "kind" : "message",
      "line" : 243,
      "npc" : "Memorial Plaque",
      "text" : "-It is not the urge to surpass all others at whatever cost,-"
    },
    {
      "kind" : "message",
      "line" : 244,
      "npc" : "Memorial Plaque",
      "text" : "- but the urge to serve others at whatever cost. -"
    },
    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Memorial Plaque",
      "text" : "- Arthur Ashe -"
    },
    {
      "kind" : "message",
      "line" : 257,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 258,
      "npc" : "Grast",
      "text" : "Memorial Day is a sad and yet glorious day."
    },
    {
      "kind" : "message",
      "line" : 259,
      "npc" : "Grast",
      "text" : "I wonder how many people remember them..."
    },
    {
      "kind" : "message",
      "line" : 264,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "Grast",
      "text" : "Oh, isn't that a Towel of Memory?"
    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Grast",
      "text" : "I'm so glad to meet someone who understands the meaning of Memorial Day."
    },
    {
      "kind" : "message",
      "line" : 268,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 269,
      "npc" : "Grast",
      "text" : "It is very important to know what we're celebrating today, don't you think?"
    },
    {
      "kind" : "message",
      "line" : 271,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 272,
      "npc" : "Grast",
      "text" : "If you like to go on a journey to pay a tribute to Memorial Day, you should bring me some materials I ask."
    },
    {
      "kind" : "message",
      "line" : 274,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 275,
      "npc" : "Grast",
      "text" : "Please bring me ^FF0000one of each Red Potion, Green Potion, Awakening Potion, and Butterfly Wing^000000."
    },
    {
      "kind" : "message",
      "line" : 276,
      "npc" : "Grast",
      "text" : "I'll be waiting for your return."
    },
    {
      "kind" : "message",
      "line" : 283,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 284,
      "npc" : "Grast",
      "text" : "Oops, you haven't brought all materials."
    },
    {
      "kind" : "message",
      "line" : 285,
      "npc" : "Grast",
      "text" : "Please make sure you need to bring me"
    },
    {
      "kind" : "message",
      "line" : 286,
      "npc" : "Grast",
      "text" : "^FF0000one of each Red Potion, Green Potion, Awakening Potion, and Butteryfly Wing^000000."
    },
    {
      "kind" : "message",
      "line" : 288,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 289,
      "npc" : "Grast",
      "text" : "You'll have to bring me more materials afterwards."
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Grast",
      "text" : "If you feel too burdened to gather them all,"
    },
    {
      "kind" : "message",
      "line" : 291,
      "npc" : "Grast",
      "text" : "I can provide you all the materials."
    },
    {
      "kind" : "option",
      "line" : 293,
      "npc" : "Grast",
      "text" : "I'll gather the rest."
    },
    {
      "kind" : "option",
      "line" : 293,
      "npc" : "Grast",
      "text" : "Give me the materials."
    },
    {
      "kind" : "message",
      "line" : 298,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 299,
      "npc" : "Grast",
      "text" : "Oh, you've brought the materials I asked."
    },
    {
      "kind" : "message",
      "line" : 301,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
      "line" : 302,
      "npc" : "Grast",
      "text" : "Hmm, you will need some more things still..."
    },
    {
      "kind" : "message",
      "line" : 304,
      "npc" : "Grast",
      "text" : "[Grast]"
    },
    {
      "kind" : "message",
