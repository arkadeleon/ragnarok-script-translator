      "npc" : "cute_pet_manager",
      "placeholders" : [
        "getmonsterinfo(.@mob_id, MOB_NAME)"
      ],
      "text" : "^FF0000{0}^000000 monsters."
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "cute_pet_manager",
      "placeholders" : [
        ".@hunt_amount",
        "getitemname(.@hunt_id)",
        "(.@hunt_id2 ? \", ^FF0000\" + .@hunt_amount2 + \" \" + getitemname(.@hunt_id2) : \"\")"
      ],
      "text" : "Bring ^FF0000{0} {1}^000000{2} ^000000 and ^FF00001 Dolly Capsule^000000"
    },
    {
      "kind" : "message",
      "line" : 222,
      "npc" : "cute_pet_manager",
      "text" : "then you can exchange them"
    },
    {
