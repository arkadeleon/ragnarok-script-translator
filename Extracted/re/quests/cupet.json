    {
      "kind" : "message",
      "line" : 123,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "cute_pet_manager",
      "text" : "Hello~! I am a Cute Pet Manager"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "cute_pet_manager",
      "text" : "who is in charge of public relations"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "cute_pet_manager",
      "text" : "for the New Upgraded Cute Pet system."
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "cute_pet_manager",
      "text" : "If you have any concerns regarding"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "cute_pet_manager",
      "text" : "the Cute Pet system I am here to guide you."
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "cute_pet_manager",
      "text" : "Let me know which taming"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "cute_pet_manager",
      "text" : "item you want,"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "cute_pet_manager",
      "text" : "then I will tell you the monster"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "cute_pet_manager",
      "text" : "that you can tame with the item."
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "cute_pet_manager",
      "text" : "Also I will explain what materials"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "cute_pet_manager",
      "text" : "you need to bring in order to"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "cute_pet_manager",
      "text" : "get the taming item."
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "cute_pet_manager",
      "text" : "If you already brought materials"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "cute_pet_manager",
      "text" : "to exchange for the taming item,"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "cute_pet_manager",
      "text" : "I can exchange it for taming items immediately."
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "cute_pet_manager",
      "text" : "However, there is a limit"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "cute_pet_manager",
      "text" : "for exchanging taming items."
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "cute_pet_manager",
      "text" : "You can only get taming items"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "cute_pet_manager",
      "placeholders" : [
        "getarg(6)"
      ],
      "text" : "{0} times. So please make sure"
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "cute_pet_manager",
      "text" : "how many times you have exchanged."
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "cute_pet_manager",
      "text" : "So, which taming item do you want?"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "cute_pet_manager",
      "text" : "Please choose one from the list."
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "cute_pet_manager",
      "text" : "Ah, you have gathered all items"
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "cute_pet_manager",
      "text" : "with your friends. You can now"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "cute_pet_manager",
      "placeholders" : [
        "getitemname(.@tame_id)"
      ],
      "text" : "exchange for an {0}."
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "cute_pet_manager",
      "text" : "Do you want to exchange with me?"
    },
    {
      "kind" : "option",
      "line" : 198,
      "npc" : "cute_pet_manager",
      "text" : "Exchange"
    },
    {
      "kind" : "option",
      "line" : 198,
      "npc" : "cute_pet_manager",
      "text" : "Don't Exchange"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "cute_pet_manager",
      "text" : "You don't? You will come back again."
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "cute_pet_manager",
      "text" : "Wise choice."
    },
    {
      "kind" : "message",
      "line" : 212,
      "npc" : "cute_pet_manager",
      "text" : "I hope you and your pet get along."
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "cute_pet_manager",
      "text" : "[Cute Pet Manager]"
    },
    {
      "kind" : "message",
      "line" : 216,
      "npc" : "cute_pet_manager",
      "placeholders" : [
        "getitemname(.@tame_id)"
      ],
      "text" : "You have chosen {0}."
    },
    {
      "kind" : "message",
      "line" : 217,
      "npc" : "cute_pet_manager",
      "text" : "You can use it for taming"
    },
    {
      "kind" : "message",
