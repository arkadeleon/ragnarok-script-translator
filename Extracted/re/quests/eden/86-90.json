  "scripts" : [
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "86-90 Mission Board",
      "text" : "Wait a minute!"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "86-90 Mission Board",
      "text" : "-You need to have an-"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "86-90 Mission Board",
      "text" : "-^4d4dff'Eden Group Mark'^000000-"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "86-90 Mission Board",
      "text" : "-to receive these missions.-"
    },
    {
      "kind" : "option",
      "line" : 27,
      "npc" : "86-90 Mission Board",
      "text" : "Just walk away."
    },
    {
      "kind" : "option",
      "line" : 27,
      "npc" : "86-90 Mission Board",
      "text" : "^0000FFEden Group^000000 missions?"
    },
    {
      "kind" : "option",
      "line" : 27,
      "npc" : "86-90 Mission Board",
      "text" : "How can I be a member of the ^0000FFEden Group^000000?"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "86-90 Mission Board",
      "text" : "::The Eden Group Missions"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "86-90 Mission Board",
      "text" : "::are basically missions"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "86-90 Mission Board",
      "text" : "::requested by"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "86-90 Mission Board",
      "text" : "::people from all around the kingdom."
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "86-90 Mission Board",
      "text" : "::We just categorize them."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "86-90 Mission Board",
      "text" : "::In the Eden Group,"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "86-90 Mission Board",
      "text" : "::we sorted out the missions"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "86-90 Mission Board",
      "text" : "::according to the level of difficulty."
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "86-90 Mission Board",
      "text" : "::According to this level,"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "86-90 Mission Board",
      "text" : "::you can find"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "86-90 Mission Board",
      "text" : "::missions that"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "86-90 Mission Board",
      "text" : "::suit you."
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "86-90 Mission Board",
      "text" : "::When you are done,"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "86-90 Mission Board",
      "text" : "::you can come back"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "86-90 Mission Board",
      "text" : "::to the mission board."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "86-90 Mission Board",
      "text" : "::Then you will be"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "86-90 Mission Board",
      "text" : "::rewarded!!"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "86-90 Mission Board",
      "text" : "::Simple, isn't it!!"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "86-90 Mission Board",
      "text" : "::No commission required!!"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "86-90 Mission Board",
      "text" : "::You can become a member"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "86-90 Mission Board",
      "text" : "::of the Eden Group"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "86-90 Mission Board",
      "text" : "::to ^0000FFLaime Evenor^000000,"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "86-90 Mission Board",
      "text" : "::who is waiting on the 1st floor."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "86-90 Mission Board",
      "text" : "::If you become a member,"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "86-90 Mission Board",
      "text" : "::you will get an"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "86-90 Mission Board",
      "text" : "::\"^006400Eden Group Mark^000000\"."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "86-90 Mission Board",
      "text" : "::Then you will be able"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "86-90 Mission Board",
      "text" : "::to see the mission board."
    },
    {
      "kind" : "message",
      "line" : 81,
