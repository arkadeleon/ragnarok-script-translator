{
  "file" : "npc/re/quests/woe_te/te_goditem_alde1.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 12,
      "npc" : "Blacksmith Cano",
      "text" : "You have too many items to proceed with the quest."
    },
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "Blacksmith Cano",
      "text" : "Please lighten your load and try again."
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Blacksmith Cano",
      "text" : "You... don't look familiar to me... ?"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Blacksmith Cano",
      "text" : "Are you going to threaten me?"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Blacksmith Cano",
      "text" : "No, right?"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Blacksmith Cano",
      "text" : "I have my reasons."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Blacksmith Cano",
      "text" : "Please, pretend not to see me."
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Blacksmith Cano",
      "text" : "From now on, I'll stay here quietly and not interrupt anyone until the siege ends."
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Blacksmith Cano",
      "text" : "Don't worry about me."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Blacksmith Cano",
      "text" : "I feel so grateful all the time about you letting me stay here."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Blacksmith Cano",
      "text" : "It's nothing special... but if you want, I'll make you tools that could be of use."
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Blacksmith Cano",
      "text" : "I mean if the guild master wants it."
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Blacksmith Cano",
      "text" : "I'm also a master who pursues the ultimate way."
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Blacksmith Cano",
      "text" : "I hope I can find that way here."
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Blacksmith Cano",
      "text" : "Ah... Master."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Blacksmith Cano",
      "text" : "I feel so thankful all the time."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Blacksmith Cano",
      "text" : "Since I owe you big time, I'll help you with anything anytime."
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Blacksmith Cano",
      "text" : "Make Jormungand."
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Blacksmith Cano",
      "text" : "Fuse materials."
    },
    {
      "kind" : "option",
      "line" : 51,
      "npc" : "Blacksmith Cano",
      "text" : "Relax."
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Blacksmith Cano",
      "text" : "^ff0000Wizardry staff is needed in the process of making Jormungand."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Blacksmith Cano",
      "text" : "You should not possess any other items except for Wizardry Staffs in order to proceed with the quest.^ff0000"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Blacksmith Cano",
      "text" : "^ff0000Even if the refinement level and cards have been applied, the process requires any one of the Wizardry Staffs you may have."
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Blacksmith Cano",
      "text" : "Please try again after organizing your possessions.^000000"
    },
    {
      "kind" : "option",
      "line" : 61,
      "npc" : "Blacksmith Cano",
      "text" : "Organize possessions."
    },
    {
      "kind" : "option",
      "line" : 61,
      "npc" : "Blacksmith Cano",
      "text" : "Continue as it is."
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Blacksmith Cano",
      "text" : "You've decided to keep Wizardry Staffs only."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Blacksmith Cano",
      "text" : "I see that you've developed the fortress as you promised."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Blacksmith Cano",
      "text" : "Moreover, you've found Twilight of Trail..."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Blacksmith Cano",
      "text" : "... so..let's get the work done."
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Blacksmith Cano",
      "text" : "Before the girls find us..."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Blacksmith Cano",
      "text" : "The girls... ?"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Blacksmith Cano",
      "text" : "... yeah, there were some girls.."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Blacksmith Cano",
      "text" : "I had to run away because of them..."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Blacksmith Cano",
      "text" : "Oh, no... !"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Blacksmith Cano",
      "text" : "They're here..!!"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Blacksmith Cano",
      "text" : "Leave it to me."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Blacksmith Cano",
      "text" : "^4d4dff!- Instruction -!"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "Soon, 7 girls that are after {0} will try to invade the fortress."
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "You have to protect {0} for 1 hour.^000000"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Blacksmith Cano",
      "text" : "^4d4dff!- Instruction -!"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Blacksmith Cano",
      "text" : "When the actual attack starts, the doorway of Emperium region will be blocked up for protection.^000000"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Blacksmith Cano",
      "text" : "Jormungand is a staff that is modeled on Jormungand, the son of god who embraces the world."
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Blacksmith Cano",
      "text" : "It also refers to Ragnarok, the twilight of the gods."
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Blacksmith Cano",
      "text" : "But, here we have items that symbolize the twilight of the gods..."
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Blacksmith Cano",
      "text" : "and I can't believe I'm going to use them to make Jormungand myself... with my own hands!"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Blacksmith Cano",
      "text" : "However, it seems like we need more materials."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Blacksmith Cano",
      "text" : "Could you check again? I'll give you the list of what we need."
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Blacksmith Cano",
      "text" : "However, would it be okay if I said something?"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Blacksmith Cano",
      "text" : "Jormungand is one of the most powerful battlegears I make and you deserve to receive something like that from me..."
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Blacksmith Cano",
      "text" : "but I would like you to have the minimum qualification at least."
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Blacksmith Cano",
      "text" : "Manage this fortress well and raise ^4d4dffits commerce level by 30 or more^000000."
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Blacksmith Cano",
      "text" : "With great power comes great responsibility and duty."
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Blacksmith Cano",
      "text" : "I would like you to master the basics first."
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Blacksmith Cano",
      "text" : "I'll make Jormungand afterward."
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Blacksmith Cano",
      "text" : "Let me give you the list of materials if you want."
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Blacksmith Cano",
      "text" : "That is so nice of you to say that."
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Blacksmith Cano",
      "text" : "By the way, I wonder how my older brother Kai is doing?"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Blacksmith Cano",
      "text" : "I'm sure he's doing fine just like I am."
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Blacksmith Cano",
      "text" : "... I hope things stay as peaceful as they are now."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Blacksmith Cano",
      "text" : "Did you hear the news?"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Blacksmith Cano",
      "text" : "The girls are coming."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Blacksmith Cano",
      "text" : "The merciless girls!!!"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Blacksmith Cano",
      "text" : "They'll get here any minute since they've declared war already."
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Blacksmith Cano",
      "text" : "I'm sure they're coming to get Jormungand."
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Blacksmith Cano",
      "text" : "Stop them. Please!"
    },
    {
      "kind" : "option",
      "line" : 151,
      "npc" : "Blacksmith Cano",
      "text" : "Leave it to me."
    },
    {
      "kind" : "option",
      "line" : 151,
      "npc" : "Blacksmith Cano",
      "text" : "What do you mean 'the girls?'"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Blacksmith Cano",
      "text" : "Thank you..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Blacksmith Cano",
      "text" : "I'm sorry that I'm causing you troubles, but my hands are tied."
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Blacksmith Cano",
      "text" : "Please, stop them for me!"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Blacksmith Cano",
      "text" : "... They are the girls who want to be Valkyries..."
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Blacksmith Cano",
      "text" : "and they always go around in groups of seven."
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Blacksmith Cano",
      "text" : "What they want is a powerful battlegear..."
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Blacksmith Cano",
      "text" : "They always threatened my older brother Kai and me."
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Blacksmith Cano",
      "text" : "They were satisfied with basic weapons at first, but"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Blacksmith Cano",
      "text" : "soon they started threatening us saying that they need something more powerful in order to become Valkyries."
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Blacksmith Cano",
      "text" : "I couldn't stand it, so I ran away... but they're here..."
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Blacksmith Cano",
      "text" : "You have to be careful since they found out that materials for Jormungand are here."
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Blacksmith Cano",
      "text" : "Ah stop following me around!"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Blacksmith Cano",
      "text" : "If you could just get rid of them... Jormungand, that's right! I'll make you Jormungand!"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Blacksmith Cano",
      "text" : "When will they ever stop following me..."
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Blacksmith Cano",
      "text" : "Now I'm scared of girls in general... and I'm too scared to do anything..."
    },
    {
      "kind" : "message",
      "line" : 187,
      "npc" : "Blacksmith Cano",
      "text" : "He's babbling now."
    },
    {
      "kind" : "message",
      "line" : 188,
      "npc" : "Blacksmith Cano",
      "text" : "Just wait and he'll calm down."
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Blacksmith Cano",
      "text" : "You have to get rid of those girls first."
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "Blacksmith Cano",
      "text" : "... Although I managed to escape from them again..."
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Blacksmith Cano",
      "text" : "it's hard."
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Blacksmith Cano",
      "text" : "life is... just so hard."
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Blacksmith Cano",
      "placeholders" : [
        ".@npc_name$"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Blacksmith Cano",
      "text" : "I'm so exhausted that I can't do anything."
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Blacksmith Cano",
      "text" : "... I don't think I can do anything for a while, whether it's producing or smithing or whatever it is."
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Blacksmith Cano",
      "text" : "I'm sorry. I'll take a break."
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Blacksmith Cano",
      "text" : "I can finally breathe now."
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Blacksmith Cano",
      "text" : "I'll start making Jormungand as promised."
    },
    {
      "kind" : "option",
      "line" : 207,
      "npc" : "Blacksmith Cano",
      "text" : "Make Jormungand."
    },
    {
      "kind" : "option",
      "line" : 207,
      "npc" : "Blacksmith Cano",
      "text" : "Fuse materials."
    },
    {
      "kind" : "option",
      "line" : 207,
      "npc" : "Blacksmith Cano",
      "text" : "Not now."
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Blacksmith Cano",
      "text" : "^ff0000Wizardry staff is needed in the process of making Jormungand."
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Blacksmith Cano",
