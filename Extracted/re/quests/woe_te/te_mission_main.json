    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Training_Instructor_TE",
      "text" : "Hey now, since this place is just for primary and secondary job classes as well as users without expanded levels, could you leave if you got nothing else to do here?"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Training_Instructor_TE",
      "text" : "There are missions you can complete in TE region."
