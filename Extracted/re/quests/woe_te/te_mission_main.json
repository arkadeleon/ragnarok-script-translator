      "kind" : "message",
      "line" : 178,
      "npc" : "Training_Instructor_TE",
      "text" : "Mm, I'm sorry but missions are for users with ^4d4dff70 level^000000 or higher."
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Training_Instructor_TE",
      "text" : "Honestly, it's hard to complete a mission if your level is too low."
    },
