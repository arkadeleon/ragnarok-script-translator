    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Reno",
      "text" : "[Reno]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Reno",
      "text" : "The Research Team decided to collect Energy Crystals by giving requests to adventurers, with appropriate rewards. That enables us to collect better and be more ^FF0000efficient^000000."
