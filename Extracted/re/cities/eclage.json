    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Injured Laphine",
      "text" : "[Doctor]\nYou're at a clinic. Don't worry.\nWe stopped the bleeding and cast emergency spells.\nYou were bleeding a lot. That was close, you know."
    },
