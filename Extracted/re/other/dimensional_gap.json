{
  "file" : "npc/re/other/dimensional_gap.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 10,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 11,
      "npc" : "Expedition Guide",
      "text" : "Are you going to enter the ^0000FFDimensional Gap^000000?  Please use this Transport Device you see here."
    },
    {
      "kind" : "option",
      "line" : 13,
      "npc" : "Expedition Guide",
      "text" : "What is the Dimensional Gap?"
    },
    {
      "kind" : "option",
      "line" : 13,
      "npc" : "Expedition Guide",
      "text" : "End Conversation."
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Expedition Guide",
      "text" : "As you know we've already entered through the Dimensional Rift to get to Ash Vacuum right?  The Dimensional Gap is an expansion of that initial discovery."
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Expedition Guide",
      "text" : "A member of the Expedition team found these backdoor passages to get through the Dimensional Rifts."
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Expedition Guide",
      "text" : "This is like a Midgard Alliance version of the Bifrost bridge so it can connect us to different parts of the New World."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Expedition Guide",
      "text" : "Time and space is distorted in the Dimensional Gap.  Not all passageways have been discovered so please be sure to use caution when entering an unverified area."
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Expedition Guide",
      "text" : "Anyone who has become lost here has yet to return."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Expedition Guide",
      "text" : "Take care."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Expedition Guide",
      "text" : "[Expedition Guide]"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Expedition Guide",
      "text" : "Please use a ^0000FFTransport Device^000000 if you wish to travel through the dimensional rift.  The insides have not been fully explored yet so please be careful in there."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Allied Forces Soldier",
      "text" : "[Allied Forces Soldier]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Allied Forces Soldier",
      "text" : "This dimensional rift is connected to the Allied Forces ^0000FFExpedition Camp^000000 in Jotunheim."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Allied Forces Soldier",
      "text" : "[Allied Forces Soldier]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Allied Forces Soldier",
      "text" : "Do not worry, it has been set up after testing hundreds of experiments for safe teleportation."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Morocc Soldier",
      "text" : "[Morocc Soldier]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Morocc Soldier",
      "text" : "This dimensional rift is connected to ^0000FFMorocc^000000 back in Midgard."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Morocc Soldier",
      "text" : "[Morocc Soldier]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Morocc Soldier",
      "text" : "This is the fastest gateway back to our world.  The area is still destroyed but restoration efforts will soon be on the way."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Spledide Soldier",
      "text" : "[Spledide Soldier]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Spledide Soldier",
      "text" : "This dimensional rift is connected to the south of ^0000FFBifrost^000000.  It enables quick travel to the Splendide frontline."
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Spledide Soldier",
      "text" : "[Spledide Soldier]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Spledide Soldier",
      "text" : "If we use it properly, it enables us to advance more easily to the capital of the Sapha."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Spledide Soldier",
      "text" : "[Spledide Soldier]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Spledide Soldier",
      "text" : "The Mayor has asked us to cooperate as best we can instead of fighting, so I'm under orders not to do anything.  Since we have a common enemy we won't fight the Sapha... for now..."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Dispatched Sapha",
      "text" : "[Dispatched Sapha]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Dispatched Sapha",
      "text" : "This dimensional rift is connected to the southern area of the ^0000FFKamidal Mountains^000000 in El Dicastes.  I just dropped by for my research, but it is incredible."
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Dispatched Sapha",
      "text" : "[Dispatched Sapha]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Dispatched Sapha",
      "text" : "Moreover it is next to the Laphine capital..... Hmm... Do not worry, I do not want to fight in such a place."
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Logistics Manager",
      "text" : "[Logistics Manager]"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Logistics Manager",
      "text" : "Welcome.  I am in charge of logistics to take care of your items in this weird place.  Do you need to access your storage?"
    },
    {
      "kind" : "option",
      "line" : 95,
      "npc" : "Logistics Manager",
      "text" : "Open Storage 200 Zeny."
    },
    {
      "kind" : "option",
      "line" : 95,
      "npc" : "Logistics Manager",
      "text" : "No Thanks."
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Logistics Manager",
      "text" : "[Logistics Manager]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Logistics Manager",
      "text" : "You are not yet qualified to use the Storage."
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Logistics Manager",
      "text" : "[Logistics Manager]"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Logistics Manager",
      "text" : "You need at least 200 zeny to use the Storage."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Logistics Manager",
      "text" : "[Logistics Manager]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Logistics Manager",
      "text" : "Let me know if you change your mind."
    },
    {
      "kind" : "message",
      "line" : 286,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 287,
      "npc" : "Merchant Prince",
      "text" : "Who're you?"
    },
    {
      "kind" : "message",
      "line" : 289,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Merchant Prince",
      "text" : "What do you want?"
    },
    {
      "kind" : "message",
      "line" : 291,
      "npc" : "Merchant Prince",
      "text" : "You looking something in"
    },
    {
      "kind" : "message",
      "line" : 292,
      "npc" : "Merchant Prince",
      "text" : "particular?"
    },
    {
      "kind" : "message",
      "line" : 294,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 295,
      "npc" : "Merchant Prince",
      "text" : "So some enforcers have been"
    },
    {
      "kind" : "message",
      "line" : 296,
      "npc" : "Merchant Prince",
      "text" : "cracking down on merchants lately."
    },
    {
      "kind" : "message",
      "line" : 297,
      "npc" : "Merchant Prince",
      "text" : "I can not sell anything."
    },
    {
      "kind" : "message",
      "line" : 299,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 300,
      "npc" : "Merchant Prince",
      "text" : "Come here..."
    },
    {
      "kind" : "message",
      "line" : 302,
      "npc" : "Merchant Prince",
      "text" : "[Jumpy Knight]"
    },
    {
      "kind" : "message",
      "line" : 303,
      "npc" : "Merchant Prince",
      "text" : "I knew you would be here!!"
    },
    {
      "kind" : "message",
      "line" : 304,
      "npc" : "Merchant Prince",
      "text" : "No illegal trading is allowed"
    },
    {
      "kind" : "message",
      "line" : 305,
      "npc" : "Merchant Prince",
      "text" : "here!"
    },
    {
      "kind" : "message",
      "line" : 306,
      "npc" : "Merchant Prince",
      "text" : "Don't you know?"
    },
    {
      "kind" : "message",
      "line" : 309,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 310,
      "npc" : "Merchant Prince",
      "text" : "Says who?"
    },
    {
      "kind" : "message",
      "line" : 312,
      "npc" : "Merchant Prince",
      "text" : "[Jumpy Knight]"
    },
    {
      "kind" : "message",
      "line" : 313,
      "npc" : "Merchant Prince",
      "text" : "Ok, then show me your permit."
    },
    {
      "kind" : "message",
      "line" : 315,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 316,
      "npc" : "Merchant Prince",
      "text" : "Permit?"
    },
    {
      "kind" : "message",
      "line" : 317,
      "npc" : "Merchant Prince",
      "text" : "No one's in charge here!"
    },
    {
      "kind" : "message",
      "line" : 319,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 320,
      "npc" : "Merchant Prince",
      "text" : "You! If you need anything come to"
    },
    {
      "kind" : "message",
      "line" : 321,
      "npc" : "Merchant Prince",
      "text" : "me ok?"
    },
    {
      "kind" : "message",
      "line" : 323,
      "npc" : "Merchant Prince",
      "text" : "[Jumpy Knight]"
    },
    {
      "kind" : "message",
      "line" : 324,
      "npc" : "Merchant Prince",
      "text" : "I will catch you!"
    },
    {
      "kind" : "message",
      "line" : 333,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 334,
      "npc" : "Merchant Prince",
      "text" : "Cold juice!"
    },
    {
      "kind" : "message",
      "line" : 335,
      "npc" : "Merchant Prince",
      "text" : "Apple, grape, orange~"
    },
    {
      "kind" : "message",
      "line" : 336,
      "npc" : "Merchant Prince",
      "text" : "Anything you want!"
    },
    {
      "kind" : "message",
      "line" : 338,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 339,
      "npc" : "Merchant Prince",
      "text" : "Sweet potato, dumpling~"
    },
    {
      "kind" : "message",
      "line" : 340,
      "npc" : "Merchant Prince",
      "text" : "Here we have delicious desserts~"
    },
    {
      "kind" : "message",
      "line" : 352,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 353,
      "npc" : "Merchant Prince",
      "text" : "You need to pay a toll to get past here."
    },
    {
      "kind" : "option",
      "line" : 355,
      "npc" : "Merchant Prince",
      "text" : "What toll?"
    },
    {
      "kind" : "message",
      "line" : 358,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 359,
      "npc" : "Merchant Prince",
      "text" : "You did not know?"
    },
    {
      "kind" : "message",
      "line" : 360,
      "npc" : "Merchant Prince",
      "text" : "500 zeny"
    },
    {
      "kind" : "message",
      "line" : 362,
      "npc" : "Merchant Prince",
      "text" : "[Jumpy Knight]"
    },
    {
      "kind" : "message",
      "line" : 363,
      "npc" : "Merchant Prince",
      "text" : "You there!"
    },
    {
      "kind" : "message",
      "line" : 364,
      "npc" : "Merchant Prince",
      "text" : "Stop right there!"
    },
    {
      "kind" : "message",
      "line" : 367,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 368,
      "npc" : "Merchant Prince",
      "text" : "Ugh! How are you always following me?"
    },
    {
      "kind" : "message",
      "line" : 369,
      "npc" : "Merchant Prince",
      "text" : "Got some kind of crush on me or something? I don't think you and I make a good match..."
    },
    {
      "kind" : "message",
      "line" : 371,
      "npc" : "Merchant Prince",
      "text" : "[Jumpy Knight]"
    },
    {
      "kind" : "message",
      "line" : 372,
      "npc" : "Merchant Prince",
      "text" : "Why don't we find out then?"
    },
    {
      "kind" : "message",
      "line" : 374,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 375,
      "npc" : "Merchant Prince",
      "text" : "That's it no more talking."
    },
    {
      "kind" : "message",
      "line" : 376,
      "npc" : "Merchant Prince",
      "text" : "I'm outta here~"
    },
    {
      "kind" : "message",
      "line" : 378,
      "npc" : "Merchant Prince",
      "text" : "[Jumpy Knight]"
    },
    {
      "kind" : "message",
      "line" : 379,
      "npc" : "Merchant Prince",
      "text" : "Keep running you sneaky coward!"
    },
    {
      "kind" : "message",
      "line" : 391,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 392,
      "npc" : "Merchant Prince",
      "text" : "500 zeny"
    },
    {
      "kind" : "message",
      "line" : 404,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 405,
      "npc" : "Merchant Prince",
      "text" : "You are lucky that you have met up"
    },
    {
      "kind" : "message",
      "line" : 406,
      "npc" : "Merchant Prince",
      "text" : "with me."
    },
    {
      "kind" : "message",
      "line" : 407,
      "npc" : "Merchant Prince",
      "text" : "Who am I?"
    },
    {
      "kind" : "message",
      "line" : 408,
      "npc" : "Merchant Prince",
      "text" : "I'm here to become a merchant"
    },
    {
      "kind" : "message",
      "line" : 409,
      "npc" : "Merchant Prince",
      "text" : "King."
    },
    {
      "kind" : "message",
      "line" : 411,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 412,
      "npc" : "Merchant Prince",
      "text" : "I might be working a street stall"
    },
    {
      "kind" : "message",
      "line" : 413,
      "npc" : "Merchant Prince",
      "text" : "now but I'll have an actual shop"
    },
    {
      "kind" : "message",
      "line" : 414,
      "npc" : "Merchant Prince",
      "text" : "some day."
    },
    {
      "kind" : "message",
      "line" : 416,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 417,
      "npc" : "Merchant Prince",
      "text" : "It's my first day so I'm having a"
    },
    {
      "kind" : "message",
      "line" : 418,
      "npc" : "Merchant Prince",
      "text" : "major sale."
    },
    {
      "kind" : "message",
      "line" : 420,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 421,
      "npc" : "Merchant Prince",
      "text" : "Let's see I've got a..."
    },
    {
      "kind" : "message",
      "line" : 422,
      "npc" : "Merchant Prince",
      "text" : "Ring of something!"
    },
    {
      "kind" : "message",
      "line" : 423,
      "npc" : "Merchant Prince",
      "text" : "Sword of stuff!"
    },
    {
      "kind" : "message",
      "line" : 424,
      "npc" : "Merchant Prince",
      "text" : "A backpack of some sort!"
    },
    {
      "kind" : "message",
      "line" : 426,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 427,
      "npc" : "Merchant Prince",
      "text" : "Tell me if you need anything,"
    },
    {
      "kind" : "message",
      "line" : 430,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 431,
      "npc" : "Merchant Prince",
      "text" : "What are you doing here?"
    },
    {
      "kind" : "message",
      "line" : 432,
      "npc" : "Merchant Prince",
      "text" : "This is my spot for a shop"
    },
    {
      "kind" : "message",
      "line" : 433,
      "npc" : "Merchant Prince",
      "text" : "Get outta my turf!"
    },
    {
      "kind" : "message",
      "line" : 435,
      "npc" : "Merchant Prince",
      "text" : "[Jumpy Knight]"
    },
    {
      "kind" : "message",
      "line" : 436,
      "npc" : "Merchant Prince",
      "text" : "Bah!!"
    },
    {
      "kind" : "message",
      "line" : 437,
      "npc" : "Merchant Prince",
      "text" : "You're gonna regret those words!"
    },
    {
      "kind" : "message",
      "line" : 439,
      "npc" : "Merchant Prince",
      "text" : "[Prince Canet]"
    },
    {
      "kind" : "message",
      "line" : 440,
      "npc" : "Merchant Prince",
      "text" : "I'm shaking..."
    },
    {
      "kind" : "message",
      "line" : 461,
      "npc" : "Curious Knight",
      "text" : "[Curious Knight]"
    },
    {
      "kind" : "message",
      "line" : 462,
      "npc" : "Curious Knight",
      "text" : "The Royal Guard in here"
    },
    {
      "kind" : "message",
      "line" : 463,
      "npc" : "Curious Knight",
      "text" : "was desperate for help."
    },
    {
      "kind" : "message",
      "line" : 464,
      "npc" : "Curious Knight",
      "text" : "We entered through a secret place"
    },
    {
      "kind" : "message",
      "line" : 465,
      "npc" : "Curious Knight",
      "text" : "in the palace."
    },
    {
      "kind" : "message",
      "line" : 467,
      "npc" : "Curious Knight",
      "text" : "[Curious Knight]"
    },
    {
      "kind" : "message",
      "line" : 468,
      "npc" : "Curious Knight",
      "text" : "We were whisked away here..."
    },
    {
      "kind" : "message",
      "line" : 469,
      "npc" : "Curious Knight",
      "text" : "No idea where I am but I have to"
    },
    {
      "kind" : "message",
      "line" : 470,
      "npc" : "Curious Knight",
      "text" : "establish a base here for the"
    },
    {
      "kind" : "message",
      "line" : 471,
      "npc" : "Curious Knight",
      "text" : "Knighthood."
    },
    {
      "kind" : "message",
      "line" : 475,
      "npc" : "Confused Thief",
      "text" : "[Confused Thief]"
    },
    {
      "kind" : "message",
      "line" : 476,
      "npc" : "Confused Thief",
      "text" : "One minute I'm in a bar..."
    },
    {
      "kind" : "message",
