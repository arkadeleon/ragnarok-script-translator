    {
      "kind" : "message",
      "line" : 578,
      "npc" : "Shaam Rumi",
      "text" : "[Shaam Rumi]"
    },
    {
      "kind" : "message",
      "line" : 579,
      "npc" : "Shaam Rumi",
      "text" : "Welcome to the ^3131FFCrossbow Clan^000000!"
    },
    {
      "kind" : "message",
      "line" : 582,
      "npc" : "Shaam Rumi",
      "text" : "[Shaam Rumi]"
    },
    {
      "kind" : "message",
      "line" : 583,
      "npc" : "Shaam Rumi",
      "text" : "You can review Clan info with ^3131FFCtrl+G^000000."
    },
    {
      "kind" : "message",
      "line" : 585,
      "npc" : "Shaam Rumi",
      "text" : "[Shaam Rumi]"
