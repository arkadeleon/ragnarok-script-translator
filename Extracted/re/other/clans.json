      "kind" : "message",
      "line" : 200,
      "npc" : "Devon Aire",
      "text" : "[Devon Aire]"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Devon Aire",
      "text" : "Most members are offensive Mage classes as the name ^3131FFArc Wand Clan^000000 suggests, but that's no requirement."
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Devon Aire",
      "text" : "[Devon Aire]"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Devon Aire",
      "text" : "...Hey, Shaam Rumi."
