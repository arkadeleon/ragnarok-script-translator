    {
      "kind" : "message",
      "line" : 593,
      "npc" : "Shaam Rumi",
      "text" : "All right then. I'm just going to go have some fun."
    },
    {
      "kind" : "message",
      "line" : 596,
      "npc" : "Shaam Rumi",
      "text" : "[Shaam Rumi]"
    },
    {
      "kind" : "message",
      "line" : 597,
      "npc" : "Shaam Rumi",
      "text" : "Ah, do you need time to think about this? No problem."
