      "text" : "A question?"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Raffam Oranpere",
      "text" : "Excited to join me? Hahah!"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Raffam Oranpere",
      "text" : "Oh, you'll join? Good choice!"
