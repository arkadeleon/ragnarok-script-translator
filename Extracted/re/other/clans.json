    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Devon Aire",
      "text" : "Get over me, Devon! Don't spread rumors!"
    },
    {
      "kind" : "message",
      "line" : 222,
      "npc" : "Devon Aire",
      "text" : "[Berman Aire]"
    },
    {
      "kind" : "message",
      "line" : 223,
