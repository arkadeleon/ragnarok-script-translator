      "npc" : "Clan Helper",
      "text" : "[Clan Helper]"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "Clan Helper",
      "text" : "Do you want to build connections without being in a guild?"
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Clan Helper",
      "text" : "[Clan Helper]"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Clan Helper",
      "text" : "Can't find the perfect guild for yourself?"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Clan Helper",
      "text" : "[Clan Helper]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Clan Helper",
      "text" : "You can join or leave clans freely! Just join!"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Clan Helper",
      "text" : "[Clan Helper]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Clan Helper",
      "text" : "Now, come on in and meet the masters of the Kingdom's best clans!"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Raffam Oranpere",
      "text" : "Hi! I'm Raffam, master of the ^3131FFSword Clan^000000 in the Rune-Midgarts Kingdom."
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Raffam Oranpere",
      "text" : "Clan Information"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Raffam Oranpere",
      "text" : "Join."
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Raffam Oranpere",
      "text" : "Leave."
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Raffam Oranpere",
      "text" : "What are Clans?"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Raffam Oranpere",
      "text" : "About the Sword Clan"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Raffam Oranpere",
      "text" : "Cancel."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Raffam Oranpere",
      "text" : "The ^3131FFClans^000000 are a type of guild ran by the Kingdom."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Raffam Oranpere",
      "text" : "They don't participate in the Siege, so members are free to join/leave anytime."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Raffam Oranpere",
      "text" : "I wish we could join the Siege. I'd love flying over on my dragon and burning everyone in my way!"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Raffam Oranpere",
      "text" : "Oops, too thrilled!"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Raffam Oranpere",
      "text" : "Join us, if no Clan suits your taste."
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Raffam Oranpere",
      "text" : "New members are given ^3131FFfree stat bonuses^000000."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Raffam Oranpere",
      "text" : "Melee stats are offered as the name ^3131FFSword Clan^000000 suggests, but not all members are Melee classes."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Raffam Oranpere",
      "text" : "Don't feel pressured, just count on me!"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Raffam Oranpere",
      "text" : "Differences in variety creates the fun."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Raffam Oranpere",
      "text" : "These odd bunches never bore me in the party."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Raffam Oranpere",
      "text" : "And who knows you might meet your soul mate in the Clan? Hahah!"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Raffam Oranpere",
      "text" : "The ^3131FFSword Clan^000000 mainly supports Melee adventurers."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Raffam Oranpere",
      "text" : "Join for free ^FF0000<STR+1, VIT+1, MHP+30, MSP+10>^000000!"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Raffam Oranpere",
      "text" : "[Raffam Oranpere]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Raffam Oranpere",
      "text" : "Remember, no Siege participation."
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Raffam Oranpere",
      "text" : "You should contact other guilds for Siege."
    },
