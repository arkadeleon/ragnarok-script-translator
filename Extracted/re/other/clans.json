    {
      "kind" : "message",
      "line" : 568,
      "npc" : "Shaam Rumi",
      "text" : "[Shaam Rumi]"
    },
    {
      "kind" : "message",
      "line" : 569,
      "npc" : "Shaam Rumi",
      "text" : "Did you finish things up with your guild?"
    },
    {
      "kind" : "message",
      "line" : 572,
      "npc" : "Shaam Rumi",
      "text" : "[Shaam Rumi]"
    },
    {
      "kind" : "message",
      "line" : 573,
      "npc" : "Shaam Rumi",
      "text" : "Eh, you're already in a Clan. Hey, this isn't funny."
