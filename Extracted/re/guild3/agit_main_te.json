      "npc" : "Kafra_Staff_TE",
      "placeholders" : [
        ".@guildname$"
      ],
      "text" : "I am instructed to only offer my services to the ^ff0000{0}^000000 Guild. Please try another Kafra Employee around here. Sorry for the inconvenience."
