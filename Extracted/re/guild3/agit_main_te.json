    {
      "kind" : "message",
      "line" : 368,
      "npc" : "invest_TE",
      "text" : "That's all I have to report, Master."
    },
    {
      "kind" : "message",
      "line" : 389,
      "npc" : "invest_TE",
      "text" : "Will you summon a Guardian? It'll be a protector to defend us loyally."
    },
    {
      "kind" : "message",
      "line" : 390,
      "npc" : "invest_TE",
      "text" : "Please select a guardian to defend us."
    },
    {
      "kind" : "message",
      "line" : 401,
      "npc" : "invest_TE",
      "text" : "Will you summon the chosen guardian? 10,000 zeny are required to summon a Guardian."
    },
    {
      "kind" : "option",
      "line" : 403,
      "npc" : "invest_TE",
      "text" : "Summon"
    },
    {
      "kind" : "option",
      "line" : 403,
      "npc" : "invest_TE",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 405,
      "npc" : "invest_TE",
      "text" : "I did as you ordered. But please remember if you the have money to spare, it'll be better to set it up."
    },
    {
      "kind" : "message",
      "line" : 410,
      "npc" : "invest_TE",
      "text" : "Master, we have not the resources to Summon the Guardian. If you want to accumulate them, you have to learn the Guild skill. We failed to summon the Guardian."
    },
    {
      "kind" : "message",
      "line" : 413,
      "npc" : "invest_TE",
      "text" : "Master, you already have summoned that Guardian. We cannot summon another."
    },
    {
      "kind" : "message",
      "line" : 415,
      "npc" : "invest_TE",
      "text" : "Well... I'm sorry but we don't have funds to summon the Guardian. We failed to summon the Guardian."
    },
    {
      "kind" : "message",
      "line" : 420,
      "npc" : "invest_TE",
      "text" : "We completed the summoning of the Guardian. Our defenses are now increased with it in place."
    },
    {
      "kind" : "message",
      "line" : 427,
      "npc" : "invest_TE",
      "text" : "We are currently hiring a Kafra Employee... Do you want to fire the Kafra Employee?"
    },
    {
      "kind" : "option",
      "line" : 429,
      "npc" : "invest_TE",
      "text" : "Fire"
    },
    {
      "kind" : "option",
      "line" : 429,
      "npc" : "invest_TE",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 431,
      "npc" : "invest_TE",
      "text" : "She worked hard in my opinion. It was a good decision to keep her."
    },
    {
      "kind" : "message",
      "line" : 435,
      "npc" : "invest_TE",
      "text" : "[ Hired Kafra Employee ]"
    },
    {
      "kind" : "message",
      "line" : 436,
      "npc" : "invest_TE",
      "text" : "I worked so hard... How can you do that, Master?... Please... Please reconsider... Check it again, Master... Please..."
    },
    {
      "kind" : "option",
      "line" : 438,
      "npc" : "invest_TE",
      "text" : "Fire"
    },
    {
      "kind" : "option",
      "line" : 438,
      "npc" : "invest_TE",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 439,
      "npc" : "invest_TE",
      "text" : "[ Hired Kafra Employee ]"
    },
    {
      "kind" : "message",
      "line" : 440,
      "npc" : "invest_TE",
      "text" : "I'll work hard for you... Thank you!"
