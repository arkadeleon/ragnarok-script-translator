      "npc" : "Kafra_Staff_TE",
      "text" : "[Kafra Employee]"
    },
    {
      "kind" : "message",
      "line" : 288,
      "npc" : "Kafra_Staff_TE",
      "text" : "We, here at Kafra Corporation,"
