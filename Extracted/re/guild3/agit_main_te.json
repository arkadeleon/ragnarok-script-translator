    {
      "kind" : "message",
      "line" : 450,
      "npc" : "invest_TE",
      "text" : "...."
    },
    {
      "kind" : "message",
      "line" : 451,
      "npc" : "invest_TE",
      "text" : "I have discharged the Kafra Employee... But... are you unsatisfied with something?"
    },
    {
      "kind" : "message",
      "line" : 454,
      "npc" : "invest_TE",
      "text" : "Will you contact the kafra Main Office and Hire a Employee for our Castle?"
    },
    {
      "kind" : "message",
      "line" : 455,
      "npc" : "invest_TE",
      "text" : "^ff0000 10,000 zeny is required for their services. "
    },
    {
      "kind" : "option",
      "line" : 457,
      "npc" : "invest_TE",
      "text" : "Hire."
    },
    {
      "kind" : "option",
      "line" : 457,
      "npc" : "invest_TE",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 459,
      "npc" : "invest_TE",
      "text" : "I did as you ordered, but some of our members will be unhappy. It will be better to hire a Kafra Employee quickly."
    },
    {
      "kind" : "message",
      "line" : 464,
      "npc" : "invest_TE",
      "text" : "Master, we can't hire a Kafra Employee because we don't have a contract with the Kafra Main Office. If you want to obtain a contract with the Kafra Main Office, you will need to learn the Guild skill first."
    },
    {
      "kind" : "message",
      "line" : 468,
      "npc" : "invest_TE",
      "text" : "Well... I'm sorry but we don't have enough funds to hire a Kafra Employee."
    },
    {
      "kind" : "message",
      "line" : 475,
      "npc" : "invest_TE",
      "text" : "We obtained a contract with the kafra Main Office, and hired a Kafra Employee."
    },
    {
      "kind" : "message",
      "line" : 478,
      "npc" : "invest_TE",
      "text" : "[ Hired Kafra Employee ]"
    },
    {
      "kind" : "message",
      "line" : 479,
      "npc" : "invest_TE",
      "text" : "How do you do? I was dispatched from the Main Office."
    },
    {
      "kind" : "message",
      "line" : 480,
      "npc" : "invest_TE",
      "text" : "I'll do my best to not tarnish the reputation of the Guild."
    },
    {
      "kind" : "message",
      "line" : 484,
      "npc" : "invest_TE",
      "text" : "The Contract terms of the hired Kafra Employee are for 1 month and after this term, you will need to pay an additional fee."
    },
    {
      "kind" : "message",
      "line" : 485,
      "npc" : "invest_TE",
      "text" : "It will be useful for our members."
    },
    {
      "kind" : "message",
      "line" : 490,
      "npc" : "invest_TE",
      "text" : "Do you want to visit the room where our valuables are stored?"
    },
    {
      "kind" : "message",
      "line" : 491,
      "npc" : "invest_TE",
      "text" : "That room is restricted to you... you are the only one with access to it."
    },
    {
      "kind" : "message",
      "line" : 494,
      "npc" : "invest_TE",
      "text" : "If you don't open the treasure box within time limits, there is a possibility of losing it when unexpected situation occurs."
    },
    {
      "kind" : "message",
      "line" : 495,
      "npc" : "invest_TE",
      "text" : "Please make sure to remember that always, Master."
    },
    {
      "kind" : "message",
      "line" : 496,
      "npc" : "invest_TE",
      "text" : "So, for our guild's improvement, you must find time to collect it."
    },
    {
      "kind" : "option",
      "line" : 498,
      "npc" : "invest_TE",
      "text" : "Go into Master's room."
    },
    {
      "kind" : "option",
      "line" : 498,
      "npc" : "invest_TE",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 501,
      "npc" : "invest_TE",
      "text" : "I'll show you the secret path. Follow me...please."
    },
    {
      "kind" : "message",
      "line" : 502,
      "npc" : "invest_TE",
      "text" : "When you want to return here, please press the secret switch."
    },
    {
      "kind" : "message",
      "line" : 517,
      "npc" : "invest_TE",
      "text" : "Goods are produced once a day... if you don't remove them in time, they will not be produced anymore."
    },
    {
      "kind" : "message",
      "line" : 518,
      "npc" : "invest_TE",
      "text" : "Therefore, it will be better if you check up on them from time to time."
