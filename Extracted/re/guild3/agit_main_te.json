      "kind" : "message",
      "line" : 313,
      "npc" : "Kafra_Staff_TE",
      "placeholders" : [
        "getarg(0)"
      ],
      "text" : "to {0} is 200 zeny."
    },
    {
      "kind" : "message",
      "line" : 343,
      "npc" : "invest_TE",
      "text" : "I have been waiting for a master to fulfill my destiny."
    },
    {
      "kind" : "message",
      "line" : 344,
      "npc" : "invest_TE",
      "text" : "Brave soul... fate will guide you towards your future..."
    },
    {
      "kind" : "message",
      "line" : 348,
      "npc" : "invest_TE",
      "placeholders" : [
        ".@guildmaster$"
      ],
      "text" : "No matter how much you pester me, I'll still follow my master ^ff0000{0}^000000. Where are the Guardians?! Send these ruffians away right now!"
    },
