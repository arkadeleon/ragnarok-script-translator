      "text" : "[Kafra Employee]"
    },
    {
      "kind" : "message",
      "line" : 310,
      "npc" : "Kafra_Staff_TE",
      "text" : "I'm sorry, but you don't have"
    },
    {
      "kind" : "message",
      "line" : 311,
      "npc" : "Kafra_Staff_TE",
      "text" : "enough zeny for the Teleport"
    },
    {
      "kind" : "message",
      "line" : 312,
      "npc" : "Kafra_Staff_TE",
      "text" : "Service. The fee to teleport"
