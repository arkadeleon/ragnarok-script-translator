      "npc" : "Gatekeeper",
      "text" : "Halt!"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Gatekeeper",
      "text" : "What brings you here, Adventurer?"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Gatekeeper",
      "text" : "We've discovered a new floor of this underwater city."
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Gatekeeper",
      "text" : "[Gatekeeper]"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Gatekeeper",
      "text" : "Do you think you're up to the challenge?"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Gatekeeper",
      "text" : "The monsters here are between levels 110 and 124."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Gatekeeper",
      "text" : "And you must beware of the Kraken!"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Gatekeeper",
      "text" : "Release the Kraken!"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Gatekeeper",
      "text" : "I'll stay here."
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Gatekeeper",
      "text" : "[Gatekeeper]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Gatekeeper",
      "text" : "Be cautious and good luck."
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Gatekeeper",
      "text" : "If you see the Kraken be sure you have your friends to help or do what we do and run."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Gatekeeper",
      "text" : "[Gatekeeper]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Gatekeeper",
      "text" : "It's always best to be prepared before exploring a new area."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Gatekeeper",
      "text" : "Come back when you're ready to go."
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Guard",
      "text" : "[Gatekeeper]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Guard",
      "text" : "So I guess you want to go back to the fifth floor?"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Guard",
      "text" : "Yes!"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Guard",
      "text" : "No, I'll stay."
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Guard",
      "text" : "[Gatekeeper]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Guard",
      "text" : "Be safe, adventurer."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Guard",
      "text" : "[Gatekeeper]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Guard",
      "text" : "You're not going?"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Guard",
      "text" : "You're braver than I thought."
    }
