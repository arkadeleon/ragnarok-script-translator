    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Kafra Teleportation",
      "speaker" : "Kafra Employee",
      "text" : "Prontera Field :\nThe Prontera West Field is a mountainous field that you can also access the ^ff0000Prontera Sewer^000000.\n^ff0000Hornets^000000 live there, so novice adventurers should beware!"
    },
    {
      "kind" : "message",
      "line" : 254,
      "npc" : "Kafra Teleportation",
      "speaker" : "Kafra Employee",
      "text" : "Prontera Field :\nSouthwestern Prontera Field is a place where ^ff0000Rockers^000000 live."
    },
    {
      "kind" : "message",
      "line" : 262,
      "npc" : "Kafra Teleportation",
      "speaker" : "Kafra Employee",
      "text" : "Prontera Field :\nProntera Lake Field is a place where the ^ff0000Ambernites^000000 live."
    },
    {
      "kind" : "message",
      "line" : 270,
      "npc" : "Kafra Teleportation",
      "speaker" : "Kafra Employee",
      "text" : "Archer's Village :\nPayon's Cave is a scary place with lots of ^ff0000Zombies^000000 and ^ff0000Skeletons^000000."
    },
    {
      "kind" : "message",
      "line" : 278,
      "npc" : "Kafra Teleportation",
      "speaker" : "Kafra Employee",
      "text" : "Sograt Desert :\nSouthwest of Prontera and Southwest of Izlude, this place is full of ^ff0000Mukas^000000 and ^ff0000Peco Pecos^000000."
    },
    {
      "kind" : "option",
      "line" : 289,
