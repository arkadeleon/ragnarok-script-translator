    {
      "kind" : "message",
      "line" : 263,
      "npc" : "Karacas",
      "text" : "[Karacas]"
    },
    {
      "kind" : "message",
      "line" : 264,
      "npc" : "Karacas",
      "text" : "Yes, you have quick wits!"
