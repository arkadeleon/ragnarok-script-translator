      "line" : 289,
      "npc" : "Karacas",
      "text" : "[Karacas]"
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Karacas",
      "text" : "When you succeed in getting 3 different kinds of reagents, you can come back."
