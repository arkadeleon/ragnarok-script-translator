      "npc" : "Guild Master",
      "text" : "......"
    },
    {
      "kind" : "message",
      "line" : 639,
      "npc" : "Guild Master",
      "text" : "[Assistant]"
    },
    {
      "kind" : "message",
      "line" : 640,
      "npc" : "Guild Master",
      "text" : "Master is meditating."
    },
    {
      "kind" : "message",
      "line" : 641,
      "npc" : "Guild Master",
      "text" : "Be quiet."
    },
    {
      "kind" : "message",
      "line" : 644,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 645,
      "npc" : "Guild Master",
      "text" : "I've heard from Yoop that a very useful stone can be created."
    },
    {
      "kind" : "message",
      "line" : 647,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 648,
      "npc" : "Guild Master",
      "text" : "It can be used to make magical jewelry that can cast powerful magic."
    },
    {
      "kind" : "message",
      "line" : 650,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 651,
      "npc" : "Guild Master",
      "text" : "Yoop."
    },
    {
      "kind" : "message",
      "line" : 653,
      "npc" : "Guild Master",
      "text" : "[Yoop]"
    },
    {
      "kind" : "message",
      "line" : 654,
      "npc" : "Guild Master",
      "text" : "Yeap, Master!"
    },
    {
      "kind" : "message",
      "line" : 656,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 657,
      "npc" : "Guild Master",
      "text" : "Please take him to the magical room."
    },
    {
      "kind" : "message",
      "line" : 659,
      "npc" : "Guild Master",
      "text" : "[Yoop]"
    },
    {
      "kind" : "message",
      "line" : 660,
      "npc" : "Guild Master",
      "text" : "Yup, Master."
    },
    {
      "kind" : "message",
      "line" : 661,
      "npc" : "Guild Master",
      "text" : "Please follow me."
    },
    {
      "kind" : "message",
      "line" : 667,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 668,
      "npc" : "Guild Master",
      "text" : "......"
    },
    {
      "kind" : "message",
      "line" : 670,
      "npc" : "Guild Master",
      "text" : "[Yoop]"
    },
    {
      "kind" : "message",
      "line" : 671,
      "npc" : "Guild Master",
      "text" : "My master is meditating now, please follow me."
    },
    {
      "kind" : "message",
      "line" : 675,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 676,
      "npc" : "Guild Master",
      "text" : "Hm...?"
    },
    {
      "kind" : "message",
      "line" : 677,
      "npc" : "Guild Master",
      "text" : "How did you come this far..."
    },
    {
      "kind" : "message",
      "line" : 681,
      "npc" : "Guild Master",
      "text" : "You've got too many items."
    },
    {
      "kind" : "message",
      "line" : 682,
      "npc" : "Guild Master",
      "text" : "Please come back after reducing the number of items you have."
    },
    {
      "kind" : "message",
      "line" : 685,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 687,
      "npc" : "Guild Master",
      "text" : "Unless you like your current job, you should use all your skill points."
    },
    {
      "kind" : "message",
      "line" : 691,
      "npc" : "Guild Master",
      "text" : "You are on a riding pet,"
    },
    {
      "kind" : "message",
      "line" : 692,
      "npc" : "Guild Master",
      "text" : "so you cannot change your job."
    },
    {
      "kind" : "message",
      "line" : 693,
      "npc" : "Guild Master",
      "text" : "Please unequip your riding pet and try again!"
    },
    {
      "kind" : "message",
      "line" : 696,
      "npc" : "Guild Master",
      "text" : "Beautiful light..."
    },
    {
      "kind" : "message",
      "line" : 697,
      "npc" : "Guild Master",
      "text" : "Don't make me disappointed at you..."
    },
    {
      "kind" : "message",
      "line" : 699,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 700,
      "npc" : "Guild Master",
      "text" : "You have become a member of the Warlocks."
    },
    {
      "kind" : "message",
      "line" : 701,
      "npc" : "Guild Master",
      "text" : "Be proud."
    },
    {
      "kind" : "message",
      "line" : 704,
      "npc" : "Guild Master",
      "text" : "^0000ffYou still have left the skill points, Please use all the skill points and try to start again!^000000"
    },
    {
      "kind" : "message",
      "line" : 707,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 708,
      "npc" : "Guild Master",
      "text" : "This crystallized magical stone will keep you safe."
    },
    {
      "kind" : "message",
      "line" : 721,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
      "line" : 722,
      "npc" : "Guild Master",
      "text" : "How are you adjusting to the power of a Warlocks?"
    },
    {
      "kind" : "message",
      "line" : 723,
      "npc" : "Guild Master",
      "text" : "If you get careless, you will be overthrown by your own power."
    },
    {
      "kind" : "message",
      "line" : 729,
      "npc" : "Yoop",
      "text" : "[Yoop]"
    },
    {
      "kind" : "message",
      "line" : 730,
      "npc" : "Yoop",
      "text" : "If you ask Ebein to be sent to the magical room, he would send you there."
    },
    {
      "kind" : "message",
      "line" : 731,
      "npc" : "Yoop",
      "text" : "Wait in the queue to enter the Chamber of Magic."
    },
