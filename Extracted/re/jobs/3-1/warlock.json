      "npc" : "Guild Master",
      "text" : "Yoop has a funny pony-tail."
    },
    {
      "kind" : "message",
      "line" : 633,
      "npc" : "Guild Master",
      "text" : "And don't disturb me."
    },
    {
      "kind" : "message",
      "line" : 636,
      "npc" : "Guild Master",
      "text" : "[Master Egnoloria]"
    },
    {
      "kind" : "message",
