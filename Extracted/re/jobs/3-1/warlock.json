      "line" : 736,
      "npc" : "Ebein",
      "text" : "[Ebein]"
    },
    {
      "kind" : "message",
      "line" : 737,
      "npc" : "Ebein",
      "text" : "Would you like to take a test?"
    },
    {
      "kind" : "message",
      "line" : 738,
      "npc" : "Ebein",
      "text" : "If you stand by in the waiting room, you'll be able to go into the Chamber of Magic."
    },
    {
      "kind" : "message",
      "line" : 740,
      "npc" : "Ebein",
      "text" : "[Ebein]"
    },
    {
      "kind" : "message",
      "line" : 741,
      "npc" : "Ebein",
      "text" : "If there're others inside the room, you just need to wait for a while."
    },
    {
      "kind" : "option",
      "line" : 743,
      "npc" : "Ebein",
      "text" : "Go to the waiting room."
