      "kind" : "option",
      "line" : 743,
      "npc" : "Ebein",
      "text" : "Go outside."
    },
    {
      "kind" : "message",
      "line" : 745,
      "npc" : "Ebein",
      "text" : "[Ebein]"
    },
    {
      "kind" : "message",
      "line" : 746,
      "npc" : "Ebein",
      "text" : "Then please enter the room yourself."
    },
    {
      "kind" : "message",
      "line" : 747,
      "npc" : "Ebein",
      "text" : "Make sure you have enough potions to survive the test as the monsters are very powerful in the Chamber."
    },
    {
      "kind" : "message",
      "line" : 750,
      "npc" : "Ebein",
      "text" : "[Ebein]"
    },
    {
      "kind" : "message",
      "line" : 751,
