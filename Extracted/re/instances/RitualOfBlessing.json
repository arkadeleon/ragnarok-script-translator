    {
      "kind" : "message",
      "line" : 596,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 597,
      "npc" : "Kronecker G. Heine",
      "text" : "It is the crown passed down in the palace of Rune-Midgarts."
    },
    {
      "kind" : "message",
      "line" : 598,
      "npc" : "Kronecker G. Heine",
      "text" : "It means more than an ordinary crown."
    },
    {
      "kind" : "message",
      "line" : 600,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 601,
      "npc" : "Kronecker G. Heine",
      "text" : "Has it been taken by them?"
    },
    {
      "kind" : "message",
      "line" : 602,
      "npc" : "Kronecker G. Heine",
      "text" : "What on earth...!"
    },
    {
      "kind" : "message",
      "line" : 604,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 605,
      "npc" : "Kronecker G. Heine",
      "text" : "What is hidden here is not known to anyone... Except the seven royal families...!"
    },
    {
      "kind" : "message",
      "line" : 607,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 608,
      "npc" : "Kronecker G. Heine",
      "text" : "Does it mean..."
    },
    {
      "kind" : "message",
      "line" : 609,
      "npc" : "Kronecker G. Heine",
      "text" : "...Well, first things first, There are things to find out."
    },
    {
      "kind" : "message",
      "line" : 611,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 612,
      "npc" : "Kronecker G. Heine",
      "text" : "Let's get out of here now."
    },
    {
      "kind" : "message",
      "line" : 613,
      "npc" : "Kronecker G. Heine",
      "text" : "There is much left for use to find out."
    },
    {
      "kind" : "message",
      "line" : 618,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 619,
      "npc" : "Kronecker G. Heine",
      "text" : "Whoever left here, clear out with the wounded near you!"
    },
    {
      "kind" : "message",
      "line" : 620,
      "npc" : "Kronecker G. Heine",
      "text" : "The Room of Consciousness will be closed for a while!"
    },
    {
      "kind" : "message",
      "line" : 625,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 626,
      "npc" : "Kronecker G. Heine",
      "text" : "Peter has been wounded."
    },
    {
      "kind" : "message",
      "line" : 627,
      "npc" : "Kronecker G. Heine",
      "text" : "We need to move him fast."
    },
    {
      "kind" : "message",
      "line" : 629,
      "npc" : "Kronecker G. Heine",
      "text" : "[Kronecker]"
    },
    {
      "kind" : "message",
      "line" : 630,
      "npc" : "Kronecker G. Heine",
      "text" : "I'll see you out there."
    },
