    {
      "kind" : "message",
      "line" : 474,
      "npc" : "Rebellion",
      "text" : "It's an awful but interesting device. It wasn't a device meant to summon monsters."
    },
    {
      "kind" : "message",
      "line" : 476,
      "npc" : "Rebellion",
      "text" : "[Rebellion]"
    },
    {
      "kind" : "message",
      "line" : 477,
      "npc" : "Rebellion",
      "text" : "After summoning monsters, it constantly releases chemical poison, making it even more difficult to remove the monster."
    },
    {
      "kind" : "message",
      "line" : 479,
      "npc" : "Rebellion",
      "text" : "[Rebellion]"
    },
    {
      "kind" : "message",
      "line" : 480,
      "npc" : "Rebellion",
      "text" : "If you touch the chemical poison, it will spread like bomb. You shouldn't get any closer."
