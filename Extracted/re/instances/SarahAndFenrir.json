      "text" : "[Professor Bernhard]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Professor Bernhard",
      "text" : "Did you successfully bring back the shards of Gigantes?"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Professor Bernhard",
      "text" : "You probably faced a lot of danger so thank you for the effort."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Professor Bernhard",
      "text" : "[Professor Bernhard]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Professor Bernhard",
      "text" : "I don't expect to receive the shards for nothing when you have risked your life for them!"
