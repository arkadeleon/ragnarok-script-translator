    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Julian",
      "text" : "^ff0000If you deal with monsters arbitrarily inside a dungeon, such as Monster taming, it will not be regarded as a normal progress. Please be aware of it.^000000"
