      "npc" : "Hisie",
      "text" : "[Loki]"
    },
    {
      "kind" : "message",
      "line" : 411,
      "npc" : "Hisie",
      "text" : "He might have been under the influence for a good while."
    },
    {
      "kind" : "message",
      "line" : 412,
      "npc" : "Hisie",
      "text" : "Anyway, this guy is not guilty."
    },
    {
      "kind" : "message",
      "line" : 413,
      "npc" : "Hisie",
      "text" : "I can prove it."
