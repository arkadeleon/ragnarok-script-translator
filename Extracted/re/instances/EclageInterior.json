    {
      "kind" : "message",
      "line" : 421,
      "npc" : "Hisie",
      "text" : "Hah..."
    },
    {
      "kind" : "message",
      "line" : 422,
      "npc" : "Hisie",
      "text" : "But things got out of control."
    },
    {
      "kind" : "message",
      "line" : 423,
      "npc" : "Hisie",
      "text" : "I didn't expect this."
    },
    {
      "kind" : "option",
      "line" : 425,
      "npc" : "Hisie",
      "text" : "What happened to the Orb?"
