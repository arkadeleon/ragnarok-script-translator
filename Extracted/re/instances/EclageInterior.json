    {
      "kind" : "message",
      "line" : 415,
      "npc" : "Hisie",
      "text" : "[Nydhog]"
    },
    {
      "kind" : "message",
      "line" : 416,
      "npc" : "Hisie",
      "text" : "I swear by the name of the guardian of Yggdrasil, too."
