    {
      "kind" : "message",
      "line" : 456,
      "npc" : "Strange Boy",
      "text" : "[Boy]"
    },
    {
      "kind" : "message",
      "line" : 457,
      "npc" : "Strange Boy",
      "text" : "To achieve that, I realized I must abandon my old body."
    },
    {
      "kind" : "message",
      "line" : 458,
      "npc" : "Strange Boy",
      "text" : "So I died--well, I let you kill me."
