    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Guardian Nidhogg",
      "text" : "[Nidhogg]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Guardian Nidhogg",
      "text" : "Please go to Commander Hiva Agip and receive the Demon God Subjugation quest."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Guardian Nidhogg",
      "text" : "[Nidhogg]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Guardian Nidhogg",
      "text" : "I've been waiting for you, hero-in-waiting. "
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Guardian Nidhogg",
      "text" : "Let me guide you to the depth of the temple where Morroc lies in wait."
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Guardian Nidhogg",
      "text" : "[Nidhogg]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Guardian Nidhogg",
      "text" : "This tree is the spitting image of Yggdrasil."
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Guardian Nidhogg",
      "text" : "I just hope Morroc is not intent on what I fear most."
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Guardian Nidhogg",
      "text" : "Through this tree the door is opened."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Guardian Nidhogg",
      "text" : "[Nidhogg]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Guardian Nidhogg",
      "text" : "I can sense that"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Guardian Nidhogg",
      "text" : "this tree is generating mana at certain intervals as if it's breathing."
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Guardian Nidhogg",
      "text" : "I'm going to catch a moment between its breaths to open up a path for you. Are you ready?"
    },
    {
      "kind" : "option",
      "line" : 55,
      "npc" : "Guardian Nidhogg",
      "text" : "Enter now."
    },
    {
      "kind" : "option",
      "line" : 55,
      "npc" : "Guardian Nidhogg",
      "text" : "Do not enter."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Guardian Nidhogg",
      "text" : "[Nidhogg]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Guardian Nidhogg",
      "text" : "Okay."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Guardian Nidhogg",
      "text" : "I understand if you need time."
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Guardian Nidhogg",
      "text" : "Take your time. I can wait as long as you want me to."
