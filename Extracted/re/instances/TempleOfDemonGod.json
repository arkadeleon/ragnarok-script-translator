    {
      "kind" : "message",
      "line" : 439,
      "npc" : "Strange Boy",
      "text" : "You insignificant creature."
    },
    {
      "kind" : "message",
      "line" : 440,
      "npc" : "Strange Boy",
      "text" : "How dare you lay a hand on a god-in-waiting?!"
    },
    {
      "kind" : "message",
      "line" : 444,
      "npc" : "Strange Boy",
      "text" : "[Boy]"
    },
    {
      "kind" : "message",
      "line" : 445,
      "npc" : "Strange Boy",
      "text" : "First, let me applaud you for coming this far."
    },
    {
      "kind" : "message",
      "line" : 446,
      "npc" : "Strange Boy",
      "text" : "You've been a good pawn."
    },
    {
      "kind" : "option",
      "line" : 448,
      "npc" : "Strange Boy",
      "text" : "What are you talking about?"
    },
    {
      "kind" : "message",
      "line" : 450,
      "npc" : "Strange Boy",
      "text" : "[Boy]"
    },
    {
      "kind" : "message",
      "line" : 451,
      "npc" : "Strange Boy",
      "text" : "I've been waiting for this day."
    },
    {
      "kind" : "message",
      "line" : 452,
      "npc" : "Strange Boy",
      "text" : "To get out of that corner of the demon world and rule the entire universe."
