      "npc" : "Guardian Nidhogg",
      "text" : "This place is too dangerous for you to explore alone."
    },
    {
      "kind" : "message",
      "line" : 16,
      "npc" : "Guardian Nidhogg",
      "text" : "Please form a party and come with your comrades."
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Guardian Nidhogg",
      "text" : "[Nidhogg]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Guardian Nidhogg",
      "text" : "Only party leaders can control access to the Temple of the Demon God."
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Guardian Nidhogg",
      "text" : "It's to ensure the safety of the entire Expedition. Please let your leader talk to me instead."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Guardian Nidhogg",
      "text" : "[Nidhogg]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Guardian Nidhogg",
      "text" : "I'm sorry, but you can't enter this place without approval from the Commander."
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Guardian Nidhogg",
      "text" : "You must be on the quest to subjugate the Demon God to enter this place."
