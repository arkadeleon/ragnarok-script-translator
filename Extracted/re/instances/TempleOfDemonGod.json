    {
      "kind" : "message",
      "line" : 284,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Welcome"
    },
    {
      "kind" : "message",
      "line" : 285,
      "npc" : "Demon God's Apostle Aha",
      "text" : "to the Temple of the Demon God."
    },
    {
      "kind" : "message",
      "line" : 286,
      "npc" : "Demon God's Apostle Aha",
      "text" : "It's my honor to be your host today."
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Demon God's Apostle Aha",
      "text" : "[Ahat]"
    },
    {
      "kind" : "message",
      "line" : 291,
      "npc" : "Demon God's Apostle Aha",
      "text" : "So, you've come."
    },
    {
      "kind" : "message",
      "line" : 292,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Gosh, you're so persistent."
    },
    {
      "kind" : "message",
      "line" : 293,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Hah hah, are you surprised to see me here?"
    },
    {
      "kind" : "message",
      "line" : 296,
      "npc" : "Demon God's Apostle Aha",
      "text" : "[Ahat]"
    },
    {
      "kind" : "message",
      "line" : 297,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Didn't you expect this at all?"
    },
    {
      "kind" : "message",
      "line" : 298,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Why don't I introduce myself officially?"
    },
    {
      "kind" : "message",
      "line" : 299,
      "npc" : "Demon God's Apostle Aha",
      "text" : "I'm Ahat, the first servant of the Demon God."
    },
    {
      "kind" : "message",
      "line" : 302,
      "npc" : "Demon God's Apostle Aha",
      "text" : "[Ahat]"
    },
    {
      "kind" : "message",
      "line" : 303,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Well, well, maybe I forfeit my life today."
    },
    {
      "kind" : "message",
      "line" : 304,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Don't look at me like that. Everything is as planned."
    },
    {
      "kind" : "message",
      "line" : 307,
      "npc" : "Demon God's Apostle Aha",
      "text" : "[Ahat]"
    },
    {
      "kind" : "message",
      "line" : 308,
      "npc" : "Demon God's Apostle Aha",
      "text" : "My master wishes for Shnaim and I to put you to the test."
    },
    {
      "kind" : "message",
      "line" : 309,
      "npc" : "Demon God's Apostle Aha",
      "text" : "To see if you deserve to be our guests."
    },
    {
      "kind" : "message",
      "line" : 312,
      "npc" : "Demon God's Apostle Aha",
      "text" : "[Ahat]"
    },
    {
      "kind" : "message",
      "line" : 313,
      "npc" : "Demon God's Apostle Aha",
      "text" : "If you think you've come this far on your own,"
    },
    {
      "kind" : "message",
      "line" : 314,
      "npc" : "Demon God's Apostle Aha",
      "text" : "you're mistaken."
    },
    {
      "kind" : "message",
      "line" : 317,
      "npc" : "Demon God's Apostle Aha",
      "text" : "[Ahat]"
    },
    {
      "kind" : "message",
      "line" : 318,
      "npc" : "Demon God's Apostle Aha",
      "text" : "Everything is as the Master has planned."
    },
    {
      "kind" : "message",
      "line" : 319,
      "npc" : "Demon God's Apostle Aha",
      "text" : "For now, let's see if you can open this door."
    },
    {
      "kind" : "message",
      "line" : 388,
