      "npc" : "Missing, the Cleaner",
      "text" : "[Missing, the Cleaner]"
    },
    {
      "kind" : "message",
      "line" : 573,
      "npc" : "Missing, the Cleaner",
      "text" : "I have the cleaning job for 40 years and I've never seen such a terrible team!!"
