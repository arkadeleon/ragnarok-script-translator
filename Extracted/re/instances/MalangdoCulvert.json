    {
      "kind" : "message",
      "line" : 529,
      "npc" : "F_mal_missing",
      "text" : "[Missing, the Cleaner]"
    },
    {
      "kind" : "message",
      "line" : 530,
      "npc" : "F_mal_missing",
      "text" : "I will tell you how to clean shortly. Can you see the culverts around you?"
