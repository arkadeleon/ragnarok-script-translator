      "kind" : "message",
      "line" : 550,
      "npc" : "F_mal_missing",
      "text" : "[Missing, the Cleaner]"
    },
    {
      "kind" : "message",
      "line" : 551,
      "npc" : "F_mal_missing",
      "text" : "Once your leader finishes preparing, it will begin, so get your hearts ready for it!!"
