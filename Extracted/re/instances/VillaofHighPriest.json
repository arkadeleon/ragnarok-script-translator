{
  "file" : "npc/re/instances/VillaofHighPriest.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Miriam",
      "text" : "[Miriam]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Miriam",
      "text" : "Are you all gathered?"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Miriam",
      "text" : "[Miriam]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Miriam",
      "text" : "I think I should check to see if there are other employees and go up to the second floor."
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Miriam",
      "text" : "[Miriam]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Miriam",
      "text" : "I feel a sharp presence beyond the central stairs."
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Miriam",
      "text" : "Probably the Heart Hunter who fought in the temple."
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Miriam",
      "text" : "[Miriam]"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Miriam",
      "text" : "I'm worried about the missing piece of Ymir's heart."
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Miriam",
      "text" : "If it's about inciting trouble, what happened at the temple is enough."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Miriam",
      "text" : "[Miriam]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Miriam",
      "text" : "What if my father has other plans..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Miriam",
      "text" : "If you try to go down the wrong path again, I have to stop him."
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Miriam",
      "text" : "[Miriam]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Miriam",
      "text" : "First, shall we get some information from the villa employees?"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Miriam",
      "text" : "I see a male employee over there."
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Miriam",
      "text" : "[Miriam]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Miriam",
      "text" : "I'll go to that employee."
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Miriam",
      "text" : "Adventurer, please find another employee and ask him about the mansion."
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Villa Employee",
      "text" : "[Villa Employee]"
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Villa Employee",
      "text" : "This is my first time meeting you. Who are you?"
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "Villa Employee",
      "text" : "Are you the elder's guest?"
    },
    {
      "kind" : "option",
      "line" : 223,
      "npc" : "Villa Employee",
      "text" : "Where is Amal?"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Villa Employee",
      "text" : "[Villa Employee]"
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Villa Employee",
      "text" : "Wouldn't he be at the chapel?"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Villa Employee",
      "text" : "Whenever you come here, please look for the chapel first..."
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Villa Employee",
      "text" : "[Villa Employee]"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Villa Employee",
      "text" : "Yes. He seemed to be a man of faith, so he built a chapel inside the mansion."
    },
    {
      "kind" : "option",
      "line" : 232,
      "npc" : "Villa Employee",
      "text" : "What about other people?"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Villa Employee",
      "text" : "[Villa Employee]"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Villa Employee",
      "text" : "Most were suddenly fired."
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Villa Employee",
      "text" : "I also heard someone tell me to leave a little while ago. Is this a sign of mass layoff!?"
    },
    {
      "kind" : "message",
      "line" : 237,
      "npc" : "Villa Employee",
      "text" : "[Villa Employee]"
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Villa Employee",
      "text" : "The atmosphere was so heavy that I couldn't even ask."
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Villa Employee",
      "text" : "The chapel can be reached by going up the central stairs and past the banquet hall."
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Villa Employee",
      "text" : "Then, go do your business."
    },
    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Villa Employee",
      "text" : "[Villa Employee]"
    },
    {
      "kind" : "message",
      "line" : 246,
      "npc" : "Villa Employee",
      "text" : "Sir Amal went to chapel."
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Villa Employee",
      "text" : "Go up the central stairs, pass the banquet hall, and you will reach the chapel."
    },
    {
      "kind" : "message",
      "line" : 253,
      "npc" : "Villa Employee",
      "text" : "This is the person Miriam decided to investigate. Let's find another one."
    },
    {
      "kind" : "message",
      "line" : 456,
      "npc" : "Locked Door",
      "text" : "Firmly Locked Door."
    },
    {
      "kind" : "message",
      "line" : 457,
      "npc" : "Locked Door",
      "text" : "There is a Silver Key hole."
    },
    {
      "kind" : "message",
      "line" : 593,
      "npc" : "Locked Door",
      "text" : "Firmly Locked Door."
    },
    {
      "kind" : "message",
      "line" : 594,
      "npc" : "Locked Door",
      "text" : "There is a small key hole."
    },
    {
      "kind" : "message",
      "line" : 598,
      "npc" : "Locked Door",
      "text" : "I used a spare key."
    },
    {
      "kind" : "message",
      "line" : 639,
      "npc" : "Ornate Door",
      "text" : "The door won't budge."
    },
    {
      "kind" : "message",
      "line" : 640,
      "npc" : "Ornate Door",
      "text" : "It feels like a strong magical force is blocking the door."
    },
    {
      "kind" : "message",
      "line" : 732,
      "npc" : "Elegant Door",
      "text" : "There is a door with an elegant ^4d4dffLily^000000 engraved on it."
    },
    {
      "kind" : "message",
      "line" : 733,
      "npc" : "Elegant Door",
      "text" : "I feel an unknown magical power."
    }
  ]
