    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Maram",
      "text" : "Try to move away from the security guard's line of sight as much as possible."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Maram",
      "text" : "If you get caught, you might be attacked, so if you can't break through, we'll meet again here."
