{
  "file" : "npc/re/instances/RoomOfConsciousness.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Fenrir",
      "text" : "Sealed in the underground"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Fenrir",
      "text" : "of the Prontera Castle..."
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Fenrir",
      "text" : "I didn't expect it to be this huge..."
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Fenrir",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Fenrir",
      "text" : "What on earth is there inside?"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Fenrir",
      "text" : "I don't know. Let's investigate the inside, first."
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Iris",
      "text" : "This...this must be..."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Iris",
      "text" : "Ymir's Heart!"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Iris",
      "text" : "This..."
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Iris",
      "text" : "This is Ymir's Heart..."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Iris",
      "text" : "~Rumbling~"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Iris",
      "text" : "Why is this place shaking?!"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Iris",
      "text" : "~Grunts~ They must've started attacking this place, too."
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Iris",
      "text" : "~Grins~ Delighted to see you all."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Iris",
      "text" : "!!"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Iris",
      "text" : "You've got to be kidding me!"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Iris",
      "text" : "From this moment on, we the Immortal Legion by Lord Valkyrie Himelmez"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Iris",
      "text" : "will take over here."
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Iris",
      "text" : "What? How dare you!"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Iris",
      "text" : "I'm game. Bring it on!"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Iris",
      "text" : "~Grins~ Do I look like I have the time to deal with a petty thing like you, human?"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Iris",
      "text" : "But, out of pure mercy, I'll let you taste the fearful power of the Immortal Legion just a little bit."
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Iris",
      "text" : "~Grunts~ When did all the legionnaires get here?"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Iris",
      "text" : "~Chuckles~ I think you're not that bad for a human."
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 228,
      "npc" : "Iris",
      "text" : "But do you think you can get away from this, again? Wake up, my underlings!"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 236,
      "npc" : "Iris",
      "text" : "What...what's up with this monster?!"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Iris",
      "text" : "Ah..."
    },
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "Iris",
      "text" : "I'll let you in on me before I go."
    },
    {
      "kind" : "message",
      "line" : 242,
      "npc" : "Iris",
      "text" : "I'm Bijou."
    },
    {
      "kind" : "message",
      "line" : 243,
      "npc" : "Iris",
      "text" : "I'm the adjutant to Lord Valkyrie Himelmez."
    },
    {
      "kind" : "message",
      "line" : 246,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Iris",
      "text" : "~Groans~"
    },
    {
      "kind" : "message",
      "line" : 248,
      "npc" : "Iris",
      "text" : "No Valkyrie's subordinates ever disappointed me and neither did you."
    },
    {
      "kind" : "message",
      "line" : 249,
      "npc" : "Iris",
      "text" : "Ymir's Heart is a huge energy source. For what do you want to use it anyway?"
    },
    {
      "kind" : "message",
      "line" : 252,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 253,
      "npc" : "Iris",
      "text" : "......"
    },
    {
      "kind" : "message",
      "line" : 254,
      "npc" : "Iris",
      "text" : "You don't need to know. You're going to be wiped out soon anyway."
    },
    {
      "kind" : "message",
      "line" : 257,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 258,
      "npc" : "Iris",
      "text" : "I don't think you'd use it for any good cause."
    },
    {
      "kind" : "message",
      "line" : 259,
      "npc" : "Iris",
      "text" : "I'll stop Bijou from taking Ymir's Heart. You go ahead and take care of that huge monster!"
    },
    {
      "kind" : "message",
      "line" : 423,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 424,
      "npc" : "Iris",
      "text" : "Was that it...? Has it gone now?"
    },
    {
      "kind" : "message",
      "line" : 425,
      "npc" : "Iris",
      "text" : "So what's left now is..."
    },
    {
      "kind" : "message",
      "line" : 429,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 430,
      "npc" : "Iris",
      "text" : "Me...I'm the only one left..."
    },
    {
      "kind" : "message",
      "line" : 433,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 434,
      "npc" : "Iris",
      "text" : "What?!"
    },
    {
      "kind" : "message",
      "line" : 436,
      "npc" : "Iris",
      "text" : "~POW!~"
    },
    {
      "kind" : "message",
      "line" : 440,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 441,
      "npc" : "Iris",
      "text" : "Aaarrghhh---!!!"
    },
    {
      "kind" : "message",
      "line" : 444,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 445,
      "npc" : "Iris",
      "text" : "I must say it was rather unexpected. ~Chuckles~"
    },
    {
      "kind" : "message",
      "line" : 446,
      "npc" : "Iris",
      "text" : "I didn't expect anyone to defeat Amdarais that I spent three good years to complete."
    },
    {
      "kind" : "message",
      "line" : 449,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 450,
      "npc" : "Iris",
      "text" : "You will pay"
    },
    {
      "kind" : "message",
      "line" : 451,
      "npc" : "Iris",
      "text" : "for ruining my three-year efforts!!"
    },
    {
      "kind" : "message",
      "line" : 452,
      "npc" : "Iris",
      "text" : "Slowly..."
    },
    {
      "kind" : "message",
      "line" : 453,
      "npc" : "Iris",
      "text" : "And horribly painfully...!!"
    },
    {
      "kind" : "message",
      "line" : 500,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 501,
      "npc" : "Fenrir",
      "text" : "~Groans~ I can't believe nothing seems to work!"
    },
    {
      "kind" : "message",
      "line" : 504,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 505,
      "npc" : "Fenrir",
      "text" : "~Chuckles~"
    },
    {
      "kind" : "message",
      "line" : 506,
      "npc" : "Fenrir",
      "text" : "I'll let you taste what despair feels like."
    },
    {
      "kind" : "message",
      "line" : 509,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 510,
      "npc" : "Fenrir",
      "text" : "Frost Diver!"
    },
    {
      "kind" : "message",
      "line" : 516,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 517,
      "npc" : "Fenrir",
      "text" : "~Groans~"
    },
    {
      "kind" : "message",
      "line" : 520,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 521,
      "npc" : "Fenrir",
      "text" : "How does it feel? Painful, eh?"
    },
    {
      "kind" : "message",
      "line" : 522,
      "npc" : "Fenrir",
      "text" : "You must become paralyzed by now."
    },
    {
      "kind" : "message",
      "line" : 523,
      "npc" : "Fenrir",
      "text" : "...But don't expect me to kill you that easily..."
    },
    {
      "kind" : "message",
      "line" : 525,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 526,
      "npc" : "Fenrir",
      "text" : "I should take care of this downright annoying cleric gal first."
    },
    {
      "kind" : "message",
      "line" : 529,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 530,
      "npc" : "Fenrir",
      "text" : "I...Iris!!"
    },
    {
      "kind" : "message",
      "line" : 533,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 534,
      "npc" : "Fenrir",
      "text" : "......"
    },
    {
      "kind" : "message",
      "line" : 538,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 539,
      "npc" : "Fenrir",
      "text" : "Sarah...?"
    },
    {
      "kind" : "message",
      "line" : 542,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 543,
      "npc" : "Fenrir",
      "text" : "So this is it..."
    },
    {
      "kind" : "message",
      "line" : 544,
      "npc" : "Fenrir",
      "text" : "This is the underground of Prontera Castle."
    },
    {
      "kind" : "message",
      "line" : 545,
      "npc" : "Fenrir",
      "text" : "The place where the first Ymir's Heart is sealed."
    },
    {
      "kind" : "message",
      "line" : 547,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 548,
      "npc" : "Fenrir",
      "text" : "And that must be..."
    },
    {
      "kind" : "message",
      "line" : 549,
      "npc" : "Fenrir",
      "text" : "Ymir's Heart..."
    },
    {
      "kind" : "message",
      "line" : 552,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 553,
      "npc" : "Fenrir",
      "text" : "What brought you all the way up here?"
    },
    {
      "kind" : "message",
      "line" : 554,
      "npc" : "Fenrir",
      "text" : "Sarah Irine."
    },
    {
      "kind" : "message",
      "line" : 555,
      "npc" : "Fenrir",
      "text" : "I didn't expect you would show up here."
    },
    {
      "kind" : "message",
      "line" : 558,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 559,
      "npc" : "Fenrir",
      "text" : "What do you think you're doing here, Bijou?"
    },
    {
      "kind" : "message",
      "line" : 562,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 563,
      "npc" : "Fenrir",
      "text" : "Yes, I was in the middle of taking care of the annoying bugs."
    },
    {
      "kind" : "message",
      "line" : 566,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 567,
      "npc" : "Fenrir",
      "text" : "What kind of answer is that, Bijou?"
    },
    {
      "kind" : "message",
      "line" : 569,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 570,
      "npc" : "Fenrir",
      "text" : "My question was: what are you still doing here, totally goofing off, and, why didn't you break any sealing off of Ymir's Heart?"
    },
    {
      "kind" : "message",
      "line" : 573,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 574,
      "npc" : "Fenrir",
      "text" : "Well, that's uh...I did break the 1st seal, though."
    },
    {
      "kind" : "message",
      "line" : 575,
      "npc" : "Fenrir",
      "text" : "This place will be cleaned up in no time. There is nothing for you to worry about, Sarah."
    },
    {
      "kind" : "message",
      "line" : 577,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 578,
      "npc" : "Fenrir",
      "text" : "Trust me and consider it done. Please be yourself as proud Valkyrie."
    },
    {
      "kind" : "message",
      "line" : 581,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 582,
      "npc" : "Fenrir",
      "text" : "(~Scoffs~ What an uptight, pathetic Valkyrie she is! I can't believe a greenhorn like you are treated the same as Himelmez. That is so unfair.)"
    },
    {
      "kind" : "message",
      "line" : 585,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 586,
      "npc" : "Fenrir",
      "text" : "You must be out of your mind, Bijou...There is no Himelmez here."
    },
    {
      "kind" : "message",
      "line" : 589,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 590,
      "npc" : "Fenrir",
      "text" : "....~Gasps~"
    },
    {
      "kind" : "message",
      "line" : 591,
      "npc" : "Fenrir",
      "text" : "I'm out of breath!"
    },
    {
      "kind" : "message",
      "line" : 594,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 595,
      "npc" : "Fenrir",
      "text" : "You'd better keep your mouth shut!"
    },
    {
      "kind" : "message",
      "line" : 598,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 599,
      "npc" : "Fenrir",
      "text" : "~Coughs~"
    },
    {
      "kind" : "message",
      "line" : 600,
      "npc" : "Fenrir",
      "text" : "~Keeps coughing~"
    },
    {
      "kind" : "message",
      "line" : 603,
      "npc" : "Fenrir",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 604,
      "npc" : "Fenrir",
      "text" : "I can certainly do without a subordinate who wastes time for this kind of petty job."
    },
    {
      "kind" : "message",
      "line" : 605,
      "npc" : "Fenrir",
      "text" : "Let me take that Ymir's Heart...myself."
    },
    {
      "kind" : "message",
      "line" : 609,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 610,
      "npc" : "Fenrir",
      "text" : "(She is Valkyrie, indeed. Oh, what can you do about that?)"
    },
    {
      "kind" : "message",
      "line" : 613,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 614,
      "npc" : "Fenrir",
      "text" : "The time is right!"
    },
    {
      "kind" : "message",
      "line" : 615,
      "npc" : "Fenrir",
      "text" : "Frost Diver!"
    },
    {
      "kind" : "message",
      "line" : 619,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 620,
      "npc" : "Fenrir",
      "text" : "What did you say?!"
    },
    {
      "kind" : "message",
      "line" : 622,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 623,
      "npc" : "Fenrir",
      "text" : "Whoa...That was a close; call."
    },
    {
      "kind" : "message",
      "line" : 624,
      "npc" : "Fenrir",
      "text" : "How could this happen?"
    },
    {
      "kind" : "message",
      "line" : 627,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 628,
      "npc" : "Fenrir",
      "text" : "This magic..."
    },
    {
      "kind" : "message",
      "line" : 629,
      "npc" : "Fenrir",
      "text" : "This must be high-level magic as I expected. It's pretty tough to cast it."
    },
    {
      "kind" : "message",
      "line" : 632,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 633,
      "npc" : "Fenrir",
      "text" : "(What is this?! Did she just master the magic that I used on her?)"
    },
    {
      "kind" : "message",
      "line" : 636,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 637,
      "npc" : "Fenrir",
      "text" : "Iris! This is a healing potion."
    },
    {
      "kind" : "message",
      "line" : 638,
      "npc" : "Fenrir",
      "text" : "Drink it and you'll come to your senses."
    },
    {
      "kind" : "message",
      "line" : 643,
      "npc" : "Fenrir",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 644,
      "npc" : "Fenrir",
      "text" : "~Muffled sound~"
    },
    {
      "kind" : "message",
      "line" : 649,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 650,
      "npc" : "Fenrir",
      "text" : "Oh, you woke up now?"
    },
    {
      "kind" : "message",
      "line" : 653,
      "npc" : "Fenrir",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 654,
      "npc" : "Fenrir",
      "text" : "Umm...."
    },
    {
      "kind" : "message",
      "line" : 655,
      "npc" : "Fenrir",
      "text" : "~Vomiting sound~"
    },
    {
      "kind" : "message",
      "line" : 656,
      "npc" : "Fenrir",
      "text" : "Yuck! Is this bitter!"
    },
    {
      "kind" : "message",
      "line" : 657,
      "npc" : "Fenrir",
      "text" : "What the heck is this?!"
    },
    {
      "kind" : "message",
      "line" : 658,
      "npc" : "Fenrir",
      "text" : "What did you give to me?"
    },
    {
      "kind" : "message",
      "line" : 661,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 662,
      "npc" : "Fenrir",
      "text" : "So you woke up, Iris."
    },
    {
      "kind" : "message",
      "line" : 663,
      "npc" : "Fenrir",
      "text" : "I'm so relieved."
    },
    {
      "kind" : "message",
      "line" : 666,
      "npc" : "Fenrir",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 667,
      "npc" : "Fenrir",
      "text" : "~Sighs~ By the way, Fenrir!"
    },
    {
      "kind" : "message",
      "line" : 668,
      "npc" : "Fenrir",
      "text" : "What about Ymir's Heart?"
    },
    {
      "kind" : "message",
      "line" : 671,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 672,
      "npc" : "Fenrir",
      "text" : "(...Fenrir? I thought too much about Ymir's Heart and totally forgot about her. If my guess is right, she must be...!)"
    },
    {
      "kind" : "message",
      "line" : 674,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 675,
      "npc" : "Fenrir",
      "text" : "~Exhales~ I see. That's right."
    },
    {
      "kind" : "message",
      "line" : 676,
      "npc" : "Fenrir",
      "text" : "That beast's blood flowing through your body...That was the answer!"
    },
    {
      "kind" : "message",
      "line" : 679,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 680,
      "npc" : "Fenrir",
      "text" : "Then, let me serve you the right way! ~Chuckles~"
    },
    {
      "kind" : "message",
      "line" : 681,
      "npc" : "Fenrir",
      "text" : "I didn't expect to see the hero from a thousand years ago!"
    },
    {
      "kind" : "message",
      "line" : 684,
      "npc" : "Fenrir",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 685,
      "npc" : "Fenrir",
      "text" : "Die!!"
    },
    {
      "kind" : "message",
      "line" : 688,
      "npc" : "Fenrir",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 689,
      "npc" : "Fenrir",
      "text" : "...Be careful. She's about to attack!"
    },
    {
      "kind" : "message",
      "line" : 781,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 782,
      "npc" : "Iris",
      "text" : "~Grunts~"
    },
    {
      "kind" : "message",
      "line" : 785,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 786,
      "npc" : "Iris",
      "text" : "~Evil laughter~ Die!"
    },
    {
      "kind" : "message",
      "line" : 787,
      "npc" : "Iris",
      "text" : "Clerics deserve to die!"
    },
    {
      "kind" : "message",
      "line" : 791,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 792,
      "npc" : "Iris",
      "text" : "Iris!!"
    },
    {
      "kind" : "message",
      "line" : 793,
      "npc" : "Iris",
      "text" : "No! Stop!!"
    },
    {
      "kind" : "message",
      "line" : 797,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 798,
      "npc" : "Iris",
      "text" : "~Chuckles~"
    },
    {
      "kind" : "message",
      "line" : 799,
      "npc" : "Iris",
      "text" : "So you're looking for a partner, eh?"
    },
    {
      "kind" : "message",
      "line" : 800,
      "npc" : "Iris",
      "text" : "Good idea, but...I think it's too late."
    },
    {
      "kind" : "message",
      "line" : 803,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 804,
      "npc" : "Iris",
      "text" : "Because..."
    },
    {
      "kind" : "message",
      "line" : 805,
      "npc" : "Iris",
      "text" : "This will be the final, fatal blow to you. Wahahaha!"
    },
    {
      "kind" : "message",
      "line" : 811,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 812,
      "npc" : "Iris",
      "text" : "....~Sighs~"
    },
    {
      "kind" : "message",
      "line" : 813,
      "npc" : "Iris",
      "text" : "Huh?...In my stomach..."
    },
    {
      "kind" : "message",
      "line" : 814,
      "npc" : "Iris",
      "text" : "This knife..."
    },
    {
      "kind" : "message",
      "line" : 815,
      "npc" : "Iris",
      "text" : "Sa...Sarah...? How?"
    },
    {
      "kind" : "message",
      "line" : 819,
      "npc" : "Iris",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 820,
      "npc" : "Iris",
      "text" : "Is that all you want to say?"
    },
    {
      "kind" : "message",
      "line" : 821,
      "npc" : "Iris",
      "text" : "Don't worry. I'll let Himelmez know of your brave contribution. Don't blame me, Bijou."
    },
    {
      "kind" : "message",
      "line" : 823,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 824,
      "npc" : "Iris",
      "text" : "Why...? Tell me why!"
    },
    {
      "kind" : "message",
      "line" : 825,
      "npc" : "Iris",
      "text" : "...That...that little chick...Was that it? Because she's your sister? Was that it? Tell me, Sarah!"
    },
    {
      "kind" : "message",
      "line" : 827,
      "npc" : "Iris",
      "text" : "[Bijou]"
    },
    {
      "kind" : "message",
      "line" : 828,
      "npc" : "Iris",
      "text" : "~Groans~"
    },
    {
      "kind" : "message",
      "line" : 832,
      "npc" : "Iris",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 833,
      "npc" : "Iris",
      "text" : "......"
    },
    {
      "kind" : "message",
      "line" : 834,
      "npc" : "Iris",
      "text" : "Your soul has been set free, Bijou."
    },
    {
      "kind" : "message",
      "line" : 837,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 838,
      "npc" : "Iris",
      "text" : "(Did she save me...?)"
    },
    {
      "kind" : "message",
      "line" : 840,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 841,
      "npc" : "Iris",
      "text" : "Sarah..."
    },
    {
      "kind" : "message",
      "line" : 842,
      "npc" : "Iris",
      "text" : "It's Sarah, right?"
    },
    {
      "kind" : "message",
      "line" : 843,
      "npc" : "Iris",
      "text" : "People say we parted when we were little..."
    },
    {
      "kind" : "message",
      "line" : 845,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 846,
      "npc" : "Iris",
      "text" : "...So what's your plan, huh? Why...why did you save me?!"
    },
    {
      "kind" : "message",
      "line" : 847,
      "npc" : "Iris",
      "text" : "Don't you ever think this will ever change my belief! I will never, ever forgive you!"
    },
    {
      "kind" : "message",
      "line" : 849,
      "npc" : "Iris",
      "text" : "[Iris]"
    },
    {
      "kind" : "message",
      "line" : 850,
      "npc" : "Iris",
      "text" : "Mom...Dad...Every people in our town. I'm going to revenge!"
    },
    {
      "kind" : "message",
      "line" : 853,
      "npc" : "Iris",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 854,
      "npc" : "Iris",
      "text" : "Shut that mouth!"
    },
    {
      "kind" : "message",
      "line" : 855,
      "npc" : "Iris",
      "text" : "Don't be a drama queen as if you're the only victim here."
    },
    {
      "kind" : "message",
      "line" : 856,
      "npc" : "Iris",
      "text" : "They just paid the price for what they sinned. The sin that they committed by killing my mother 12 years ago."
    },
    {
      "kind" : "message",
      "line" : 858,
      "npc" : "Iris",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 859,
      "npc" : "Iris",
      "text" : "Do you want me to tell you the truth? Those 'loved ones' you're incessantly talking about...Our great elder and the people in our town were actually..."
    },
    {
      "kind" : "message",
      "line" : 861,
      "npc" : "Iris",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 862,
      "npc" : "Iris",
      "text" : "......"
    },
    {
      "kind" : "message",
      "line" : 863,
      "npc" : "Iris",
      "text" : "Stop it..."
    },
    {
      "kind" : "message",
      "line" : 864,
      "npc" : "Iris",
      "text" : "Ymir's Heart comes first, no matter what."
    },
    {
      "kind" : "message",
      "line" : 866,
      "npc" : "Iris",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 867,
      "npc" : "Iris",
      "text" : "Mark my word."
    },
    {
      "kind" : "message",
      "line" : 868,
      "npc" : "Iris",
      "text" : "I didn't let you live."
    },
    {
      "kind" : "message",
      "line" : 869,
      "npc" : "Iris",
      "text" : "I will let you die soon."
    },
    {
      "kind" : "message",
      "line" : 870,
      "npc" : "Iris",
      "text" : "I make sure you no longer see the light of day the next time when we meet."
    },
    {
      "kind" : "message",
      "line" : 872,
      "npc" : "Iris",
      "text" : "[Sarah]"
    },
    {
      "kind" : "message",
      "line" : 873,
      "npc" : "Iris",
      "text" : "Don't you ever let anyone kill you until then, Iris."
    },
    {
      "kind" : "message",
      "line" : 874,
      "npc" : "Iris",
      "text" : "I'd better bid farewell for today, then."
    },
    {
      "kind" : "message",
      "line" : 879,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 880,
      "npc" : "Iris",
      "text" : "~Grunts~ That Valkyrie destroyed the ceiling when taking Ymir's Heart!"
    },
    {
      "kind" : "message",
      "line" : 882,
      "npc" : "Iris",
      "text" : "[Fenrir]"
    },
    {
      "kind" : "message",
      "line" : 883,
      "npc" : "Iris",
      "text" : "We'd better get out of here, too! This place is too dangerous!"
    }
  ]
}