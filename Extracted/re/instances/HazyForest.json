      "line" : 104,
      "npc" : "Laphine Soldier",
      "text" : "[Laphine Soldier]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Laphine Soldier",
      "text" : "We can't go against the forest,"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Laphine Soldier",
