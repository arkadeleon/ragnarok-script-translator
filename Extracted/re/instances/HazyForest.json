      "kind" : "message",
      "line" : 99,
      "npc" : "Laphine Soldier",
      "text" : "[Laphine Soldier]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Laphine Soldier",
      "text" : "You'll get permission soon."
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Laphine Soldier",
      "text" : "Now go to the log tunnel, the only way to get into the Hazy Forest."
