{
  "file" : "npc/re/merchants/enchan_rockridge.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 13,
      "npc" : "Contraband Processor",
      "text" : "I'm carrying too many types of items. I should lighten my bag first."
    },
    {
      "kind" : "message",
      "line" : 17,
      "npc" : "Contraband Processor",
      "text" : "I'm overweight. I'd better lighten my bag first."
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Contraband Processor",
      "text" : "Have you tried to buy some contraband items with Rock Ridge Coins? I can make your contraband items better."
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "text" : "Make them better? How?"
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "text" : "Enchant contraband items."
    },
    {
      "kind" : "option",
      "line" : 24,
      "npc" : "Contraband Processor",
      "text" : "Reset contraband item Enchantment level."
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Contraband Processor",
      "text" : "Ah, have we met before? I meet so many people every day that I can't remember all of their faces. Let me catch you up to speed."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Contraband Processor",
      "text" : "I can enchant the equipment that you can buy with Rock Ridge Coins, for up to 3 sockets for Armor and Garments and up to 2 sockets for Accessories."
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Contraband Processor",
      "text" : "I charge 2 Rock Ridge Coins per socket for both enchanting and resetting."
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Contraband Processor",
      "text" : "Oh, and note that these contraband items are prone to destruction, especially when they are reset."
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Contraband Processor",
      "text" : "Cancel"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Contraband Processor",
      "text" : "Armor"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Contraband Processor",
      "text" : "Garment"
    },
    {
      "kind" : "option",
      "line" : 39,
      "npc" : "Contraband Processor",
      "text" : "Accessory (Right Slot)"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Contraband Processor",
      "text" : "You're silly."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Contraband Processor",
      "text" : "Why are you wasting my time? Go wear your equipment first."
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Contraband Processor",
      "text" : "I don't handle items like this."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Contraband Processor",
      "text" : "Something wrong happened."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Contraband Processor",
      "text" : "It's not enchanted. What do you expect me to reset?"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Contraband Processor",
      "text" : "Oh, do you really want to reset it? As I told you before, contraband Vigilante Badges are prone to destruction."
    },
    {
      "kind" : "option",
      "line" : 95,
      "npc" : "Contraband Processor",
      "text" : "I'll come back later."
    },
    {
      "kind" : "option",
      "line" : 95,
      "npc" : "Contraband Processor",
      "text" : "Let's do it."
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Contraband Processor",
      "text" : "Alright, come back if you change your mind."
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Contraband Processor",
      "text" : "This has been enchanted to the maximum limit. Maybe you should reset it."
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Contraband Processor",
      "text" : "This has been enchanted to the maximum limit. Maybe you should reset it."
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Contraband Processor",
      "text" : "Did you just try to switch equipment?"
    },
    {
      "kind" : "message",
      "line" : 214,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "Contraband Processor",
      "text" : "I charge 2 Rock Ridge Coins for this service. Bring them to me."
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 228,
      "npc" : "Contraband Processor",
      "text" : "Ah, that didn't turn out well."
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Contraband Processor",
      "text" : "Well, just my luck."
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Contraband Processor",
      "text" : "[Contraband Processor]"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Contraband Processor",
      "text" : "Done. Check it out."
    },
    {
      "kind" : "message",
