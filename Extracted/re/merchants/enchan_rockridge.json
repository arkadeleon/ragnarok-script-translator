      "kind" : "message",
      "line" : 254,
      "npc" : "Affable Lady",
      "text" : "[Affable Lady]"
    },
    {
      "kind" : "message",
      "line" : 255,
      "npc" : "Affable Lady",
      "text" : "Hmpf, don't act like you don't know. I'm talking about the special equipment you can buy in Rock Ridge."
    },
    {
      "kind" : "message",
      "line" : 257,
      "npc" : "Affable Lady",
      "text" : "[Affable Lady]"
    },
    {
      "kind" : "message",
