      "npc" : "Affable Lady",
      "text" : "[Affable Lady]"
    },
    {
      "kind" : "message",
      "line" : 250,
      "npc" : "Affable Lady",
      "text" : "You're an adventurer. I like people like you who have passion."
    },
    {
      "kind" : "message",
      "line" : 251,
      "npc" : "Affable Lady",
      "text" : "So, are you here because of ^0000CDit^000000?"
