      "npc" : "Affable Lady",
      "text" : "The armor dealer brings in new stock every Friday, and it's sold almost as soon as it's in, every time."
    },
    {
      "kind" : "message",
      "line" : 261,
      "npc" : "Affable Lady",
      "text" : "[Affable Lady]"
    },
    {
      "kind" : "message",
      "line" : 262,
      "npc" : "Affable Lady",
      "text" : "*Chuckle* Which one do you want: one for your ^0000CDshoulders^000000, ^0000CDneck, or chest^000000?"
    },
    {
      "kind" : "option",
      "line" : 264,
      "npc" : "Affable Lady",
      "text" : "Um, anything."
    },
    {
      "kind" : "option",
      "line" : 264,
      "npc" : "Affable Lady",
      "text" : "For my shoulders"
