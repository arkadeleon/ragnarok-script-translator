    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Cash Sales Guide",
      "text" : "Okay~"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Cash Sales Guide",
      "text" : "But don't get frustrated."
    },
    {
      "kind" : "message",
