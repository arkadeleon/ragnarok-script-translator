      "kind" : "message",
      "line" : 76,
      "npc" : "RareDiamondMerchant",
      "text" : "It's rather inexpensive!"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "RareDiamondMerchant",
      "text" : "If you're interested, talk to me any time!"
