    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Traveler Ichack",
      "text" : "[Traveler Ichack]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Traveler Ichack",
      "text" : "There was someone in the expedition team claiming that he was the first, but it WAS me. That's right."
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Traveler Ichack",
      "text" : "[Traveler Ichack]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Traveler Ichack",
      "text" : "That's why I will provide a service to guide adventurers from Midgard."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Traveler Ichack",
      "text" : "What would you like to know?"
