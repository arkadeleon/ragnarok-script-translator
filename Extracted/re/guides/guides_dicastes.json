      "kind" : "message",
      "line" : 80,
      "npc" : "Traveler Ichack",
      "text" : "Perhaps it's because trading is involved."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Traveler Ichack",
      "text" : "Poor cats. They must be shivering from the cold out there."
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Traveler Ichack",
