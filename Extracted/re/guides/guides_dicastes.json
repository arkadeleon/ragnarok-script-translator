    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Traveler Ichack",
      "text" : "Oh!! You are a stranger!"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Traveler Ichack",
      "text" : "I'm Ichack, the first adventurer that arrived here in El Dicastes!"
