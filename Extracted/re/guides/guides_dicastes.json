      "kind" : "message",
      "line" : 53,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"upper area\",\"dicastes01,280,283\")"
      ],
      "text" : "{0} is around 1 o'clock."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Traveler Ichack",
      "text" : "[Traveler Ichack]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Traveler Ichack",
      "text" : "Because of the dangers here, we need better security..."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Traveler Ichack",
      "text" : "Have you ever been to the "
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"training room\",\"dicastes01,255,172\")"
      ],
      "text" : "{0}? The training guards seem to never sleep!"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Traveler Ichack",
      "text" : "[Traveler Ichack]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Traveler Ichack",
      "text" : "This is one of the most important reasons why they live here."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"factory\",\"dicastes01,97,256\")"
      ],
      "text" : "If you go to the {0}, you can see the recently refined Bradium."
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Traveler Ichack",
      "text" : "[Traveler Ichack]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Traveler Ichack",
      "text" : "Although I arrived here as the first adventurer, the owner of the pub was the first person here."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Traveler Ichack",
      "placeholders" : [
        "F_Navi(\"Bumen Florine's pub\",\"dicastes01,136,106\")"
      ],
      "text" : "{0} is located underground in the lower residential area."
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Traveler Ichack",
      "text" : "He might have some valuable information for you."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Traveler Ichack",
      "text" : "[Traveler Ichack]"
    },
    {
      "kind" : "message",
