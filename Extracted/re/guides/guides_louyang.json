    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Luoyang Guide",
      "text" : "[Representative]"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Luoyang Guide",
      "text" : "Knowing your enemy"
    },
    {
      "kind" : "message",
