      "npc" : "Luoyang Guide",
      "placeholders" : [
        "F_Navi(\"Tavern\",\"louyang,280,165\")"
      ],
      "text" : "When you get tired during your trip, I suggest that you visit the {0}. It's located at ^00FF00+^000000."
    },
