      "line" : 88,
      "npc" : "Luoyang Guide",
      "text" : "[Representative]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Luoyang Guide",
      "text" : "The Tavern is a good place"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Luoyang Guide",
      "text" : "to meet other tourists, as well as to hear of any news that may be helpful to know."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Luoyang Guide",
      "text" : "[Representative]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Luoyang Guide",
      "placeholders" : [
        "F_Navi(\"Observatory\",\"louyang,136,245\")"
      ],
      "text" : "You won't get a better view of the world than you can at the {0}."
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Luoyang Guide",
      "text" : "It's a must see here."
    },
