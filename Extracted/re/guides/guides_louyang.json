      "npc" : "Luoyang Guide",
      "placeholders" : [
        "F_Navi(\"Doctor's Office\",\"louyang,261,93\",\"^AAFF00\")"
      ],
      "text" : "It's a famous {0}"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Luoyang Guide",
      "text" : "according to rumor it can cure all diseases. But I'm not sure if it's true or not."
