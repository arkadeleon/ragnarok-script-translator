      "npc" : "Luoyang Guide",
      "text" : "[Representative]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Luoyang Guide",
      "text" : "We now provide an ocean lane to accomodate foreign travelers and intercultural exchange from which all can benefit."
