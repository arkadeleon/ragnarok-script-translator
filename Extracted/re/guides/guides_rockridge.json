      "line" : 14,
      "npc" : "Guide",
      "text" : "[Sheriff Assistant]"
    },
    {
      "kind" : "message",
      "line" : 15,
      "npc" : "Guide",
      "text" : "Tell me where you want to go, and I'll show you where it is."
