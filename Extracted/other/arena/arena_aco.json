      "text" : "under Acolyte Class Mode."
    },
    {
      "kind" : "message",
      "line" : 1665,
      "npc" : "Guide Alias",
      "text" : "These are ^3131FFAcolyte Mode^000000 and"
    },
    {
      "kind" : "message",
      "line" : 1666,
      "npc" : "Guide Alias",
      "text" : "^3131FFPriest Mode^000000. For both modes,"
    },
    {
      "kind" : "message",
      "line" : 1667,
      "npc" : "Guide Alias",
      "text" : "you will need to wait inside the ^3131FFAcolyte Class Waiting Room^000000."
