{
  "file" : "npc/other/pvp.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "PVP Narrator",
      "text" : "Hello and welcome!"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "PVP Narrator",
      "text" : "I am in charge of"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "PVP Narrator",
      "text" : "explaining the PVP Modes."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "PVP Narrator",
      "text" : "I am the PVP Narrator!"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "PVP Narrator",
      "text" : "What is PVP?"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "PVP Narrator",
      "text" : "What are the PVP Modes?"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "PVP Narrator",
      "text" : "What are the rules for PVP?"
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "PVP Narrator",
      "text" : "Save Position."
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "PVP Narrator",
      "text" : "End Dialog."
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "PVP Narrator",
      "text" : "In short, PVP means"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "PVP Narrator",
      "text" : "' Player VS Player Mode '"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "PVP Narrator",
      "text" : "It's a unique place for people"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "PVP Narrator",
      "text" : "to duel with each other."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "PVP Narrator",
      "text" : "Just tell the"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "PVP Narrator",
      "text" : "^3355FFGate Keeper^000000"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "PVP Narrator",
      "text" : "that you want to try. He will"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "PVP Narrator",
      "text" : "let you enter the PVP square."
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "PVP Narrator",
      "text" : "But, you need to be at"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "PVP Narrator",
      "text" : "least level 31. And you"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "PVP Narrator",
      "text" : "must pay 500 zeny entrance fee in order"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "PVP Narrator",
      "text" : "to enter a PVP fight square."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "PVP Narrator",
      "text" : "When you are qualified, you"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "PVP Narrator",
      "text" : "can choose one of the two modes."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "PVP Narrator",
      "text" : "Yoyo Mode or Nightmare Mode."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "PVP Narrator",
      "text" : "Yoyo Mode is risk free."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "PVP Narrator",
      "text" : "You can experience PVP"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "PVP Narrator",
      "text" : "without any restriction or"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "PVP Narrator",
      "text" : "punishment. It is recommended"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "PVP Narrator",
      "text" : "that you practice your skills"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "PVP Narrator",
      "text" : "here before you move on."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "PVP Narrator",
      "text" : "Nightmare Mode is very"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "PVP Narrator",
      "text" : "dangerous! Please be cautious,"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "PVP Narrator",
      "text" : "you will lose some of your"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "PVP Narrator",
      "text" : "EXP when you are defeated. And"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "PVP Narrator",
      "text" : "there is a small chance that"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "PVP Narrator",
      "text" : "you will drop some equipment."
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "PVP Narrator",
      "text" : "However, if you win, the"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "PVP Narrator",
      "text" : "rewards can be great!"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "PVP Narrator",
      "text" : "To avoid misunderstanding,"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "PVP Narrator",
      "text" : "you should think twice"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "PVP Narrator",
      "text" : "before you go there..."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "PVP Narrator",
      "text" : "Good Luck!"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "PVP Narrator",
      "text" : "Each of the fight squares"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "PVP Narrator",
      "text" : "have a row of Narrators and"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "PVP Narrator",
      "text" : "choose them based on your"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "PVP Narrator",
      "text" : "qualifications."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "PVP Narrator",
      "text" : "Each Narrator will ask"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "PVP Narrator",
      "text" : "which of the five PVP maps"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "PVP Narrator",
      "text" : "you wish to go to."
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "PVP Narrator",
      "text" : "Choose, and go in!"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "PVP Narrator",
      "text" : "Each map has a limitation on"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "PVP Narrator",
      "text" : "the number of people who can"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "PVP Narrator",
      "text" : "participate. So you will see"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "PVP Narrator",
      "text" : "figures in the corner showing"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "PVP Narrator",
      "text" : "'Attendee/Total'."
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "PVP Narrator",
      "text" : "Also, there is a hidden EXP"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "PVP Narrator",
      "text" : "value in PVP mode. This EXP"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "PVP Narrator",
      "text" : "score will only apply inside"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "PVP Narrator",
      "text" : "of the PVP zone, so do not"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "PVP Narrator",
      "text" : "worry."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "PVP Narrator",
      "text" : "Every player's EXP at the"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "PVP Narrator",
      "text" : "beginning is usually 5 points."
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "PVP Narrator",
      "text" : "If you win, it will"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "PVP Narrator",
      "text" : "increase by 1 point"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "PVP Narrator",
      "text" : "In the same way, when you"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "PVP Narrator",
      "text" : "lose... Your EXP will"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "PVP Narrator",
      "text" : "drop by 5 points."
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "PVP Narrator",
      "text" : "So be careful!"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "PVP Narrator",
      "text" : "When you are defeated"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "PVP Narrator",
      "text" : "And your EXP is equal"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "PVP Narrator",
      "text" : "to or less than 0,"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "PVP Narrator",
      "text" : "You will be removed from PVP"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "PVP Narrator",
      "text" : "and your duel is finished!"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "PVP Narrator",
      "text" : "However, if your EXP is more"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "PVP Narrator",
      "text" : "than 0. You can still get help"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "PVP Narrator",
      "text" : "through other players healing..."
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "PVP Narrator",
      "text" : "Do you get it?"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "PVP Narrator",
      "text" : "The fighting commands inside of"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "PVP Narrator",
      "text" : "PVP are the same as the normal."
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "PVP Narrator",
      "text" : "All the basic controls are the"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "PVP Narrator",
      "text" : "same."
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "PVP Narrator",
      "text" : "However, there is one thing..."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "PVP Narrator",
      "text" : "Within the PVP fight square"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "PVP Narrator",
      "text" : "and PVP fighting zones,"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "PVP Narrator",
      "text" : "you cannot save your position."
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "PVP Narrator",
      "text" : "Remember well... These rules"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "PVP Narrator",
      "text" : "can help to ensure your victory."
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "PVP Narrator",
      "text" : "Position successfully saved..."
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "PVP Narrator",
      "text" : "Thank you very much!"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "PVP Narrator",
      "text" : "We will see you again soon."
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "PVP Narrator",
      "text" : "[PVP Narrator]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "PVP Narrator",
      "text" : "With war raging between monsters"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "PVP Narrator",
      "text" : "and humans, this competition"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "PVP Narrator",
      "text" : "among people - PVP -"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "PVP Narrator",
      "text" : "encourages us all to get"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "PVP Narrator",
      "text" : "stronger. Come again,"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "PVP Narrator",
      "text" : "we welcome your challenge!"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Gate Keeper",
      "text" : "[Gate Keeper]"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Gate Keeper",
      "text" : "Glad to be of service."
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Gate Keeper",
      "text" : "I will open the PVP fight"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Gate Keeper",
      "text" : "square for you! If you have"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Gate Keeper",
      "text" : "any questions about the PVP"
    },
    {
      "kind" : "message",
      "line" : 184,
      "npc" : "Gate Keeper",
      "text" : "modes or rules, Please ask"
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Gate Keeper",
      "text" : "the Narrator..."
    },
    {
      "kind" : "option",
      "line" : 187,
      "npc" : "Gate Keeper",
      "text" : "^FF5533' PvP Nightmare Mode'^000000"
    },
    {
      "kind" : "option",
      "line" : 187,
      "npc" : "Gate Keeper",
      "text" : "^3355FF' PvP Yoyo Mode'^000000"
    },
    {
      "kind" : "option",
      "line" : 187,
      "npc" : "Gate Keeper",
      "text" : "^3355FF' PvP Event Mode'^000000"
    },
    {
      "kind" : "option",
      "line" : 187,
      "npc" : "Gate Keeper",
      "text" : "Quit"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Gate Keeper",
      "text" : "[Gate Keeper]"
    },
    {
      "kind" : "message",
      "line" : 190,
      "npc" : "Gate Keeper",
      "text" : "I am sorry, but currently the Nightmare mode service is not available."
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Gate Keeper",
      "text" : "Please use the Yoyo Mode instead. We apologize for the inconvenience."
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Gate Keeper",
      "text" : "[Gate Keeper]"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Gate Keeper",
      "text" : "The admission fee is 500 Zeny."
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Gate Keeper",
      "text" : "Do you want to move"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Gate Keeper",
      "text" : "to the Yoyo Mode"
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Gate Keeper",
      "text" : "fight square?"
    },
    {
      "kind" : "option",
      "line" : 200,
      "npc" : "Gate Keeper",
      "text" : "Move"
    },
    {
      "kind" : "option",
      "line" : 200,
      "npc" : "Gate Keeper",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Gate Keeper",
      "text" : "[Gate Keeper]"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Gate Keeper",
      "text" : "Excuse me, but"
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Gate Keeper",
      "text" : "did you not come prepared?"
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Gate Keeper",
      "text" : "Double check that you have the"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Gate Keeper",
      "text" : "500 Zeny entrance fee, and"
    },
    {
      "kind" : "message",
      "line" : 212,
      "npc" : "Gate Keeper",
      "text" : "that you are at least level 31!"
    },
    {
      "kind" : "message",
      "line" : 216,
      "npc" : "Gate Keeper",
      "text" : "[Gate Keeper]"
    },
    {
      "kind" : "message",
      "line" : 217,
      "npc" : "Gate Keeper",
      "text" : "With war raging between monsters"
    },
