    {
      "kind" : "message",
      "line" : 875,
      "npc" : "Arcade Helper",
      "text" : "[Helper]"
    },
    {
      "kind" : "message",
      "line" : 876,
      "npc" : "Arcade Helper",
      "text" : "If you'd like to play"
    },
    {
      "kind" : "message",
      "line" : 877,
      "npc" : "Arcade Helper",
      "text" : "a game of bingo, then"
    },
    {
      "kind" : "message",
      "line" : 878,
      "npc" : "Arcade Helper",
      "text" : "please proceed this way."
    },
    {
      "kind" : "message",
      "line" : 884,
      "npc" : "Arcade Owner",
      "text" : "[Arcade Owner]"
    },
    {
      "kind" : "message",
      "line" : 885,
      "npc" : "Arcade Owner",
      "text" : "Welcome to the"
    },
    {
      "kind" : "message",
      "line" : 886,
      "npc" : "Arcade Owner",
      "text" : "Bingo Game Arcade."
    },
    {
      "kind" : "message",
      "line" : 887,
      "npc" : "Arcade Owner",
      "text" : "Care to play a game of"
    },
    {
      "kind" : "message",
      "line" : 888,
      "npc" : "Arcade Owner",
      "text" : "bingo? If you have any"
    },
    {
      "kind" : "message",
      "line" : 889,
      "npc" : "Arcade Owner",
      "text" : "questions, feel free to ask."
    },
    {
      "kind" : "option",
      "line" : 891,
      "npc" : "Arcade Owner",
      "text" : "Rules for Bingo"
    },
    {
      "kind" : "option",
      "line" : 891,
      "npc" : "Arcade Owner",
      "text" : "Bingo Room"
    },
    {
      "kind" : "option",
      "line" : 891,
      "npc" : "Arcade Owner",
      "text" : "Marvelous Medals"
    },
    {
      "kind" : "message",
      "line" : 893,
      "npc" : "Arcade Owner",
      "text" : "[Arcade Owner]"
    },
    {
      "kind" : "message",
      "line" : 894,
      "npc" : "Arcade Owner",
      "text" : "The rules for playing bingo"
    },
    {
      "kind" : "message",
      "line" : 895,
      "npc" : "Arcade Owner",
      "text" : "are simple. First, take a board"
    },
    {
      "kind" : "message",
      "line" : 896,
      "npc" : "Arcade Owner",
      "text" : "with 25 boxes organized so that"
    },
    {
      "kind" : "message",
      "line" : 897,
      "npc" : "Arcade Owner",
      "text" : "there are five rows and five"
    },
    {
      "kind" : "message",
      "line" : 898,
      "npc" : "Arcade Owner",
      "text" : "columns. Then, number the"
    },
    {
      "kind" : "message",
      "line" : 899,
      "npc" : "Arcade Owner",
      "text" : "boxes in any order you like."
    },
    {
      "kind" : "message",
      "line" : 901,
      "npc" : "Arcade Owner",
      "text" : "[Arcade Owner]"
    },
    {
      "kind" : "message",
      "line" : 902,
      "npc" : "Arcade Owner",
      "text" : "Of course, you must use"
    },
    {
      "kind" : "message",
      "line" : 903,
      "npc" : "Arcade Owner",
      "text" : "the numbers 1 through 25."
    },
    {
      "kind" : "message",
      "line" : 904,
      "npc" : "Arcade Owner",
      "text" : "When everyone's bingo board"
    },
    {
      "kind" : "message",
      "line" : 905,
      "npc" : "Arcade Owner",
      "text" : "is ready, the game will begin."
    },
    {
      "kind" : "message",
      "line" : 906,
      "npc" : "Arcade Owner",
      "text" : "Our game coordinator will call out a number from 1 to 25 at random."
    },
    {
      "kind" : "message",
      "line" : 908,
      "npc" : "Arcade Owner",
      "text" : "[Arcade Owner]"
    },
    {
      "kind" : "message",
      "line" : 909,
      "npc" : "Arcade Owner",
      "text" : "Each time the coordinator"
    },
    {
      "kind" : "message",
      "line" : 910,
      "npc" : "Arcade Owner",
      "text" : "calls out a number, make sure"
    },
    {
      "kind" : "message",
      "line" : 911,
      "npc" : "Arcade Owner",
      "text" : "that you mark the corresponding"
    },
    {
      "kind" : "message",
      "line" : 912,
      "npc" : "Arcade Owner",
      "text" : "numbered square on your bingo"
    },
    {
      "kind" : "message",
      "line" : 913,
      "npc" : "Arcade Owner",
      "text" : "board. Now, these are the"
    },
    {
      "kind" : "message",
      "line" : 914,
      "npc" : "Arcade Owner",
      "text" : "conditions for winning..."
    },
    {
      "kind" : "message",
      "line" : 916,
      "npc" : "Arcade Owner",
      "text" : "[Arcade Owner]"
    },
    {
      "kind" : "message",
      "line" : 917,
      "npc" : "Arcade Owner",
      "text" : "If you can make a line of"
    },
    {
      "kind" : "message",
      "line" : 918,
      "npc" : "Arcade Owner",
      "text" : "5 squares in a row, horizontally, vertically, or diagonally, using"
    },
    {
      "kind" : "message",
      "line" : 919,
      "npc" : "Arcade Owner",
      "text" : "the numbers called out by the"
    },
    {
      "kind" : "message",
      "line" : 920,
      "npc" : "Arcade Owner",
      "text" : "coordinator, you quickly yell"
    },
    {
      "kind" : "message",
      "line" : 921,
      "npc" : "Arcade Owner",
      "text" : "the word, ''Bingo.''"
    },
    {
      "kind" : "message",
      "line" : 923,
      "npc" : "Arcade Owner",
      "text" : "[Arcade Owner]"
    },
    {
      "kind" : "message",
      "line" : 924,
      "npc" : "Arcade Owner",
      "text" : "If you are the first to yell"
    },
    {
      "kind" : "message",
      "line" : 925,
      "npc" : "Arcade Owner",
      "text" : "the word, ''Bingo,'' you'll"
    },
