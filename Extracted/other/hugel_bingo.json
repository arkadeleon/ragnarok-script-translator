      "npc" : "Arcade Owner",
      "text" : "left door as a spectator"
    },
    {
      "kind" : "message",
      "line" : 945,
      "npc" : "Arcade Owner",
      "text" : "in the Bingo Room."
    },
    {
      "kind" : "message",
      "line" : 948,
      "npc" : "Arcade Owner",
      "text" : "[Arcade Owner]"
    },
    {
      "kind" : "message",
      "line" : 949,
      "npc" : "Arcade Owner",
      "text" : "When you win a bingo"
