    },
    {
      "kind" : "message",
      "line" : 466,
      "npc" : "1a",
      "text" : "W-we just matched"
    },
    {
      "kind" : "message",
      "line" : 467,
      "npc" : "1a",
      "text" : "5 numbers in a row!"
    },
    {
      "kind" : "message",
      "line" : 468,
      "npc" : "1a",
      "text" : "Quickly, say ''^FF0000Bingo^000000!''"
    },
    {
      "kind" : "message",
      "line" : 469,
      "npc" : "1a",
      "text" : "Remember, you'll only"
    },
    {
      "kind" : "message",
      "line" : 470,
      "npc" : "1a",
      "text" : "have one chance to say it!"
    },
    {
      "kind" : "message",
      "line" : 482,
      "npc" : "1a",
      "text" : "Oh no! I'm sorry, but"
    },
    {
      "kind" : "message",
      "line" : 483,
      "npc" : "1a",
      "text" : "someone already yelled"
    },
    {
      "kind" : "message",
      "line" : 484,
      "npc" : "1a",
      "text" : "''bingo'' before you did."
    },
    {
      "kind" : "message",
      "line" : 485,
      "npc" : "1a",
      "text" : "I'm sorry, but you missed"
    },
    {
      "kind" : "message",
      "line" : 486,
      "npc" : "1a",
      "text" : "your chance! Better luck,"
    },
    {
      "kind" : "message",
      "line" : 487,
      "npc" : "1a",
      "text" : "next time, alright?"
    },
    {
      "kind" : "message",
      "line" : 492,
      "npc" : "1a",
      "text" : "I'm sorry, but you"
    },
    {
      "kind" : "message",
      "line" : 493,
      "npc" : "1a",
      "text" : "said it wrong. Next time,"
    },
    {
      "kind" : "message",
      "line" : 494,
      "npc" : "1a",
      "text" : "make sure that you yell"
    },
    {
      "kind" : "message",
      "line" : 495,
      "npc" : "1a",
      "text" : "out the word, ''^FF0000Bingo^000000,'' okay?"
