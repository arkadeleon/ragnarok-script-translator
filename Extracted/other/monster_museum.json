{
  "file" : "npc/other/monster_museum.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Museum Guide",
      "text" : "[Cenia]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Museum Guide",
      "text" : "Welcome to the Monster Museum."
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Museum Guide",
      "text" : "Monster Museum?"
    },
    {
      "kind" : "option",
      "line" : 29,
      "npc" : "Museum Guide",
      "text" : "Tips"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Museum Guide",
      "text" : "[Cenia]"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Museum Guide",
      "text" : "The Monster Museum was founded by"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Museum Guide",
      "text" : "the Sages of the Schweicherbil"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Museum Guide",
      "text" : "Magic Academy after researching"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Museum Guide",
      "text" : "every creature dwelling in the"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Museum Guide",
      "text" : "Midgard continent."
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Museum Guide",
      "text" : "[Cenia]"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Museum Guide",
      "text" : "In this museum, you can see every"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Museum Guide",
      "text" : "single monster in Midgard,"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Museum Guide",
      "text" : "even the ones you hardly ever encounter."
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Museum Guide",
      "text" : "[Cenia]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Museum Guide",
      "text" : "The glass tubes holding monsters"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Museum Guide",
      "text" : "was developed with the latest"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Museum Guide",
      "text" : "technology as a part of the"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Museum Guide",
      "text" : "Schwarz Project. Rest assured,"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Museum Guide",
      "text" : "you'll be well protected."
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Museum Guide",
      "text" : "[Cenia]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Museum Guide",
      "text" : "Please check on the Opaque option"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Museum Guide",
      "text" : "on your option windows by"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Museum Guide",
      "text" : "pressing ALT + O, if you want to"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Museum Guide",
      "text" : "see the monsters better."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Museum Guide",
      "text" : "[Cenia]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Museum Guide",
      "text" : "Feel free to talk to me anytime."
    },
    {
      "kind" : "message",
      "line" : 70,
      "text" : "Scientific name : Deviace"
    },
    {
      "kind" : "message",
      "line" : 71,
      "text" : "Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 72,
      "text" : "Attribute : Water"
    },
    {
      "kind" : "message",
      "line" : 74,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 75,
      "text" : "This monster dwells under the deep"
    },
    {
      "kind" : "message",
      "line" : 76,
      "text" : "sea and has a round body with a"
    },
    {
      "kind" : "message",
      "line" : 77,
      "text" : "acetabulum on its dorsal side."
    },
    {
      "kind" : "message",
      "line" : 78,
      "text" : "Although its sharp teeth are"
    },
    {
      "kind" : "message",
      "line" : 79,
      "text" : "intimidating, it has a very mellow"
    },
    {
      "kind" : "message",
      "line" : 80,
      "text" : "character."
    },
    {
      "kind" : "message",
      "line" : 82,
      "text" : "Therefore, it never initiates"
    },
    {
      "kind" : "message",
      "line" : 83,
      "text" : "attack on an undersea traveler"
    },
    {
      "kind" : "message",
      "line" : 84,
      "text" : "unless it's attacked first."
    },
    {
      "kind" : "message",
      "line" : 85,
      "text" : "However, once it becomes upset, it"
    },
    {
      "kind" : "message",
      "line" : 86,
      "text" : "uses high level magic skills. So"
    },
    {
      "kind" : "message",
      "line" : 87,
      "text" : "it's better to be careful with this monster."
    },
    {
      "kind" : "message",
      "line" : 96,
      "text" : "Scientific name : Seal"
    },
    {
      "kind" : "message",
      "line" : 97,
      "text" : "Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 98,
      "text" : "Attribute : Water"
    },
    {
      "kind" : "message",
      "line" : 100,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 101,
      "text" : "When you take a look at this"
    },
    {
      "kind" : "message",
      "line" : 102,
      "text" : "monster carefully, you will find"
    },
    {
      "kind" : "message",
      "line" : 103,
      "text" : "that it's not actually a seal but"
    },
    {
      "kind" : "message",
      "line" : 104,
      "text" : "an unidentified monster hiding"
    },
    {
      "kind" : "message",
      "line" : 105,
      "text" : "inside the seal-like leather"
    },
    {
      "kind" : "message",
      "line" : 106,
      "text" : "clothing."
    },
    {
      "kind" : "message",
      "line" : 108,
      "text" : "It is rumored that the monster"
    },
    {
      "kind" : "message",
      "line" : 109,
      "text" : "wears this clothing in order"
    },
    {
      "kind" : "message",
      "line" : 110,
      "text" : "to protect its sensitive skin"
    },
    {
      "kind" : "message",
      "line" : 111,
      "text" : "from the weather. The Seal's"
    },
    {
      "kind" : "message",
      "line" : 112,
      "text" : "clothing is a very good material"
    },
    {
      "kind" : "message",
      "line" : 113,
      "text" : "for people to produce winter coats."
    },
    {
      "kind" : "message",
      "line" : 122,
      "text" : "Scientific name : Sage Worm"
    },
    {
      "kind" : "message",
      "line" : 123,
      "text" : "Size : Small"
    },
    {
      "kind" : "message",
      "line" : 124,
      "text" : "Attribute : Neutral"
    },
    {
      "kind" : "message",
      "line" : 126,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 127,
      "text" : "A strange beast with the head of"
    },
    {
      "kind" : "message",
      "line" : 128,
      "text" : "an old scholar and the tail of a"
    },
    {
      "kind" : "message",
      "line" : 129,
      "text" : "worm. Although it is physically"
    },
    {
      "kind" : "message",
      "line" : 130,
      "text" : "weak, it has the intelligence"
    },
    {
      "kind" : "message",
      "line" : 131,
      "text" : "to support its comrades with"
    },
    {
      "kind" : "message",
      "line" : 132,
      "text" : "magic skills."
    },
    {
      "kind" : "message",
      "line" : 134,
      "text" : "As its scholarly appearance"
    },
    {
      "kind" : "message",
      "line" : 135,
      "text" : "indicates, it's usually seen near books or book shelves."
    },
    {
      "kind" : "message",
      "line" : 144,
      "text" : "Scientific name : Penomena"
    },
    {
      "kind" : "message",
      "line" : 145,
      "text" : "Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 146,
      "text" : "Attribute : Poison"
    },
    {
      "kind" : "message",
      "line" : 148,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 149,
      "text" : "This monster dwells inside the"
    },
    {
      "kind" : "message",
      "line" : 150,
      "text" : "deepest part of caves where there"
    },
    {
      "kind" : "message",
      "line" : 151,
      "text" : "is enough moisture to keep it from"
    },
    {
      "kind" : "message",
      "line" : 152,
      "text" : "getting dried up."
    },
    {
      "kind" : "message",
      "line" : 154,
      "text" : "Unlike Hydra, a similar looking"
    },
    {
      "kind" : "message",
      "line" : 155,
      "text" : "creature, it can move itself"
    },
    {
      "kind" : "message",
      "line" : 156,
      "text" : "towards its enemy using many"
    },
    {
      "kind" : "message",
      "line" : 157,
      "text" : "small appendixes on its acetabulum."
    },
    {
      "kind" : "message",
      "line" : 159,
      "text" : "The long, thin tentacles on the"
    },
    {
      "kind" : "message",
      "line" : 160,
      "text" : "body shoot deadly poison which is"
    },
    {
      "kind" : "message",
      "line" : 161,
      "text" : "enough to kill its enemy at once."
    },
    {
      "kind" : "message",
      "line" : 170,
      "text" : "Scientific name : Galapago"
    },
    {
      "kind" : "message",
      "line" : 171,
      "text" : "Size : Small"
    },
    {
      "kind" : "message",
      "line" : 172,
      "text" : "Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 174,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 175,
      "text" : "It's a kind of bird, but sadly, its body is too heavy to fly."
    },
    {
      "kind" : "message",
      "line" : 176,
      "text" : "It's very sensitive to sunlight so it carries a water bottle and wears sunglasses all the time."
    },
    {
      "kind" : "message",
      "line" : 178,
      "text" : "Although gluttonous, it will"
    },
    {
      "kind" : "message",
      "line" : 179,
      "text" : "always cooperate to attack"
    },
    {
      "kind" : "message",
      "line" : 180,
      "text" : "prey, as well as predators."
    },
    {
      "kind" : "message",
      "line" : 181,
      "text" : "Otherwise, Galapago is a"
    },
    {
      "kind" : "message",
      "line" : 182,
      "text" : "generally laid back monster."
    },
    {
      "kind" : "message",
      "line" : 191,
      "text" : "Scientific name : Raydric"
    },
    {
      "kind" : "message",
      "line" : 192,
      "text" : "Size : Large"
    },
    {
      "kind" : "message",
      "line" : 193,
      "text" : "Attribute : Shadow"
    },
    {
      "kind" : "message",
      "line" : 195,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 196,
      "text" : "A suit of armor animated by the"
    },
    {
      "kind" : "message",
      "line" : 197,
      "text" : "spirit of a castle guard. The"
    },
    {
      "kind" : "message",
      "line" : 198,
      "text" : "spirit is bound to this armor by"
    },
    {
      "kind" : "message",
      "line" : 199,
      "text" : "a powerful curse."
    },
    {
      "kind" : "message",
      "line" : 201,
      "text" : "Since Raydric used to be a castle"
    },
    {
      "kind" : "message",
      "line" : 202,
      "text" : "guard, it possesses fast movements"
    },
    {
      "kind" : "message",
      "line" : 203,
      "text" : "and powerful attack strength."
    },
    {
      "kind" : "message",
      "line" : 212,
      "text" : " Scientific name : Chepet"
    },
    {
      "kind" : "message",
      "line" : 213,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 214,
      "text" : " Attribute : Fire"
    },
    {
      "kind" : "message",
      "line" : 216,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 217,
      "text" : "An evil creature hiding in a"
    },
    {
      "kind" : "message",
      "line" : 218,
      "text" : "pretty doll. It attacks passersby"
    },
    {
      "kind" : "message",
      "line" : 219,
      "text" : "by striking matchsticks held in"
    },
    {
      "kind" : "message",
      "line" : 220,
      "text" : "the doll's hand. A very rare"
    },
    {
      "kind" : "message",
      "line" : 221,
      "text" : "monster since it dwells in"
    },
    {
      "kind" : "message",
      "line" : 222,
      "text" : "only a few places."
    },
    {
      "kind" : "message",
      "line" : 231,
      "text" : " Scientific name : Violy"
    },
    {
      "kind" : "message",
      "line" : 232,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 233,
      "text" : " Attribute : Neutral"
    },
    {
      "kind" : "message",
      "line" : 235,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 236,
      "text" : "A pretty doll looking creature with beautiful golden hair."
    },
    {
      "kind" : "message",
      "line" : 237,
      "text" : "Since It plays violin all the time with a peaceful look on its face, people don't realize at first that it's a monster."
    },
    {
      "kind" : "message",
      "line" : 239,
      "text" : "Exercise extreme caution upon encountering a Violy. Otherwise, it will snatch your soul in no time with its charming song."
    },
    {
      "kind" : "message",
      "line" : 248,
      "text" : " Scientific name : Alice "
    },
    {
      "kind" : "message",
      "line" : 249,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 250,
      "text" : " Attribute : Neutral"
    },
    {
      "kind" : "message",
      "line" : 252,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 253,
      "text" : "Alice is a robot made to assist as"
    },
    {
      "kind" : "message",
      "line" : 254,
      "text" : "a castle housemaid. They've been"
    },
    {
      "kind" : "message",
      "line" : 255,
      "text" : "known to remain and automatically"
    },
    {
      "kind" : "message",
      "line" : 256,
      "text" : "do their tasks long after the"
    },
    {
      "kind" : "message",
      "line" : 257,
      "text" : "castle has been abandoned."
    },
    {
      "kind" : "message",
      "line" : 259,
      "text" : "Without any discernable power"
    },
    {
      "kind" : "message",
      "line" : 260,
      "text" : "source, how it moves and operates"
    },
    {
      "kind" : "message",
      "line" : 261,
      "text" : "is still a scientific mystery."
    },
    {
      "kind" : "message",
      "line" : 270,
      "text" : " Scientific name : Assulter"
    },
    {
      "kind" : "message",
      "line" : 271,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 272,
      "text" : " Attribute : Wind"
    },
    {
      "kind" : "message",
      "line" : 274,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 275,
      "text" : "Unlike other turtles on Turtle"
    },
    {
      "kind" : "message",
      "line" : 276,
      "text" : "Island, this turtle stands on two"
    },
    {
      "kind" : "message",
      "line" : 277,
      "text" : "legs and attacks passersby with"
    },
    {
      "kind" : "message",
      "line" : 278,
      "text" : "the other two legs, wielding a"
    },
    {
      "kind" : "message",
      "line" : 279,
      "text" : "big shuriken from its back."
    },
    {
      "kind" : "message",
      "line" : 281,
      "text" : "Interestingly, it creates a clone"
    },
    {
      "kind" : "message",
      "line" : 282,
      "text" : "to do more damage when it"
    },
    {
      "kind" : "message",
      "line" : 283,
      "text" : "encounters dangerous enemies."
    },
    {
      "kind" : "message",
      "line" : 284,
      "text" : "It does very powerful damage using"
    },
    {
      "kind" : "message",
      "line" : 285,
      "text" : "its shuriken, but its nail attack"
    },
    {
      "kind" : "message",
      "line" : 286,
      "text" : "is more threatening."
    },
    {
      "kind" : "message",
      "line" : 305,
      "text" : " Scientific name : Wanderer"
    },
    {
      "kind" : "message",
      "line" : 306,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 307,
      "text" : " Attribute : Wind"
    },
    {
      "kind" : "message",
      "line" : 309,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 310,
      "text" : "Undead warrior who came back to"
    },
    {
      "kind" : "message",
      "line" : 311,
      "text" : "life through a curse. Considering"
    },
    {
      "kind" : "message",
      "line" : 312,
      "text" : "its technical fencing skill, he"
    },
    {
      "kind" : "message",
      "line" : 313,
      "text" : "must have been a very honorable"
    },
    {
      "kind" : "message",
      "line" : 314,
      "text" : "warrior as a living human."
    },
    {
      "kind" : "message",
      "line" : 316,
      "text" : "Wanderer can move amazingly fast"
    },
    {
      "kind" : "message",
      "line" : 317,
      "text" : "and can slay enemies with a single"
    },
    {
      "kind" : "message",
      "line" : 318,
      "text" : "stroke of its sword."
    },
    {
      "kind" : "message",
      "line" : 327,
      "text" : " Scientific name : Caterpillar"
    },
    {
      "kind" : "message",
      "line" : 328,
      "text" : " Size : Small"
    },
    {
      "kind" : "message",
      "line" : 329,
      "text" : " Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 331,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 332,
      "text" : "Although the eyes of this creature"
    },
    {
      "kind" : "message",
      "line" : 333,
      "text" : "have atrophied due to living under"
    },
    {
      "kind" : "message",
      "line" : 334,
      "text" : "the earth, it uses a feeler and"
    },
    {
      "kind" : "message",
      "line" : 335,
      "text" : "appendices on its body to sense"
    },
    {
      "kind" : "message",
      "line" : 336,
      "text" : "objects in its dark surroundings."
    },
    {
      "kind" : "message",
      "line" : 338,
      "text" : "Caterpillar is rumored to be the"
    },
    {
      "kind" : "message",
      "line" : 339,
      "text" : "larva of Creamy Fear, the advanced"
    },
    {
      "kind" : "message",
      "line" : 340,
      "text" : "Creamy."
    },
    {
      "kind" : "message",
      "line" : 349,
      "text" : " Scientific name : Thief Bug"
    },
    {
      "kind" : "message",
      "line" : 350,
      "text" : " ^FFFFFFScientific name :^000000 (Male)"
    },
    {
      "kind" : "message",
      "line" : 351,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 352,
      "text" : " Attribute : Shadow"
    },
    {
      "kind" : "message",
      "line" : 354,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 355,
      "text" : "Although it has a big blue body,"
    },
    {
      "kind" : "message",
      "line" : 356,
      "text" : "it's also fast and voracious, just like other Thief Bugs."
    },
    {
      "kind" : "message",
      "line" : 358,
      "text" : "However, it is stronger than other Thief Bugs because it's designated to protect the females and babies from danger."
    },
    {
      "kind" : "message",
      "line" : 367,
      "text" : " Scientific name : Tri Joint"
    },
    {
      "kind" : "message",
      "line" : 368,
      "text" : " Size : Small"
    },
    {
      "kind" : "message",
      "line" : 369,
      "text" : " Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 371,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 372,
      "text" : "Tri Joint is a prehistoric"
    },
    {
      "kind" : "message",
      "line" : 373,
      "text" : "monster that is covered with"
    },
    {
      "kind" : "message",
      "line" : 374,
      "text" : "a hard shell, and uses a feeler"
    },
    {
      "kind" : "message",
      "line" : 375,
      "text" : "instead of eyes so that it can"
    },
    {
      "kind" : "message",
      "line" : 376,
      "text" : "live in dark places."
    },
    {
      "kind" : "message",
      "line" : 378,
      "text" : "Recently, since many Tri Joints have been discovered inside many caves, Sages are very excited to study them to learn more about the evolution of monsters in Midgard."
    },
    {
      "kind" : "message",
      "line" : 387,
      "text" : " Scientific name : Arclouz"
    },
    {
      "kind" : "message",
      "line" : 388,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 389,
      "text" : " Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 391,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 392,
      "text" : "Hard shelled monster that coils"
    },
    {
      "kind" : "message",
      "line" : 393,
      "text" : "its body to attack its enemy."
    },
    {
      "kind" : "message",
      "line" : 394,
      "text" : "Arclouz tend to stay in groups"
    },
    {
      "kind" : "message",
      "line" : 395,
      "text" : "and are very aggressive"
    },
    {
      "kind" : "message",
      "line" : 396,
      "text" : "creatures."
    },
    {
      "kind" : "message",
      "line" : 398,
      "text" : "They have incredibly fast"
    },
    {
      "kind" : "message",
      "line" : 399,
      "text" : "movement speed, contrary to"
    },
    {
      "kind" : "message",
      "line" : 400,
      "text" : "their looks, and are often"
    },
    {
      "kind" : "message",
      "line" : 401,
      "text" : "compared to PecoPecos."
    },
    {
      "kind" : "message",
      "line" : 410,
      "text" : " Scientific name : Dragon Tail"
    },
    {
      "kind" : "message",
      "line" : 411,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 412,
      "text" : " Attribute : Wind"
    },
    {
      "kind" : "message",
      "line" : 414,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 415,
      "text" : "An insect which is considered as"
    },
    {
      "kind" : "message",
      "line" : 416,
      "text" : "a Libelluidae, or Dragon Fly. It"
    },
    {
      "kind" : "message",
      "line" : 417,
      "text" : "uses its strong tail to suck the"
    },
    {
      "kind" : "message",
      "line" : 418,
      "text" : "blood out of an enemy, or to put"
    },
    {
      "kind" : "message",
      "line" : 419,
      "text" : "the enemy to sleep by shooting"
    },
    {
      "kind" : "message",
      "line" : 420,
      "text" : "a sleeping poison."
    },
    {
      "kind" : "message",
      "line" : 429,
      "text" : " Scientific name : Owl Duke"
    },
    {
      "kind" : "message",
      "line" : 430,
      "text" : " Size : Large"
    },
    {
      "kind" : "message",
      "line" : 431,
      "text" : " Attribute : Neutral "
    },
    {
      "kind" : "message",
      "line" : 433,
      "text" : "Explanation:"
    },
    {
      "kind" : "message",
      "line" : 434,
      "text" : "An owl that wears a count costume."
    },
    {
      "kind" : "message",
      "line" : 435,
      "text" : "It's very intimidating looking"
    },
    {
      "kind" : "message",
      "line" : 436,
      "text" : "with its dark, yet suave look."
    },
    {
      "kind" : "message",
      "line" : 437,
      "text" : "Owl Duke is not actually an owl,"
    },
    {
      "kind" : "message",
      "line" : 438,
      "text" : "but a devil with very sharp claws"
    },
    {
      "kind" : "message",
      "line" : 439,
      "text" : "on its big feet."
    },
    {
      "kind" : "message",
      "line" : 441,
      "text" : "It's skillful at using many"
    },
    {
      "kind" : "message",
      "line" : 442,
      "text" : "lightning magic spells. When"
    },
    {
      "kind" : "message",
      "line" : 443,
      "text" : "you see it attacking an enemy,"
    },
    {
      "kind" : "message",
      "line" : 444,
      "text" : "you can sense the Owl Duke's"
    },
    {
      "kind" : "message",
      "line" : 445,
      "text" : "aristocratic pompousness."
    },
    {
      "kind" : "message",
      "line" : 454,
      "text" : " Scientific name : Marine Sphere"
    },
    {
      "kind" : "message",
      "line" : 455,
      "text" : " Size : Small"
    },
    {
      "kind" : "message",
      "line" : 456,
      "text" : " Attribute : Water"
    },
    {
      "kind" : "message",
      "line" : 458,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 459,
      "text" : "A strange creature that wanders"
    },
    {
      "kind" : "message",
      "line" : 460,
      "text" : "in the deep oceans. It explodes"
    },
    {
      "kind" : "message",
      "line" : 461,
      "text" : "with great power when it's"
    },
    {
      "kind" : "message",
      "line" : 462,
      "text" : "touched, earning it the name"
    },
    {
      "kind" : "message",
      "line" : 463,
      "text" : "'The Sea Bomb.'"
    },
    {
      "kind" : "message",
      "line" : 465,
      "text" : "If there is a Marine Sphere"
    },
    {
      "kind" : "message",
      "line" : 466,
      "text" : "caught in the explosion of"
    },
    {
      "kind" : "message",
      "line" : 467,
      "text" : "another, a trigger explosion"
    },
    {
      "kind" : "message",
      "line" : 468,
      "text" : "will result, and can lead to"
    },
    {
      "kind" : "message",
      "line" : 469,
      "text" : "a dangerous chain reaction."
    },
    {
      "kind" : "message",
      "line" : 478,
      "text" : " Scientific name : Mandragora"
    },
    {
      "kind" : "message",
      "line" : 479,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 480,
      "text" : " Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 482,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 483,
      "text" : "An insectivore that swallows"
    },
    {
      "kind" : "message",
      "line" : 484,
      "text" : "anything alive. When it finds"
    },
    {
      "kind" : "message",
      "line" : 485,
      "text" : "its prey, it strikes it first"
    },
    {
      "kind" : "message",
      "line" : 486,
      "text" : "with a long tentacle to"
    },
    {
      "kind" : "message",
      "line" : 487,
      "text" : "to paralyze it."
    },
    {
      "kind" : "message",
      "line" : 489,
      "text" : "Once paralyzed, its prey is"
    },
    {
      "kind" : "message",
      "line" : 490,
      "text" : "put in a large tube attached"
    },
    {
      "kind" : "message",
      "line" : 491,
      "text" : "to its body where it is slowly"
    },
    {
      "kind" : "message",
      "line" : 492,
      "text" : "digested. Although this tube"
    },
    {
      "kind" : "message",
      "line" : 493,
      "text" : "has a skull mark, Mandragora"
    },
    {
      "kind" : "message",
      "line" : 494,
      "text" : "does not actually contain any"
    },
    {
      "kind" : "message",
      "line" : 495,
      "text" : "poison."
    },
    {
      "kind" : "message",
      "line" : 497,
      "text" : "This digestive tube"
    },
    {
      "kind" : "message",
      "line" : 498,
      "text" : "apparatus also has a very unique,"
    },
    {
      "kind" : "message",
      "line" : 499,
      "text" : "but disgusting smell that is far"
    },
    {
      "kind" : "message",
      "line" : 500,
      "text" : "from useful in attracting prey."
    },
    {
      "kind" : "message",
      "line" : 509,
      "text" : " Scientific name : Geographer"
    },
    {
      "kind" : "message",
      "line" : 510,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 511,
      "text" : " Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 513,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 514,
      "text" : "An insectivore that looks like"
    },
    {
      "kind" : "message",
      "line" : 515,
      "text" : "a sunflower. It uses the petal"
    },
    {
      "kind" : "message",
      "line" : 516,
      "text" : "like tentacles around its"
    },
    {
      "kind" : "message",
      "line" : 517,
      "text" : "mouth to attract and snare"
    },
    {
      "kind" : "message",
      "line" : 518,
      "text" : "its prey."
    },
    {
      "kind" : "message",
      "line" : 520,
      "text" : "Unlike Mandragora, Geographer"
    },
    {
      "kind" : "message",
      "line" : 521,
      "text" : "does not have a tube to"
    },
    {
      "kind" : "message",
      "line" : 522,
      "text" : "store its prey. So it slowly"
    },
    {
      "kind" : "message",
      "line" : 523,
      "text" : "eats it's prey, little by little."
    },
    {
      "kind" : "message",
      "line" : 525,
      "text" : "Although Geographer has small"
    },
    {
      "kind" : "message",
      "line" : 526,
      "text" : "and short roots, the roots are"
    },
    {
      "kind" : "message",
      "line" : 527,
      "text" : "tough and strong enough to"
    },
    {
      "kind" : "message",
      "line" : 528,
      "text" : "bear the weight of the upper body."
    },
    {
      "kind" : "message",
      "line" : 530,
      "text" : "The namesake of this monster, a"
    },
    {
      "kind" : "message",
      "line" : 531,
      "text" : "human geographer that was"
    },
    {
      "kind" : "message",
      "line" : 532,
      "text" : "promptly eaten upon discovering"
    },
    {
      "kind" : "message",
      "line" : 533,
      "text" : "this species of beast, will"
    },
    {
      "kind" : "message",
      "line" : 534,
      "text" : "never be forgotten..."
    },
    {
      "kind" : "message",
      "line" : 543,
      "text" : " Scientific name : Rafflesia"
    },
    {
      "kind" : "message",
      "line" : 544,
      "text" : " Size : Small"
    },
    {
      "kind" : "message",
      "line" : 545,
      "text" : " Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 547,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 548,
      "text" : "A puffy, leafy monster"
    },
    {
      "kind" : "message",
      "line" : 549,
      "text" : "threatened with extinction."
    },
    {
      "kind" : "message",
      "line" : 550,
      "text" : "Rafflesia is the rarest"
    },
    {
      "kind" : "message",
      "line" : 551,
      "text" : "monster in Midgard and"
    },
    {
      "kind" : "message",
      "line" : 552,
      "text" : "is thus protected by law."
    },
    {
      "kind" : "message",
      "line" : 554,
      "text" : "Due to this situation, most Sages"
    },
    {
      "kind" : "message",
      "line" : 555,
      "text" : "are having a hard time to"
    },
    {
      "kind" : "message",
      "line" : 556,
      "text" : "research this monster."
    },
    {
      "kind" : "message",
      "line" : 557,
      "text" : "However, a few Sages are"
    },
    {
      "kind" : "message",
      "line" : 558,
      "text" : "currently seeking methods to"
    },
    {
      "kind" : "message",
      "line" : 559,
      "text" : "cultivate and save the Rafflesias."
    },
    {
      "kind" : "message",
      "line" : 568,
      "text" : " Scientific name : Stem Worm"
    },
    {
      "kind" : "message",
      "line" : 569,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 570,
      "text" : " Attribute : Wind"
    },
    {
      "kind" : "message",
      "line" : 572,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 573,
      "text" : "A mutated Worm Tail that has a"
    },
    {
      "kind" : "message",
      "line" : 574,
      "text" : "round, brownish grey body with"
    },
    {
      "kind" : "message",
      "line" : 575,
      "text" : "a small head. It is covered"
    },
    {
      "kind" : "message",
      "line" : 576,
      "text" : "with scales and has a long"
    },
    {
      "kind" : "message",
      "line" : 577,
      "text" : "stem-like tail which is used"
    },
    {
      "kind" : "message",
      "line" : 578,
      "text" : "as a whip in attacks."
    },
    {
      "kind" : "message",
      "line" : 587,
      "text" : " Scientific name : Blazzer"
    },
    {
      "kind" : "message",
      "line" : 588,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 589,
      "text" : " Attribute : Fire"
    },
    {
      "kind" : "message",
      "line" : 591,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 592,
      "text" : "This is a fire ball that has been"
    },
    {
      "kind" : "message",
      "line" : 593,
      "text" : "seen near volcanic zones."
    },
    {
      "kind" : "message",
      "line" : 594,
      "text" : "Because of this monster's sudden"
    },
    {
      "kind" : "message",
      "line" : 595,
      "text" : "appearance, Sages believe that"
    },
    {
      "kind" : "message",
      "line" : 596,
      "text" : "volcanic activity may occur"
    },
    {
      "kind" : "message",
      "line" : 597,
      "text" : "sooner or later near Juno."
    },
    {
      "kind" : "message",
      "line" : 599,
      "text" : "Blazzer blows out noxious gas"
    },
    {
      "kind" : "message",
      "line" : 600,
      "text" : "which harm passersby. It is"
    },
    {
      "kind" : "message",
      "line" : 601,
      "text" : "unknown whether or not these"
    },
    {
      "kind" : "message",
      "line" : 602,
      "text" : "are attacks or the Blazzer's"
    },
    {
      "kind" : "message",
      "line" : 603,
      "text" : "form of communication."
    },
    {
      "kind" : "message",
      "line" : 612,
      "text" : " Scientific name : Ride Word"
    },
    {
      "kind" : "message",
      "line" : 613,
      "text" : " Size : Small"
    },
    {
      "kind" : "message",
      "line" : 614,
      "text" : " Attribute : Neutral"
    },
    {
      "kind" : "message",
      "line" : 616,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 617,
      "text" : "It's a cursed magic book with"
    },
    {
      "kind" : "message",
      "line" : 618,
      "text" : "sharp teeth. It exists to attack any living thing nearby."
    },
    {
      "kind" : "message",
      "line" : 627,
      "text" : " Scientific name : Megalodon"
    },
    {
      "kind" : "message",
      "line" : 628,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 629,
      "text" : " Attribute : Undead"
    },
    {
      "kind" : "message",
      "line" : 631,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 632,
      "text" : "A skeleton fish that was brought"
    },
    {
      "kind" : "message",
      "line" : 633,
      "text" : "back to life by a curse. Although"
    },
    {
      "kind" : "message",
      "line" : 634,
      "text" : "It looks very threatening, it's"
    },
    {
      "kind" : "message",
      "line" : 635,
      "text" : "benign and will not attack"
    },
    {
      "kind" : "message",
      "line" : 636,
      "text" : "undersea travellers outright."
    },
    {
      "kind" : "message",
      "line" : 645,
      "text" : " Scientific name : Sleeper"
    },
    {
      "kind" : "message",
      "line" : 646,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 647,
      "text" : " Attribute : Earth"
    },
    {
      "kind" : "message",
      "line" : 649,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 650,
      "text" : "Unidentified sand creature."
    },
    {
      "kind" : "message",
      "line" : 651,
      "text" : "Usually it stays under the earth,"
    },
    {
      "kind" : "message",
      "line" : 652,
      "text" : "but when travellers step on the"
    },
    {
      "kind" : "message",
      "line" : 653,
      "text" : "sand, it may abruptly"
    },
    {
      "kind" : "message",
      "line" : 654,
      "text" : "appear to attack them."
    },
    {
      "kind" : "message",
      "line" : 656,
      "text" : "It's smaller than Sandman and can"
    },
    {
      "kind" : "message",
      "line" : 657,
      "text" : "cause indirect attacks by causing a sand storm."
    },
    {
      "kind" : "message",
      "line" : 666,
      "text" : " Scientific name : Ancient Mummy"
    },
    {
      "kind" : "message",
      "line" : 667,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 668,
      "text" : " Attribute : Undead"
    },
    {
      "kind" : "message",
      "line" : 670,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 671,
      "text" : "A mummy cursed with eternal life."
    },
    {
      "kind" : "message",
      "line" : 672,
      "text" : "Although wrapped in decaying"
    },
    {
      "kind" : "message",
      "line" : 673,
      "text" : "bandages, Ancient Mummy also"
    },
    {
      "kind" : "message",
      "line" : 674,
      "text" : "wears a splendid hair ornament"
    },
    {
      "kind" : "message",
      "line" : 675,
      "text" : "adorned with a snake."
    },
    {
      "kind" : "message",
      "line" : 677,
      "text" : "This kind of head ornament"
    },
    {
      "kind" : "message",
      "line" : 678,
      "text" : "indicates that the Ancient"
    },
    {
      "kind" : "message",
      "line" : 679,
      "text" : "Mummy was a person of high rank"
    },
    {
      "kind" : "message",
      "line" : 680,
      "text" : "while he was still alive."
    },
    {
      "kind" : "message",
      "line" : 682,
      "text" : "Since Ancient Mummy has"
    },
    {
      "kind" : "message",
      "line" : 683,
      "text" : "been wandering the underworld"
    },
    {
      "kind" : "message",
      "line" : 684,
      "text" : "for a long time, it does not have"
    },
    {
      "kind" : "message",
      "line" : 685,
      "text" : "any consciousness and will"
    },
    {
      "kind" : "message",
      "line" : 686,
      "text" : "attack any living thing nearby."
    },
    {
      "kind" : "message",
      "line" : 695,
      "text" : " Scientific name : Incubus"
    },
    {
      "kind" : "message",
      "line" : 696,
      "text" : " Size : Medium"
    },
    {
      "kind" : "message",
      "line" : 697,
      "text" : " Attribute : Shadow"
    },
    {
      "kind" : "message",
      "line" : 699,
      "text" : "Explanation :"
    },
    {
      "kind" : "message",
      "line" : 700,
      "text" : "This demon attracts humans"
    },
    {
      "kind" : "message",
      "line" : 701,
      "text" : "with its stunningly beautiful"
    },
    {
      "kind" : "message",
      "line" : 702,
      "text" : "appearance. When it poses as a"
    },
    {
      "kind" : "message",
      "line" : 703,
      "text" : "male human, we call it Incubus."
    },
    {
      "kind" : "message",
      "line" : 704,
      "text" : "As a female, we call it Succubus."
    },
    {
