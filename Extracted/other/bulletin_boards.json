    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Bulletin Board",
      "text" : "[Payon: The Mountain City]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Bulletin Board",
      "text" : "Payon has various armor and weapons, especially for the Archer class. If you wish to become an Archer, it would be best to become familiar with this city."
