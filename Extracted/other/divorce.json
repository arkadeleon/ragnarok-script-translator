  "scripts" : [
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Deviruchi",
      "text" : "Bwah hah hah~!"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Deviruchi",
      "text" : "That look in your eyes~!"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Deviruchi",
      "text" : "Those are definitely the eyes"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Deviruchi",
      "text" : "of a lonely male bachelor."
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Deviruchi",
      "text" : "I'm almost 100 percent sure"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Deviruchi",
      "text" : "you got ditched at the altar."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Deviruchi",
      "text" : "They're just filled with the"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Deviruchi",
      "text" : "pain of an old maid--!"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Deviruchi",
      "text" : "Couldn't rope some poor guy"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Deviruchi",
      "text" : "into marriage, huh?"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Deviruchi",
      "text" : "HHAHAHAHA~!"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Deviruchi",
      "text" : "Oooooh...Hee hee~"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Deviruchi",
      "text" : "I'd be more sympathetic if,"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Deviruchi",
      "text" : "you know, I weren't a creature"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Deviruchi",
      "text" : "of darkness."
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Deviruchi",
      "text" : "You look awfully depressed..."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Deviruchi",
      "text" : "Lucky for you, I could care"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Deviruchi",
      "text" : "less about happy people..."
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Deviruchi",
      "text" : "It's the humans in despair"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Deviruchi",
      "text" : "that I take an interest in."
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Deviruchi",
      "text" : "Hahahahahahah~!"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Deviruchi",
      "text" : "I sense that you carry a"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Deviruchi",
      "text" : "tiresome burden..."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Deviruchi",
      "text" : "If I'm not wrong, you're"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Deviruchi",
      "text" : "a married man, aren't you?"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Deviruchi",
      "text" : "a married woman, aren't you?"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Deviruchi",
      "text" : "Let me ask you one thing."
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Deviruchi",
      "text" : "Are you happy to be married?"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Deviruchi",
      "text" : "Forget about responsibilities,"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Deviruchi",
      "text" : "romance and all that other junk"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Deviruchi",
      "text" : "for now."
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Deviruchi",
      "text" : "I mean, can just one single"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Deviruchi",
      "text" : "person really bring you all that"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Deviruchi",
      "text" : "happiness? I know all about how"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Deviruchi",
      "text" : "special weddings and the magic"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Deviruchi",
      "text" : "of love is supposed to be, but..."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Deviruchi",
      "text" : "At the end of the day, you and"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Deviruchi",
      "text" : "your partner fight, and you feel"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Deviruchi",
      "text" : "totally totally miserable."
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Deviruchi",
      "text" : "...all because of HER."
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Deviruchi",
      "text" : "...all because of HIM."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Deviruchi",
      "text" : "Yes, it's your destiny to find me"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Deviruchi",
      "text" : "here. We all make mistakes..."
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Deviruchi",
      "text" : "Even if you promised everlasting"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Deviruchi",
      "text" : "love, even if you made a vow..."
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Deviruchi",
      "text" : "I can free you from that prison"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Deviruchi",
      "text" : "of matrimony."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Deviruchi",
      "text" : "It's simple if you look at"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Deviruchi",
      "text" : "marriage as a contract...a"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Deviruchi",
      "text" : "contract that ends with 'till"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Deviruchi",
      "text" : "death do we part.' Here in"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Deviruchi",
      "text" : "Niflheim, it's easy to use"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Deviruchi",
      "text" : "that little loophole..."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Deviruchi",
      "text" : "*whispers*"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Deviruchi",
      "text" : "^555555It's not like you're breaking^000000"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Deviruchi",
      "text" : "^555555any promises, and it's not"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Deviruchi",
      "text" : "like your wife will care if she"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Deviruchi",
      "text" : "doesn't know... Don't you"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Deviruchi",
      "text" : "want to be freed from her?^000000"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Deviruchi",
      "text" : "^555555any promises. Hell, your husband"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Deviruchi",
      "text" : "doesn't even have to know"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Deviruchi",
      "text" : "about it... you deserve"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Deviruchi",
      "text" : "real happiness, right?^000000"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Deviruchi",
      "text" : "You can have a brand new love"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Deviruchi",
      "text" : "with a better person..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Deviruchi",
      "text" : "Wouldn't that be great...?"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Deviruchi",
      "text" : "I can help you if you want..."
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Deviruchi",
      "text" : "I can make all of this happen!"
    },
    {
      "kind" : "option",
      "line" : 146,
      "npc" : "Deviruchi",
      "text" : "No thanks, I am happy."
    },
    {
      "kind" : "option",
      "line" : 146,
      "npc" : "Deviruchi",
      "text" : "Yes, please do."
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Deviruchi",
      "text" : "Hmpf~! You must still be"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Deviruchi",
      "text" : "fascinated with the silly"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Deviruchi",
      "text" : "notion of eternal love. Well,"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Deviruchi",
      "text" : "if you think you're happy,"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Deviruchi",
      "text" : "then I'll have nothing"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Deviruchi",
      "text" : "to do with you--!"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Deviruchi",
      "text" : "Good, good..."
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Deviruchi",
      "text" : "Now all you have to do is give"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Deviruchi",
      "text" : "me what I want in exchange..."
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Deviruchi",
      "text" : "Just 2,500,000 zeny and...*cough!*"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Deviruchi",
      "text" : "^666666An eensy piece of your soul.^000000"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Deviruchi",
      "text" : "After that, it's the carefree"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Deviruchi",
      "text" : "single's life. All you have to"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Deviruchi",
      "text" : "do is say the word..."
    },
    {
      "kind" : "option",
      "line" : 170,
      "npc" : "Deviruchi",
      "text" : "...Give me some time to think."
    },
    {
      "kind" : "option",
      "line" : 170,
      "npc" : "Deviruchi",
      "text" : "Any price will do, give me a divorce right now!"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Deviruchi",
      "text" : "I understand. But if you think"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Deviruchi",
      "text" : "about anything, think about"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Deviruchi",
      "text" : "your wife's nagging, and"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Deviruchi",
      "text" : "how great it would be to"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Deviruchi",
      "text" : "finally free yourself of the"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Deviruchi",
      "text" : "old ball and chain~"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Deviruchi",
      "text" : "how horrible your husband is,"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Deviruchi",
      "text" : "and what a relief it would"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Deviruchi",
      "text" : "be to be rid of that crumbum~"
    },
    {
      "kind" : "message",
      "line" : 187,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Deviruchi",
      "text" : "Excellent choice~"
    },
    {
      "kind" : "message",
      "line" : 190,
      "npc" : "Deviruchi",
      "text" : "Let's get started right"
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Deviruchi",
      "text" : "away! This may take some"
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "Deviruchi",
      "text" : "time, but it's better than"
    },
    {
      "kind" : "message",
      "line" : 193,
      "npc" : "Deviruchi",
      "text" : "being hopelessly married"
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Deviruchi",
      "text" : "^FF0000for the rest of your life.^000000"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Deviruchi",
      "text" : "[Deviruchi]"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Deviruchi",
      "text" : "Bwahhahahaha~!"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Deviruchi",
      "text" : "Now you're free~!"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Deviruchi",
      "text" : "Don't you feel so much"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Deviruchi",
      "text" : "better now as a single?"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Deviruchi",
      "text" : "Ah, bachelorhood..."
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Deviruchi",
      "text" : "Hmmm...I did tell you to bring"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Deviruchi",
      "text" : "2,500,000 zeny, right?"
    },
    {
      "kind" : "message",
      "line" : 212,
      "npc" : "Deviruchi",
      "text" : "No one else in this world can"
    },
    {
      "kind" : "message",
      "line" : 213,
      "npc" : "Deviruchi",
      "text" : "offer this kind of freedom..."
    },
    {
      "kind" : "message",
      "line" : 214,
      "npc" : "Deviruchi",
      "text" : "You can't put a price on"
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "Deviruchi",
      "text" : "peace of mind, can you?"
    }
  ]
}