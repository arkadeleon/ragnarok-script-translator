      "npc" : "Acolyte",
      "text" : "[Keiki]"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Acolyte",
      "text" : "Hello there, adventurer."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Acolyte",
      "text" : "I've been studying magic from all over Rune-Midgarts to upgrade what I believe to be one of the greatest skills available to the acolyte class."
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Acolyte",
      "text" : "[Keiki]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Acolyte",
      "text" : "I am the one and only Acolyte that has attained the Level 10 Warp Portal skill!"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Acolyte",
      "text" : "[Keiki]"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Acolyte",
      "text" : "That's right! And..."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Acolyte",
      "text" : "I promise you that I don't forget locations that I have already memorized."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Acolyte",
      "text" : "One day I will level up my skills to warp to wherever I please~"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Acolyte",
      "text" : "[Keiki]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Acolyte",
      "text" : "I am willing to warp you to the many locations that I have memorized for a small fee."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Acolyte",
      "text" : "Would you like to use this service?"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Acolyte",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Acolyte",
      "text" : "No"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Acolyte",
      "text" : "[Keiki]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Acolyte",
      "text" : "Where would you like to go to?"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Acolyte",
      "text" : "I wish you goodluck on your journey."
    },
    {
      "kind" : "option",
      "line" : 56,
      "npc" : "Acolyte",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Acolyte",
      "text" : "[Keiki]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Acolyte",
      "text" : "I'm sorry, but you don't have"
    },
