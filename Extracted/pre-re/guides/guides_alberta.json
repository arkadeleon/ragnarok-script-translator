    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Guide",
      "text" : "The Merchant Guild"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Guide",
      "text" : "handles Job Changes"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Guide",
      "text" : "to the Merchant Class,"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Guide",
      "text" : "and is located in the"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Guide",
      "text" : "southwest corner"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Guide",
      "text" : "of Alberta."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Guide",
      "text" : "The Weapon Shop"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Guide",
      "text" : "can be found in the"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Guide",
      "text" : "southern end of Alberta."
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Guide",
      "text" : "The Tool Shop"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Guide",
      "text" : "is kind of close"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Guide",
      "text" : "to the center of"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Guide",
      "text" : "Alberta. It shouldn't"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Guide",
      "text" : "be too hard to find."
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Guide",
      "text" : "There's an Inn"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Guide",
      "text" : "at the northern"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Guide",
      "text" : "end of Alberta"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Guide",
      "text" : "where you can rest."
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Guide",
      "text" : "The Forge in Alberta"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Guide",
      "text" : "is in the same building"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Guide",
      "text" : "as the Merchant Guild."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Guide",
      "text" : "It's to the southwest."
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Guide",
      "text" : "Please ask me to ''Remove"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Guide",
      "text" : "Marks from Mini-Map'' if you"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Guide",
      "text" : "no longer wish to have the"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Guide",
      "text" : "location marks displayed"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Guide",
      "text" : "on your Mini-Map."
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Guide",
      "text" : "Advances in sorcery and"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Guide",
      "text" : "technology have allowed"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Guide",
      "text" : "us to update our information"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Guide",
      "text" : "system, enabling up to mark"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Guide",
      "text" : "locations on your Mini-Map"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Guide",
      "text" : "for easier navigation."
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Guide",
      "text" : "Your Mini-Map is located"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Guide",
      "text" : "in the upper right corner"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Guide",
      "text" : "of the screen. If you can't"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Guide",
      "text" : "see it, press the Ctrl + Tab"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Guide",
      "text" : "keys or click the ''Map'' button in your Basic Info Window."
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Guide",
      "text" : "On your Mini-Map,"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Guide",
      "text" : "click on the ''+'' and ''-''"
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Guide",
      "text" : "symbols to zoom in and"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Guide",
      "text" : "our of your Mini-Map. We"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Guide",
      "text" : "hope you enjoy your travels"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Guide",
      "text" : "here in the city of Alberta."
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Guide",
      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Guide",
      "text" : "Be safe when you"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Guide",
      "text" : "travel and don't hesitate"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Guide",
      "text" : "to ask me if you have any"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Guide",
      "text" : "questions about Alberta."
    }
  ]
}