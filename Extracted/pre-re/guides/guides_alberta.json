      "text" : "[Alberta Guide]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Guide",
      "text" : "Welcome to Alberta,"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Guide",
      "text" : "the Port City. Feel free"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Guide",
      "text" : "to ask me if you're having"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Guide",
      "text" : "trouble finding anything in"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Guide",
      "text" : "town, or if you just need"
    },
    {
      "kind" : "message",
