    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Soldier",
      "text" : "Welcome to Luoyang,"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Soldier",
      "text" : "a city with a long"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Soldier",
      "text" : "and colorful history."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Soldier",
      "text" : "[Soldier]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Soldier",
      "text" : "Recently we've developed"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Soldier",
      "text" : "an ocean lane to accomodate"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Soldier",
      "text" : "positive exchange with"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Soldier",
      "text" : "foreign nations."
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Soldier",
      "text" : "[Soldier]"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Soldier",
      "text" : "Luoyang is well-known for various specialties in addition to its rich history. Here you can find many things unique to our land."
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Soldier",
      "text" : "[Soldier]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Soldier",
      "text" : "Please take your time"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Soldier",
      "text" : "and we invite you to enjoy"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Soldier",
      "text" : "your trip here in Luoyang."
    },
    {
