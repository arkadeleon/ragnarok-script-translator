      "kind" : "message",
      "line" : 112,
      "npc" : "Guide",
      "text" : "on your Mini-Map."
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Guide",
      "text" : "[Morocc Guide]"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Guide",
      "text" : "Advances in sorcery and"
