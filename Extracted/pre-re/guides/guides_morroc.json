      "text" : "the center of Morocc."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Guide",
      "text" : "[Morocc Guide]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Guide",
      "text" : "Please ask me to ''Remove"
    },
    {
      "kind" : "message",
      "line" : 109,
