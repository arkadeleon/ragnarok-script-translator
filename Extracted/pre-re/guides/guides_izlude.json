      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Guide",
      "text" : "Welcome to Izlude,"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Guide",
      "text" : "Prontera's satellite city."
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Guide",
      "text" : "If you need any guidance"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Guide",
      "text" : "around Izlude, feel free"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Guide",
      "text" : "to ask me at anytime."
    },
