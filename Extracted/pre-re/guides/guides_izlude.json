      "kind" : "message",
      "line" : 53,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Guide",
      "text" : "The Swordman Association"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Guide",
      "text" : "is located on an island that is"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Guide",
      "text" : "in west Izlude. If you're thinking of changing jobs to Swordman,"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Guide",
      "text" : "you should check it out."
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Guide",
      "text" : "The Swordman Hall"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Guide",
      "text" : "is located in the eastern"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Guide",
      "text" : "island connected to Izlude."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Guide",
      "text" : "Izlude's famous"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Guide",
      "text" : "Arena is located at the"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Guide",
      "text" : "northern end of Izlude."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Guide",
      "text" : "You can find the"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Guide",
      "text" : "Marina in the northeast"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Guide",
      "text" : "part of Izlude. There, you can"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Guide",
      "text" : "ride a ship which will take you"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Guide",
      "text" : "to Alberta or Byalan Island."
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Guide",
      "text" : "You can easily"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Guide",
      "text" : "find the Weapon Shop"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Guide",
      "text" : "in northwest Izlude."
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Guide",
      "text" : "The Tool Shop shouldn't"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Guide",
      "text" : "be too hard to find in the"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Guide",
      "text" : "northeast part of Izlude."
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Guide",
      "text" : "Please ask me to ''Remove"
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Guide",
      "text" : "Marks from Mini-Map'' if you"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Guide",
      "text" : "no longer wish to have the"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Guide",
      "text" : "location marks displayed"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Guide",
      "text" : "on your Mini-Map."
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Guide",
      "text" : "Advances in sorcery and"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Guide",
      "text" : "technology have allowed"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Guide",
      "text" : "us to update our information"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Guide",
      "text" : "system, enabling up to mark"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Guide",
      "text" : "locations on your Mini-Map"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Guide",
      "text" : "for easier navigation."
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Guide",
      "text" : "Your Mini-Map is located"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Guide",
      "text" : "in the upper right corner"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Guide",
      "text" : "of the screen. If you can't"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Guide",
      "text" : "see it, press the Ctrl + Tab"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Guide",
      "text" : "keys or click the ''Map'' button in your Basic Info Window."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Guide",
      "text" : "On your Mini-Map,"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Guide",
      "text" : "click on the ''+'' and ''-''"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Guide",
      "text" : "symbols to zoom in and"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Guide",
      "text" : "our of your Mini-Map. We"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Guide",
      "text" : "hope you enjoy your travels"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Guide",
      "text" : "here in the city of Izlude."
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Guide",
      "text" : "[Izlude Guide]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Guide",
      "text" : "Okay then, feel"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Guide",
      "text" : "free to come to me"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Guide",
      "text" : "if you ever feel lost"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Guide",
      "text" : "around Izlude, alright?"
    }
  ]
}