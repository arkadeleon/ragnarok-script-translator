    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Guide",
      "text" : "If you need any guidance"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Guide",
      "text" : "around the city, feel free"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Guide",
      "text" : "to ask me and I'll do my"
    },
