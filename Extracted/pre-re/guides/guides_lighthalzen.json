      "npc" : "Guide",
      "text" : "[Lighthalzen Guide]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Guide",
      "text" : "Rekenber Corporation,"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Guide",
      "text" : "the largest company in"
    },
    {
      "kind" : "message",
