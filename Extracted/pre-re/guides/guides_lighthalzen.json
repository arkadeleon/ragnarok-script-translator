    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Guide",
      "text" : "[Lighthalzen Guide]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Guide",
      "text" : "Please be aware that I'm"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Guide",
      "text" : "in charge of providing info"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Guide",
      "text" : "regarding the West District"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Guide",
      "text" : "of Lighthalzen. Now, please"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Guide",
      "text" : "select the location that you'd"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Guide",
      "text" : "like to learn more about."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Guide",
      "text" : "[Lighthalzen Guide]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Guide",
      "text" : "But before that,"
    },
    {
      "kind" : "message",
