{
  "file" : "npc/pre-re/guides/guides_hugel.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Hugel Guide Granny",
      "text" : "[Hugel Guide Granny]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hugel Guide Granny",
      "text" : "Oh, hello~ you are one energetic adventurer."
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Hugel Guide Granny",
      "text" : "Welcome to Hugel. I was honored to guide you to this beautiful village."
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Hugel Guide Granny",
      "text" : "If this is the first time for you to use the guide services, why don't you check the ''Notice'' menu first?"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Hugel Guide Granny",
      "text" : "Village Guide"
    },
    {
      "kind" : "option",
