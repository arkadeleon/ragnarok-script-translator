      "text" : "Remove Marks from Mini-Map"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Hugel Guide Granny",
      "text" : "Notice"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Hugel Guide Granny",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Hugel Guide Granny",
      "text" : "[Hugel Guide Granny]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Hugel Guide Granny",
      "text" : "I can tell you any building location as long as it is in Hugel."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Hugel Guide Granny",
      "text" : "So where do you want to go?"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Hugel Guide Granny",
      "text" : "Would you like me"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Hugel Guide Granny",
      "text" : "to mark locations"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Hugel Guide Granny",
      "text" : "on your Mini-Map?"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Hugel Guide Granny",
      "text" : "Yes."
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Hugel Guide Granny",
      "text" : "No."
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hugel Guide Granny",
      "text" : "Church"
    },
    {
      "kind" : "option",
