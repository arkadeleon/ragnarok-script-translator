    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Guide",
      "text" : "The Prontera Chivralry,"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Guide",
      "text" : "which is responsible for"
    },
