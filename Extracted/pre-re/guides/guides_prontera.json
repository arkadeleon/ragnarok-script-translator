      "line" : 79,
      "npc" : "Guide",
      "text" : "the safety of our capital, is"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Guide",
      "text" : "in Prontera's northwest corner."
    },
    {
      "kind" : "message",
