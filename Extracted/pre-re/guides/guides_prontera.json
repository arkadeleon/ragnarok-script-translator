      "text" : "is located northeast"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Guide",
      "text" : "of the central fountain."
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Guide",
      "text" : "The Tool Shop"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Guide",
      "text" : "is located northwest"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Guide",
      "text" : "of the central fountain."
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Guide",
      "text" : "The Inns in Prontera are"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Guide",
      "text" : "located both to the east"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Guide",
      "text" : "and west of Prontera's"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Guide",
      "text" : "central fountain area."
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Guide",
      "text" : "The Trading Post"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Guide",
      "text" : "can be found southeast"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Guide",
      "text" : "from the central fountain."
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Guide",
      "text" : "The Pub is located"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Guide",
      "text" : "southeast of the fountain,"
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Guide",
      "text" : "behind the Trading Post."
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Guide",
      "text" : "If you head north from"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Guide",
      "text" : "the central fountain, you'll"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Guide",
      "text" : "find an empty area in which"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Guide",
      "text" : "both branches of the Prontera"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Guide",
      "text" : "Library can be accessed if you"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Guide",
      "text" : "head towards the east or west."
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Guide",
      "text" : "The Job Agency is"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Guide",
      "text" : "just southwest of the"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Guide",
      "text" : "central fountain area."
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Guide",
      "text" : "The Prontera Castle is"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Guide",
      "text" : "located at the northern"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Guide",
      "text" : "sector of this city. You can"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Guide",
      "text" : "go to the fields that are north"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Guide",
      "text" : "of Prontera by going through"
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Guide",
      "text" : "the castle's rear exit."
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Guide",
      "text" : "The City Hall"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Guide",
      "text" : "is located in the"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Guide",
      "text" : "southwest corner"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Guide",
      "text" : "in our city of Prontera."
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Guide",
      "text" : "Please ask me to ''Remove"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Guide",
      "text" : "Marks from Mini-Map'' if you"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Guide",
      "text" : "no longer wish to have the"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Guide",
      "text" : "location marks displayed"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Guide",
      "text" : "on your Mini-Map."
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Guide",
      "text" : "Advances in sorcery and"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Guide",
      "text" : "technology have allowed"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Guide",
      "text" : "us to update our information"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Guide",
      "text" : "system, enabling up to mark"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Guide",
      "text" : "locations on your Mini-Map"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Guide",
      "text" : "for easier navigation."
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Guide",
      "text" : "Your Mini-Map is located"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Guide",
      "text" : "in the upper right corner"
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Guide",
      "text" : "of the screen. If you can't"
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Guide",
      "text" : "see it, press the Ctrl + Tab"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Guide",
      "text" : "keys or click the ''Map'' button in your Basic Info Window."
    },
    {
      "kind" : "message",
      "line" : 213,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 214,
      "npc" : "Guide",
      "text" : "On your Mini-Map,"
    },
    {
      "kind" : "message",
      "line" : 215,
      "npc" : "Guide",
      "text" : "click on the ''+'' and ''-''"
    },
    {
      "kind" : "message",
      "line" : 216,
      "npc" : "Guide",
      "text" : "symbols to zoom in and"
    },
    {
      "kind" : "message",
      "line" : 217,
      "npc" : "Guide",
      "text" : "our of your Mini-Map. We"
    },
    {
      "kind" : "message",
      "line" : 218,
      "npc" : "Guide",
      "text" : "hope you enjoy your travels"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Guide",
      "text" : "here in the city of Prontera."
    },
    {
      "kind" : "message",
      "line" : 222,
      "npc" : "Guide",
      "text" : "[Prontera Guide]"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Guide",
      "text" : "Well, adventurer..."
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Guide",
      "text" : "I hope your journeys"
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Guide",
      "text" : "through Rune-Midgarts"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Guide",
      "text" : "are both fun and safe."
    }
  ]
