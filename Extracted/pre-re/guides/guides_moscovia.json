      "npc" : "Moscovia Guide",
      "text" : "The Palace"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Moscovia Guide",
      "text" : "Armor Shop"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Moscovia Guide",
      "text" : "Tool Shop"
    },
    {
      "kind" : "option",
