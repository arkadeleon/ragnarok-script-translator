      "npc" : "Moscovia Guide",
      "text" : "An Inn"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Moscovia Guide",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 37,
