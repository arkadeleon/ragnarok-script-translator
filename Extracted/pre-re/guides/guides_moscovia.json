      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Moscovia Guide",
      "text" : "The Palace can be found ^ff0000+^000000 at the"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Moscovia Guide",
      "text" : "end of the North sea from"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Moscovia Guide",
      "text" : "Rune-Midgarts."
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Moscovia Guide",
      "text" : "There resides our Lord the Czar of"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Moscovia Guide",
      "text" : "Moscovia and his retainers."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Moscovia Guide",
      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Moscovia Guide",
      "text" : "The Armor Shop is located at the"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Moscovia Guide",
      "text" : "southwest corner of town.."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Moscovia Guide",
      "text" : "You can buy armor made by the best"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Moscovia Guide",
      "text" : "craftsmen of Moscovia there."
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Moscovia Guide",
      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Moscovia Guide",
      "text" : "The Tool Shop is located just south"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Moscovia Guide",
      "text" : "from the center of town."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Moscovia Guide",
      "text" : "You can find all sorts of things"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Moscovia Guide",
      "text" : "you need for your travels."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Moscovia Guide",
      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Moscovia Guide",
      "text" : "The Inn 'Sticky Herb Tree' is just"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Moscovia Guide",
      "text" : "north from the center of town."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Moscovia Guide",
      "text" : "If you need to rest, there is no"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Moscovia Guide",
      "text" : "better place to stay."
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Moscovia Guide",
      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Moscovia Guide",
      "text" : "I've deleted all marks on the mini-map."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Moscovia Guide",
      "text" : "Whenever you'd like to put marks"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Moscovia Guide",
      "text" : "there, you can ask me."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Moscovia Guide",
      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Moscovia Guide",
      "text" : "It'd be great to walk about alone."
    },
    {
      "kind" : "message",
