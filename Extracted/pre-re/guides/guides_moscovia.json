      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 18,
      "npc" : "Moscovia Guide",
      "text" : "Welcome to Moscovia"
    },
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Moscovia Guide",
      "text" : "Here is the paradise spreading on"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Moscovia Guide",
      "text" : "the endless seas"
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Moscovia Guide",
      "text" : "You'll be happy with the beautiful"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Moscovia Guide",
      "text" : "scenery and the sunlight!"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Moscovia Guide",
      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Moscovia Guide",
      "text" : "I was sent from Moscovia Palace"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Moscovia Guide",
      "text" : "to guide tourists and to give them"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Moscovia Guide",
      "text" : "information on this town."
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Moscovia Guide",
      "text" : "If you have some questions, please ask me."
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Moscovia Guide",
      "text" : "Ask where you can go."
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Moscovia Guide",
      "text" : "Delete all the marks on the mini-map."
    },
    {
      "kind" : "option",
      "line" : 30,
      "npc" : "Moscovia Guide",
      "text" : "Cancel."
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Moscovia Guide",
      "text" : "[Moscovia Guide]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Moscovia Guide",
      "text" : "Where would you like to go?"
