    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Rachel Guide",
      "text" : "Welcome to the capital of"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Rachel Guide",
      "text" : "Arunafeltz, Rachel where a warm"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Rachel Guide",
      "text" : "breath of goddess Freya reaches."
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Rachel Guide",
      "text" : "If this is the first time for you"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Rachel Guide",
      "text" : "to use the guide services, why"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Rachel Guide",
      "text" : "don't you check the \"Notice\" menu first?"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "text" : "Village Guide"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "text" : "Remove Marks from Mini-Map"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "text" : "Notice"
    },
    {
      "kind" : "option",
      "line" : 33,
      "npc" : "Rachel Guide",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Rachel Guide",
      "text" : "I can tell you any building location as long as it is in Rachel."
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Rachel Guide",
      "text" : "So where do you want to go?"
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Rachel Guide",
      "text" : "Would you like me"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Rachel Guide",
      "text" : "to mark locations"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Rachel Guide",
      "text" : "on your Mini-Map?"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Rachel Guide",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 43,
      "npc" : "Rachel Guide",
      "text" : "No"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "text" : "Cheshrumnir"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "text" : "Inn"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "text" : "Weapon Shop"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "text" : "Tool Shop"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "text" : "Airport"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Rachel Guide",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Rachel Guide",
      "text" : "Cheshrumnir is a holy ground where pope, the incarnation of goddess Freya stays."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Rachel Guide",
      "text" : "Take the road to the norh to find the building."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Rachel Guide",
      "text" : "You can rest your fatigue off the journey in the Inn."
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Rachel Guide",
      "text" : "The left building next to me is the Inn of Rachel."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Rachel Guide",
      "text" : "Do you want to check out the weapons that are sold in Rachel?"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Rachel Guide",
      "text" : "The weapon shop is located nearby the western gate."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Rachel Guide",
      "text" : "Rachel tool shop sells the best quality potions."
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Rachel Guide",
      "text" : "It's located nearby the western gate."
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Rachel Guide",
      "text" : "The Airport is located outside the eastern gate."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Rachel Guide",
      "text" : "If you like to get rid of all the location marks on your Mini-Map,"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Rachel Guide",
      "text" : "just ask me again, and choose \"Remove Marks from Mini-Map\" menu."
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Rachel Guide",
      "text" : "Okay, they are gone now. If you have more locations to ask, just let me know."
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Rachel Guide",
      "text" : "When you are using the ''Village Guide'' menu,"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Rachel Guide",
      "text" : "make sure that building locations will be marked on your mini-map at the upper right side of your screen."
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Rachel Guide",
      "text" : "If you cannot see your mini-map, use the short cut key ''ctrl+tab'' or press the ''Map'' button on your basic information windows, okay?"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Rachel Guide",
      "text" : "And you can also zoom out your mini-map by using the ''-'' button in case you cannot view the entire map of the village."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Rachel Guide",
      "text" : "[Rachel Guide]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Rachel Guide",
      "text" : "Hope you have a wonderfull journey"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Rachel Guide",
      "text" : "in Arunafeltz."
    }
  ]
}