{
  "file" : "npc/pre-re/guides/guides_veins.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Veins Guide",
      "text" : "Desert City Veins welcomes adventurers seeking shelter from harsh sandstorms."
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Veins Guide",
      "text" : "If this is the first time for you to use the guide services, why don't you check the..."
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "text" : "Village Guide"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "text" : "Remove Marks from Mini-Map"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "text" : "Notice"
    },
    {
      "kind" : "option",
      "line" : 25,
      "npc" : "Veins Guide",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Veins Guide",
      "text" : "I can tell you any building location as long as it is in Veins."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Veins Guide",
      "text" : "So where do you want to go?"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Veins Guide",
      "text" : "Would you like me"
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Veins Guide",
      "text" : "to mark locations"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Veins Guide",
      "text" : "on your Mini-Map?"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Veins Guide",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 35,
      "npc" : "Veins Guide",
      "text" : "No"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Temple"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Inn"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Weapon Shop"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Tool Shop"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Airship"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Tavern"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Geological Research Institute"
    },
    {
      "kind" : "option",
      "line" : 42,
      "npc" : "Veins Guide",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Veins Guide",
      "text" : "Our temple is located north,"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Veins Guide",
      "text" : "and always crowded with sincere followers of Goddess Freya."
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Veins Guide",
      "text" : "You can rest your fatigue of the journey in the Inn."
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Veins Guide",
      "text" : "The left building next to me is the Inn of Veins."
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Veins Guide",
      "text" : "Yes, you should protect yourself from danger on your own."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Veins Guide",
      "text" : "Purchase high quality weapons at affordable prices."
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Veins Guide",
      "text" : "The Veins Weapon Shop is located to the West."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Veins Guide",
      "text" : "Have you packed enough necessities  for your adventure?"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Veins Guide",
      "text" : "If not, I suggest you check what the Veins in the Center can offer you."
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Veins Guide",
      "text" : "Please be aware that Veins only operates cargo airships."
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Veins Guide",
      "text" : "If you'd like to make friends with"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Veins Guide",
      "text" : "the townspeople, I suggest you"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Veins Guide",
      "text" : "go have a drink at the tavern to"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Veins Guide",
      "text" : "the west."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Veins Guide",
      "text" : "Are you interested in studying geology?"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Veins Guide",
      "text" : "Then you'd better go check out the"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Veins Guide",
      "text" : "Geological Research Institute on"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Veins Guide",
      "text" : "the 2nd floor of the weapon shop."
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Veins Guide",
      "text" : "If you like to get rid of all the location marks on your Mini-Map,"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Veins Guide",
      "text" : "just ask me again, and choose 'Remove Marks from Mini-Map' menu."
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Veins Guide",
      "text" : "Okay, they are gone now. If you have more locations to ask, just let me know."
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Veins Guide",
      "text" : "Enjoy your stay in Veins."
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Veins Guide",
      "text" : "When you are using the ''Village Guide'' menu,"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Veins Guide",
      "text" : "make sure that building locations will be marked on your mini-map at the upper right side of your screen."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Veins Guide",
      "text" : "If you cannot see your mini-map, use the short cut key ''ctrl+tab'' or press the ''Map'' button on your basic information windows, okay?"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Veins Guide",
      "text" : "And you can also zoom out your mini-map by using the ''-'' button in case you cannot view the entire map of the village."
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Veins Guide",
      "text" : "[Veins Guide]"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Veins Guide",
      "text" : "Enjoy your stay in Veins."
    }
  ]
}