{
  "file" : "npc/pre-re/other/resetskill.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 19,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 20,
      "npc" : "Hypnotist",
      "text" : "Greetings, adventurer."
    },
    {
      "kind" : "message",
      "line" : 21,
      "npc" : "Hypnotist",
      "text" : "I'm a member of the Hypnotist"
    },
    {
      "kind" : "message",
      "line" : 22,
      "npc" : "Hypnotist",
      "text" : "Academy sent here to Prontera"
    },
    {
      "kind" : "message",
      "line" : 23,
      "npc" : "Hypnotist",
      "text" : "to provide Skill Reset services"
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Hypnotist",
      "text" : "to certain First Class characters for a really good price: free!"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Hypnotist",
      "text" : "Although I offer unlimited"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Hypnotist",
      "text" : "skill resets for now, I have"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Hypnotist",
      "text" : "two conditions that must be"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Hypnotist",
      "text" : "fulfilled. First, you must be"
    },
    {
      "kind" : "message",
      "line" : 31,
      "npc" : "Hypnotist",
      "text" : "lower than ^FF0000Base Level 40^000000."
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Hypnotist",
      "text" : "Second, you must be a"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Hypnotist",
      "text" : "^FF0000Swordman, Acolyte, Mage,"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Hypnotist",
      "text" : "Thief, Archer, Merchant,"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Hypnotist",
      "text" : "Taekwon Boy, Taekwon Girl, Gunslinger and Ninja^000000"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Hypnotist",
      "text" : "Job character to qualify."
    },
    {
      "kind" : "message",
      "line" : 39,
      "npc" : "Hypnotist",
      "text" : "Now, do you have any questions?"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hypnotist",
      "text" : "Skill Reset?"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hypnotist",
      "text" : "I want a Skill Reset"
    },
    {
      "kind" : "option",
      "line" : 41,
      "npc" : "Hypnotist",
      "text" : "Nothing"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Hypnotist",
      "text" : "Skill Resets allow adventuers"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Hypnotist",
      "text" : "to redistribute their Skill"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Hypnotist",
      "text" : "Points if they are unhappy"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Hypnotist",
      "text" : "with their current skills."
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Hypnotist",
      "text" : "Before proceeding with"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Hypnotist",
      "text" : "a Skill Reset, you must"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Hypnotist",
      "text" : "reduce all of the weight"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Hypnotist",
      "text" : "of all carried items on your"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Hypnotist",
      "text" : "character to 0. You can put"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Hypnotist",
      "text" : "extra items in Kafra Storage."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Hypnotist",
      "text" : "Ah, it's also important"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Hypnotist",
      "text" : "to remove your ^FF0000Pushcart^000000"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Hypnotist",
      "text" : "if you have one equipped."
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Hypnotist",
      "text" : "Otherwise, hypnosis won't"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Hypnotist",
      "text" : "work, or will backfire..."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Hypnotist",
      "text" : "Are you sure that you"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Hypnotist",
      "text" : "want to proceed with"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Hypnotist",
      "text" : "my ^FF0000Skill Reset^000000 service?"
    },
    {
      "kind" : "option",
      "line" : 72,
      "npc" : "Hypnotist",
      "text" : "Yes"
    },
    {
      "kind" : "option",
      "line" : 72,
      "npc" : "Hypnotist",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Hypnotist",
      "text" : "I'm sorry, but characters"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Hypnotist",
      "text" : "with Base Levels higher"
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Hypnotist",
      "text" : "than 40 are ineligible for the"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Hypnotist",
      "text" : "Skill Reset service I provide."
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Hypnotist",
      "text" : "Oh! Please remove your"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Hypnotist",
      "text" : "Pushcart before proceeding"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Hypnotist",
      "text" : "with the Skill Reset service."
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Hypnotist",
      "text" : "Thanks for cooperating~"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Hypnotist",
      "text" : "If you're here for my Skill"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Hypnotist",
      "text" : "Reset service, please"
    },
    {
      "kind" : "message",
      "line" : 94,
      "npc" : "Hypnotist",
      "text" : "remember that you can't"
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Hypnotist",
      "text" : "reset your skills until the"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Hypnotist",
      "text" : "^FF0000weight of your carried items in"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Hypnotist",
      "text" : "your Inventory is reduced to 0^000000."
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Hypnotist",
      "text" : "Why don't you place your"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Hypnotist",
      "text" : "things into the Kafra Storage"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Hypnotist",
      "text" : "for now? That way, you can"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Hypnotist",
      "text" : "safely keep all of your goods."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Hypnotist",
      "text" : "Thank you for using"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Hypnotist",
      "text" : "my Skill Redistribution"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Hypnotist",
      "text" : "services. Oh, and best"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Hypnotist",
      "text" : "of luck to you on your"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Hypnotist",
      "text" : "travels, adventurer."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Hypnotist",
      "text" : "I'm sorry, but your"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Hypnotist",
      "text" : "Job Class doesn't qualify"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Hypnotist",
      "text" : "for the Skill Reset service"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Hypnotist",
      "text" : "that I provide. I can only"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Hypnotist",
      "text" : "offer Skill Resets to the"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Hypnotist",
      "text" : "following Jobs..."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Hypnotist",
      "text" : "^FF0000Swordman, Acolyte,"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Hypnotist",
      "text" : "Mage, Thief, Archer,"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Hypnotist",
      "text" : "Merchant, Taekwon"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Hypnotist",
      "text" : "Boy, Taekwon Girl, Gunslinger and Ninja^000000."
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Hypnotist",
      "text" : "Thank you, and good"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Hypnotist",
      "text" : "luck on your adventures."
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Hypnotist",
      "text" : "Please travel in safety~"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Hypnotist",
      "text" : "[Hypnotist]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Hypnotist",
      "text" : "Thank you, and good"
    },
    {
      "kind" : "message",
      "line" : 139,
      "npc" : "Hypnotist",
      "text" : "luck on your adventures."
    },
