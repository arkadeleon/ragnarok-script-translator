    {
      "kind" : "message",
      "line" : 276,
      "npc" : "Ascetic",
      "text" : "[Father Rubalkabara]"
    },
    {
      "kind" : "message",
      "line" : 277,
      "npc" : "Ascetic",
      "text" : "Well, I'll send the message telling them that you've come to visit me. So, you may now return to the Prontera Sanctuary."
