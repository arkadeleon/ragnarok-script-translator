    {
      "kind" : "message",
      "line" : 267,
      "npc" : "Ascetic",
      "text" : "[Father Rubalkabara]"
    },
    {
      "kind" : "message",
      "line" : 268,
      "npc" : "Ascetic",
      "text" : "I believe you've been told much about Acolytes from Friar Mareusis. Plus, there's plenty of helpful people in the Prontera Sanctuary."
