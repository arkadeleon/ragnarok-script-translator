    {
      "kind" : "message",
      "line" : 232,
      "npc" : "Archer Guildsman",
      "text" : "[Archer Guildsman]"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Archer Guildsman",
      "text" : "First of all, you have to the Job Level 9 as a Novice, and know all of the Basic Skills."
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Archer Guildsman",
      "text" : "[Archer Guildsman]"
    },
    {
      "kind" : "message",
      "line" : 236,
      "npc" : "Archer Guildsman",
      "text" : "An Archer needs extremely high concentration and reflexes, so we do not accept those who have little patience."
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Archer Guildsman",
      "text" : "[Archer Guildsman]"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Archer Guildsman",
      "text" : "You also have to gather ^FF0000Trunks^000000. There are 4 different types of Trunks, each of differing quality. You'll be given different grades for your Trunks, depending on their quality."
    },
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "Archer Guildsman",
      "text" : "[Archer Guildsman]"
    },
    {
      "kind" : "message",
      "line" : 242,
      "npc" : "Archer Guildsman",
      "text" : "In order to become an Archer, you must receive a grade of at least ^0000FF25^000000 points out of 40. You can get Trunks from 'Willow,' the tree. Be careful, though. They can be tough monsters."
    }
