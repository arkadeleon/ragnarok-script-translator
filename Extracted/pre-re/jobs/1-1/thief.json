{
  "file" : "npc/pre-re/jobs/1-1/thief.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Thief Guide",
      "text" : "Huh? Do I know you? It's creepy that you seem so familiar. You don't have a twin, do you?"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Thief Guide",
      "text" : "What, do you want to be a Thief? I'm sorry, but you look like you need more training."
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Thief Guide",
      "text" : "Take your time and learn all the Basic Skills, will you? Well then, see you later~!"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Thief Guide",
      "text" : "Well, I got this feeling like you've been through a lifetime of fighting, so I'm promoting you to a Thief right this minute. I better give you tough guys what you want..."
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Thief Guide",
      "text" : "Since you've become a Thief, live as a Thief. Now, go for it! Next~"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Thief Guide",
      "text" : "Hey, dude."
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Thief Guide",
      "text" : "Hey, baby~"
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Thief Guide",
      "text" : "Hey, dude."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Thief Guide",
      "text" : "Hey, baby."
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Thief Guide",
      "text" : "...Hey! You look too goody-goody to want to be a Thief!! Now scram, I'm busy. Next!"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Thief Guide",
      "text" : "If you have a problem, feel free to speak to me anytime, alright?"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Thief Guide",
      "text" : "What the heck...?"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Thief Guide",
      "text" : "Huh."
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Thief Guide",
      "text" : "Now, that's"
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Thief Guide",
      "text" : "a big sword."
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Thief Guide",
      "text" : "So..."
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Thief Guide",
      "text" : "Trying to make"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Thief Guide",
      "text" : "up for something"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Thief Guide",
      "text" : "...Buddy?"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Thief Guide",
      "text" : "What's a Mage doin' here? Shouldn't you be doing card tricks elsewhere? Oh well, it's a free country..."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Thief Guide",
      "text" : "Oh wait,"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Thief Guide",
      "text" : "it's not..."
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Thief Guide",
      "text" : "Get outta here!"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Thief Guide",
      "text" : "Man, shouldn't you"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Thief Guide",
      "text" : "Archers be playing"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Thief Guide",
      "text" : "in the forest"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Thief Guide",
      "text" : "or something?"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Thief Guide",
      "text" : "You know we all steal for a living, right? What are you doing in this kinda place, Acolyte?"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Thief Guide",
      "text" : "You're a Merchant,"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Thief Guide",
      "text" : "right? Why are you"
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Thief Guide",
      "text" : "walking into a den"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Thief Guide",
      "text" : "of Thieves?!"
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Thief Guide",
      "text" : "It's like you're begging"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Thief Guide",
      "text" : "us to steal from you!"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Thief Guide",
      "text" : "Come on, hurry and"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Thief Guide",
      "text" : "get outta here~"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Thief Guide",
      "text" : "Oh my God..."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Thief Guide",
      "text" : "Am I dying?"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Thief Guide",
      "text" : "Why else would a Priest come here? I guess I better start confessing all of my misdeeds."
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Thief Guide",
      "text" : "Didn't you use to be one of us?! Man, you changed. You seem real dangerous now..."
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Thief Guide",
      "text" : "Man, you got real cool all of a sudden! You must have some skills I can only dream of!"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Thief Guide",
      "text" : "*Sigh* Look, there's really no need for you to be in this kind of place. You oughta go where you ought to go."
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Thief Guide",
      "text" : "Hmmm?"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Thief Guide",
      "text" : "You gathered Mushrooms for"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Thief Guide",
      "text" : "the Thief test, right?"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Thief Guide",
      "text" : "Here, talk to the other guy right next to me. He's the one in charge of checking your Mushrooms."
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Thief Guide",
      "text" : "So how was the"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Thief Guide",
      "text" : "Mushroom Farm?"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Thief Guide",
      "text" : "Have any fun?"
    },
    {
      "kind" : "option",
      "line" : 156,
      "npc" : "Thief Guide",
      "text" : "Yeah, kinda Cool."
    },
    {
      "kind" : "option",
      "line" : 156,
      "npc" : "Thief Guide",
      "text" : "It was horrible."
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Thief Guide",
      "text" : "Heh heh! That's a good attitude. In our line of work, you gotta enjoy getting your hands dirty, one way or another."
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Thief Guide",
      "text" : "Yeah? I've been there too, so I can see why that place isn't everyone's cup of tea. Still, being a Thief isn't all glamour and trendy night life."
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Thief Guide",
      "text" : "Hey, whaddya doin' here? Aren't you supposed to be gathering Mushrooms? Or did you need it explained to you again?"
    },
    {
      "kind" : "option",
      "line" : 169,
      "npc" : "Thief Guide",
      "text" : "Yes."
    },
    {
      "kind" : "option",
      "line" : 169,
      "npc" : "Thief Guide",
      "text" : "No, that's okay."
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Thief Guide",
      "text" : "*Sigh* Well, there's always one in the bunch. Alright, listen carefully."
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Thief Guide",
      "text" : "Alright, for your test, you gotta steal Mushrooms from a farm. Don't worry, the guy who owns the farm deserves to be robbed."
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Thief Guide",
      "text" : "Anyway, you gotta gather two kinds of Mushrooms: ^0000FFOrange Net Mushrooms^000000 and ^0000FFOrange Gooey Mushrooms^000000."
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Thief Guide",
      "text" : "Be careful, since there are monsters are the farm that are there to protect the Mushrooms. So this will be no walk in the park."
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 183,
      "npc" : "Thief Guide",
      "text" : "When you come back here after gathering Mushrooms, you'll be graded on the Mushrooms you've collected."
    },
    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Thief Guide",
      "text" : "Each Orange Net Mushroom gets you 3 points, and you get 1 point for each Orange Gooey Mushroom. You need a total of 25 points to pass the test."
    },
    {
      "kind" : "message",
      "line" : 188,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Thief Guide",
      "text" : "Go outside and keep going ahead toward the Eastern Field of the Pyramids. Then you will see one of our comrades between two columns."
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "Thief Guide",
      "text" : "Speak to that guy, and he'll take you to the farm through the backdoor."
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Thief Guide",
      "text" : "On that field, I think his coordinates are '^FF0000141, 125^000000.' Just type ^3355FF/where^000000 in the right side of your chat box to check your present coordinates."
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Thief Guide",
      "text" : "Huh. For a second there, I thought you had something really important to tell me."
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Thief Guide",
      "text" : "What brings you down"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Thief Guide",
      "text" : "here to this rathole?"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Thief Guide",
      "text" : "Ah..."
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Thief Guide",
      "text" : "You came back."
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Thief Guide",
      "text" : "Are you sure you're"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Thief Guide",
      "text" : "ready to try again?"
    },
    {
      "kind" : "option",
      "line" : 214,
      "npc" : "Thief Guide",
      "text" : "Hey, I came here to be a Thief!"
    },
    {
      "kind" : "option",
      "line" : 214,
      "npc" : "Thief Guide",
      "text" : "Nah, I'm just looking around."
    },
    {
      "kind" : "message",
      "line" : 216,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 217,
      "npc" : "Thief Guide",
      "text" : "Heh, I like your confidence. Still, you know being a Thief isn't all what it's cracked up to be."
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Thief Guide",
      "text" : "Still..."
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "Thief Guide",
      "text" : "Do you really"
    },
    {
      "kind" : "message",
      "line" : 222,
      "npc" : "Thief Guide",
      "text" : "want to be"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Thief Guide",
      "text" : "a Thief?"
    },
    {
      "kind" : "option",
      "line" : 225,
      "npc" : "Thief Guide",
      "text" : "Yeah."
    },
    {
      "kind" : "option",
      "line" : 225,
      "npc" : "Thief Guide",
      "text" : "No, just wasting your time."
    },
    {
      "kind" : "option",
      "line" : 225,
      "npc" : "Thief Guide",
      "text" : "Why did you become a Thief?"
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 228,
      "npc" : "Thief Guide",
      "text" : "Really..."
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 232,
      "npc" : "Thief Guide",
      "text" : "Yeah..."
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Thief Guide",
      "text" : "I can see that."
    },
    {
      "kind" : "message",
      "line" : 236,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 237,
      "npc" : "Thief Guide",
      "text" : "Me...?"
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Thief Guide",
      "text" : "I had no choice at the time. It was either steal or starve. But it's not like I need to give you my life story."
    },
    {
      "kind" : "message",
      "line" : 242,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 243,
      "npc" : "Thief Guide",
      "text" : "So do you want to"
    },
    {
      "kind" : "message",
      "line" : 244,
      "npc" : "Thief Guide",
      "text" : "apply to become"
    },
    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Thief Guide",
      "text" : "a Thief or not?"
    },
    {
      "kind" : "option",
      "line" : 247,
      "npc" : "Thief Guide",
      "text" : "Yes, I will."
    },
    {
      "kind" : "option",
      "line" : 247,
      "npc" : "Thief Guide",
      "text" : "I'm too scared to be a Thief!"
    },
    {
      "kind" : "message",
      "line" : 249,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 250,
      "npc" : "Thief Guide",
      "text" : "Alright, tell"
    },
    {
      "kind" : "message",
      "line" : 251,
      "npc" : "Thief Guide",
      "text" : "me your name."
    },
    {
      "kind" : "message",
      "line" : 253,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 254,
      "npc" : "Thief Guide",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "{0}?"
    },
    {
      "kind" : "message",
      "line" : 255,
      "npc" : "Thief Guide",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "What kind of name is {0}? Anyway, give me a second."
    },
    {
      "kind" : "message",
      "line" : 258,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 259,
      "npc" : "Thief Guide",
      "text" : "Alright, your registration has been processed. Okay, you can begin your test if you're ready."
    },
    {
      "kind" : "option",
      "line" : 261,
      "npc" : "Thief Guide",
      "text" : "Yeah, I'm ready."
    },
    {
      "kind" : "option",
      "line" : 261,
      "npc" : "Thief Guide",
      "text" : "No, I'm not ready yet."
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "Thief Guide",
      "text" : "[Thief Guide]"
    },
    {
      "kind" : "message",
      "line" : 266,
      "npc" : "Thief Guide",
      "text" : "Not ready?"
    },
    {
      "kind" : "message",
