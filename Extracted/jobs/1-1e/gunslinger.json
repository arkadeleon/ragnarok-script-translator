{
  "file" : "npc/jobs/1-1e/gunslinger.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Master Miller",
      "text" : "Well, aren't you an"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Master Miller",
      "text" : "adorable little child~"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Master Miller",
      "text" : "Where's your mommy?"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Master Miller",
      "text" : "This place is dangerous, so"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Master Miller",
      "text" : "please go home soon, okay?"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Master Miller",
      "text" : "Interested in becoming"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Master Miller",
      "text" : "a Gunslinger, eh? You've"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Master Miller",
      "text" : "got potential, but you're"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Master Miller",
      "text" : "not yet experienced enough."
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Master Miller",
      "text" : "Just train yourself a bit more,"
    },
    {
      "kind" : "message",
      "line" : 49,
      "npc" : "Master Miller",
      "text" : "and then come back, you hear?"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Master Miller",
      "text" : "I'm Miller, a full time"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Master Miller",
      "text" : "Gunslinger drillmaster, and"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Master Miller",
      "text" : "full time guardian for Lady"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Master Miller",
      "text" : "Selena. Now, what do you"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Master Miller",
      "text" : "need? If it's not important, then I can't make the time for you."
    },
    {
      "kind" : "option",
      "line" : 60,
      "npc" : "Master Miller",
      "text" : "Nothing."
    },
    {
      "kind" : "option",
      "line" : 60,
      "npc" : "Master Miller",
      "text" : "I want to become a Gunslinger."
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Master Miller",
      "text" : "Don't waste my time."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Master Miller",
      "text" : "If you do want to become"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Master Miller",
      "text" : "a Gunslinger, then come"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Master Miller",
      "text" : "back and talk to me."
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Master Miller",
      "text" : "Hm. You're pretty young, but"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Master Miller",
      "text" : "your eyes tell me that you're"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Master Miller",
      "text" : "pretty ambitious. You'll need to pass our interview and educational"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Master Miller",
      "text" : "course to become a Gunslinger. Do you want to apply for the job?"
    },
    {
      "kind" : "option",
      "line" : 74,
      "npc" : "Master Miller",
      "text" : "Give me some time to think."
    },
    {
      "kind" : "option",
      "line" : 74,
      "npc" : "Master Miller",
      "text" : "Sure!"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Master Miller",
      "text" : "Understandable."
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Master Miller",
      "text" : "If you do decide that"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Master Miller",
      "text" : "you want to become"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Master Miller",
      "text" : "a Gunslinger, then let"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Master Miller",
      "text" : "me know right away."
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Master Miller",
      "text" : "I'll get you started."
    },
    {
      "kind" : "message",
      "line" : 84,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Master Miller",
      "text" : "Great, great. Alright then,"
    },
    {
      "kind" : "message",
      "line" : 86,
      "npc" : "Master Miller",
      "text" : "let's get you started. Take"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Master Miller",
      "text" : "this letter to Mr. Wise Bull"
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Master Miller",
      "text" : "Horn in Payon. He's a shaman"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Master Miller",
      "text" : "that will judge whether or not"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Master Miller",
      "text" : "you qualify to be a Gunslinger."
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Master Miller",
      "text" : "Take that letter of"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Master Miller",
      "text" : "introduction I've written"
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Master Miller",
      "text" : "for you to Mr. Wise Bull"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Master Miller",
      "text" : "Horn in Payon. He'll test"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Master Miller",
      "text" : "you to see if you're really"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Master Miller",
      "text" : "Gunslinger material."
    },
    {
      "kind" : "message",
      "line" : 106,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 107,
      "npc" : "Master Miller",
      "text" : "Hmm... Wise Bull Horn"
    },
    {
      "kind" : "message",
      "line" : 108,
      "npc" : "Master Miller",
      "text" : "asked you to collect the"
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Master Miller",
      "text" : "items you need to make the"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Master Miller",
      "text" : "voucher? Hm. I guess that's"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Master Miller",
      "text" : "part of his qualification test."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Master Miller",
      "text" : "Wise Bull Horn asked"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Master Miller",
      "text" : "you to bring him some"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Master Miller",
      "text" : "Milk? He must really like"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Master Miller",
      "text" : "you if he's already asking"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Master Miller",
      "text" : "for favors. Good luck, friend."
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Master Miller",
      "text" : "I expect to hear good"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Master Miller",
      "text" : "news from you soon. You"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Master Miller",
      "text" : "know, I have no doubt that"
    },
    {
      "kind" : "message",
      "line" : 128,
      "npc" : "Master Miller",
      "text" : "you'll become a Gunslinger."
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Master Miller",
      "text" : "Hey, you have leftover"
    },
    {
      "kind" : "message",
      "line" : 135,
      "npc" : "Master Miller",
      "text" : "Skill Points. You better"
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Master Miller",
      "text" : "use them all up before you"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Master Miller",
      "text" : "come and talk to me again."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Master Miller",
      "text" : "Oh, you've brought a"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Master Miller",
      "text" : "voucher from Wise Bull Horn?"
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Master Miller",
      "text" : "It's been a while since he's"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Master Miller",
      "text" : "given one to anybody, so"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Master Miller",
      "text" : "I'm really proud of you!"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Master Miller",
      "text" : "If Wise Bull Horn approves,"
    },
    {
      "kind" : "message",
      "line" : 149,
      "npc" : "Master Miller",
      "text" : "then I have no reason to"
    },
    {
      "kind" : "message",
      "line" : 150,
      "npc" : "Master Miller",
      "text" : "reject you. Alright then, I'll"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Master Miller",
      "text" : "promote you to a Gunslinger."
    },
    {
      "kind" : "message",
      "line" : 152,
      "npc" : "Master Miller",
      "text" : "But first, let me explain"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Master Miller",
      "text" : "our job in more detail."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 156,
      "npc" : "Master Miller",
      "text" : "As a Gunslinger, you must"
    },
    {
      "kind" : "message",
      "line" : 157,
      "npc" : "Master Miller",
      "text" : "keep your gun with you at"
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Master Miller",
      "text" : "all times. The Gunslinger"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Master Miller",
      "text" : "Guild keeps track of every Gun"
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Master Miller",
      "text" : "and Bullet, so you can only get"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Master Miller",
      "text" : "them from our guild members."
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Master Miller",
      "text" : "Don't worry, Gunslinger"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Master Miller",
      "text" : "Guildsmen can be found almost"
    },
    {
      "kind" : "message",
      "line" : 166,
      "npc" : "Master Miller",
      "text" : "anywhere these days. Anyway,"
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Master Miller",
      "text" : "it has to be this way by order of our guild leader, Lady Selena."
    },
    {
      "kind" : "message",
      "line" : 169,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Master Miller",
      "text" : "You might get the chance to"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Master Miller",
      "text" : "meet her one of these days."
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Master Miller",
      "text" : "Anyway, just now that we have"
    },
    {
      "kind" : "message",
      "line" : 173,
      "npc" : "Master Miller",
      "text" : "to regulate Gun and Bullet sales to keep them away from evil"
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Master Miller",
      "text" : "or irresponsible folk."
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Master Miller",
      "text" : "In any case, it's always"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Master Miller",
      "text" : "a pleasure for me to talk"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Master Miller",
      "text" : "to another Gunslinger, so"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Master Miller",
      "text" : "let's keep in touch. May the"
    },
    {
      "kind" : "message",
      "line" : 181,
      "npc" : "Master Miller",
      "text" : "power of the earth protect"
    },
    {
      "kind" : "message",
      "line" : 182,
      "npc" : "Master Miller",
      "text" : "you in all of your adventures~"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 201,
      "npc" : "Master Miller",
      "text" : "Oh! Long time, no see,"
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Master Miller",
      "text" : "friend. How have you been?"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Master Miller",
      "text" : "I hope you've been keeping"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Master Miller",
      "text" : "you Gun well maintained."
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Master Miller",
      "text" : "Take care of it, and it'll take"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Master Miller",
      "text" : "care of you. Remember it."
    },
    {
      "kind" : "message",
      "line" : 209,
      "npc" : "Master Miller",
      "text" : "[Master Miller]"
    },
    {
      "kind" : "message",
      "line" : 210,
      "npc" : "Master Miller",
      "text" : "If you don't have"
    },
    {
      "kind" : "message",
      "line" : 211,
      "npc" : "Master Miller",
      "text" : "any business with me,"
    },
    {
      "kind" : "message",
      "line" : 212,
      "npc" : "Master Miller",
      "text" : "then please go on your way."
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Wise Bull Horn",
      "text" : "[Wise Bull Horn]"
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "Wise Bull Horn",
      "text" : "Hello, young wolf."
    },
    {
      "kind" : "message",
      "line" : 222,
      "npc" : "Wise Bull Horn",
      "text" : "What business has"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Wise Bull Horn",
      "text" : "brought you before me?"
    },
    {
      "kind" : "message",
      "line" : 225,
      "npc" : "Wise Bull Horn",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "[{0}]"
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Wise Bull Horn",
      "text" : "Mr. Miller sent me to"
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Wise Bull Horn",
      "text" : "deliver this letter to you."
    },
    {
      "kind" : "message",
      "line" : 228,
      "npc" : "Wise Bull Horn",
      "text" : "Actually, I'm interested in"
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Wise Bull Horn",
      "text" : "becoming a Gunslinger..."
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Wise Bull Horn",
      "text" : "[Wise Bull Horn]"
    },
    {
      "kind" : "message",
      "line" : 232,
      "npc" : "Wise Bull Horn",
      "text" : "Miller, you said?"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Wise Bull Horn",
      "text" : "Hm, the Black Fox doesn't"
    },
    {
      "kind" : "message",
      "line" : 234,
      "npc" : "Wise Bull Horn",
      "text" : "give introductions for anyone"
    },
    {
      "kind" : "message",
      "line" : 235,
      "npc" : "Wise Bull Horn",
      "text" : "he doesn't believe will make"
    },
    {
      "kind" : "message",
      "line" : 236,
      "npc" : "Wise Bull Horn",
      "text" : "a good Gunslinger. Yes, I think"
    },
    {
      "kind" : "message",
      "line" : 237,
      "npc" : "Wise Bull Horn",
      "text" : "I know why he sent you to me."
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Wise Bull Horn",
      "text" : "[Wise Bull Horn]"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Wise Bull Horn",
      "text" : "I can see it in your eyes:"
    },
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "Wise Bull Horn",
      "text" : "you've got a warm heart and a"
    },
    {
      "kind" : "message",
      "line" : 242,
      "npc" : "Wise Bull Horn",
      "text" : "strong sense of responsibility."
    },
    {
      "kind" : "message",
      "line" : 243,
      "npc" : "Wise Bull Horn",
      "text" : "All you need is the blessing"
    },
    {
      "kind" : "message",
      "line" : 244,
      "npc" : "Wise Bull Horn",
      "text" : "of the Earth to protect you"
    },
    {
      "kind" : "message",
      "line" : 245,
      "npc" : "Wise Bull Horn",
      "text" : "as a Gunslinger."
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Wise Bull Horn",
      "text" : "[Wise Bull Horn]"
    },
    {
      "kind" : "message",
      "line" : 248,
      "npc" : "Wise Bull Horn",
      "text" : "I can make a voucher that"
    },
    {
      "kind" : "message",
