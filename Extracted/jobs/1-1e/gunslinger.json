    },
    {
      "kind" : "message",
      "line" : 267,
      "npc" : "Wise Bull Horn",
      "text" : "will help you achieve"
    },
    {
      "kind" : "message",
      "line" : 268,
      "npc" : "Wise Bull Horn",
      "text" : "your goal of becoming"
    },
    {
      "kind" : "message",
      "line" : 269,
      "npc" : "Wise Bull Horn",
      "text" : "a Gunslinger."
    },
    {
      "kind" : "message",
      "line" : 276,
      "npc" : "Wise Bull Horn",
      "text" : "[Wise Bull Horn]"
    },
    {
      "kind" : "message",
      "line" : 277,
      "npc" : "Wise Bull Horn",
      "text" : "I can make a voucher that"
    },
    {
      "kind" : "message",
      "line" : 278,
      "npc" : "Wise Bull Horn",
      "text" : "will demonstrate your desire"
    },
    {
      "kind" : "message",
      "line" : 279,
      "npc" : "Wise Bull Horn",
      "text" : "to become a warrior of the"
    },
    {
      "kind" : "message",
      "line" : 280,
      "npc" : "Wise Bull Horn",
      "text" : "earth for you to present to"
    },
    {
      "kind" : "message",
      "line" : 281,
      "npc" : "Wise Bull Horn",
      "text" : "Gunslinger drillmasters."
    },
    {
