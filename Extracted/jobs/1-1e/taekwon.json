      "text" : "I wish to share with the world."
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Phoenix",
      "text" : "[Phoenix]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Phoenix",
