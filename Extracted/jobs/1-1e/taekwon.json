      "npc" : "Phoenix",
      "text" : "to mature if you run away"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Phoenix",
      "text" : "from challenges? Fear can"
    },
    {
      "kind" : "message",
      "line" : 206,
      "npc" : "Phoenix",
      "text" : "be a healthy reaction that"
    },
    {
      "kind" : "message",
