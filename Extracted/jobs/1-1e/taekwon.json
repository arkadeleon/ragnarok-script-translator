      "text" : "attempts rarely yield"
    },
    {
      "kind" : "message",
      "line" : 192,
      "npc" : "Phoenix",
      "text" : "fruitful results."
    },
    {
      "kind" : "message",
      "line" : 194,
      "npc" : "Phoenix",
      "text" : "[Phoenix]"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Phoenix",
      "text" : "Seeing as you already"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Phoenix",
      "text" : "understand the importance"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Phoenix",
      "text" : "of one's will, we'll proceed"
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Phoenix",
      "text" : "to the next question."
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Phoenix",
      "text" : "[Phoenix]"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Phoenix",
      "text" : "Fool! How do you expect"
    },
