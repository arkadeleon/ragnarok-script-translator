      "kind" : "message",
      "line" : 164,
      "npc" : "Phoenix",
      "text" : "[Phoenix]"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Phoenix",
      "text" : "As a practitioner of my"
    },
    {
      "kind" : "message",
      "line" : 166,
