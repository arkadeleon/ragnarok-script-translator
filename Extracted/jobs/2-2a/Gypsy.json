      "text" : "For me, it's a way of life~"
    },
    {
      "kind" : "message",
      "line" : 37,
      "npc" : "Gypsy",
      "text" : "[Gypsy]"
    },
    {
      "kind" : "message",
      "line" : 38,
      "npc" : "Gypsy",
      "text" : "The land of Midgard"
    },
    {
      "kind" : "message",
