      "npc" : "Gypsy",
      "text" : "is in need of talented women"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Gypsy",
      "text" : "to subtly change the balances"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Gypsy",
      "text" : "in the battle between good"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Gypsy",
      "text" : "and evil."
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Gypsy",
      "text" : "[Gypsy]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Gypsy",
      "text" : "Are you ready"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Gypsy",
      "text" : "to take up this role,"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Gypsy",
      "text" : "and become a Gypsy?"
    },
    {
      "kind" : "option",
      "line" : 49,
      "npc" : "Gypsy",
      "text" : "No."
    },
    {
      "kind" : "option",
      "line" : 49,
      "npc" : "Gypsy",
      "text" : "Yes."
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Gypsy",
      "text" : "[Gypsy]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Gypsy",
      "text" : "When you're ready,"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Gypsy",
      "text" : "feel free to come back."
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Gypsy",
      "text" : "Honor to the warriors!"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Gypsy",
      "text" : "[Gypsy]"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Gypsy",
      "text" : "It is still possible for you to learn more skills. Please use"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Gypsy",
      "text" : "all of your remaining Skill Points before returning to me."
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Gypsy",
      "text" : "[Gypsy]"
    },
    {
      "kind" : "message",
