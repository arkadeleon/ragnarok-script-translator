      "text" : "Congratulations."
    },
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Lord Knight",
      "text" : "Honor to the warriors!"
    },
    {
      "kind" : "message",
      "line" : 27,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 28,
      "npc" : "Lord Knight",
      "text" : "We Knights have an"
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Lord Knight",
      "text" : "awesome responsibility..."
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Lord Knight",
      "text" : "To serve and protect."
    },
    {
      "kind" : "message",
      "line" : 32,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 33,
      "npc" : "Lord Knight",
      "text" : "Even at the cost"
    },
    {
      "kind" : "message",
      "line" : 34,
      "npc" : "Lord Knight",
      "text" : "of our own lives,"
    },
    {
      "kind" : "message",
      "line" : 35,
      "npc" : "Lord Knight",
      "text" : "we must safeguard the"
    },
    {
      "kind" : "message",
      "line" : 36,
      "npc" : "Lord Knight",
      "text" : "well being of our comrades."
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Lord Knight",
      "text" : "Your time has come!"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Lord Knight",
      "text" : "The world still needs you."
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Lord Knight",
      "text" : "Please continue your life"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Lord Knight",
      "text" : "as a hero with a new appearance."
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Lord Knight",
      "text" : "Would you like"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Lord Knight",
      "text" : "to become a Lord Knight?"
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Lord Knight",
      "text" : "No."
    },
    {
      "kind" : "option",
      "line" : 50,
      "npc" : "Lord Knight",
      "text" : "Yes."
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Lord Knight",
      "text" : "When you're ready,"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Lord Knight",
      "text" : "feel free to come back."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Lord Knight",
      "text" : "Honor to the warriors!"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Lord Knight",
      "text" : "It is still possible for you to learn more skills. Please use"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Lord Knight",
      "text" : "all of your remaining Skill Points before returning to me."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Lord Knight",
      "text" : "Congratulations!"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Lord Knight",
      "text" : "As a Lord Knight,"
    },
    {
      "kind" : "message",
      "line" : 68,
      "npc" : "Lord Knight",
      "text" : "I hope that you will be"
    },
    {
      "kind" : "message",
      "line" : 69,
      "npc" : "Lord Knight",
      "text" : "at the forefront of battle,"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Lord Knight",
      "text" : "and lead your allies to victory!"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Lord Knight",
      "text" : "Welcome"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Lord Knight",
      "text" : "to Valhalla,"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Lord Knight",
      "text" : "the Hall of Honor."
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Lord Knight",
      "text" : "[Lord Knight]"
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Lord Knight",
      "text" : "Please make"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Lord Knight",
      "text" : "yourself comfortable"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Lord Knight",
      "text" : "while you are here."
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Lord Knight",
      "text" : "Honor to the warriors!"
    }
  ]
