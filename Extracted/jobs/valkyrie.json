{
  "file" : "npc/jobs/valkyrie.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Valkyrie",
      "text" : "Welcome"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Valkyrie",
      "text" : "to Valhalla,"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Valkyrie",
      "text" : "the Hall of Honor."
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Valkyrie",
      "text" : "Please make"
    },
    {
      "kind" : "message",
      "line" : 52,
      "npc" : "Valkyrie",
      "text" : "yourself comfortable"
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Valkyrie",
      "text" : "while you are here."
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Valkyrie",
      "text" : "Honor to the warriors!"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 59,
      "npc" : "Valkyrie",
      "text" : "Welcome"
    },
    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Valkyrie",
      "text" : "to Valhalla,"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Valkyrie",
      "text" : "the Hall of Honor."
    },
    {
      "kind" : "message",
      "line" : 63,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 64,
      "npc" : "Valkyrie",
      "text" : "You will now end"
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Valkyrie",
      "text" : "your present life and"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Valkyrie",
      "text" : "begin an entirely new life."
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Valkyrie",
      "text" : "Honor to the warriors!"
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Valkyrie",
      "text" : "There are a few things you must"
    },
    {
      "kind" : "message",
      "line" : 72,
      "npc" : "Valkyrie",
      "text" : "do before we start. You must"
    },
    {
      "kind" : "message",
      "line" : 73,
      "npc" : "Valkyrie",
      "text" : "first empty your mind and body."
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Valkyrie",
      "text" : "Honor comes when you abandon"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Valkyrie",
      "text" : "all your selfish desires..."
    },
    {
      "kind" : "message",
      "line" : 77,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 78,
      "npc" : "Valkyrie",
      "text" : "You cannot take anything with you to the next life. Your items, zeny, pets and Pushcart all have to be left behind."
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 81,
      "npc" : "Valkyrie",
      "text" : "When you are ready"
    },
    {
      "kind" : "message",
      "line" : 82,
      "npc" : "Valkyrie",
      "text" : "please return to me,"
    },
    {
      "kind" : "message",
      "line" : 83,
      "npc" : "Valkyrie",
      "text" : "brave adventurer."
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 90,
      "npc" : "Valkyrie",
      "text" : "I see you've already"
    },
    {
      "kind" : "message",
      "line" : 91,
      "npc" : "Valkyrie",
      "text" : "released yourself from"
    },
    {
      "kind" : "message",
      "line" : 92,
      "npc" : "Valkyrie",
      "text" : "all worldy attachments,"
    },
    {
      "kind" : "message",
      "line" : 93,
      "npc" : "Valkyrie",
      "placeholders" : [
        "strcharinfo(0)"
      ],
      "text" : "{0}."
    },
    {
      "kind" : "message",
      "line" : 95,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 96,
      "npc" : "Valkyrie",
      "text" : "That's an admirable attitude for an adventurer such as yourself. Honor comes when you abandon all personal desires for the sake of mankind."
    },
    {
      "kind" : "message",
      "line" : 99,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 100,
      "npc" : "Valkyrie",
      "text" : "Hmm... I sense that you have"
    },
    {
      "kind" : "message",
      "line" : 101,
      "npc" : "Valkyrie",
      "text" : "some lingering attachment or"
    },
    {
      "kind" : "message",
      "line" : 102,
      "npc" : "Valkyrie",
      "text" : "unfinished business in your"
    },
    {
      "kind" : "message",
      "line" : 103,
      "npc" : "Valkyrie",
      "text" : "current life. Take care of that,"
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Valkyrie",
      "text" : "and bring closure to your present life."
    },
    {
      "kind" : "message",
      "line" : 109,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 110,
      "npc" : "Valkyrie",
      "text" : "Now, let me remove all"
    },
    {
      "kind" : "message",
      "line" : 111,
      "npc" : "Valkyrie",
      "text" : "of your present memories..."
    },
    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Valkyrie",
      "text" : "However, you will be able to"
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Valkyrie",
      "text" : "remember the most honorable"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Valkyrie",
      "text" : "moments of this life."
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Valkyrie",
      "text" : "With one,"
    },
    {
      "kind" : "message",
      "line" : 118,
      "npc" : "Valkyrie",
      "text" : "I will ask the"
    },
    {
      "kind" : "message",
      "line" : 119,
      "npc" : "Valkyrie",
      "text" : "goddess Urd to remove"
    },
    {
      "kind" : "message",
      "line" : 120,
      "npc" : "Valkyrie",
      "text" : "all of your present"
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Valkyrie",
      "text" : "memories."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 124,
      "npc" : "Valkyrie",
      "text" : "With two,"
    },
    {
      "kind" : "message",
      "line" : 125,
      "npc" : "Valkyrie",
      "text" : "I will ask the"
    },
    {
      "kind" : "message",
      "line" : 126,
      "npc" : "Valkyrie",
      "text" : "goddess Verdandi to keep"
    },
    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Valkyrie",
      "text" : "and record the most honorable moments of your present life."
    },
    {
      "kind" : "message",
      "line" : 129,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 130,
      "npc" : "Valkyrie",
      "text" : "With three,"
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Valkyrie",
      "text" : "I will ask the"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Valkyrie",
      "text" : "goddess Skuld to"
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Valkyrie",
      "text" : "guide you to your"
    },
    {
      "kind" : "message",
      "line" : 134,
      "npc" : "Valkyrie",
      "text" : "next life."
    },
    {
      "kind" : "message",
      "line" : 136,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Valkyrie",
      "text" : "One..."
    },
    {
      "kind" : "message",
      "line" : 140,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Valkyrie",
      "text" : "One..."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Valkyrie",
      "text" : "Two......"
    },
    {
      "kind" : "message",
      "line" : 144,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Valkyrie",
      "text" : "One..."
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Valkyrie",
      "text" : "Two......"
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Valkyrie",
      "text" : "And Three."
    },
    {
      "kind" : "message",
      "line" : 158,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 159,
      "npc" : "Valkyrie",
      "text" : "Congratulations."
    },
    {
      "kind" : "message",
      "line" : 160,
      "npc" : "Valkyrie",
      "text" : "You are now reborn"
    },
    {
      "kind" : "message",
      "line" : 161,
      "npc" : "Valkyrie",
      "text" : "into a brand new life."
    },
    {
      "kind" : "message",
      "line" : 162,
      "npc" : "Valkyrie",
      "text" : "Please take these small gifts"
    },
    {
      "kind" : "message",
      "line" : 163,
      "npc" : "Valkyrie",
      "text" : "in preparation for your new adventures."
    },
    {
      "kind" : "message",
      "line" : 167,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 168,
      "npc" : "Valkyrie",
      "text" : "I wish that the release the goddess Urd has granted you proves to be a blessing. I hope that the memories Verdandi has recorded will always honor you."
    },
    {
      "kind" : "message",
      "line" : 170,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Valkyrie",
      "text" : "And I pray that the new life to which the goddess Skuld will guide you will be even more honorable than your last."
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Valkyrie",
      "text" : "Welcome"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Valkyrie",
      "text" : "to Valhalla,"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Valkyrie",
      "text" : "the Hall of Honor."
    },
    {
      "kind" : "message",
      "line" : 207,
      "npc" : "Valkyrie",
      "text" : "[Valkyrie]"
    },
    {
      "kind" : "message",
      "line" : 208,
      "npc" : "Valkyrie",
      "text" : "Unfortunately, you have not yet been invited here. I ask you to leave immediately. Honor to the warriors!"
    },
    {
      "kind" : "message",
      "line" : 218,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 219,
      "npc" : "Metheus Sylphe",
      "text" : "Welcome to the Library of the Schweicherbil Magic Academy."
    },
    {
      "kind" : "message",
      "line" : 220,
      "npc" : "Metheus Sylphe",
      "text" : "I assume you have come here"
    },
    {
      "kind" : "message",
      "line" : 221,
      "npc" : "Metheus Sylphe",
      "text" : "to read the 'Book of Ymir.'"
    },
    {
      "kind" : "message",
      "line" : 223,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 224,
      "npc" : "Metheus Sylphe",
      "text" : "Unfortunately, the original copy of the book has been damaged over time. We currently only allow the public to view a copy of the book."
    },
    {
      "kind" : "message",
      "line" : 226,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 227,
      "npc" : "Metheus Sylphe",
      "text" : "Also, in order to preserve the original 'Book of Ymir,' we have decided to accept donations from people who wish to read the copy we have provided."
    },
    {
      "kind" : "message",
      "line" : 229,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 230,
      "npc" : "Metheus Sylphe",
      "text" : "The suggested"
    },
    {
      "kind" : "message",
      "line" : 231,
      "npc" : "Metheus Sylphe",
      "text" : "donation amount is"
    },
    {
      "kind" : "message",
      "line" : 232,
      "npc" : "Metheus Sylphe",
      "text" : "1,285,000 zeny."
    },
    {
      "kind" : "option",
      "line" : 234,
      "npc" : "Metheus Sylphe",
      "text" : "Donate."
    },
    {
      "kind" : "option",
      "line" : 234,
      "npc" : "Metheus Sylphe",
      "text" : "Cancel."
    },
    {
      "kind" : "message",
      "line" : 238,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 239,
      "npc" : "Metheus Sylphe",
      "text" : "Thank you, your donation will be used for a good cause. You may"
    },
    {
      "kind" : "message",
      "line" : 240,
      "npc" : "Metheus Sylphe",
      "text" : "now go in and read the book."
    },
    {
      "kind" : "message",
      "line" : 243,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 244,
      "npc" : "Metheus Sylphe",
      "text" : "Unfortunately, you don't seem to possess enough zeny at the moment. Please check your funds and come back again."
    },
    {
      "kind" : "message",
      "line" : 247,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 248,
      "npc" : "Metheus Sylphe",
      "text" : "Take your time, and"
    },
    {
      "kind" : "message",
      "line" : 249,
      "npc" : "Metheus Sylphe",
      "text" : "enjoy your travels."
    },
    {
      "kind" : "message",
      "line" : 252,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 253,
      "npc" : "Metheus Sylphe",
      "text" : "Once again, thank you for your generous donation. Feel free to read a carbon copy of the 'Book of Ymir' at your leisure."
    },
    {
      "kind" : "message",
      "line" : 256,
      "npc" : "Metheus Sylphe",
      "text" : "[Metheus Sylphe]"
    },
    {
      "kind" : "message",
      "line" : 257,
      "npc" : "Metheus Sylphe",
      "text" : "Welcome to the Library of the Schweicherbil Magic Academy."
    },
    {
      "kind" : "message",
      "line" : 258,
      "npc" : "Metheus Sylphe",
      "text" : "Here, we have a countless number of books. Please take your time and look around."
    },
    {
      "kind" : "message",
      "line" : 264,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 265,
      "npc" : "Book of Ymir",
      "text" : "...The entrance to the Hall of Honor is open to anyone who has moved forward into their next life. It is there to help heroes decide what they want to do, and can lead them to anywhere in this world."
    },
    {
      "kind" : "message",
      "line" : 267,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 268,
      "npc" : "Book of Ymir",
      "text" : "In the Hall of Honor, everything is prepared for heroes. It is rumored that any wish that cannot be fulfilled in our reality can be realized in the Hall of Honor."
    },
    {
      "kind" : "option",
      "line" : 270,
      "npc" : "Book of Ymir",
      "text" : "Stop reading."
    },
    {
      "kind" : "option",
      "line" : 270,
      "npc" : "Book of Ymir",
      "text" : "Continue reading."
    },
    {
      "kind" : "message",
      "line" : 271,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 272,
      "npc" : "Book of Ymir",
      "text" : "....."
    },
    {
      "kind" : "message",
      "line" : 275,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 276,
      "npc" : "Book of Ymir",
      "text" : "There is a forgotten path which leads to the Hall of Honor, the closest place to the heavens. The ordinary will never discover this place..."
    },
    {
      "kind" : "message",
      "line" : 283,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 284,
      "npc" : "Book of Ymir",
      "text" : "...Therefore, ancient heroes were"
    },
    {
      "kind" : "message",
      "line" : 285,
      "npc" : "Book of Ymir",
      "text" : "always in anguish, knowing that"
    },
    {
      "kind" : "message",
      "line" : 286,
      "npc" : "Book of Ymir",
      "text" : "eventually, they were mortal and"
    },
    {
      "kind" : "message",
      "line" : 287,
      "npc" : "Book of Ymir",
      "text" : "would pass from this realm..."
    },
    {
      "kind" : "message",
      "line" : 289,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 290,
      "npc" : "Book of Ymir",
      "text" : "There were no documents,"
    },
    {
      "kind" : "message",
      "line" : 291,
      "npc" : "Book of Ymir",
      "text" : "songs, or remaining folklore that had any information on life after death. However, I recently uncovered an old scroll"
    },
    {
      "kind" : "message",
      "line" : 292,
      "npc" : "Book of Ymir",
      "text" : "about Valkyrie..."
    },
    {
      "kind" : "message",
      "line" : 294,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 295,
      "npc" : "Book of Ymir",
      "text" : "Valkyrie..."
    },
    {
      "kind" : "message",
      "line" : 296,
      "npc" : "Book of Ymir",
      "text" : "The legendary"
    },
    {
      "kind" : "message",
      "line" : 297,
      "npc" : "Book of Ymir",
      "text" : "guardian angel."
    },
    {
      "kind" : "message",
      "line" : 298,
      "npc" : "Book of Ymir",
      "text" : "Angel of Ragnarok."
    },
    {
      "kind" : "message",
      "line" : 300,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 301,
      "npc" : "Book of Ymir",
      "text" : "Adventurers of great strength"
