      "text" : "given a new life."
    },
    {
      "kind" : "message",
      "line" : 307,
      "npc" : "Book of Ymir",
      "text" : "[The Book of Ymir]"
    },
    {
      "kind" : "message",
      "line" : 308,
      "npc" : "Book of Ymir",
      "text" : "Reborn, they will live again as"
