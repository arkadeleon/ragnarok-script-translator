      "text" : "100z"
    },
    {
      "kind" : "option",
      "line" : 133,
      "npc" : "Black Jack Dealer",
      "text" : "Too rich for my blood...."
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Black Jack Dealer",
      "text" : "[Dealer]"
    },
    {
      "kind" : "message",
      "line" : 154,
      "npc" : "Black Jack Dealer",
      "text" : "I'm sorry but you don't have enough zeny to make that bet."
    },
    {
      "kind" : "message",
