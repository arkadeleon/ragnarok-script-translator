    {
      "kind" : "option",
      "line" : 133,
      "npc" : "Black Jack Dealer",
      "text" : "Too rich for my blood...."
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Black Jack Dealer",
      "text" : "[Dealer]\nI'm sorry but you don't have enough zeny to make that bet."
    },
