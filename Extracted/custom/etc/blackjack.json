      "npc" : "Black Jack Dealer",
      "text" : "Congratulations, you've won!"
    },
    {
      "kind" : "message",
      "line" : 241,
      "npc" : "Black Jack Dealer",
      "text" : "[Dealer]"
    },
    {
      "kind" : "message",
      "line" : 242,
      "npc" : "Black Jack Dealer",
      "text" : "I'm sorry but you've lost."
    },
    {
      "kind" : "message",
