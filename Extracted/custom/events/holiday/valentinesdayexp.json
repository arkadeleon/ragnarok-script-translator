      "npc" : "Tine",
      "text" : "[Tine]"
    },
    {
      "kind" : "message",
      "line" : 50,
      "npc" : "Tine",
      "text" : "It being known that Black Handmade Chocolate works on married guys... And the White one on the married girls!"
    },
    {
      "kind" : "message",
      "line" : 51,
      "npc" : "Tine",
      "text" : "If you lose your wedding ring... then alas, it won't work on you."
