      "kind" : "message",
      "line" : 140,
      "npc" : "Kafra Clerk",
      "text" : "[Kafra Clerk]"
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Kafra Clerk",
      "text" : "Sorry but we have not received any ^8080FFThread^000000."
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Kafra Clerk",
      "text" : "Our shipments have been put off until its safe."
    },
    {
      "kind" : "message",
      "line" : 143,
      "npc" : "Kafra Clerk",
      "text" : "You see we get our ^8080FFThread^000000 from Alberta and a monsters keeps attacking our merchants."
