      "npc" : "Bearded Man",
      "text" : "Let's make you your beard!"
    },
    {
      "kind" : "message",
      "line" : 85,
      "npc" : "Bearded Man",
      "text" : "^8080FF~You see him cutting and sewing the beard together~^000000"
    },
    {
      "kind" : "message",
      "line" : 87,
      "npc" : "Bearded Man",
      "text" : "^8080FF~He hands you the finished beard~^000000"
