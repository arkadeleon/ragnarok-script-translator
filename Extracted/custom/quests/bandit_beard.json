    {
      "kind" : "message",
      "line" : 127,
      "npc" : "Kafra Clerk",
      "text" : "What can I do for you?"
    },
    {
      "kind" : "option",
      "line" : 131,
      "npc" : "Kafra Clerk",
      "text" : "What's in the boxes?"
    },
    {
      "kind" : "option",
      "line" : 131,
      "npc" : "Kafra Clerk",
      "text" : "Nothing."
    },
    {
      "kind" : "message",
      "line" : 133,
      "npc" : "Kafra Clerk",
      "text" : "[Kafra Clerk]"
