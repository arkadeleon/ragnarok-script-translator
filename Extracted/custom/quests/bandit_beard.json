    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Bearded Man",
      "text" : "[Bearded Man]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Bearded Man",
      "text" : "I would need some ^8080FFThread^000000 for the Beard."
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Bearded Man",
