    {
      "kind" : "message",
      "line" : 60,
      "npc" : "Bearded Man",
      "text" : "[Bearded Man]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Bearded Man",
      "text" : "Fine, be that way!"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Bearded Man",
      "text" : "[Bearded Man]"
    },
    {
      "kind" : "message",
      "line" : 67,
      "npc" : "Bearded Man",
      "text" : "Sorry, I can only make one per person."
