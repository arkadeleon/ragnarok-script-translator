    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Master Tailor",
      "text" : "But I have the address to where I get the shipments."
    },
    {
      "kind" : "message",
      "line" : 115,
      "npc" : "Master Tailor",
      "text" : "It is in Al de Baran Kafra Inc. warehouse area."
    },
    {
      "kind" : "message",
      "line" : 116,
      "npc" : "Master Tailor",
      "text" : "The address is: Al de Baran 59, 221"
    },
    {
      "kind" : "message",
      "line" : 117,
      "npc" : "Master Tailor",
      "text" : "See you later."
    },
    {
      "kind" : "message",
      "line" : 123,
      "npc" : "Kafra Clerk",
      "text" : "[Kafra Clerk]"
