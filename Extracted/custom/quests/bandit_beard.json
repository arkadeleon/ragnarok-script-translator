    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Kafra Clerk",
      "text" : "[Kafra Clerk]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Kafra Clerk",
      "text" : "Now this monsters has not been doing this before."
    },
    {
      "kind" : "message",
      "line" : 147,
      "npc" : "Kafra Clerk",
      "text" : "It may have to do with the warmer months."
    },
    {
      "kind" : "message",
      "line" : 148,
      "npc" : "Kafra Clerk",
      "text" : "Please help us out!"
    },
    {
      "kind" : "message",
      "line" : 151,
      "npc" : "Kafra Clerk",
      "text" : "[Kafra Clerk]"
    },
    {
      "kind" : "message",
      "line" : 153,
      "npc" : "Kafra Clerk",
      "text" : "Oh by the way, that Thread Merchant is somewhere around Alberta 60 and 100..."
    },
    {
      "kind" : "message",
      "line" : 155,
      "npc" : "Kafra Clerk",
      "text" : "Thank You!"
    },
    {
      "kind" : "message",
      "line" : 164,
      "npc" : "Man",
      "text" : "[Thread Merchant]"
    },
    {
      "kind" : "message",
      "line" : 165,
      "npc" : "Man",
      "text" : "ARGGG!! I can never get my stuff to Al de Baran!"
