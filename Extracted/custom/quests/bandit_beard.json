    {
      "kind" : "message",
      "line" : 97,
      "npc" : "Bearded Man",
      "text" : "[Bearded Man]"
    },
    {
      "kind" : "message",
      "line" : 98,
      "npc" : "Bearded Man",
      "text" : "What the hell! I can't make a beard without the items!"
