    {
      "kind" : "message",
      "line" : 112,
      "npc" : "Master Tailor",
      "text" : "What? A Bearded Man sent you..."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Master Tailor",
      "text" : "Well I'm sorry to say that I am out of ^8080FFThread^000000."
