    {
      "kind" : "message",
      "line" : 185,
      "npc" : "Man",
      "text" : "[Thread Merchant]"
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Man",
      "text" : "Oh NO! Here they come!!"
