{
  "file" : "npc/custom/card_remover.txt",
  "scripts" : [
    {
      "kind" : "message",
      "line" : 24,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 25,
      "npc" : "Wise Old Woman",
      "text" : "Good day, young one. I have the power to remove cards that you have compounded onto your equipment. Does this idea please you?"
    },
    {
      "kind" : "option",
      "line" : 27,
      "npc" : "Wise Old Woman",
      "text" : "Yes, it does."
    },
    {
      "kind" : "option",
      "line" : 27,
      "npc" : "Wise Old Woman",
      "text" : "What do you charge?"
    },
    {
      "kind" : "option",
      "line" : 27,
      "npc" : "Wise Old Woman",
      "text" : "No thanks."
    },
    {
      "kind" : "message",
      "line" : 29,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 30,
      "npc" : "Wise Old Woman",
      "text" : "Very well. Which item shall I examine for you?"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 42,
      "npc" : "Wise Old Woman",
      "text" : "Young one... Your not wearing anything there that I can remove cards from."
    },
    {
      "kind" : "message",
      "line" : 46,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 47,
      "npc" : "Wise Old Woman",
      "text" : "Young one... There are no cards compounded on this item. I can do nothing with it, I'm afraid."
    },
    {
      "kind" : "message",
      "line" : 53,
      "npc" : "Wise Old Woman",
      "text" : "^3355FFJust a minute!"
    },
    {
      "kind" : "message",
      "line" : 54,
      "npc" : "Wise Old Woman",
      "text" : "I can't offer any of my"
    },
    {
      "kind" : "message",
      "line" : 55,
      "npc" : "Wise Old Woman",
      "text" : "services to you because"
    },
    {
      "kind" : "message",
      "line" : 56,
      "npc" : "Wise Old Woman",
      "text" : "you're carrying too much"
    },
    {
      "kind" : "message",
      "line" : 57,
      "npc" : "Wise Old Woman",
      "text" : "stuff. Put your extra items in"
    },
    {
      "kind" : "message",
      "line" : 58,
      "npc" : "Wise Old Woman",
      "text" : "Kafra Storage and come again~"
    },
    {
      "kind" : "message",
      "line" : 61,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 62,
      "npc" : "Wise Old Woman",
      "placeholders" : [
        ".@cardcount",
        "(.zenycost+(.@cardcount * .percardcost))"
      ],
      "text" : "This item has {0} cards compounded on it. To perform my magic, I will need {1} zeny, a ^0000FFStar Crumb^000000, and a ^0000FFYellow Gemstone^000000."
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Wise Old Woman",
      "text" : "Very well. Do it."
    },
    {
      "kind" : "option",
      "line" : 64,
      "npc" : "Wise Old Woman",
      "text" : "Never mind."
    },
    {
      "kind" : "message",
      "line" : 65,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 66,
      "npc" : "Wise Old Woman",
      "text" : "Very well. Return at once if you seek my services."
    },
    {
      "kind" : "message",
      "line" : 70,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 71,
      "npc" : "Wise Old Woman",
      "text" : "You do not have all the items I require to work my magic, child. Come again when you do."
    },
    {
      "kind" : "message",
      "line" : 74,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 75,
      "npc" : "Wise Old Woman",
      "text" : "Before I begin, I must warn you--I may fail. If I do, I may destroy the cards, the item, or both. I do not give refunds. That being said, which is more important to you: The cards, or the item?"
    },
    {
      "kind" : "option",
      "line" : 77,
      "npc" : "Wise Old Woman",
      "text" : "I changed my mind about this."
    },
    {
      "kind" : "option",
      "line" : 77,
      "npc" : "Wise Old Woman",
      "text" : "The item."
    },
    {
      "kind" : "option",
      "line" : 77,
      "npc" : "Wise Old Woman",
      "text" : "The cards."
    },
    {
      "kind" : "message",
      "line" : 79,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "npc" : "Wise Old Woman",
      "text" : "Very well. Return at once if you seek my services."
    },
    {
      "kind" : "message",
      "line" : 88,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 89,
      "npc" : "Wise Old Woman",
      "text" : "Very well. I shall begin."
    },
    {
      "kind" : "message",
      "line" : 104,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 105,
      "npc" : "Wise Old Woman",
      "text" : "The process was a total failure. I am afraid the item and the cards were destroyed."
    },
    {
      "kind" : "message",
      "line" : 113,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 114,
      "npc" : "Wise Old Woman",
      "text" : "While I have managed to remove the cards from the item, they were destroyed in the process. The item, however, is okay."
    },
    {
      "kind" : "message",
      "line" : 121,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 122,
      "npc" : "Wise Old Woman",
      "text" : "Most unfortunate. I succeeded at removing the cards, but the item itself was destroyed in the process."
    },
    {
      "kind" : "message",
      "line" : 131,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 132,
      "npc" : "Wise Old Woman",
      "text" : "I have failed to remove the cards. Luckily, however, both the item and the cards are still okay."
    },
    {
      "kind" : "message",
      "line" : 137,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 138,
      "npc" : "Wise Old Woman",
      "text" : "The process was a success. Here are your cards and your item. Farewell."
    },
    {
      "kind" : "message",
      "line" : 141,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 142,
      "npc" : "Wise Old Woman",
      "placeholders" : [
        "callfunc(\"F_InsertComma\",.zenycost)",
        "callfunc(\"F_InsertComma\",.percardcost)"
      ],
      "text" : "I charge a flat fee of {0} zeny, plus {1} zeny for each card I remove from the item. In addition, I need a star crumb and a yellow gemstone to work my magic."
    },
    {
      "kind" : "message",
      "line" : 145,
      "npc" : "Wise Old Woman",
      "text" : "[Wise Old Woman]"
    },
    {
      "kind" : "message",
      "line" : 146,
      "npc" : "Wise Old Woman",
      "text" : "Very well. Return at once if you seek my services."
    }
