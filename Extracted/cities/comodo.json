      "npc" : "Zain",
      "text" : "I'm sorry, but you"
    },
    {
      "kind" : "message",
      "line" : 372,
      "npc" : "Zain",
      "text" : "don't have enough"
    },
    {
      "kind" : "message",
      "line" : 373,
      "npc" : "Zain",
      "text" : "zeny for the boarding fare."
    },
    {
