    {
      "kind" : "message",
      "line" : 402,
      "npc" : "Serutero",
      "text" : "[Serutero]"
    },
    {
      "kind" : "message",
      "line" : 403,
      "npc" : "Serutero",
      "text" : "Hello, I'm Serutero,"
    },
    {
      "kind" : "message",
      "line" : 404,
      "npc" : "Serutero",
      "text" : "guardian of the roads that"
    },
    {
      "kind" : "message",
      "line" : 405,
      "npc" : "Serutero",
      "text" : "lead to Sandaruman Fortress."
    },
    {
      "kind" : "message",
      "line" : 406,
      "npc" : "Serutero",
      "text" : "If you really want to go there,"
    },
    {
      "kind" : "message",
      "line" : 407,
      "npc" : "Serutero",
      "text" : "I'll permit you to continue, but you must beware of its dangers..."
    },
    {
      "kind" : "option",
      "line" : 409,
      "npc" : "Serutero",
      "text" : "I'm going there!"
    },
    {
      "kind" : "option",
      "line" : 409,
      "npc" : "Serutero",
      "text" : "Sandaruman Fortress?"
    },
    {
      "kind" : "option",
      "line" : 409,
      "npc" : "Serutero",
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 411,
      "npc" : "Serutero",
      "text" : "[Serutero]"
    },
    {
      "kind" : "message",
      "line" : 412,
      "npc" : "Serutero",
      "text" : "So you're really going"
    },
    {
      "kind" : "message",
      "line" : 413,
      "npc" : "Serutero",
      "text" : "to go to Sandaruman"
    },
    {
      "kind" : "message",
      "line" : 414,
      "npc" : "Serutero",
      "text" : "Fortress. Alright then,"
    },
    {
      "kind" : "message",
      "line" : 415,
      "npc" : "Serutero",
      "text" : "good luck, and be careful!"
    },
    {
      "kind" : "message",
      "line" : 420,
      "npc" : "Serutero",
      "text" : "[Serutero]"
    },
    {
      "kind" : "message",
      "line" : 421,
      "npc" : "Serutero",
      "text" : "Although Sandaruman"
    },
    {
      "kind" : "message",
      "line" : 422,
      "npc" : "Serutero",
      "text" : "Fortress is infested with"
    },
    {
      "kind" : "message",
      "line" : 423,
      "npc" : "Serutero",
      "text" : "monsters now, it used to be"
    },
    {
      "kind" : "message",
      "line" : 424,
      "npc" : "Serutero",
      "text" : "a province where people lived."
    },
    {
      "kind" : "message",
      "line" : 425,
      "npc" : "Serutero",
      "text" : "However, they were always"
    },
    {
      "kind" : "message",
      "line" : 426,
      "npc" : "Serutero",
      "text" : "invaded and pillaged..."
    },
    {
      "kind" : "message",
      "line" : 428,
      "npc" : "Serutero",
      "text" : "[Serutero]"
    },
    {
      "kind" : "message",
      "line" : 429,
      "npc" : "Serutero",
      "text" : "Sandaruman's inhabitants"
    },
    {
      "kind" : "message",
      "line" : 430,
      "npc" : "Serutero",
      "text" : "eventually adapted to the"
    },
    {
      "kind" : "message",
      "line" : 431,
      "npc" : "Serutero",
      "text" : "invasions, developing smoke"
    },
    {
      "kind" : "message",
      "line" : 432,
      "npc" : "Serutero",
      "text" : "signals and fortifications to"
    },
    {
      "kind" : "message",
      "line" : 433,
      "npc" : "Serutero",
      "text" : "withstand the ravages of war."
    },
    {
      "kind" : "message",
      "line" : 434,
      "npc" : "Serutero",
      "text" : "Then, Comodo was built..."
    },
    {
      "kind" : "message",
      "line" : 436,
      "npc" : "Serutero",
      "text" : "[Serutero]"
    },
    {
      "kind" : "message",
      "line" : 437,
      "npc" : "Serutero",
      "text" : "Comodo grew in power and"
    },
    {
      "kind" : "message",
      "line" : 438,
      "npc" : "Serutero",
      "text" : "influence and eventually annexed Sandaruman. More and more people"
    },
    {
      "kind" : "message",
      "line" : 439,
      "npc" : "Serutero",
      "text" : "moved from the fortress to Comodo until Sandaruman fortress was"
    },
    {
      "kind" : "message",
      "line" : 440,
      "npc" : "Serutero",
      "text" : "essentially abandoned."
    },
    {
      "kind" : "message",
      "line" : 442,
      "npc" : "Serutero",
      "text" : "[Serutero]"
    },
    {
      "kind" : "message",
      "line" : 443,
      "npc" : "Serutero",
      "text" : "There were a few people"
    },
    {
      "kind" : "message",
      "line" : 444,
      "npc" : "Serutero",
      "text" : "remaining in Sandaruman,"
    },
    {
      "kind" : "message",
      "line" : 445,
      "npc" : "Serutero",
      "text" : "but they revolted and some"
    },
    {
      "kind" : "message",
      "line" : 446,
      "npc" : "Serutero",
      "text" : "fledging government came into"
    },
    {
      "kind" : "message",
      "line" : 447,
      "npc" : "Serutero",
      "text" : "power there. The monsters took"
    },
    {
      "kind" : "message",
      "line" : 448,
      "npc" : "Serutero",
      "text" : "the chance to take over..."
    },
    {
      "kind" : "message",
      "line" : 450,
      "npc" : "Serutero",
      "text" : "[Serutero]"
    },
    {
      "kind" : "message",
      "line" : 451,
      "npc" : "Serutero",
      "text" : "There's nothing around"
    },
    {
      "kind" : "message",
      "line" : 452,
      "npc" : "Serutero",
      "text" : "Sandaruman now. Well, nothing"
    },
    {
      "kind" : "message",
      "line" : 453,
      "npc" : "Serutero",
      "text" : "except maybe Paros Lighthouse,"
    },
    {
      "kind" : "message",
      "line" : 454,
      "npc" : "Serutero",
      "text" : "which is southwest of here. That place might be of interest to"
    },
