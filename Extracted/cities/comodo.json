      "text" : "Welcome to the"
    },
    {
      "kind" : "message",
      "line" : 382,
      "npc" : "Kafra Employee",
      "text" : "Kafra Corporation."
    },
    {
      "kind" : "message",
      "line" : 383,
      "npc" : "Kafra Employee",
      "text" : "You know that our"
    },
    {
      "kind" : "message",
      "line" : 384,
      "npc" : "Kafra Employee",
      "text" : "service is always"
    },
    {
      "kind" : "message",
      "line" : 385,
      "npc" : "Kafra Employee",
      "text" : "on your side~"
    },
    {
      "kind" : "message",
      "line" : 387,
      "npc" : "Kafra Employee",
      "text" : "[Kafra Misty]"
    },
    {
      "kind" : "message",
      "line" : 388,
      "npc" : "Kafra Employee",
      "text" : "The Kafra Corporation"
    },
    {
      "kind" : "message",
      "line" : 389,
