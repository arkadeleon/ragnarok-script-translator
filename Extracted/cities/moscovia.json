    {
      "kind" : "message",
      "line" : 20,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 21,
      "text" : "Moscovia! Do you know Moscovia?"
    },
    {
      "kind" : "message",
      "line" : 22,
      "text" : "the paradise spreading on the endless seas..."
    },
    {
      "kind" : "message",
      "line" : 23,
      "text" : "Welcome to Moscovia"
    },
    {
      "kind" : "message",
      "line" : 24,
      "text" : "It's adventurous and mystic."
    },
    {
      "kind" : "option",
      "line" : 26,
      "text" : "About Moscovia..."
    },
    {
      "kind" : "option",
      "line" : 26,
      "text" : "Go to Moscovia."
    },
    {
      "kind" : "option",
      "line" : 26,
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 28,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 29,
      "text" : "Moscovia is a beautiful kingdom"
    },
    {
      "kind" : "message",
      "line" : 30,
      "text" : "on an island located north of Rune-"
    },
    {
      "kind" : "message",
      "line" : 31,
      "text" : "Midgarts."
    },
    {
      "kind" : "message",
      "line" : 33,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 34,
      "text" : "I'm sure that you will be"
    },
    {
      "kind" : "message",
      "line" : 35,
      "text" : "absolutely fascinated"
    },
    {
      "kind" : "message",
      "line" : 36,
      "text" : "by Moscovia's beautiful scenery"
    },
    {
      "kind" : "message",
      "line" : 37,
      "text" : "and gorgeous palace."
    },
    {
      "kind" : "message",
      "line" : 39,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "text" : "Now that our long winter has"
    },
    {
      "kind" : "message",
      "line" : 41,
      "text" : "passed,"
    },
    {
      "kind" : "message",
      "line" : 42,
      "text" : "I'm happy that I can now show you"
    },
    {
      "kind" : "message",
      "line" : 43,
      "text" : "our gorgeous hometown."
    },
    {
      "kind" : "message",
      "line" : 45,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 46,
      "text" : "If you feel like visiting Moscovia"
    },
    {
      "kind" : "message",
      "line" : 47,
      "text" : "take the chance now!"
    },
    {
      "kind" : "message",
      "line" : 48,
      "text" : "I'll help you to have a nice trip"
    },
    {
      "kind" : "message",
      "line" : 49,
      "text" : "to Moscovia!"
    },
    {
      "kind" : "message",
      "line" : 53,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 54,
      "text" : "Ok then, let us start now."
    },
    {
      "kind" : "message",
      "line" : 55,
      "text" : "You should pay me 10,000 zeny"
    },
    {
      "kind" : "message",
      "line" : 56,
      "text" : "to go to Moscovia."
    },
    {
      "kind" : "message",
      "line" : 57,
      "text" : "But when you come back,"
    },
    {
      "kind" : "message",
      "line" : 58,
      "text" : "you don't have to pay."
    },
    {
      "kind" : "message",
      "line" : 60,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 61,
      "text" : "Can we leave now?"
    },
    {
      "kind" : "option",
      "line" : 63,
      "text" : "Let's go!"
    },
    {
      "kind" : "option",
      "line" : 63,
      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 64,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 65,
      "text" : "If you're too busy now,"
    },
    {
      "kind" : "message",
      "line" : 66,
      "text" : "please tell me again whenever you want."
    },
    {
      "kind" : "message",
      "line" : 67,
      "text" : "I'm always ready to guide anyone to Moscovia."
    },
    {
      "kind" : "message",
      "line" : 71,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 72,
      "text" : "I'm sorry but you don't have"
    },
    {
      "kind" : "message",
      "line" : 73,
      "text" : "enough zeny now"
    },
    {
      "kind" : "message",
      "line" : 74,
      "text" : "You need 10,000 zeny"
    },
    {
      "kind" : "message",
      "line" : 75,
      "text" : "to go to Moscovia"
    },
    {
      "kind" : "message",
      "line" : 76,
      "text" : "Thank you."
    },
    {
      "kind" : "message",
      "line" : 79,
      "text" : "[Moscovia P.R. Officer]"
    },
    {
      "kind" : "message",
      "line" : 80,
      "text" : "Ok then, we're leaving now."
    },
