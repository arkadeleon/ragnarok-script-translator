      "text" : "[Undead Chicken]"
    },
    {
      "kind" : "message",
      "line" : 76,
      "npc" : "Undead Chicken",
      "text" : "I lived a peaceful life as a normal chicken. But then came the day I was tragically killed and eaten by humans. Well... Heh heh~! Now it's my turn! *Cackles*"
