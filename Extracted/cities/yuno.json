      "text" : "Cancel"
    },
    {
      "kind" : "message",
      "line" : 388,
      "npc" : "Airship Representative",
      "text" : "[Airship Representative]"
    },
    {
      "kind" : "message",
      "line" : 389,
      "npc" : "Airship Representative",
      "text" : "I regret to say that you do not have enough zeny with you."
