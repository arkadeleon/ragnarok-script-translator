    {
      "kind" : "message",
      "line" : 267,
      "npc" : "Friendly Looking Lady",
      "text" : "[Hong Miao]"
    },
    {
      "kind" : "message",
      "line" : 268,
      "npc" : "Friendly Looking Lady",
      "text" : "Welcome."
    },
    {
      "kind" : "message",
      "line" : 270,
      "npc" : "Friendly Looking Lady",
      "text" : "[Hong Miao]"
    },
    {
      "kind" : "message",
      "line" : 271,
      "npc" : "Friendly Looking Lady",
      "text" : "This is an elevator which leads"
    },
    {
      "kind" : "message",
      "line" : 272,
      "npc" : "Friendly Looking Lady",
      "text" : "to the Observation Tower. We are providing you a safe and fast transfer service for an affordable fee. Would you like to use this service?"
    },
    {
      "kind" : "option",
      "line" : 274,
      "npc" : "Friendly Looking Lady",
      "text" : "Information."
    },
    {
      "kind" : "option",
      "line" : 274,
      "npc" : "Friendly Looking Lady",
      "text" : "Yes."
    },
    {
      "kind" : "option",
      "line" : 274,
      "npc" : "Friendly Looking Lady",
      "text" : "Maybe next time."
    },
    {
      "kind" : "message",
      "line" : 276,
      "npc" : "Friendly Looking Lady",
      "text" : "[Hong Miao]"
    },
    {
      "kind" : "message",
      "line" : 277,
      "npc" : "Friendly Looking Lady",
      "text" : "After many suggestions and proposals were sent to the Luoyang tourism office, the Observation Tower was built so tourists can enjoy the sights."
    },
    {
      "kind" : "message",
      "line" : 279,
      "npc" : "Friendly Looking Lady",
      "text" : "[Hong Miao]"
    },
    {
      "kind" : "message",
      "line" : 280,
      "npc" : "Friendly Looking Lady",
      "text" : "Due to the geographical"
    },
    {
      "kind" : "message",
      "line" : 281,
      "npc" : "Friendly Looking Lady",
      "text" : "features of Luoyang, it's difficult to enjoy the breath taking view that our land has to offer."
    },
    {
      "kind" : "message",
      "line" : 283,
      "npc" : "Friendly Looking Lady",
      "text" : "[Hong Miao]"
    },
    {
      "kind" : "message",
      "line" : 284,
      "npc" : "Friendly Looking Lady",
      "text" : "You can come up to the tower by taking the elevator right here. We are providing this quick and safe transfer service for 500 zeny per person."
    },
    {
      "kind" : "message",
      "line" : 288,
      "npc" : "Friendly Looking Lady",
      "text" : "[Hong Miao]"
    },
    {
      "kind" : "message",
      "line" : 289,
      "npc" : "Friendly Looking Lady",
      "text" : "I'm sorry, but you do not have enough zeny. I hope you'll come back later to enjoy the Observation Tower. Have a good day."
    },
    {
      "kind" : "message",
      "line" : 292,
      "npc" : "Friendly Looking Lady",
      "text" : "[Hong Miao]"
    },
