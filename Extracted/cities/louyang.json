    },
    {
      "kind" : "message",
      "line" : 30,
      "text" : "La la la la~"
    },
    {
      "kind" : "option",
      "line" : 32,
      "text" : "About Luoyang."
    },
    {
      "kind" : "option",
      "line" : 32,
      "text" : "Go to Luoyang."
