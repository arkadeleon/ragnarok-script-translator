      "text" : "[Young man]"
    },
    {
      "kind" : "message",
      "line" : 276,
      "npc" : "Young man",
      "text" : "Wait! Just so you know, I don't care if the items in your inventory have been upgraded, or have cards attached."
    },
    {
      "kind" : "message",
