      "kind" : "message",
      "line" : 44,
      "npc" : "Vending Machine Man",
      "text" : "[Titicupe]"
    },
    {
      "kind" : "message",
      "line" : 45,
      "npc" : "Vending Machine Man",
      "text" : "And the headgears--! I... I can't contain myself!"
