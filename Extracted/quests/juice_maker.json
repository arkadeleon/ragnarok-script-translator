      "text" : "[Housewife Marianne]"
    },
    {
      "kind" : "message",
      "line" : 40,
      "npc" : "Marianne",
      "text" : "Hm? ...You!"
    },
    {
      "kind" : "message",
      "line" : 41,
      "npc" : "Marianne",
      "text" : "You're the one who gave, my little Morrison that Meat?! Did you come here thinking I wouldn't know about it?!"
    },
    {
      "kind" : "message",
      "line" : 43,
      "npc" : "Marianne",
      "text" : "[Housewife Marianne]"
    },
    {
      "kind" : "message",
      "line" : 44,
      "npc" : "Marianne",
      "text" : "Go away, get out of my house NOW!!"
