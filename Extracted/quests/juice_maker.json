      "kind" : "message",
      "line" : 47,
      "npc" : "Marianne",
      "text" : "[Housewife Marianne]"
    },
    {
      "kind" : "message",
      "line" : 48,
      "npc" : "Marianne",
      "text" : "Morrison!! I'm going to be very very mad if you keep doing this!"
