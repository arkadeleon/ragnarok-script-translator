      "npc" : "Roberto",
      "text" : "Ah! That arrow!"
    },
    {
      "kind" : "message",
      "line" : 26,
      "npc" : "Roberto",
      "text" : "You made it, didn't you!"
    },
    {
      "kind" : "message",
