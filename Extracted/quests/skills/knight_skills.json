    {
      "kind" : "message",
      "line" : 171,
      "npc" : "Knight",
      "text" : "in the Knighthood has"
    },
    {
      "kind" : "message",
      "line" : 172,
      "npc" : "Knight",
      "text" : "been rekindled."
    },
    {
      "kind" : "message",
      "line" : 174,
      "npc" : "Knight",
      "text" : "[Essofeit]"
    },
    {
      "kind" : "message",
      "line" : 175,
      "npc" : "Knight",
      "text" : "In my recognition of you"
    },
    {
      "kind" : "message",
      "line" : 176,
      "npc" : "Knight",
      "text" : "as a true Knight, I will teach"
    },
    {
      "kind" : "message",
      "line" : 177,
      "npc" : "Knight",
      "text" : "you a special skill that I've"
    },
    {
      "kind" : "message",
      "line" : 178,
      "npc" : "Knight",
      "text" : "been researching recently. Why"
    },
    {
      "kind" : "message",
      "line" : 179,
      "npc" : "Knight",
      "text" : "don't you come back after I've"
    },
    {
      "kind" : "message",
      "line" : 180,
      "npc" : "Knight",
      "text" : "completed the preparations?"
    },
    {
      "kind" : "message",
      "line" : 186,
      "npc" : "Knight",
      "text" : "[Essofeit]"
    },
    {
      "kind" : "message",
      "line" : 187,
      "npc" : "Knight",
      "text" : "It's shameful..."
    },
    {
      "kind" : "message",
      "line" : 188,
      "npc" : "Knight",
      "text" : "Most new recruits into"
    },
    {
      "kind" : "message",
      "line" : 189,
      "npc" : "Knight",
      "text" : "the Prontera Chivalry are"
    },
    {
      "kind" : "message",
      "line" : 190,
      "npc" : "Knight",
      "text" : "more concerned about their"
    },
    {
      "kind" : "message",
      "line" : 191,
      "npc" : "Knight",
      "text" : "pensions than their honor!"
    },
    {
      "kind" : "message",
      "line" : 195,
      "npc" : "Knight",
      "text" : "[Essofeit]"
    },
    {
      "kind" : "message",
      "line" : 196,
      "npc" : "Knight",
      "text" : "Maybe I'm romanticizing"
    },
    {
      "kind" : "message",
      "line" : 197,
      "npc" : "Knight",
      "text" : "the past, but I don't agree"
    },
    {
      "kind" : "message",
      "line" : 198,
      "npc" : "Knight",
      "text" : "with all the bureaucracy"
    },
    {
      "kind" : "message",
      "line" : 199,
      "npc" : "Knight",
      "text" : "that is present today in"
    },
    {
      "kind" : "message",
      "line" : 200,
      "npc" : "Knight",
      "text" : "the Prontera Chivalry."
    },
    {
      "kind" : "message",
      "line" : 202,
      "npc" : "Knight",
      "text" : "[Essofeit]"
    },
    {
      "kind" : "message",
      "line" : 203,
      "npc" : "Knight",
      "text" : "Although, I admit"
    },
    {
      "kind" : "message",
      "line" : 204,
      "npc" : "Knight",
      "text" : "that I was a lot happier"
    },
    {
      "kind" : "message",
      "line" : 205,
      "npc" : "Knight",
      "text" : "back when honor was all"
    },
