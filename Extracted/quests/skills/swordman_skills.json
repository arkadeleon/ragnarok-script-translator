      "npc" : "Leon Von Frich",
      "text" : "They are.. somewhat like ingredients."
    },
    {
      "kind" : "message",
      "line" : 262,
      "npc" : "Leon Von Frich",
      "text" : "[Leon]"
    },
    {
      "kind" : "message",
      "line" : 263,
      "npc" : "Leon Von Frich",
      "text" : "come to me again once you have all the materials."
    },
