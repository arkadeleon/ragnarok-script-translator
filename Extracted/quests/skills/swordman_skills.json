      "npc" : "Leon Von Frich",
      "text" : "[Leon]"
    },
    {
      "kind" : "message",
      "line" : 233,
      "npc" : "Leon Von Frich",
      "text" : "...Haha nothing special, just a skill that aims at the vital spot!"
    },
    {
      "kind" : "message",
      "line" : 236,
      "npc" : "Leon Von Frich",
      "text" : "[Leon]"
    },
    {
      "kind" : "message",
      "line" : 237,
      "npc" : "Leon Von Frich",
      "text" : "It's a skill I developed recently."
    },
    {
      "kind" : "message",
