      "npc" : "Leon Von Frich",
      "text" : "and finally, I developed this wonderful new skill!"
    },
    {
      "kind" : "message",
      "line" : 252,
      "npc" : "Leon Von Frich",
      "text" : "Would you like to learn this skill?"
    },
    {
      "kind" : "option",
      "line" : 254,
      "npc" : "Leon Von Frich",
      "text" : "Yes."
    },
    {
      "kind" : "option",
      "line" : 254,
      "npc" : "Leon Von Frich",
      "text" : "No."
    },
    {
      "kind" : "option",
      "line" : 254,
      "npc" : "Leon Von Frich",
      "text" : "Do you have any advice on how to eat sushi?"
