    {
      "kind" : "message",
      "line" : 415,
      "npc" : "Juan",
      "text" : "[Juan]"
    },
    {
      "kind" : "message",
      "line" : 416,
      "npc" : "Juan",
      "text" : "Even though you may have a lot of strength"
    },
    {
      "kind" : "message",
      "line" : 417,
      "npc" : "Juan",
      "text" : "you can't do much when you reach your limits so"
