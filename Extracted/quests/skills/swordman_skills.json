    {
      "kind" : "message",
      "line" : 249,
      "npc" : "Leon Von Frich",
      "text" : "[Leon]"
    },
    {
      "kind" : "message",
      "line" : 250,
      "npc" : "Leon Von Frich",
      "text" : "I drew back from the battlefield to do research"
    },
    {
      "kind" : "message",
