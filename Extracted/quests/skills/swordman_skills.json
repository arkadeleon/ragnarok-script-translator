      "kind" : "message",
      "line" : 394,
      "npc" : "Juan",
      "text" : "wings of a butterfly will"
    },
    {
      "kind" : "message",
      "line" : 395,
      "npc" : "Juan",
      "text" : "help you gather your strength!"
    },
    {
      "kind" : "message",
      "line" : 396,
      "npc" : "Juan",
      "text" : "And 10 Horrendous Mouth."
    },
    {
      "kind" : "message",
      "line" : 397,
      "npc" : "Juan",
      "text" : "10 Decayed Nail."
    },
    {
      "kind" : "message",
      "line" : 398,
      "npc" : "Juan",
      "text" : "and last but not least..."
    },
    {
      "kind" : "message",
      "line" : 399,
      "npc" : "Juan",
      "text" : "10 Honey!"
    },
    {
      "kind" : "message",
      "line" : 401,
      "npc" : "Juan",
      "text" : "[Juan]"
    },
    {
      "kind" : "message",
      "line" : 402,
      "npc" : "Juan",
      "text" : "Did you get all that down?"
    },
    {
      "kind" : "message",
      "line" : 403,
      "npc" : "Juan",
      "text" : "As always, please come back"
    },
    {
      "kind" : "message",
      "line" : 404,
      "npc" : "Juan",
      "text" : "when you are ready."
    },
