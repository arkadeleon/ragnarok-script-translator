      "kind" : "message",
      "line" : 243,
      "npc" : "Leon Von Frich",
      "text" : "[Leon]"
    },
    {
      "kind" : "message",
      "line" : 244,
      "npc" : "Leon Von Frich",
      "text" : "When I was a swordsman like you,"
